{d:\lattices\b3_lat\b3_sfsf4q.opa}

{opa to tracy-2 export}

define lattice;
energy = 2.500000;
dp = 1.0d-10;  codeps = 1.0d-6;  dk = 1.0d-6;
meth   = 4; nbend = 10; nquad = 10;

{----- variables ---------------------------------------------------}

brv   = -0.34;
bbv   = 4.375-2.0*brv;
mbrv  = -0.0889026597923138;
mbbv  = 2.5-mbrv;

{----- table of elements ---------------------------------------------}

c0   = 2.99792458e8;
h_rf = 538;
C    = 16*20.2;

cav: Cavity, L = 0.0, Frequency = c0/C*h_rf, Voltage = 1.5e6, harnum = h_rf,
     phi = 0.0;

l1     : drift, l = 0.100000;
ml1    : drift, l = 0.100000;
ml1a   : drift, l = 0.100000;
ml1b   : drift, l = 0.100000;
ml1c   : drift, l = 0.100000;
ul1    : drift, l = 0.150000;
ul2    : drift, l = 0.300000;
ul3    : drift, l = 0.150000;
ul4    : drift, l = 0.100000;
ul5    : drift, l = 2.800000;

bb     : bending, l = 1.100000, t = bbv, k = 0.000000, t1 = bbv/2.0,
         t2 = bbv/2.0, n=nbend, method=meth;
mbb    : bending, l = 0.850000, t = mbbv, k = 0.000000, t1 = mbbv/2.0,
         t2 = mbbv/2.0, n=nbend, method=meth;

qd     : quadrupole, l = 0.125000, k = -9.602787, n=nquad, method=meth;
mqd    : quadrupole, l = 0.130000, k = -9.782278, n=nquad, method=meth;

{uq1    : quadrupole, l = 0.100000, k = 6.144712, n=nquad, method=meth;
uq2    : quadrupole, l = 0.170000, k = -9.390129, n=nquad, method=meth;
uq3    : quadrupole, l = 0.250000, k =  9.183668, n=nquad, method=meth;
uq4    : quadrupole, l = 0.100000, k = -8.997373, n=nquad, method=meth;

sd     : sextupole, l = 0.050000, k = -231.702860, n = 1, method=meth;
sf     : sextupole, l = 0.055000, k =  231.266556, n = 1, method=meth;}

uq1     : multipole, l = 0.10000,
          hom = (2,  6.14471e+00, 0e0, 4,  4.73427e+03, 0e0),
          n = nquad, Method = Meth;
uq2     : multipole, l = 0.17000,
          hom = (2, -9.39013e+00, 0e0, 4, -9.99954e+03, 0e0),
          n = nquad, Method = Meth;
uq3     : multipole, l = 0.25000,
          hom = (2,  9.18367e+00, 0e0, 4,  6.44062e+03, 0e0),
          n = nquad, Method = Meth;
uq4     : multipole, l = 0.10000,
          hom = (2, -8.99737e+00, 0e0, 4, -9.99964e+03, 0e0),
          n = nquad, Method = Meth;

sf      : multipole, l = 0.05500,
          hom = (2,  0.00000e+00, 0e0,
                 3,  2.31694e+02, 0e0,
                 4, -1.85015e+03, 0e0),
          n = 1, Method = Meth;
sd      : multipole, l = 0.05000,
          hom = (2,  0.00000e+00, 0e0,
                 3, -2.32250e+02, 0e0,
                 4,  4.13116e+03, 0e0),
          n = 1, Method = Meth;

om_sd  : marker;
om_sf  : marker;
om_mbb : marker;
om_c   : marker;

br     : bending, l = 0.170000, t = brv, k = 8.697105, t1 = brv/2.0,
         t2 = brv/2.0, n=nbend, method=meth;
mbr    : bending, l = 0.180000, t = mbrv, k = 8.899091, t1 = mbrv/2.0,
         t2 = mbrv/2.0, n=nbend, method=meth;


{----- table of segments ---------------------------------------------}

ucell : sf, l1, br, l1, qd, l1, sd, om_sd, sd, l1, bb, l1, sd, om_sd, sd, l1,
      	qd, l1, br, l1, sf;
dcell : om_sf, sf, ml1, mbr, ml1c, mqd, ml1b, sd, om_sd, sd, ml1a, mbb, om_mbb;
arc   : inv(dcell), ucell, om_sf, ucell, om_sf, om_c, ucell, om_sf, ucell,
        dcell;
mund  : om_mbb, ul1, uq1, ul2, uq2, ul3, uq3, ul4, uq4, ul5;
sec   : inv(mund), arc, mund;
sech  : om_c, 2*ucell, dcell, mund;
sec16 : inv(mund), arc, mund;
ring  : 1*sec, cav;

cell: ring, symmetry=1;

end;

{d:\lattices\b3_lat\b3_sfsf4q.opa}
