{d:\lattices\b3_lat\b3_cf425cf.opa}

{opa to tracy-2 export}

define lattice;
energy = 2.500000;
dp = 1e-6; codeps = 1e-15; dk = 1e-6;
meth = 4; nbend = 10; nquad = 10;

{----- variables ---------------------------------------------------}

brv   = -0.39;
bbv   = 4.25-2.0*brv;
mbrv  = -0.154936661938647;
mbbv  = 2.75-mbrv;

{----- table of elements ---------------------------------------------}

c0 = 2.99792458e8;
h_rf = 538;
C    = 16*20.2;

cav: Cavity, L = 0.0, Frequency = c0/C*h_rf, Voltage = 1.5e6, harnum = h_rf,
     phi = 0.0;

l1     : Drift, L = 0.100000;
ml1    : Drift, L = 0.100000;
ml1a   : Drift, L = 0.100000;
ml1b   : Drift, L = 0.100000;
ul1    : Drift, L = 0.242036;
ul2    : Drift, L = 0.100000;
ul3    : Drift, L = 0.100000;
ul4    : Drift, L = 2.800000;

bb     : Bending, L = 1.000000, T = bbv, K = -1.396722, T1 = bbv/2.0,
         T2 = bbv/2.0, N=nbend, method=meth;
mbb    : Bending, L = 0.700000, T = mbbv, K = -1.200000, T1 = mbbv/2.0,
         T2 = mbbv/2.0, N=nbend, method=meth;

br     : Bending, L = 0.150000, T = brv, K = 7.163088, T1 = brv/2.0,
         T2 = brv/2.0, N=nbend, method=meth;
mbr    : Bending, L = 0.150000, T = mbrv, K = 8.410041, T1 = mbrv/2.0,
         T2 = mbrv/2.0, N=nbend, method=meth;

uq1    : Quadrupole, L = 0.130000, K = -9.338897, N=nquad, method=meth;
uq2    : Quadrupole, L = 0.280000, K =  9.339560, N=nquad, method=meth;
uq3    : Quadrupole, L = 0.100000, K = -9.028075, N=nquad, method=meth;

sd     : Sextupole, L = 0.170000/2.0, K = -236.251699, N = 1, method=meth;
sd2    : Sextupole, L = 0.170000/2.0, K = -236.251699, N = 1, method=meth;
sf     : Sextupole, L = 0.130000,     K =  240.093069, N = 1, method=meth;

{uq1     : multipole, l = 0.13000,
          hom = (2, -9.33890e+00, 0e0, 4, -7.17075e+03, 0e0),
          n = nquad, Method = Meth;
uq2     : multipole, l = 0.28000,
          hom = (2,  9.33956e+00, 0e0, 4,  2.96746e+03, 0e0),
          n = nquad, Method = Meth;
uq3     : multipole, l = 0.10000,
          hom = (2, -9.02807e+00, 0e0, 4, -2.91993e+03, 0e0),
          n = nquad, Method = Meth;

sf      : multipole, l = 0.13000,
          hom = (2,  0.00000e+00, 0e0,
                 3,  2.48325e+02, 0e0,
                 4, -6.92315e+03, 0e0),
          n = 1, Method = Meth;
sd      : multipole, l = 0.17000/2.0,
          hom = (2,  0.00000e+00, 0e0,
                 3, -2.83544e+02, 0e0,
                 4,  2.15069e+03, 0e0),
          n = 1, Method = Meth;
sd2     : multipole, l = 0.17000/2.0,
          hom = (2,  0.00000e+00, 0e0,
                 3, -8.79574e+01, 0e0,
                 4,  2.95604e+04, 0e0),
          n = 1, Method = Meth;}

om_sf  : Marker;
om_sd  : Marker;
om_mbb : Marker;
om_c   : Marker;
om_s   : Marker;


{----- table of segments ---------------------------------------------}

ucell:      sf, l1, br, l1, sd, om_sd, sd, l1, bb, l1, sd, om_sd, sd,
	    l1, br, l1, sf;
dcell:      om_sf, sf, ml1, mbr, ml1b, sd2, om_sd, sd2, ml1a, mbb,
	    om_mbb;
arc:        inv(dcell), ucell, om_sf, ucell, om_sf, om_c, ucell, om_sf,
	    ucell, dcell;
mund:       om_mbb, ul1, uq1, ul2, uq2, ul3, uq3, ul4, om_s;
sec:        inv(mund), arc, mund;
ring:       sec, cav;

cell:       ring, symmetry=1;

end;

