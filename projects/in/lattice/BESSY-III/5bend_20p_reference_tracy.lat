{..bessy iii\re__your_start_on_tuesday_01.12.2020\5bend_20p_reference.opa}

{opa to tracy-2 export}

define lattice;
energy = 2.500000;
dp = 1.0d-10;  codeps = 1.0d-6;  dk = 1.0d-6;
meth = 4; nbend = 10; nquad = 10;

{----- variables ----------------------------------------------------}

orbitdpp  = 0;
b0a       = 2.39*1.0;
b1a       = -0.205*1.0;
mb1a      = -0.0*1.0;
mb0a      = 2.445-mb1a;

pi = 4.0*arctan(1.0);
c0 = 2.99792458e8; gamma = 3.5e9/c0; Brho = 1e9*Energy/c0;
h_rf = 535; C = 20*16.0600000;

{----- table of elements ----------------------------------------------------}

cav: Cavity, L = 0.0, Frequency = c0/C*h_rf, Voltage = 1.5e6, harnum = h_rf,
     phi = 0.0;

l0  : drift, l = 0.100000;
l1  : drift, l = 0.100000;
l2  : drift, l = 0.100000;
l3  : drift, l = 0.100000;
ml0 : drift, l = 0.050000;
ml1 : drift, l = 0.050000;
ml2 : drift, l = 0.100000;
ml3 : drift, l = 0.100000;
ul0 : drift, l = 0.100000;
ul1 : drift, l = 0.100000;
ul2 : drift, l = 0.100000;
ul3 : drift, l = 0.100000;
ul4 : drift, l = 2.500000;
o1l : drift, l = 0.040000;

q0  : quadrupole, l = 0.090000, k = -11.102108, n=nquad, method=meth;
q1  : quadrupole, l = 0.140000, k = 11.052113, n=nquad, method=meth;
q1a : quadrupole, l = 0.120000, k = 11.335714, n=nquad, method=meth;
mq0 : quadrupole, l = 0.100000, k = 0.000000, n=nquad, method=meth;
mq1 : quadrupole, l = 0.130000, k = -11.304641, n=nquad, method=meth;
mq2 : quadrupole, l = 0.160000, k = 11.684475, n=nquad, method=meth;
uq1 : quadrupole, l = 0.090000, k = -9.208116, n=nquad, method=meth;
uq2 : quadrupole, l = 0.240000, k = 11.669158, n=nquad, method=meth;
uq3 : quadrupole, l = 0.090000, k = -11.061242, n=nquad, method=meth;

b0  : bending, l = 0.230000, t = b0a, k = 0.000000, t1 = 0.000000,
      t2 = b0a, n=nbend, method=meth;
i_b0  : bending, l = 0.230000, t = b0a, k = 0.000000, t1 = b0a,
      t2 = 0.000000, n=nbend, method=meth;
b1  : bending, l = 0.050000, t = b1a, k = 0.000000, t1 = b1a/2.0,
      t2 = b1a/2.0, n=nbend, method=meth;
mb0 : bending, l = 0.230000, t = mb0a, k = 0.000000, t1 = mb0a/2.0,
      t2 = mb0a/2.0, n=nbend, method=meth;
mb1 : bending, l = 0.050000, t = mb1a, k = 0.000000, t1 = mb1a/2.0,
      t2 = mb1a/2.0, n=nbend, method=meth;

s0  : sextupole, l = 0.060000, k = 721.734906, n = 1, method=meth;
s0a : sextupole, l = 0.040000, k = 782.633295, n = 1, method=meth;
s1  : sextupole, l = 0.080000, k = -762.247450, n = 1, method=meth;
s1a : sextupole, l = 0.080000, k = -87.578394, n = 1, method=meth;
s3  : sextupole, l = 0.080000, k = -407.911570, n = 1, method=meth;
s4  : sextupole, l = 0.080000, k = -252.946142, n = 1, method=meth;
s5  : sextupole, l = 0.080000, k = 503.956264, n = 1, method=meth;

mbc : marker;


{----- table of segments ----------------------------------------------------}

cell0    : mbc, b0, l0, q0, l1, s1, l1, q1, l2, b1, l3, s0;
i_cell0  : s0, l3, b1, l2, q1, l1, s1, l1, q0, l0, i_b0, mbc;
cell1    : mbc, b0, l0, q0, l1, s1, l1, q1a, l2, b1, l3, s0a;
i_cell1  : s0a, l3, b1, l2, q1a, l1, s1, l1, q0, l0, i_b0, mbc;
mbacell  : i_cell0, cell0;
i_mbacell: i_cell0, cell0;
mcell    : mb0, ml3, mq1, ml2, s1a, ml2, mq2, ml1, ml0, s0a;
mund     : ul0, s3, ul0, uq1, ul1, uq2, ul2, s5, ul2, uq3, ul4;
match    : cell1, inv(mcell), mund;
i_match  : inv(mund), mcell, i_cell1;
arc      : i_match, cell0, mbacell, i_cell0, match;
i_arc    : i_match, cell0, i_mbacell, i_cell0, match;

line: 1*arc, cav;

cell: line, symmetry=1;

end;

{..bessy iii\re__your_start_on_tuesday_01.12.2020\5bend_20p_reference.opa}
