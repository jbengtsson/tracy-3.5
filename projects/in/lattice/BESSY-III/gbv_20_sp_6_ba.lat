{z:\git\tracy-3.5\projects\in\lattice\bessy-iii\jbgv_20_sp_5ba.opa}

{opa to tracy-2 export}

define lattice;
energy = 2.500000;
dp = 1.0d-10;  codeps = 1.0d-6;  dk = 1.0d-6;
meth = 4; nbend = 10; nquad = 10; nsext = 10;

{----- variables ----------------------------------------------------}


{----- table of elements ----------------------------------------------------}

c0 = 2.99792458e8; gamma = 3.5e9/c0; Brho = 1e9*Energy/c0;

h_rf = 535; C = 20*16.0600000;

cav: Cavity, L = 0.0, Frequency = c0/C*h_rf, Voltage = 1.5e6, harnum = h_rf,
     phi = 0.0;

l1   : drift, l = 0.100000;
l2   : drift, l = 0.100000;
l3   : drift, l = 0.100000;
l4   : drift, l = 0.100000;
l5   : drift, l = 0.100000;
l6   : drift, l = 0.100000;
l7   : drift, l = 0.100000;
l8   : drift, l = 0.100000;
l9   : drift, l = 2.500000;

b1e:      bending, l =  0.69999995,
    t =  2.17050402, t1 =  1.08525201, t2 =  1.08525201, k = -1.11862757,
    n = nbend, method = 4;
b1c:      bending, l =  0.40000000,
    t =  1.96676719, t1 =  0.98338359, t2 =  0.98338359, k = -2.23018073,
    n = nbend, method = 4;
b2:       bending, l =  0.13000000,
    t = -0.20751455, t1 = -0.10375728, t2 = -0.10375728, k = 10.52886690,
    n = nbend, method = 4;

q1:       quadrupole, l = 0.16000000, k =   -8.33341289, n = nquad, method = 4;
q2:       quadrupole, l = 0.26000000, k =    9.00645296, n = nquad, method = 4;
q3:       quadrupole, l = 0.10000000, k =   -6.17013203, n = nquad, method = 4;

s1:       sextupole,  l = 0.06000000, k =  989.10221119, n = nsext, method = 4;
s2:       sextupole,  l = 0.08000000, k = -922.01826102, n = nsext, method = 4;

s3   : sextupole, l = 0.080000, k = 0.000000, n = 1, method=meth;
s4   : sextupole, l = 0.080000, k = 0.000000, n = 1, method=meth;

mbac : marker;
s1c  : marker;

ps_rot: map;

{----- table of segments ----------------------------------------------------}

cell_hc : mbac, b1c, l1, s2, l2, b2, l3, s1, s1c;
cell_u  : inv(cell_hc), cell_hc;
cell_he : s1c, s1, l3, b2, l2, s2, l1, b1e;
cell_m  : l4, s3, l5, q1, l6, q2, l7, s4, l8, q3, l9;
match   : cell_he, cell_m;
line    : inv(match), 4*cell_u, match;
achr    : line;

ring: 1*achr, ps_rot, cav;

cell: ring, symmetry=1;

end;

