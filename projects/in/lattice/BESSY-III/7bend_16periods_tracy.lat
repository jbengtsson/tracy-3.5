{z:\git\tracy-3.5\projects\in\lattice\bessy-iii\7bend_16periods.opa}

{opa to tracy-2 export}

define lattice;
energy = 2.500000;
dp = 1.0d-10;  codeps = 1.0d-6;  dk = 1.0d-6;
meth   = 4; nbend = 10; nquad = 10;

{----- variables ----------------------------------------------------}

orbitdpp  = 0;
b0a       = 2.0*1.0;
b1a       = -0.165*1.0;
mb0a      = 2.075*1.0;
mb1a      = -0.0*1.0;

{----- table of elements ----------------------------------------------------}

c0 = 2.99792458e8; gamma = 3.5e9/c0; Brho = 1e9*Energy/c0;

h_rf = 535; C = 20*16.0600000;

cav: Cavity, L = 0.0, Frequency = c0/C*h_rf, Voltage = 1.5e6, harnum = h_rf,
     phi = 0.0;

l0   : drift, l = 0.100000;
l1   : drift, l = 0.100000;
l2   : drift, l = 0.100000;
l3   : drift, l = 0.100000;
ml0  : drift, l = 0.100000;
ml1  : drift, l = 0.100000;
ml2  : drift, l = 0.100000;
ml3  : drift, l = 0.100000;
ul0  : drift, l = 0.100000;
ul1  : drift, l = 0.100000;
ul2  : drift, l = 0.100000;
ul3  : drift, l = 0.100000;
ul4  : drift, l = 2.500000;

q0   : quadrupole, l = 0.090000, k = -11.195751, n=nquad, method=meth;
q0a  : quadrupole, l = 0.090000, k = -11.188811, n=nquad, method=meth;
q1   : quadrupole, l = 0.140000, k = 11.167885, n=nquad, method=meth;
q1a  : quadrupole, l = 0.130000, k = 10.480515, n=nquad, method=meth;
mq1  : quadrupole, l = 0.130000, k = -11.123916, n=nquad, method=meth;
mq2  : quadrupole, l = 0.160000, k = 11.748542, n=nquad, method=meth;
uq1  : quadrupole, l = 0.090000, k = -9.793062, n=nquad, method=meth;
uq2  : quadrupole, l = 0.240000, k = 11.814885, n=nquad, method=meth;
uq3  : quadrupole, l = 0.100000, k = -10.046458, n=nquad, method=meth;

b0   : bending, l = 0.220000, t = b0a, k = 0.000000, t1 = 0.000000,
       t2 = b0a, n=nbend, method=meth;
i_b0   : bending, l = 0.220000, t = b0a, k = 0.000000, t1 = b0a,
       t2 = 0.000000, n=nbend, method=meth;
b1   : bending, l = 0.050000, t = b1a, k = 0.000000, t1 = b1a/2.0,
       t2 = b1a/2.0, n=nbend, method=meth;
b1a  : bending, l = 0.050000, t = b1a, k = 0.000000, t1 = b1a/2.0,
       t2 = b1a/2.0, n=nbend, method=meth;
mb0  : bending, l = 0.220000, t = mb0a, k = 0.000000, t1 = mb0a/2.0,
       t2 = mb0a/2.0, n=nbend, method=meth;
mb1  : bending, l = 0.000000, t = mb1a, k = 0.000000, t1 = mb1a/2.0,
       t2 = mb1a/2.0, n=nbend, method=meth;

sf0  : sextupole, l = 0.040000, k = 774.682337, n = 1, method=meth;
sf1  : sextupole, l = 0.040000, k = 1802.110300, n = 1, method=meth;
sf2  : sextupole, l = 0.040000, k = 667.060645, n = 1, method=meth;
sf3  : sextupole, l = 0.040000, k = 488.766869, n = 1, method=meth;
sd0  : sextupole, l = 0.080000, k = 63.145599, n = 1, method=meth;
sd1  : sextupole, l = 0.080000, k = -1345.621470, n = 1, method=meth;
sd2  : sextupole, l = 0.080000, k = -1117.362060, n = 1, method=meth;
sd3  : sextupole, l = 0.080000, k = -1067.142580, n = 1, method=meth;
sd4  : sextupole, l = 0.080000, k = -488.929576, n = 1, method=meth;
sd5  : sextupole, l = 0.080000, k = -108.533722, n = 1, method=meth;
sh1  : sextupole, l = 0.080000, k = -305.670767, n = 1, method=meth;
sh2  : sextupole, l = 0.080000, k = 28.346071, n = 1, method=meth;

mbac : marker;


{----- table of segments ----------------------------------------------------}

cella   : mbac, b0, l0, q0, l1, sd0, l1, q1, l2, b1, l3, sf0;
i_cella : sf0, l3, b1, l2, q1, l1, sd0, l1, q0, l0, i_b0, mbac;
cellb1  : mbac, b0, l0, q0, l1, sd1, l1, q1, l2, b1, l3, sf0;
i_cellb1: sf0, l3, b1, l2, q1, l1, sd1, l1, q0, l0, i_b0, mbac;
cellb2  : mbac, b0, l0, q0, l1, sd2, l1, q1, l2, b1, l3, sf1;
i_cellb2: sf1, l3, b1, l2, q1, l1, sd2, l1, q0, l0, i_b0, mbac;
cellc   : mbac, b0, l0, q0, l1, sd3, l1, q1, l2, b1, l3, sf1;
i_cellc : sf1, l3, b1, l2, q1, l1, sd3, l1, q0, l0, i_b0, mbac;
cell1   : mbac, b0, l0, q0a, l1, sd4, l1, q1a, l2, b1a, l3, sf2;
i_cell1 : sf2, l3, b1a, l2, q1a, l1, sd4, l1, q0a, l0, i_b0, mbac;
mbacell : i_cellb2, cellb1, i_cella, cella, i_cellb1, cellb2;
i_mbacell: i_cellb2, cellb1, i_cella, cella, i_cellb1, cellb2;
mcell   : mb0, ml3, mq1, ml2, sd5, ml2, mq2, ml1, sf2;
mund    : ul0, sh1, ul0, uq1, ul1, uq2, ul2, sh2, ul3, uq3, ul4;
match   : cell1, inv(mcell), mund;
i_match : inv(mund), mcell, i_cell1;
arc     : i_match, cellc, mbacell, i_cellc, match;
i_arc   : i_match, cellc, i_mbacell, i_cellc, match;

line: cella, i_cella;
{line: arc, cav;}

cell: line, symmetry=1;

end;

