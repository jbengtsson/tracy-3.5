            Q5N, dms_20, bpm, dms_19, S5X, dms_18, DL3, dms_17, Q4N, dms_16, & 
            S4A, dms_15, bpm, dms_14, O1X, dms_13, A2N, dms_12, S3A, dms_11, dms_10, &
