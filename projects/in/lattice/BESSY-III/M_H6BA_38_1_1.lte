!bpm_10     : moni, group="girder"
!bpm_11     : moni, group="girder"
bpm     : moni, group="girder"

COR_11    : KICKER, l=0.08

GS       : mark,group="girder"
GE       : mark,group="girder"
GM       : mark,group="girderChange"

LS:mark
SS:mark
MS:mark
SE:mark

CAV: RFCA,L=0.0,VOLT=1420000,PHASE=149.3705824908528,FREQ=499510634.4542388,CHANGE_T=0

MAL : MALIGN,ON_PASS=0
W1  : WATCH,FILENAME="%s.w1",MODE="centroid"
W2  : WATCH,FILENAME="%s.w2",MODE="parameter"
W3  : WATCH,FILENAME="%s.w3",MODE="coordinate"

!----- For collective effects simulation -------

d0: drift,l=0
gb: line=(d0)

wp: mark
impedance: mark
Q: charge,total=0,allow_total_change=1

!----- table of segments ----------------------------------------------------

DL1     : line=(DL1_5, DL1_4, DL1_3, DL1_2, DL1_1)
