{opa to tracy-2 export}

define lattice;
energy = 2.500000;
dp = 1.0d-10;  codeps = 1.0d-6;  dk = 1.0d-6;
meth = 4; nbend = 10; nquad = 10; nsext = 10;

{----- variables ----------------------------------------------------}


{----- table of elements ----------------------------------------------------}

c0 = 2.99792458e8; gamma = 3.5e9/c0; Brho = 1e9*Energy/c0;

h_rf = 535; C = 20*16.0600000;

cav: Cavity, L = 0.0, Frequency = c0/C*h_rf, Voltage = 1.5e6, harnum = h_rf,
     phi = 180.0;

l1   : drift, l = 0.100000;
l2   : drift, l = 0.100000;
l3   : drift, l = 0.28;
{l4   : drift, l = 0.100000;
l5   : drift, l = 0.100000;
l6   : drift, l = 0.28;
l7   : drift, l = 2.500000;}
l4   : drift, l = 0.66178;
l5   : drift, l = 0.10568;
l6   : drift, l = 0.11254;
l7   : drift, l = 2.10000;


b1e1:     bending, l =  0.08000000,
    t =  1.19398190, t1 =  0.59699095, t2 =  0.59699095, k = -0.06785423,
    n = nbend, method = 4;
b1e2:     bending, l =  0.08000000,
    t =  0.56370036, t1 =  0.28185018, t2 =  0.28185018, k = -2.84638586,
    n = nbend, method = 4;
