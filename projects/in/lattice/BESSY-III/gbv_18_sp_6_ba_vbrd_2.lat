    t =  0.37636844, t1 =  0.18818422, t2 =  0.18818422, k = -2.27214416,
    n = nbend, method = 4;
b1e4:     bending, l =  0.08000000,
    t =  0.29853382, t1 =  0.14926691, t2 =  0.14926691, k = -2.38864336,
    n = nbend, method = 4;
b1e5:     bending, l =  0.08000000,
    t =  0.16849437, t1 =  0.08424719, t2 =  0.08424719, k = -3.86370146,
    n = nbend, method = 4;

b1c1:     bending, l =  0.08000000,
    t =  1.19398190, t1 =  0.59699095, t2 =  0.59699095, k = -0.06785423,
    n = nbend, method = 4;
b1c2:     bending, l =  0.08000000,
    t =  0.56370036, t1 =  0.28185018, t2 =  0.28185018, k = -2.84638586,
    n = nbend, method = 4;
b1c3:     bending, l =  0.08000000,
    t =  0.37636844, t1 =  0.18818422, t2 =  0.18818422, k = -2.27214416,
    n = nbend, method = 4;
b1c4:     bending, l =  0.08000000,
    t =  0.29853382, t1 =  0.14926691, t2 =  0.14926691, k = -2.38864336,
    n = nbend, method = 4;
b1c5:     bending, l =  0.08000000,
    t =  0.16849437, t1 =  0.08424719, t2 =  0.08424719, k = -3.86370146,
    n = nbend, method = 4;

b2:       bending, l =  0.13000000,
    t = -0.60107889, t1 = -0.30053944, t2 = -0.30053944, k = 10.65460964,
    n = nbend, method = 4;

q1:       quadrupole, l = 0.16000000, k =   -8.00762077, n = nquad, method = 4;
q2:       quadrupole, l = 0.26000000, k =    9.34899346, n = nquad, method = 4;
q3:       quadrupole, l = 0.10000000, k =   -8.23837768, n = nquad, method = 4;

s1:       sextupole,  l = 0.06000000, k =  600.07245585, n = nsext, method = 4;
s2:       sextupole,  l = 0.08000000, k = -592.90213721, n = nsext, method = 4;

b1e: b1e1, b1e2, b1e3, b1e4, b1e5;
b1c: b1c1, b1c2, b1c3, b1c4, b1c5;

mbac : marker;
s1c  : marker;

ps_rot: map;

{----- table of segments ----------------------------------------------------}

cell_hc: mbac, b1c, l1, s2, l2, b2, l3, s1, s1c;
cell_u:  inv(cell_hc), cell_hc;
cell_he: s1c, s1, l3, b2, l2, s2, l1, inv(b1e);
cell_m:  l4, q1, l5, q2, l6, q3, l7;
match:   cell_he, cell_m;

{line: cell_hc, inv(cell_hc);}
{line: inv(cell_hc), cell_hc;}
{line: cell_u, match;}
line: inv(match), 4*cell_u, match;

ring: 1*line, ps_rot, cav;

cell: ring, symmetry=1;

end;

