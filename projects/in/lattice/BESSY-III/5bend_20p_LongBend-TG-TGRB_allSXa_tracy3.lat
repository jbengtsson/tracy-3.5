{..examples\example-cells\20periods\5bend_20p_longbend-tg-tgrb_allsxa.opa}

{opa to tracy-3 export}

define lattice;
energy = 2.500000;
dp = 1.0d-10;  codeps = 1.0d-6;  dk = 1.0d-6;
meth = 4; nbend = 10; nquad = 10;

{----- variables ---------------------------------------------------}

orbitdpp  = 0;
b0a       = 2.3*1.0;
b1a       = -0.205*1.0;
mb1a      = -0.0*1.0;
mb0a      = 2.715-mb1a;

{----- table of elements ---------------------------------------------}

l0   : drift, l = 0.100000;
l1   : drift, l = 0.100000;
l2   : drift, l = 0.100000;
l3   : drift, l = 0.100000;
ml0  : drift, l = 0.050000;
ml1  : drift, l = 0.050000;
ml2  : drift, l = 0.100000;
ml3  : drift, l = 0.100000;
ul0  : drift, l = 0.100000;
ul1  : drift, l = 0.100000;
ul2  : drift, l = 0.100000;
ul3  : drift, l = 0.100000;
ul4  : drift, l = 2.500000;
o1l  : drift, l = 0.040000;

q0   : quadrupole, l = 0.090000, k = -10.424964, n=nquad, method=meth;
q0a  : quadrupole, l = 0.090000, k = -11.000000, n=nquad, method=meth;
q1   : quadrupole, l = 0.130000, k = 11.138731, n=nquad, method=meth;
q1a  : quadrupole, l = 0.090000, k = 3.325848, n=nquad, method=meth;
mq0  : quadrupole, l = 0.100000, k = 0.000000, n=nquad, method=meth;
mq1  : quadrupole, l = 0.090000, k = -4.462128, n=nquad, method=meth;
mq2  : quadrupole, l = 0.090000, k = 11.655598, n=nquad, method=meth;
uq1  : quadrupole, l = 0.160000, k = -11.018415, n=nquad, method=meth;
uq2  : quadrupole, l = 0.260000, k = 11.456599, n=nquad, method=meth;
uq3  : quadrupole, l = 0.100000, k = -11.297369, n=nquad, method=meth;

b0   : bending, l = 0.400000, t = b0a, k = -2.247678, t1 = 0.000000, t2 = b0a,
       n=nbend, method=meth;
b1   : bending, l = 0.130000, t = b1a, k = 11.101269, t1 = b1a/2.0,
       t2 = b1a/2.0, n=nbend, method=meth;
mb0  : bending, l = 0.230000, t = mb0a, k = 0.000000, t1 = mb0a/2.0,
       t2 = mb0a/2.0, n=nbend, method=meth;
mb1  : bending, l = 0.050000, t = mb1a, k = 0.000000, t1 = mb1a/2.0,
       t2 = mb1a/2.0, n=nbend, method=meth;

sd1  : sextupole, l = 0.080000, k = -130.572481, n = 5, method=meth;
sd2  : sextupole, l = 0.080000, k = -1038.684735, n = 5, method=meth;
sd3  : sextupole, l = 0.080000, k = -584.857836, n = 5, method=meth;
sd4  : sextupole, l = 0.080000, k = -1954.730330, n = 5, method=meth;
sf1  : sextupole, l = 0.040000, k = 983.702028, n = 5, method=meth;
sf2  : sextupole, l = 0.040000, k = 1579.299800, n = 5, method=meth;
sh1  : sextupole, l = 0.080000, k = -1263.885509, n = 5, method=meth;
sh2  : sextupole, l = 0.080000, k = 424.115572, n = 5, method=meth;

mbac : marker;


{----- table of segments ---------------------------------------------}

cell0   : mbac, b0, l1, sd1, l1, b1, l3, sf1;
cell1   : mbac, b0, l1, sd2, l1, b1, l3, sf1;
cell2   : mbac, b0, l1, sd3, l1, q1a, l2, b1, l3, sf2;
mbacell0: inv(cell0), cell0;
mcell0  : mb0, ml3, mq1, ml2, sd4, ml2, mq2, ml1, ml0, sf2;
mund    : ul0, sh1, ul0, uq1, ul1, uq2, ul2, sh2, ul2, uq3, ul4;
match   : cell2, inv(mcell0), mund;
arc     : inv(match), cell1, mbacell0, inv(cell1), match;

cell: arc, symmetry=1;

end;

{..examples\example-cells\20periods\5bend_20p_longbend-tg-tgrb_allsxa.opa}
