!..design\lattices\bessy-iii\2022_11_pg\b3_sf_uc4375_dsc_sf_4372_1276.opa

!opa to elegant export

!----- table of elements ---------------------------------------------

BPM: monitor, L=0.000

SKY: marker
SKX: marker


! l1     : drift, l = 0.100000
l1h    : drift, l = "0.100000 2 /"
l1: line=(l1h, l1h)
l1BPM: line=(l1h, BPM, l1h)

ml1    : drift, l = 0.100000

!ml1a   : drift, l = 0.100000
ml1ah   : drift, l = "0.100000 2 /"
ml1a: line=(ml1ah, ml1ah)
ml1aBPM: line=(ml1ah, BPM, ml1ah)

ml1b   : drift, l = 0.100000
ml1c   : drift, l = 0.100000
ul1    : drift, l = 0.120000

ul2    : drift, l = 0.250000
ul2h   : drift, l = "0.25000 2 /"

ul2SK: line=(ul2h, SKY, SKX, ul2h)

ul3    : drift, l = 0.100000
!ul4d   : drift, l = 2.800000
ul4dr  : drift, l = 2.750000
ul4BPM    : Line=(l1h, BPM, ul4dr)
!ul4BPM    : Line=(l1h, BPM, SKY, SKX, ul4dr)

qd     : kquad, l = 0.125000, k1 = -9.573181
mqd    : kquad, l = 0.130000, k1 = -9.753806
uq1    : kquad, l = 0.150000, k1 = 9.025159
uq2    : kquad, l = 0.250000, k1 = -9.108800
uq3    : kquad, l = 0.180000, k1 = 9.434980

bb0     : csbend, l = 1.100000, angle = 0.088226, k1 = 0.000000, e1 = 0.044113,&
         e2 = 0.044113
bb: Line=(SKX, bb0)

br     : csbend, l = 0.170000, angle = -0.005934, k1 = 8.660561,&
         e1 = -0.002967, e2 = -0.002967
mbb    : csbend, l = 0.850000, angle = 0.045120, k1 = 0.000000, e1 = 0.022560,&
         e2 = 0.022560
mbr    : csbend, l = 0.180000, angle = -0.001487, k1 = 8.862581,&
         e1 = -0.000744, e2 = -0.000744

sd     : ksext, l = 0.110000, k2 = -465.507178
sf     : ksext, l = 0.050000, k2 = 480.518826
sd1     : ksext, l = 0.110000, k2 = -465.507178
sf1     : ksext, l = 0.050000, k2 = 480.518826
sd2     : ksext, l = 0.110000, k2 = -465.507178
sf2     : ksext, l = 0.050000, k2 = 480.518826
sd3     : ksext, l = 0.110000, k2 = -465.507178
sf3     : ksext, l = 0.050000, k2 = 480.518826

om_sf  : marker
om_mbb : marker
om_c   : marker
sec_start: marker
sec_end: marker

!tuneMeas: watch,filename="%s.TMFOM",mode="coordinates", interval=1
tuneMeas: watch,filename="%s.TMFOM",mode="centroid", interval=1


!----- table of segments ---------------------------------------------

!ucell : line=(om_sf, SKX, sf, l1, br, l1, qd, l1, sd, l1BPM, bb, l1BPM, SKY, sd, l1, qd, l1,&
!        br, l1, sf, om_sf)

uc1 : line=(om_sf, sf1, l1, br, l1, qd, l1, sd1, l1BPM, bb, l1BPM, SKY, sd1, l1, qd, l1,&
        br, l1, sf2, om_sf)
uc2 : line=(om_sf, SKX, sf2, l1, br, l1, qd, l1, sd2, l1BPM, bb, l1BPM, sd2, l1, qd, l1,&
        br, l1, sf3, om_sf)
dcell : line=(om_sf, SKX, sf3, ml1, mbr, ml1c, mqd, ml1b, sd3, ml1aBPM, mbb, om_mbb)

arc   : line=(-dcell, -uc2, -uc1, om_c, SKX, uc1, uc2, dcell)

mund  : line=(om_mbb, ul1, uq1, ul2SK, uq2, ul3, uq3, ul4BPM)
!sec   : line=(-mund, arc, mund, SKX)
!sec   : line=(-mund, arc, mund, BPM)
sec   : line=(-mund, arc, mund)
sech  : line=(om_c, uc1, uc2, dcell, mund)
sec16 : line=(-mund, arc, mund)

MAL: MALIGN, ON_PASS=1

RING  : line=(sec_start, MAL, sec, sec_end, 15*sec, tuneMeas)

!..design\lattices\bessy-iii\2022_11_pg\b3_sf_uc4375_dsc_sf_4372_1276.opa
