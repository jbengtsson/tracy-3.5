!&alter_elements name="*", type="KSEXT",item=K2, value=0.0, multiplicative=1 &end

&run_control
        n_steps = 1,
	n_passes = 1024,
&end

!&bunched_beam  n_particles_per_bunch=1   &end

&find_aperture
        output = "nLines_dpp=0.aper"
        mode = "n-lines",
        xmax = 0.01
	xmin = -0.01
        ymax = 0.01
	ymin = 0.00
        nx = 10,
	ny = 10,
        n_splits = 1,
        split_fraction = 0.1
        n_lines = 36,
	offset_by_orbit = 1
	verbosity = 10,
&end

!&track &end



