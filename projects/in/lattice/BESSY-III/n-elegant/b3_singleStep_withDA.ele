
&rpn_expression
   expression = "
   	      2500 0.511 / sto RGAMMA,
	      1.0 sto allSwitch,
"
&end

&run_setup
!    lattice = "testlat.lte",
!    lattice = "latticeCopy.lte",
    lattice = "lattice.lte",
    p_central = "(RGAMMA)",
    use_beamline="RING",
    default_order = 2,
    magnets = "%s.mag",
    parameters = b3_uncorr.para,
!    sigma = %s.sig,
!    centroid = %s.cen,
!    output = %s.out,
!    final = %s.fin,
!    element_divisions = 1, 
    random_number_seed = 0,
&end

&alter_elements name="*", type="CSBEND",item=N_KICKS, value=16&end
&alter_elements name="*", type="KQUAD",item=N_KICKS, value=16&end
&alter_elements name="*", type="KSEXT",item=N_KICKS, value=16&end
!&alter_elements name="*", type="KSEXT",item=K2, value=0.0, multiplicative=1 &end


&twiss_output
	filename = "b3_uncorr.twi",
	radiation_integrals=1
!	output_at_each_step=1
&end

&run_control
        n_steps = 1,
	n_passes = 10,
&end

&error_control
	clear_error_settings = 0
	error_log = "latest.erl"
!	summarize_error_settings = 1
&end


! Quad Errors
&error_element
        name="*", element_type=KQUAD, item=DX, amplitude="(25.0e-6 allSwitch *)", type="gaussian", cutoff=2.0, bind=0, fractional=0
&end
&error_element
        name="*", element_type=KQUAD, item=DY, amplitude="(25.0e-6 allSwitch *)", type="gaussian", cutoff=2.0, bind=0, fractional=0
&end

! Bend Errors
&error_element
        name="*", element_type=CSBEND, item=DX, amplitude="(25.0e-6 allSwitch *)", type="gaussian", cutoff=2.0, bind=0, fractional=0
&end
&error_element
        name="*", element_type=CSBEND, item=DY, amplitude="(25.0e-6 allSwitch *)", type="gaussian", cutoff=2.0, bind=0, fractional=0
&end

! Sext Errors
&error_element
        name="*", element_type=KSEXT, item=DX, amplitude="(25.0e-6 allSwitch *)", type="gaussian", cutoff=2.0, bind=0, fractional=0
&end
&error_element
        name="*", element_type=KSEXT, item=DY, amplitude="(25.0e-6 allSwitch *)", type="gaussian", cutoff=2.0, bind=0, fractional=0
&end


&bunched_beam  n_particles_per_bunch=1   &end

&closed_orbit
    output= b3_unCorr.clo,
    verbosity = 10,
    closed_orbit_iterations = 2000,
    iteration_fraction = 0.1,
&end


&track &end



! *******************************************************************************************************
!
!     next step ... 
!
! *******************************************************************************************************

&rpn_expression
   expression = "2500 0.511 / sto RGAMMA"
&end

&run_setup
    lattice = "lattice.lte",
    p_central = "(RGAMMA)",
    use_beamline="RING",
    default_order = 2,
!    magnets = "%s.mag",
    parameters = b3.para,
!    sigma = %s.sig,
!    centroid = %s.cen,
!    output = %s.out,
!    final = %s.fin,
!    element_divisions = 1, 
!    random_number_seed = 10,
&end

&twiss_output
	filename = "b3_corr.twi",
	radiation_integrals=1
	output_at_each_step=1
&end


&load_parameters
	filename=b3_uncorr.para
&end

&alter_elements name="*", type="CSBEND",item=N_KICKS, value=16&end
&alter_elements name="*", type="KQUAD",item=N_KICKS, value=16&end
&alter_elements name="*", type="KSEXT",item=N_KICKS, value=16&end
!&alter_elements name="*", type="KSEXT",item=K2, value=0.0, multiplicative=1 &end

&run_control
        n_steps = 1,
	n_passes = 10,
&end

&correct
	disable = 0
        mode = "orbit", method = "global"
        n_iterations = 10
	verbose = 10
        trajectory_output = b3.traj  
        corrector_output  = b3.cor  
        statistics        = b3.scor
!        corrector_tweek[0] = 10e-6, 10e-6
   	corrector_limit[0] = 0.002, 0.002
     	correction_fraction[0] = 0.25, 0.75  
!     	correction_accuracy[0] = 1e-6, 1e-6
	auto_limit_SVs[0] = 1, 1  
	remove_smallest_SVs[0] = 32, 0 
!        keep_largest_SVs[0] = 160, 0
	closed_orbit_accuracy = 1e-6  
        closed_orbit_iterations = 1024
       	closed_orbit_iteration_fraction = 0.25
	closed_orbit_tracking_turns=1024
	prezero_correctors=0
!	use_perturbed_matrix=1
!        use_response_from_computed_orbits=1
!	closed_orbit_accuracy=1e-9
	start_from_centroid=1
	n_xy_cycles=10
	force_alternation=1
&end

&bunched_beam  n_particles_per_bunch=1   &end

&track &end


! *******************************************************************************************************
!
!     next step ... 
!
! *******************************************************************************************************

