{..iii\b3_sf_40grad_doneqx44qy13_name_4372_1276_ssho_bestxxx_hardware.opa}

{opa to tracy-2 export}

define lattice;
energy = 2.500000;
dp = 1.0d-10; codeps = 1.0d-15; dk = 1.0d-6;
meth = 4; nbend = 10; nquad = 10;

{----- variables ----------------------------------------------------}

brv   = -0.23;
bbv   = (4.0-2.0*brv)/2.0;
mbrv  = -0.213291318808772;
mbbv  = 3.25-mbrv;

{----- table of elements ----------------------------------------------------}

c0 = 2.99792458e8; gamma = 3.5e9/c0; Brho = 1e9*Energy/c0;

h_rf = 538; C = 16*20.2;

cav: Cavity, L = 0.0, Frequency = c0/C*h_rf, Voltage = 1.5e6, harnum = h_rf,
     phi = 0.0;

bpm: beam position monitor;
chv: multipole, l = 0.0, N = 1, method=meth;

l1     : drift, l = 0.100000;
ml1    : drift, l = 0.100000+0.08;
ml1a   : drift, l = 0.100000+0.08;
ml1b   : drift, l = 0.100000;
ul1    : drift, l = 0.200000;
ul2    : drift, l = 0.282003;
ul3    : drift, l = 0.200000;
ul4    : drift, l = 2.800000;

qd     : quadrupole, l = 0.130000, k = -9.376548, n=nquad, method=meth;
mqd    : quadrupole, l = 0.130000, k = -5.000000, n=nquad, method=meth;
uq1    : quadrupole, l = 0.175000, k = -2.557067, n=nquad, method=meth;
uq2    : quadrupole, l = 0.240000, k =  7.899384, n=nquad, method=meth;
uq3    : quadrupole, l = 0.120000, k = -6.751186, n=nquad, method=meth;

bb_h   : bending, l = 1.000000/2.0, t = bbv, k = 0.000000, t1 = bbv/2.0,
         t2 = bbv/2.0, n=nbend, method=meth;
br     : bending, l = 0.160000, t = brv, k = 9.395465, t1 = brv/2.0,
         t2 = brv/2.0, n=nbend, method=meth;
mbb    : bending, l = 0.650000, t = mbbv, k = -1.600000, t1 = mbbv/2.0,
         t2 = mbbv/2.0, n=nbend, method=meth;
mbr    : bending, l = 0.160000, t = mbrv, k = 7.752612, t1 = mbrv/2.0,
         t2 = mbrv/2.0, n=nbend, method=meth;

sf_h:  sextupole, l = 0.060000, k =  2.853e+02, n = 1, method=meth;
sd_h:  sextupole, l = 0.060000, k = -2.341e+02, n = 1, method=meth;

{sf_h    : multipole, l = 0.06000,
          hom = (3,  2.02565e+02, 0e0, 4, -1.05415e+03, 0e0),
          n = 1, Method = Meth;
sd_h    : multipole, l = 0.06000,
          hom = (3, -2.35298e+02, 0e0, 4,  6.47725e+02, 0e0),
          n = 1, Method = Meth;
sf2_h   : multipole, l = 0.14000,
          hom = (3,  1.78062e+02, 0e0),
          n = 1, Method = Meth;}

{sd2_h: sextupole, l = 0.06,     k = 0.0, n = 1, method=meth;}

sf_m:  marker;
sd_m:  marker;

ps_rot: map;


{----- table of segments ----------------------------------------------------}

u_hcell: bb_h, l1, sd_h, sd_m, sd_h, l1, qd, l1, br, l1;
u_cell:  u_hcell, sf_h, sf_m, sf_h, inv(u_hcell);

m_cell: sf_h, ml1, mbr, ml1b, sd_h, sd_m, sd_h, ml1a, mbb, ul1, uq1, ul2,
	uq2, ul3, uq3, ul4;

s_per:  inv(m_cell), inv(u_hcell, sf_h, sf_m), 3*u_cell, u_hcell, sf_h,
	sf_m, m_cell;

{ring:   u_cell, cav;}
ring:   1*(s_per, ps_rot), cav;

cell: ring, symmetry=1;

end;
