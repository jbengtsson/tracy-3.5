{..cy-3.5\projects\in\lattice\bessy-iii\b3_sf_40grad_doneqx44qy13_top.opa}

{opa to tracy-2 export}

define lattice;
energy = 2.500000;
dp = 1.0d-10; codeps = 1.0d-6;  dk = 1.0d-6;
meth = 4; nbend = 10; nquad = 10;

{----- variables ----------------------------------------------------}

b2a   = -0.23;
b1a   =  4.0-2.0*b2a;
mb2a  = -0.244832764868045;
mb1a  =  3.25-mb2a;

{----- table of elements ----------------------------------------------------}

c0 = 2.99792458e8; gamma = 3.5e9/c0; Brho = 1e9*Energy/c0;

h_rf = 538; C = 16*20.2;

cav: Cavity, L = 0.0, Frequency = c0/C*h_rf, Voltage = 1.5e6, harnum = h_rf,
     phi = 0.0;

bpm: beam position monitor;
chv: multipole, l = 0.0, N = 1, method=meth;

l1     : drift, l = 0.100000;
ml1    : drift, l = 0.100000;
ml1a   : drift, l = 0.140000;
ml1b   : drift, l = 0.100000;
ul1    : drift, l = 0.280000;
ul2    : drift, l = 0.253150;
ul3    : drift, l = 0.100000;
ul4    : drift, l = 2.800000;

b1     : bending, l = 0.500000, t = b1a/2, k = 0.000000, t1 = 0,
         t2 = b1a/2.0, n=nbend, method=meth;
b2     : bending, l = 0.160000, t = b2a, k = 9.389515, t1 = b2a/2.0,
         t2 = b2a/2.0, n=nbend, method=meth;
mb1    : bending, l = 0.700000, t = mb1a, k = -1.600000, t1 = mb1a/2.0,
         t2 = mb1a/2.0, n=nbend, method=meth;
mb2    : bending, l = 0.160000, t = mb2a, k = 7.896711, t1 = mb2a/2.0,
         t2 = mb2a/2.0, n=nbend, method=meth;

q1     : quadrupole, l = 0.130000, k = -9.366917, n=nquad, method=meth;
mq1    : quadrupole, l = 0.130000, k = -5.000000, n=nquad, method=meth;
uq1    : quadrupole, l = 0.100000, k = -4.009569, n=nquad, method=meth;
uq2    : quadrupole, l = 0.240000, k =  9.290481, n=nquad, method=meth;
uq3    : quadrupole, l = 0.120000, k = -9.513104, n=nquad, method=meth;

{ Original.}
{s1a_h  : sextupole, l = 0.060000, k = -233.935253, n = 1, method=meth;
s1b_h  : sextupole, l = 0.060000, k = -233.935253, n = 1, method=meth;
s2a_h  : sextupole, l = 0.070000, k =  246.209678, n = 1, method=meth;
s2b_h  : sextupole, l = 0.070000, k =  246.209678, n = 1, method=meth;}

{ Bettina. }
s1a_h  : sextupole, l = 0.060000, k = -225.912620, n = 1, method=meth;
s1b_h  : sextupole, l = 0.060000, k = -269.761161, n = 1, method=meth;
s2a_h  : sextupole, l = 0.070000, k =  185.778422, n = 1, method=meth;
s2b_h  : sextupole, l = 0.070000, k =  346.124878, n = 1, method=meth;

{s1a_h  : sextupole, l = 0.060000, k = -2.49915e+02, n = 1, method=meth;
s1b_h  : sextupole, l = 0.060000, k = -1.86127e+02, n = 1, method=meth;
s2a_h  : sextupole, l = 0.070000, k =  1.84666e+02, n = 1, method=meth;
s2b_h  : sextupole, l = 0.070000, k =  3.34509e+02, n = 1, method=meth;}

om_s1a: marker;
om_s1b: marker;
s1a: s1a_h, om_s1a, s1a_h;
s1b: s1b_h, om_s1b, s1b_h;

om_s2a : marker;
om_s2b : marker;
om_mb1 : marker;
om_b1  : marker;

b_t    : marker;

ps_rot: map;


{----- table of segments ----------------------------------------------------}

ucell   : s2a_h, l1, b2, l1, q1, l1, s1a, l1, inv(b1), om_b1, b1, l1, s1a,
	  l1, q1, l1, b2, l1, s2a_h;
ucellh  : om_b1, b1, l1, s1a, l1, q1, l1, b2, l1, s2a_h, om_s2a, bpm, chv;
ucellh1 : b1, l1, s1a, l1, q1, l1, b2, l1, s2b_h, bpm, chv, om_s2b;
dcell   : s2b_h, ml1, mb2, ml1b, s1b, ml1a, mb1, om_mb1;
arc     : inv(dcell), inv(ucellh1), ucellh, ucell, b_t, bpm, chv, om_s2a,
	  ucell, inv(ucellh), ucellh1, dcell;
mund    : ul1, uq1, ul2, bpm, chv, uq2, ul3, uq3, bpm, chv, ul4;
sec     : b_t, inv(mund), arc, mund;

{ring: ucell;}
{ring: inv(mund), inv(dcell), inv(ucellh1), ucellh1, dcell, mund;}
ring: 1*(sec, ps_rot), b_t, cav;

cell: ring, symmetry=1;

end;

{..cy-3.5\projects\in\lattice\bessy-iii\b3_sf_40grad_doneqx44qy13_top.opa}
