{..it\tracy-3.5\projects\in\lattice\bessy-iii\notg-tgrb-b60-6bend-6sx.opa}

{opa to tracy-2 export}

define lattice;
energy = 2.500000;
dp = 1.0d-10; codeps = 1.0d-6; dk = 1.0d-6;
meth = 4; nbend = 10; nquad = 10; nsext = 2;

{----- variables ----------------------------------------------------}


{----- table of elements ----------------------------------------------------}

c0 = 2.99792458e8; gamma = 3.5e9/c0; Brho = 1e9*Energy/c0;

h_rf = 538; C = 16*20.2;

cav: Cavity, L = 0.0, Frequency = c0/C*h_rf, Voltage = 1.5e6, harnum = h_rf,
     phi = 0.0;

bpm: beam position monitor;
chv: multipole, l = 0.0, N = 1, method=meth;

l0  : drift, l = 0.100000;
l1  : drift, l = 0.100000;
{l2  : drift, l = 0.100000;}
l3  : drift, l = 0.100000;
ul0 : drift, l = 0.100000;
ul1 : drift, l = 0.100000;
ul2 : drift, l = 0.100000;
ul3 : drift, l = 0.100000;
ul4 : drift, l = 2.800000;

b0:       bending, l =  0.60000000,
    t =  2.54365072, t1 =  1.27182536, t2 =  1.27182536, k =  0.00000000,
    n = nbend, method = 4;
b1:       bending, l =  0.14000000,
    t = -0.26526249, t1 = -0.13263124, t2 = -0.13263124, k =  8.15254164,
    n = nbend, method = 4;

b0_m:     bending, l =  0.60000000,
    t =  2.83069381, t1 =  1.41534691, t2 =  1.41534691, k =  0.00000000,
    n = nbend, method = 4;
b1_m:     bending, l =  0.14000000,
    t = -0.69424674, t1 = -0.34712337, t2 = -0.34712337, k =  5.03688652,
    n = nbend, method = 4;

q0:       quadrupole, l = 0.11000000, k =   -7.77704922, n = nquad, method = 4;
q0_m:     quadrupole, l = 0.11000000, k =   -0.82934172, n = nquad, method = 4;

uq1:      quadrupole, l = 0.10000000, k =    5.26665836, n = nquad, method = 4;
uq2:      quadrupole, l = 0.20000000, k =   -8.79966638, n = nquad, method = 4;
uq3:      quadrupole, l = 0.20000000, k =    7.58203383, n = nquad, method = 4;

d1:       drift, l =  0.29951485;

s0:       sextupole,  l = 0.04000000, k =  553.72726640, n = nsext, method = 4;
s1:       sextupole,  l = 0.08000000, k = -369.70237659, n = nsext, method = 4;

s3  : sextupole, l = 0.080000, k = 0.0, n = 1, method=meth;
s4  : sextupole, l = 0.080000, k = 0.0, n = 1, method=meth;

b_t  : marker;

ps_rot: map;

{----- table of segments ----------------------------------------------------}

h_cell:     b0,       l0, q0,   l1, s1, l1, b1,   l3, s0;
h_cell_m:   b0_m, d1, l0, q0_m, l1, s1, l1, b1_m, l3, s0;
match_cell: ul0, s3, ul0, uq1, ul1, uq2, bpm, chv, ul2, s4, ul3,
	    uq3, bpm, chv, ul4;
c_0:        inv(h_cell), h_cell, bpm, chv;
sp:         b_t, inv(match_cell), h_cell_m, bpm, chv, 2*c_0, b_t, 2*c_0,
	    inv(h_cell_m), match_cell;

{line: c_0, cav;}
{line: inv(h_cell), h_cell, inv(h_cell_m), match_cell;}
line: 1*(sp, ps_rot), b_t, cav;

cell: line, symmetry=1;

end;

{..it\tracy-3.5\projects\in\lattice\bessy-iii\notg-tgrb-b60-6bend-6sx.opa}
