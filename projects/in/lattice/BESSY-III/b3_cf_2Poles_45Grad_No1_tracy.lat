{..it\tracy-3.5\projects\in\lattice\bessy-iii\b3_cf_2poles_45grad_no1.opa}

{opa to tracy-2 export}

define lattice;
energy = 2.500000;
dp = 1.0d-10;  codeps = 1.0d-6;  dk = 1.0d-6;
meth   = 0; nbend = 1; nquad = 1;

{----- variables ----------------------------------------------------}

b2a   = -0.4;
b1a   = 4.5-2.0*b2a;
mb2a  = 0;
mb1a  = 2.25-mb2a;

{----- table of elements ----------------------------------------------------}

l1     : drift, l = 0.100000;
ml1    : drift, l = 0.100000;
ml1a   : drift, l = 0.226126;
ml1b   : drift, l = 0.568183;
ul1    : drift, l = 0.280150;
ul2    : drift, l = 0.186225;
ul3    : drift, l = 0.100000;
ul4    : drift, l = 2.800000;

uq1    : quadrupole, l = 0.150000, k = -7.785685, n=nquad, method=meth;
uq2    : quadrupole, l = 0.200000, k = 8.451754, n=nquad, method=meth;
uq3    : quadrupole, l = 0.100000, k = -5.985905, n=nquad, method=meth;

b1     : bending, l = 1.000000, t = b1a, k = -1.571294, t1 = b1a/2.0,
         t2 = b1a/2.0, n=nbend, method=meth;
b2     : bending, l = 0.140000, t = b2a, k = 8.479348, t1 = b2a/2.0,
         t2 = b2a/2.0, n=nbend, method=meth;
mb1    : bending, l = 0.280000, t = mb1a, k = 0.000000, t1 = mb1a/2.0,
         t2 = mb1a/2.0, n=nbend, method=meth;
mb2    : bending, l = 0.120000, t = mb2a, k = 7.755013, t1 = mb2a/2.0,
         t2 = mb2a/2.0, n=nbend, method=meth;

s1     : sextupole, l = 0.100000, k = -461.665510, n = 1, method=meth;
s2     : sextupole, l = 0.050000, k = 653.439253, n = 1, method=meth;
s3     : sextupole, l = 0.100000, k = 0.000000, n = 1, method=meth;
s4     : sextupole, l = 0.100000, k = 0.000000, n = 1, method=meth;

om_s2  : marker;
om_mb1 : marker;
om_c   : marker;


{----- table of segments ----------------------------------------------------}

ucell : om_s2, s2, l1, b2, l1, s1, l1, b1, l1, s1, l1, b2, l1, s2, om_s2;
dcell : om_s2, s2, ml1, mb2, ml1b, s1, ml1a, mb1, om_mb1;
arc   : inv(dcell), 2*ucell, om_c, 2*ucell, dcell;
mund  : ul1, uq1, ul2, s3, ul2, uq2, ul3, s4, ul3, uq3, ul4;
sec   : inv(mund), arc, mund;
secm  : dcell, mund;
sech  : om_c, 2*ucell, dcell, mund;
sec16 : inv(mund), arc, mund;
ring  : 16*sec;

cell: ring, symmetry=1;

end;

{..it\tracy-3.5\projects\in\lattice\bessy-iii\b3_cf_2poles_45grad_no1.opa}
