{..iii\b3_sf_40grad_doneqx44qy13_name_4372_1276_ssho_bestxxx_hardware.opa}

{opa to tracy-2 export}

define lattice;
energy = 2.500000;
dp = 1.0d-10; codeps = 1.0d-6; dk = 1.0d-6;
meth = 4; nbend = 10; nquad = 10;

{----- variables ----------------------------------------------------}

brv   = -0.23;
bbv   = 4.0-2.0*brv;
mbrv  = -0.213291318808772;
mbbv  = 3.25-mbrv;

{----- table of elements ----------------------------------------------------}

c0 = 2.99792458e8; gamma = 3.5e9/c0; Brho = 1e9*Energy/c0;

h_rf = 538; C = 16*20.2;

cav: Cavity, L = 0.0, Frequency = c0/C*h_rf, Voltage = 1.5e6, harnum = h_rf,
     phi = 0.0;

bpm: beam position monitor;
chv: multipole, l = 0.0, N = 1, method=meth;

l1     : drift, l = 0.100000;
ml1    : drift, l = 0.100000;
ml1a   : drift, l = 0.100000;
ml1b   : drift, l = 0.100000;
ul1    : drift, l = 0.200000;
ul2    : drift, l = 0.282003;
ul3    : drift, l = 0.200000;
ul4    : drift, l = 2.800000;

qd     : quadrupole, l = 0.130000, k = -9.376548, n=nquad, method=meth;
mqd    : quadrupole, l = 0.130000, k = -5.000000, n=nquad, method=meth;
uq1    : quadrupole, l = 0.175000, k = -2.557067, n=nquad, method=meth;
uq2    : quadrupole, l = 0.240000, k = 7.899384, n=nquad, method=meth;
uq3    : quadrupole, l = 0.120000, k = -6.751186, n=nquad, method=meth;

bb     : bending, l = 1.000000, t = bbv, k = 0.000000, t1 = bbv/2.0,
         t2 = bbv/2.0, n=nbend, method=meth;
br     : bending, l = 0.160000, t = brv, k = 9.395465, t1 = brv/2.0,
         t2 = brv/2.0, n=nbend, method=meth;
mbb    : bending, l = 0.650000, t = mbbv, k = -1.600000, t1 = mbbv/2.0,
         t2 = mbbv/2.0, n=nbend, method=meth;
mbr    : bending, l = 0.160000, t = mbrv, k = 7.752612, t1 = mbrv/2.0,
         t2 = mbrv/2.0, n=nbend, method=meth;

sd1    : sextupole, l = 0.120000, k = -181.732542, n = 1, method=meth;
sd2    : sextupole, l = 0.120000, k = -188.849591, n = 1, method=meth;
sd3a   : sextupole, l = 0.120000, k = -235.666667, n = 1, method=meth;
sd3b   : sextupole, l = 0.200000, k = -200.292457, n = 1, method=meth;
sf1    : sextupole, l = 0.060000, k = 181.732775, n = 1, method=meth;
sf2    : sextupole, l = 0.060000, k = 197.465396, n = 1, method=meth;
sf3    : sextupole, l = 0.060000, k = 253.333333, n = 1, method=meth;
sf3a   : sextupole, l = 0.140000, k = 254.843943, n = 1, method=meth;

om_sf  : marker;
om_mbb : marker;
om_c   : marker;

b_t    : marker;

oxx    : multipole, l = 0.0, hom = (4,0.0000,0), n = 1, method=meth;
oxy    : multipole, l = 0.0, hom = (4,0.0000,0), n = 1, method=meth;
oyy    : multipole, l = 0.0, hom = (4,0.0000,0), n = 1, method=meth;

ps_rot: map;


{----- table of segments ----------------------------------------------------}

ucs21 : om_sf, sf2, l1, br, l1, qd, l1, sd2, l1, bb, l1, sd1, l1, qd,
        l1, br, l1, sf1, om_sf;
ucs32 : om_sf, sf3, l1, br, l1, qd, l1, sd3a, l1, bb, l1, sd2, l1, qd,
        l1, br, l1, sf2, om_sf, bpm, chv;
dcell : bpm, chv, om_sf, sf3a, ml1, mbr, ml1b, sd3b, ml1a, mbb, oyy;
arc   : inv(dcell, om_mbb), ucs32, ucs21, b_t, bpm, chv, om_c,
        inv(ucs21), inv(ucs32), dcell, om_mbb;
mund  : om_mbb, ul1, uq1, ul2, bpm, chv, uq2, oxx, ul3, oxy, uq3, bpm, chv, ul4;
sec   : b_t, inv(mund), arc, mund;
ring  : 1*(sec, ps_rot), b_t, cav;

cell: ring, symmetry=1;

end;

{..iii\b3_sf_40grad_doneqx44qy13_name_4372_1276_ssho_bestxxx_hardware.opa}
