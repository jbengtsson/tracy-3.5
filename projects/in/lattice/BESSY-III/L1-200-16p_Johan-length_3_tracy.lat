{..\tracy-3.5\projects\in\lattice\bessy-iii\l1-200-16p_johan-length_3.opa}

{opa to tracy-2 export}

define lattice;
energy = 2.500000;
dp = 1.0d-10;  codeps = 1.0d-6;  dk = 1.0d-6;
meth = 4; nbend = 10; nquad = 10; nsext = 1;

{----- variables ----------------------------------------------------}

orbitdpp  = 0;
b0a       = 2.455*1.0;
b1a       = -0.205*1.0;
mb1a      = -0.165*1.0;
mb0a      = 2.415*1.0;

{----- table of elements ----------------------------------------------------}

c0 = 2.99792458e8; gamma = 3.5e9/c0; Brho = 1e9*Energy/c0;

h_rf = 538; C = 16*20.2;

cav: Cavity, L = 0.0, Frequency = c0/C*h_rf, Voltage = 1.5e6, harnum = h_rf,
     phi = 0.0;

bpm: beam position monitor;
chv: multipole, l = 0.0, N = 1, method=meth;

l01  : drift, l = 0.549613;
l02  : drift, l = 0.091515;
l11  : drift, l = 0.150000;
l12  : drift, l = 0.150000;
l2   : drift, l = 0.100000;
l3   : drift, l = 0.100000;
ml0  : drift, l = 0.440000;
ml1  : drift, l = 0.239961;
ml2  : drift, l = 0.100000;
ml3  : drift, l = 0.100000;
ul0  : drift, l = 0.100000;
ul1  : drift, l = 0.059837;
ul2  : drift, l = 0.100000;
ul3  : drift, l = 0.100000;
ul4  : drift, l = 2.800000;
o1l  : drift, l = 0.040000;

uq1  : quadrupole, l = 0.100000, k = -7.721786, n=nquad, method=meth;
uq2  : quadrupole, l = 0.120000, k = 7.647096, n=nquad, method=meth;
uq3  : quadrupole, l = 0.090000, k = -1.990310, n=nquad, method=meth;

b0   : bending, l = 0.450000, t = 2.384952, k = -1.604458, t1 = 1.192476,
       t2 = 1.192476, n=nbend, method=meth;
b1   : bending, l = 0.150000, t = -0.206882, k = 7.465899,
       t1 = -0.103441, t2 = -0.103441, n=nbend, method=meth;
mb0  : bending, l = 0.450000, t = 2.399116, k = 0.313578, t1 = 1.199558,
       t2 = 1.199558, n=nbend, method=meth;
mb1  : bending, l = 0.130000, t = 0.138602, k = 7.911741, t1 = 0.069301,
       t2 = 0.069301, n=nbend, method=meth;

s0:       sextupole,  l = 0.06000000, k =  519.64952003, n = nsext, method = 4;
s1:       sextupole,  l = 0.08000000, k = -537.40086220, n = nsext, method = 4;
s3   : sextupole, l = 0.080000, k = 0.000000, n = 5, method=meth;
s4   : sextupole, l = 0.080000, k = 0.000000, n = 5, method=meth;

mbac : marker;
sf   : marker;
b_t  : marker;

o1   : multipole, l = 0.0, hom = (1,0.0000,0), n = 1, method=meth;
o2   : multipole, l = 0.0, hom = (1,0.0000,0), n = 1, method=meth;
o3   : multipole, l = 0.0, hom = (1,0.0000,0), n = 1, method=meth;

ps_rot: map;

{----- table of segments ----------------------------------------------------}

cell0    : mbac, b0, l11, s1, l12, b1, l3, s0, sf, bpm, chv;
cell1    : mbac, mb0, ml0, s1, ml1, mb1, ml2, s0, sf;
mbacell  : inv(cell0), cell0;
mund     : ul1, uq1, o1, uq1, ul0, s3, ul0, uq2, bpm, chv, o2, uq2, ul2, s4,
           ul2, uq3, o3, uq3, bpm, chv, ul4;
straight : inv(mund);
match    : inv(cell1), mund;
arc      : b_t, inv(match), 2*mbacell, b_t, 2*mbacell, match;

line: 16*(arc, ps_rot), b_t, cav;

cell: line, symmetry=1;

end;

{..\tracy-3.5\projects\in\lattice\bessy-iii\l1-200-16p_johan-length_3.opa}
