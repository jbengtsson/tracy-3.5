{..ii\b3_cf_425grad_doneqx44qy13_name_4372_1276_ssho_bestxxx_hardware.opa}

{opa to tracy-2 export}

define lattice;
energy = 2.500000;
dp = 1.0d-10;  codeps = 1.0d-6;  dk = 1.0d-6;
meth = 4; nbend = 10; nquad = 10;

{----- variables ----------------------------------------------------}

brv   = -0.38;
bbv   = 4.25-2.0*brv;
mbrv  = -0.14750073106053;
mbbv  = 2.75-mbrv;

{----- table of elements ----------------------------------------------------}

c0 = 2.99792458e8; gamma = 3.5e9/c0; Brho = 1e9*Energy/c0;

h_rf = 538; C = 16*20.2;

cav: Cavity, L = 0.0, Frequency = c0/C*h_rf, Voltage = 1.5e6, harnum = h_rf,
     phi = 0.0;

bpm: beam position monitor;
chv: multipole, l = 0.0, N = 1, method=meth;

l1     : drift, l = 0.100000;
ml1    : drift, l = 0.100000;
ml1a   : drift, l = 0.260000;
ml1b   : drift, l = 0.100000;
ul1    : drift, l = 0.100000;
ul2    : drift, l = 0.253388;
ul3    : drift, l = 0.300000;
ul4    : drift, l = 2.800000;

uq1    : quadrupole, l = 0.165000, k = -9.421282, n=nquad, method=meth;
uq2    : quadrupole, l = 0.200000, k = 9.412986, n=nquad, method=meth;
uq3    : quadrupole, l = 0.100000, k = -2.712603, n=nquad, method=meth;

bb     : bending, l = 1.100000, t = bbv, k = -1.166115, t1 = bbv/2.0,
         t2 = bbv/2.0, n=nbend, method=meth;
br     : bending, l = 0.163000, t = brv, k = 6.045379, t1 = brv/2.0,
         t2 = brv/2.0, n=nbend, method=meth;
mbb    : bending, l = 0.600000, t = mbbv, k = 0.000000, t1 = mbbv/2.0,
         t2 = mbbv/2.0, n=nbend, method=meth;
mbr    : bending, l = 0.163000, t = mbrv, k = 6.364826, t1 = mbrv/2.0,
         t2 = mbrv/2.0, n=nbend, method=meth;

{sd1    : sextupole, l = 0.200000, k = -127.993839, n = 1, method=meth;
sd2    : sextupole, l = 0.200000, k = -170.681989, n = 1, method=meth;
sd3a   : sextupole, l = 0.200000, k = -223.410360, n = 1, method=meth;
sd3b   : sextupole, l = 0.200000, k = -251.149674, n = 1, method=meth;
sf1    : sextupole, l = 0.150000, k = 81.525438, n = 1, method=meth;
sf2    : sextupole, l = 0.150000, k = 165.275411, n = 1, method=meth;
sf3    : sextupole, l = 0.150000, k = 250.325061, n = 1, method=meth;}

{ Linear chromaticity zeroed. }
sd1    : sextupole, l = 0.200000, k = -130.71860, n = 1, method=meth;
sd2    : sextupole, l = 0.200000, k = -175.91137, n = 1, method=meth;
sd3a   : sextupole, l = 0.200000, k = -225.89470, n = 1, method=meth;
sd3b   : sextupole, l = 0.200000, k = -253.75852, n = 1, method=meth;
sf1    : sextupole, l = 0.150000, k =   83.42785, n = 1, method=meth;
sf2    : sextupole, l = 0.150000, k =  169.30213 , n = 1, method=meth;
sf3    : sextupole, l = 0.150000, k =  254.71165, n = 1, method=meth;

om_sf  : marker;
om_mbb : marker;
om_c   : marker;

b_t    : marker;

oxx    : multipole, l = 0.0, hom = (4,0.0000,0), n = 1, method=meth;
oxy    : multipole, l = 0.0, hom = (4,0.0000,0), n = 1, method=meth;
oyy    : multipole, l = 0.0, hom = (4,0.0000,0), n = 1, method=meth;

ps_rot: map;


{----- table of segments ----------------------------------------------------}

ucs21  : om_sf, sf2, l1, br, l1, sd2, l1, bb, l1, sd1, l1, br, l1, sf1,
         om_sf;
ucs32  : om_sf, sf3, l1, br, l1, sd3a, l1, bb, l1, sd2, l1, br, l1,
         sf2, om_sf;
dcell  : om_sf, sf3, ml1, mbr, ml1b, sd3b, ml1a, mbb, om_mbb;
arc    : inv(dcell), bpm, chv, ucs32, bpm, chv, ucs21, b_t, om_c, bpm, chv,
         inv(ucs21), bpm, chv, inv(ucs32), bpm, chv, dcell;
mund   : om_mbb, oyy, ul1, uq1, ul2, bpm, chv, uq2, oxx, ul3, oxy, uq3, bpm,
         chv, ul4;
sec    : b_t, inv(mund), arc, mund;
ring   : 1*(sec, ps_rot), b_t, cav;

cell: ring, symmetry=1;

end;

{..ii\b3_cf_425grad_doneqx44qy13_name_4372_1276_ssho_bestxxx_hardware.opa}
