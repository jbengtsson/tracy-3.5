{..opa\examples\example-cells\lattices talk 3\5bend-16p-cell-best-7sx.opa}

{opa to tracy-3 export}

define lattice;
energy = 2.500000;
dp = 1.0d-10;  codeps = 1.0d-6;  dk = 1.0d-6;
meth = 4; nbend = 10; nquad = 10;

{----- variables ---------------------------------------------------}

orbitdpp  = 0;
b0a       = 2.92*1.0;
b1a       = -0.4*1.0;
mb1a      = -0.0*1.0;
mb0a      = 3.69-mb1a;

{----- table of elements ---------------------------------------------}

c0 = 2.99792458e8; gamma = 3.5e9/c0; Brho = 1e9*Energy/c0;

h_rf = 538; C = 16*20.2;

cav: Cavity, L = 0.0, Frequency = c0/C*h_rf, Voltage = 1.5e6, harnum = h_rf,
     phi = 0.0;

bpm: beam position monitor;
chv: multipole, l = 0.0, N = 1, method=meth;

l0   : drift, l = 0.100000;
l1   : drift, l = 0.130000;
l1a  : drift, l = 0.170000;
l2   : drift, l = 0.100000;
l3   : drift, l = 0.100000;
ml1  : drift, l = 0.100000;
ml2  : drift, l = 0.116057;
ml3  : drift, l = 0.100000;
ul0  : drift, l = 0.100000;
ul1  : drift, l = 0.120000;
ul2  : drift, l = 0.122502;
ul3  : drift, l = 0.100000;
ul4  : drift, l = 2.800000;

q0   : quadrupole, l = 0.090000, k = -10.424964, n=nquad, method=meth;
q0a  : quadrupole, l = 0.090000, k = -11.000000, n=nquad, method=meth;
q1   : quadrupole, l = 0.130000, k = 11.138731, n=nquad, method=meth;
q1a  : quadrupole, l = 0.090000, k = 4.351168, n=nquad, method=meth;
mq0  : quadrupole, l = 0.100000, k = 0.000000, n=nquad, method=meth;
mq1  : quadrupole, l = 0.080000, k = -3.235232, n=nquad, method=meth;
mq2  : quadrupole, l = 0.200000, k = 6.475190, n=nquad, method=meth;
uq1  : quadrupole, l = 0.110000, k = -7.420266, n=nquad, method=meth;
uq2  : quadrupole, l = 0.160000, k = 7.632516, n=nquad, method=meth;
uq3  : quadrupole, l = 0.055000, k = -7.592571, n=nquad, method=meth;

b0   : bending, l = 0.540000, t = b0a, k = -1.319928, t1 = 0.000000, t2 = b0a,
       n=nbend, method=meth;
b1   : bending, l = 0.150000, t = b1a, k = 7.335241, t1 = b1a/2.0, t2 = b1a/2.0,
       n=nbend, method=meth;
b1a  : bending, l = 0.140000, t = b1a, k = 7.575988, t1 = b1a/2.0, t2 = b1a/2.0,
       n=nbend, method=meth;
mb0  : bending, l = 0.420000, t = mb0a, k = 0.000000, t1 = mb0a/2.0,
       t2 = mb0a/2.0, n=nbend, method=meth;
mb1  : bending, l = 0.050000, t = mb1a, k = 0.000000, t1 = mb1a/2.0,
       t2 = mb1a/2.0, n=nbend, method=meth;

s0   : sextupole, l = 0.060000, k = 301.273113, n = 5, method=meth;
s0a  : sextupole, l = 0.060000, k = 727.016448, n = 5, method=meth;
s1   : sextupole, l = 0.080000, k = -327.454311, n = 5, method=meth;
s1a  : sextupole, l = 0.080000, k = -320.994749, n = 5, method=meth;
s1b  : sextupole, l = 0.080000, k = -320.956120, n = 5, method=meth;
s1c  : sextupole, l = 0.080000, k = -1176.000000, n = 5, method=meth;
s3   : sextupole, l = 0.080000, k = -606.460175, n = 5, method=meth;
s4   : sextupole, l = 0.080000, k = 212.480750, n = 5, method=meth;

mbac : marker;
b_t  : marker;

o1   : multipole, l = 0.0, hom = (4,126.4220,0), n = 1, method=meth;
o2   : multipole, l = 0.0, hom = (4,80.5452,0), n = 1, method=meth;
o3   : multipole, l = 0.0, hom = (4,-351.9553,0), n = 1, method=meth;

ps_rot: map;

{----- table of segments ---------------------------------------------}

cell0   : mbac, b0, l1, s1, l1, b1, l3, s0, bpm, chv;
cells   : mbac, b0, l1, s1a, l1, b1, l3, s0, bpm, chv;
cell1   : mbac, b0, l1a, s1b, l1a, b1a, l3, s0a, bpm, chv;
mbacell : inv(cell0), b_t, cell0;
mcell   : mb0, ml3, mq1, ml2, s1c, ml2, mq2, ml1, s0a, bpm, chv;
mund    : ul0, s3, ul0, uq1, o1, uq1, ul1, uq2, o2, uq2, bpm, chv, ul2, s4,
          ul2, uq3, o3, uq3, bpm, chv, ul4;
match   : cell1, inv(mcell), mund;
arc     : b_t, inv(match), cells, mbacell, inv(cells), match;

line: 1*(arc, ps_rot), b_t, cav;

cell: line, symmetry=1;

end;

{..opa\examples\example-cells\lattices talk 3\5bend-16p-cell-best-7sx.opa}
