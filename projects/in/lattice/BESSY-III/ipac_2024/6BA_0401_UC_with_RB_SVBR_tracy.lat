{..0231124_4.5deg_allesaufnull\b3bd_sfsf4q_bb1bb2_vary_morealpha_top1.opa}

{opa to tracy-2 export}

define lattice;
energy = 2.500000;
dp = 1.0d-10;  codeps = 1.0d-6;  dk = 1.0d-6;
meth = 4; nbend = 10; nquad = 10;

{----- variables ---------------------------------------------------}

brb    = -0.15;
bb1b   = 0.16;
bb2b   = (4.5-2*bb1b)-2.0*brb;
mbrb   = -0.31015962150778;
mbb1b  = 0.45;
mbb2b  = 2.25-mbb1b-mbrb;

{----- table of elements ---------------------------------------------}

c0   = 2.99792458e8;
h_rf = 538;
C    = 16*20.2;

cav: Cavity, L = 0.0, Frequency = c0/C*h_rf, Voltage = 1.5e6, harnum = h_rf,
     phi = 0.0;

l1     : drift, l = 0.100000;
ml1    : drift, l = 0.100000;
ml1a   : drift, l = 0.100000;
ml1b   : drift, l = 0.100000;
ml1c   : drift, l = 0.100000;
ul1    : drift, l = 0.250000;
ul2    : drift, l = 0.250000;
ul3    : drift, l = 0.200000;
ul4    : drift, l = 0.100000;
ul5    : drift, l = 2.800000;

qd     : quadrupole, l = 0.125000, k = -9.361708, n=nquad, method=meth;
mqd    : quadrupole, l = 0.130000, k = -9.200906, n=nquad, method=meth;
uq1    : quadrupole, l = 0.100000, k = 6.792969, n=nquad, method=meth;
uq2    : quadrupole, l = 0.180000, k = -8.180370, n=nquad, method=meth;
uq3    : quadrupole, l = 0.240000, k = 8.732444, n=nquad, method=meth;
uq4    : quadrupole, l = 0.100000, k = -9.282014, n=nquad, method=meth;

bb2    : bending, l = 0.800000, t = bb2b, k = 0.000000, t1 = bb2b/2.0,
         t2 = bb2b/2.0, n=nbend, method=meth;
mbb2   : bending, l = 1.000000, t = mbb2b, k = 0.000000, t1 = mbb2b/2.0,
         t2 = mbb2b/2.0, n=nbend, method=meth;

sd     : sextupole, l = 0.050000, k = -249.287977, n = 1, method=meth;
sf     : sextupole, l = 0.050000, k = 265.950890, n = 1, method=meth;

om_sd  : marker;
om_sf  : marker;
om_mbb : marker;
om_c   : marker;

bb1    : bending, l = 0.160000, t = bb1b, k = -7.485289, t1 = bb1b/2.0,
         t2 = bb1b/2.0, n=nbend, method=meth;
mbb1   : bending, l = 0.170000, t = mbb1b, k = -7.017857, t1 = mbb1b/2.0,
         t2 = mbb1b/2.0, n=nbend, method=meth;
br     : bending, l = 0.180000, t = brb, k = 8.348017, t1 = brb/2.0,
         t2 = brb/2.0, n=nbend, method=meth;
mbr    : bending, l = 0.180000, t = mbrb, k = 8.296055, t1 = mbrb/2.0,
         t2 = mbrb/2.0, n=nbend, method=meth;


{----- table of segments ---------------------------------------------}

ucell : om_sf, sf, l1, br, l1, bb1, l1, sd, om_sd, sd, l1, bb2, l1, sd, om_sd,
        sd, l1, bb1, l1, br, l1, sf, om_sf;
dcell : om_sf, sf, ml1, mbr, ml1c, mbb1, ml1b, sd, om_sd, sd, ml1a, mbb2,
        om_mbb;
arc   : inv(dcell), ucell, ucell, om_c, ucell, ucell, dcell;
mund  : om_mbb, ul1, uq1, ul2, uq2, ul3, uq3, ul4, uq4, ul5;
sec   : inv(mund), arc, mund;

ring  : ucell, cav;

cell: ring, symmetry=1;

end;

{..0231124_4.5deg_allesaufnull\b3bd_sfsf4q_bb1bb2_vary_morealpha_top1.opa}
