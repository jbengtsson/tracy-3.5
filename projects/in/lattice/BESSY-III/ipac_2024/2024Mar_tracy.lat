{d:\lattices\b3_lat\20249999_final\2024mar.opa}

{opa to tracy-2 export}

define lattice;
energy = 2.500000;
dp = 1.0d-10;  codeps = 1.0d-6;  dk = 1.0d-6;
meth = 4; nbend = 10; nquad = 10;

{----- variables ---------------------------------------------------}

rba   = -0.28;
b1a   = 4.25-2.0*rba;
mwba  = 0.2;
mb1a  = 2.75-mwba;



{----- table of elements ---------------------------------------------}

c0   = 2.99792458e8;
h_rf = 538;
C    = 16*22.74040;

cav: Cavity, L = 0.0, Frequency = c0/C*h_rf, Voltage = 1.5e6, harnum = h_rf,
     phi = 0.0;

lo     : drift, l = 0.025000;
l1     : drift, l = 0.100000;
ml1    : drift, l = 0.100000;
ml2    : drift, l = 0.100000;
ml3    : drift, l = 0.100000;
ml4    : drift, l = 0.100000;
ul1    : drift, l = 0.150000;
ul2    : drift, l = 0.150000;
ul3    : drift, l = 0.130000;
ul4    : drift, l = 0.100000;
ul5    : drift, l = 2.800000;

qd     : quadrupole, l = 0.130000, k = -9.178248, n=nquad, method=meth;
uq1    : quadrupole, l = 0.100000, k = 8.677909, n=nquad, method=meth;
uq2    : quadrupole, l = 0.200000, k = -9.526291, n=nquad, method=meth;
uq3    : quadrupole, l = 0.260000, k = 9.052253, n=nquad, method=meth;
uq4    : quadrupole, l = 0.100000, k = -8.509481, n=nquad, method=meth;
mb2    : quadrupole, l = 0.180000, k = 9.365333, n=nquad, method=meth;

b1     : bending, l = 0.550000, t = b1a/2, k = 0.000000, t1 = 0.000000,
         t2 = b1a/2.0, n=nbend, method=meth;
i_b1     : bending, l = 0.550000, t = b1a/2, k = 0.000000, t1 = b1a/2.0,
         t2 = 0.000000, n=nbend, method=meth;
mb1    : bending, l = 0.650000, t = mb1a, k = 0.000000, t1 = mb1a/2.0,
         t2 = mb1a/2.0, n=nbend, method=meth;

sd     : sextupole, l = 0.050000, k = -236.499033, n = 1, method=meth;
sf     : sextupole, l = 0.050000, k = 243.292480, n = 1, method=meth;
sd5    : sextupole, l = 0.050000, k = -239.967748, n = 1, method=meth;
sd4    : sextupole, l = 0.050000, k = -211.299921, n = 1, method=meth;
sd3    : sextupole, l = 0.050000, k = -215.407243, n = 1, method=meth;
sd2    : sextupole, l = 0.050000, k = -200.093085, n = 1, method=meth;
sd1    : sextupole, l = 0.050000, k = -226.546244, n = 1, method=meth;
sf3    : sextupole, l = 0.050000, k = 230.944691, n = 1, method=meth;
sf2    : sextupole, l = 0.050000, k = 204.087886, n = 1, method=meth;
sf1    : sextupole, l = 0.050000, k = 190.137366, n = 1, method=meth;
shx    : sextupole, l = 0.000100, k = 0.000000, n = 1, method=meth;
shy    : sextupole, l = 0.000100, k = 0.000000, n = 1, method=meth;

om_sf  : marker;
om_mb1 : marker;
om_c   : marker;

mqd    : bending, l = 0.150000, t = mwba, k = -8.701492, t1 = mwba/2.0,
         t2 = mwba/2.0, n=nbend, method=meth;
rb     : bending, l = 0.170000, t = rba, k = 8.642872, t1 = rba/2.0,
         t2 = rba/2.0, n=nbend, method=meth;

oxx    : multipole, l = 0.0, hom = (4,320.0000,0), n = 1, method=meth;
oyy    : multipole, l = 0.0, hom = (4,0.0000,0), n = 1, method=meth;


{----- table of segments ---------------------------------------------}

ucell : om_sf, sf, l1, rb, l1, qd, l1, sd, sd, l1, i_b1, om_c, b1, l1, sd, sd,
        l1, qd, l1, rb, l1, sf, om_sf;
i_ucell: om_sf, sf, l1, rb, l1, qd, l1, sd, sd, l1, i_b1, om_c, b1, l1, sd, sd,
        l1, qd, l1, rb, l1, sf, om_sf;
uc21  : om_sf, sf1, l1, rb, l1, qd, l1, sd1, sd1, l1, i_b1, om_c, b1, l1, sd2,
        sd2, l1, qd, l1, rb, l1, sf2, om_sf;
i_uc21: om_sf, sf2, l1, rb, l1, qd, l1, sd2, sd2, l1, i_b1, om_c, b1, l1, sd1,
        sd1, l1, qd, l1, rb, l1, sf1, om_sf;
uc32  : om_sf, sf2, l1, rb, l1, qd, l1, sd3, sd3, l1, i_b1, om_c, b1, l1, sd4,
        sd4, l1, qd, l1, rb, l1, sf3, om_sf;
i_uc32: om_sf, sf3, l1, rb, l1, qd, l1, sd4, sd4, l1, i_b1, om_c, b1, l1, sd3,
        sd3, l1, qd, l1, rb, l1, sf2, om_sf;
dcell : om_sf, sf3, sf3, ml1, lo, oxx, lo, ml1, mb2, ml2, mqd, ml3, sd5, sd5,
        sd5, ml4, mb1, om_mb1;
arc   : inv(dcell), i_uc32, i_uc21, om_c, uc21, uc32, dcell;
mund  : om_mb1, ul1, uq1, ul2, uq2, shy, ul3, uq3, shx, ul4, uq4, ul5;
sec   : inv(mund), arc, mund;

ring  : 1*sec, cav;

cell: ring, symmetry=1;
end;

{d:\lattices\b3_lat\20249999_final\2024mar.opa}
