B3: Bending, L = 0.550000, T =  3.75000, K = -0.350000,
    T1 =  1.87500, T2 =  1.87500, N = Nbend, Method = Meth;
B2: Bending, L = 0.550000, T =  3.75000, K = -0.350000,
    T1 =  3.75000, T2 =  0.00000, N = Nbend, Method = Meth;
B1: Bending, L = 0.550000, T =  3.75000, K = -0.350000,
    T1 =  0.00000, T2 =  3.75000, N = Nbend, Method = Meth;

{ PAC05 }
S1: Sextupole, K = -3.535687, N = 1, Method = Meth;
S2: Sextupole, K =  8.564052, N = 1, Method = Meth;
S3: Sextupole, K = -4.139105, N = 1, Method = Meth;
S4: Sextupole, K = -1.779094, N = 1, Method = Meth;
SD1: Sextupole, K = -0.730646, N = 1, Method = Meth;
SD2: Sextupole, K = -3.623121, N = 1, Method = Meth;
SF1: Sextupole, K =  6.009776, N = 1, Method = Meth;
SF2: Sextupole, K = -5.052600, N = 1, Method = Meth;
S9: Sextupole, K =  1.752169, N = 1, Method = Meth;

MP: Marker;

c0 = 2.99792458e8; Brho = 1e9*Energy/c0; m_e = 0.51099906e6;

lambda_scw = 6.0e-2; K_scw = 19.6; n_scw = 17; L_scw = n_scw*lambda_scw;
B_scw = 2.0*pi*m_e*K_scw/(c0*lambda_scw);

DI0_SCW: Drift, L = 3.05 - L_scw/2.0;

SCWB: Wiggler, L = L_scw, lambda = lambda_scw, kxV = 0.0,
      BoBrhoV = B_scw/Brho, N = n_scw*5, Method = Meth;

lambda_scmgu = 1.4e-2; K_scmgu = 2.2; n_scmgu = 357;
L_scmgu = n_scmgu*lambda_scmgu;
B_scmgu = 2.0*pi*m_e*K_scmgu/(c0*lambda_scmgu);

DI0_SCMGU: Drift, L = 3.05-L_scmgu/2.0;

SCMGUB: Wiggler, L = L_scmgu, lambda = lambda_scmgu, kxV = 0.0,
        BoBrhoV = B_scmgu/Brho, N = n_scmgu*5, Method = Meth;

h_rf = 1050; C = 630.0;

{CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 1.9e6, Harnum = h_rf;}
CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 2.2e6, Harnum = h_rf;
{CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 3.74e6, Harnum = h_rf;}

MID: DI0, DSX, S1, DSX, DI1, TWK1, QI1, DI1, DSX, S2,
     DSX, DI1, TWK2, QI2, D2AH, DSX, S3, DSX, D2AH, TWK3, QI3,
     DI2, DSX, S4, DSX, DI3;

MIDSCW: DI0_SCW, DSX, S1, DSX, DI1, QI1, DI1, DSX, S2,
        DSX, DI1, QI2, D2AH, DSX, S3, DSX, D2AH, QI3,
        DI2, DSX, S3, DSX, DI3;

MIDSCMGU: DI0_SCMGU, DSX, S1, DSX, DI1, QI1, DI1, DSX, S2,
          DSX, DI1, QI2, D2AH, DSX, S3, DSX, D2AH, QI3,
          DI2, DSX, S3, DSX, DI3;

DISP: B3, DD0, DSD, SD1, DSD, DD1, QDB, DD2A, DSX, SD2, DSX, DD2,
      QDF, DD3, DSD, DSDS6U, SF1, DSDS6D, DSD, DD4,
      QF3, DD5, DSD, SF2, DSD, DD0;

DISP_NO_S: B3, DD0, DSD, DSD, DD1, QDB, DD2A, DSX, DSX, DD2,
           QDF, DD3, DSD, DSDS6U, DSDS6D, DSD, DD4,
           QF3, DD5, DSD, DSD, DD0;

DISP_SF: B3, DD0, DSD, DSD, DD1, QDB, DD2A, DSX, DSX, DD2,
         QDF, DD3, DSD, DSDS6U, SF1, DSDS6D, DSD, DD4,
         QF3, DD5, DSD, SF2, DSD, DD0;

DISP_SD: B3, DD0, DSD, SD1, DSD, DD1, QDB, DD2A, DSX, SD2, DSX, DD2,
         QDF, DD3, DSD, DSDS6U, DSDS6D, DSD, DD4,
         QF3, DD5, DSD, DSD, DD0;

PER: MID, DISP, B2, S9, MP, S9, B1, INV(DISP), INV(MID);

PER1: DISP, B2, S9, S9, B1, INV(DISP), INV(MID), MID;

PER_SF_SD: MID, DISP_SF,   B2, MP, B1, INV(DISP_NO_S), INV(MID),
           MID, DISP_SF,   B2, MP, B1, INV(DISP_SD),   INV(MID),
           MID, DISP_NO_S, B2, MP, B1, INV(DISP_SD),   INV(MID);

PERSCW: DISP, B2, B1, INV(DISP), INV(MIDSCW), SCWB, MIDSCW;

PERSCMGU: DISP, B2, S9, S9, B1, INV(DISP), INV(MIDSCMGU), SCMGUB, MIDSCMGU;

RING: 1*PER, CAV;

{RING: 1*PER_SF_SD, CAV;}

{RING: PERSCMGU, 0*PER1, CAV;}

CELL: RING, SYMMETRY = 1;

END;
