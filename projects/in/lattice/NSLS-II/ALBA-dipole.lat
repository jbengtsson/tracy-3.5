{*   ALBA storage ring dipole *}
define lattice;

intmeth= 4;

{***** System parameters *****}
Energy = 3.0;    { GeV }
dP     = 1.0d-8;
CODeps = 1.0d-15;
NSbend = 10;
Angle  = 11.25;

idsr: marker;

B1: Bending, L = 1.383684, T = Angle, K = -0.565618,
    T1 = Angle/2.0, T2 = Angle/2.0, N = NSbend, method = intmeth;


CELDA: idsr, B1;

RING:  CELDA;
{***** Define CELL structure ****}
 CELL:	RING, symmetry = 1;
end;

