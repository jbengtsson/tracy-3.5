{ New DBA30HLC16Es2rng7x7s.opa H(8m) L(5m)Rho = 25m }

define lattice; ringtype = 1;

Energy = 3.0;

dP = 1e-8; CODeps = 1e-14;  
  
Meth = 4; Nbend = 4; Nquad = 4;  
  
pi = 4.0*arctan(1.0);  
 

HCM: Corrector, Horizontal, Method= Meth;
VCM: Corrector, Vertical, Method= Meth;
BPM: Beam Position Monitor ;

DFCH : Drift, L=0.15;
DH0 : Drift, L=4.65;
DH1A : Drift, L=0.175;
DH2A : Drift, L=0.1575;
DH2B : Drift, L=0.1575;
DH2C : Drift, L=0.15;
DH3A : Drift, L=0.19;
DH3B : Drift, L=0.195;
DH4A : Drift, L=0.175;
DH4B : Drift, L=0.1;
DH4C : Drift, L=0.18;
DL0 : Drift, L=3.3;
DL1A : Drift, L=0.175;
DL2A : Drift, L=0.1375;
DL2B : Drift, L=0.1375;
DL2C : Drift, L=0.25;
DL3A : Drift, L=0.6386;
DL3B : Drift, L=0.15;
DL4A : Drift, L=0.15;
DL4B : Drift, L=0.15;
DM1A : Drift, L=0.365;
DM1B : Drift, L=0.31;
