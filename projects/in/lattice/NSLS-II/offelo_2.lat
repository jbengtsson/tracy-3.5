define lattice; ringtype = 1;

Energy = 3.0;

pi = 4.0*arctan(1.0);

dP = 1e-8; CODeps = 1e-16;  

Meth = 4; Nbend = 10; Nquad = 10; Nsext = 10; Nmult = 10;


B2H: BENDING, L = 0.65, T = 0.002147363399583*180.0/pi, N = Nbend,
     Method = Meth;

O:   DRIFT, L = 0.075;
OFW: DRIFT, L = 0.3001321078893861;
O1F: DRIFT, L = 0.3499999988208027;
O2F: DRIFT, L = 0.2214533266809365;


QF2: Quadrupole, L = 0.19,  K =  1.2942316793623900, N = Nquad, Method = Meth;
QD2: Quadrupole, L = 0.175, K = -1.2962213952904922, N = Nquad, Method = Meth;
QF3: Quadrupole, L = 0.28,  K =  1.7773968396426005, N = Nquad, Method = Meth;
QD3: Quadrupole, L = 0.2,   K = -1.3483772626260819, N = Nquad, Method = Meth;

S1: Multipole, L = 0.0, N = 1, Method = Meth,
     HOM = (3, -87.6060144990682517, 0.0),
     HOM = (4, -206458.8807373046875000, 0.0),
     HOM = (5, -516350686.2570312619209290, 0.0);
S2: Multipole, L = 0.0, N = 1, Method = Meth,
     HOM = (3, 267.8925610750912938, 0.0),
     HOM = (4, 323920.5604980468051508, 0.0),
     HOM = (5, -1904591008.3250005245208740, 0.0);
S3: Multipole, L = 0.0, N = 1, Method = Meth,
     HOM = (3, -223.1534750223160017, 0.0),
     HOM = (4, 242695.9511077880451921, 0.0),
     HOM = (5, -5322876103.0750017166137695, 0.0);
S4: Multipole, L = 0.0, N = 1, Method = Meth,
     HOM = (3, 61.9016716882586451, 0.0),
     HOM = (4, -83554.1691296577337198, 0.0),
     HOM = (5, -3400258.0203124997206032, 0.0);
S5: Multipole, L = 0.0, N = 1, Method = Meth,
     HOM = (3, 23.2562294214963892, 0.0),
     HOM = (4, 248244.0826126098691020, 0.0),
     HOM = (5, -485650435.2328125834465027, 0.0);

FODOH: QD2, O, B2H, B2H, O, QF2;
FODO:  S1, FODOH, S2, INV(FODOH), S3;

NC0: FODO, QD2, O, B2H, B2H;

HCELL: OFW, QF3, QF3, S4, O1F, QD3, QD3, S5, O2F, B2H;

OFFELO:  1*(NC0, HCELL, INV(NC0, HCELL));

CELL: OFFELO, SYMMETRY = 1;

END;
