define lattice; ringtype = 1;

Energy = 3.0;

dP = 1e-8; CODeps = 1e-14;

Meth = 4; Nbend = 10; Nquad = 1;

pi = 4.0*arctan(1.0);

c0 = 2.99792458e8; h_rf = 1320; C = 10.1586800; Brho = 1e9*Energy/c0;

CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 5.00e6/2, Harnum = h_rf;

D1: Drift, L = 0.882179;

D2: Drift, L =  1.54308;
D3: Drift, L = -0.126125;

D4: Drift, L = -0.0186808;
D5: Drift, L =  0.382393;
D6: Drift, L =  2.5;

{ M-BA; matching sections has 1/2 dipoles. }
{ C ~ 300 m, QBA, N = 20, E = 3 GeV. }
{Lb = 1.0; phib = 6.0;}
{ C ~ 500 m, 7-BA, N = 20, E = 3 GeV. }
{Lb = 1.0; phib = 3.0;}
{ C ~ 800 m, 8-BA, N = 30, E = 3 GeV. }
Lb = 1.0; phib = 1.71;
{ C ~ 1100 m, 10-BA, N = 36, E = 6 GeV. }
{Lb = 1.0; phib = 1.111;}

BH: Bending, L = Lb/2.0, K = 0.0, T = phib/2.0, T1 = 0.0, T2 = 0.0,
    N = Nbend, Method = Meth;

rho = Lb/(phib*pi/180.0);

Lb2 = 0.756902;

B1: Bending, L = Lb2, K = 0.0, T = Lb2/rho*180.0/pi, T1 = 0.0, T2 = 0.0,
    N = Nbend, Method = Meth;

{QD: Quadrupole, L = 0.0, K = -1.07,    N = Nquad, Method = Meth;}
QD: Quadrupole, L = 0.0, K = -1.25,    N = Nquad, Method = Meth;
QF: Quadrupole, L = 0.0, K =  2.86486, N = Nquad, Method = Meth;

QF1: Quadrupole, L = 0.0, K =  3.96313, N = Nquad, Method = Meth;

QD1: Quadrupole, L = 0.0, K = -2.33193,  N = Nquad, Method = Meth;
QF2: Quadrupole, L = 0.0, K =  1.83738, N = Nquad, Method = Meth;

FODCELL: QF, BH, QD;

HCELL: D1, FODCELL;

FCELL: HCELL, INV(HCELL);

MCELL: B1, D3, QF1, D2, FODCELL;

STR: D6, QF2, D5, QD1, D4;

SPERH: STR, MCELL;

SPER: SPERH, INV(SPERH);

QBA: SPERH, INV(HCELL), HCELL, INV(SPERH);

SBA: SPERH, INV(HCELL), 3*FCELL, HCELL, INV(SPERH);

OBA: SPERH, INV(HCELL), 4*FCELL, HCELL, INV(SPERH);

TENBA: SPERH, INV(HCELL), 6*FCELL, HCELL, INV(SPERH);

{LINE: FCELL, CAV;}

{LINE: MCELL, INV(MCELL), CAV;}

{LINE: SPER, CAV;}

{LINE: QBA, CAV;}

{LINE: SBA, CAV;}

LINE: OBA, CAV;

{LINE: TENBA, CAV;}

CELL: LINE, SYMMETRY = 1;

END;
