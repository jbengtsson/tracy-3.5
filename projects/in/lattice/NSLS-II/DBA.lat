define lattice; ringtype = 1;

Energy = 3.0;

dP = 1e-8; CODeps = 1e-14;

Meth = 4; Nbend = 10; Nquad = 1;

pi = 4.0*arctan(1.0);

c0 = 2.99792458e8; h_rf = 1320; C = 10.1586800; Brho = 1e9*Energy/c0;

CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 5.00e6/2, Harnum = h_rf;

D1_L = 0.779; D2_L = 5.0;
{D1_L = 0.75067; D2_L = 5.10000;}

D1: Drift, L = D1_L;
D2: Drift, L = D2_L;

scl = 1.0;
{scl = 5.0/8.0;}

B: Bending, L = scl*1.0, T = scl*6.0, T1 = 0.0, T2 = 0.0,
   N = Nbend, Method = Meth;

K_QF = 0.876; K_QD = -0.356/2.0;
{K_QF = 0.88526; K_QD = -0.15055;}

QF: Quadrupole, L = 0.0, K = K_QF, N = Nquad, Method = Meth;
QD: Quadrupole, L = 0.0, K = K_QD, N = Nquad, Method = Meth;

HCELL: B, D1, QF, D2, QD;

{LINE: HCELL, CAV;}

{LINE: INV(HCELL), CAV;}

LINE: HCELL, INV(HCELL), CAV;

CELL: LINE, SYMMETRY = 1;

END;
