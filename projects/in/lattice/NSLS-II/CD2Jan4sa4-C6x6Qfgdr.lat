SH4      : Sextupole, K = -0.188233, N = 1, Method = Meth;}




SQ: Multipole, N = 1, Method = Meth;

MP : Marker;
OMB : Marker;

GS: Multipole, N = 1, Method = Meth;
GE: Multipole, N = 1, Method = Meth;

c0 = 2.99792458e8  ; h_rf = 1320; C = 791.958 ;

CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 5.00e6, Harnum = h_rf;

LID :DSX, SL1, DSX, DL1A,BPM, QL1, DL2A, DHV1,HCM,VCM,DHV1, DL2B, DSX, SL2, DSX, 
     DL2C, QL2, DL3A, DSX, SL3, DSX, DL3B, QL3,BPM, DL4A, DHV2,HCM,VCM,DHV2;

HID :DSX, SH1, DSX, DH1A, BPM,QH1, DH2A, DSX,SH2,DSX, DH2B, DHV1,HCM,VCM,DHV1,  
     DH2C, QH2, DH3A, DSX, SH3, DSX, DH3B, QH3,BPM, DH4A, DSX, SH4, DSX, 
     DH4B, DHV2,HCM,VCM,DHV2;

HID_SQ :DSX, SH1, DSX, DH1A, BPM,QH1, DH2A, DSX,SH2,DSX, DH2B, DHV1,HCM,VCM,SQ,DHV1, 
     DH2C, QH2, DH3A, DSX, SH3, DSX, DH3B, QH3,BPM, DH4A, DSX, SH4, DSX, 
     DH4B, DHV2,HCM,VCM,DHV2;

{ BPM P3 moved to QM2 }
DISP :DM1B, QM1, DM2A, DSX, SM1, DSX, DM2B, BPM, QM2, DM2C, 
      DSD, SM2, OMB, DSD, DM2C, QM2, DM2B, DSX, SM1, DSX, DM2A, QM1, 
      BPM, DM1E, DHV2,VCM,HCM,DHV2 ;

DBA:  B1, DM1A, DHV2,VCM,HCM,DHV2, GS, DISP,
      GE, DM1D, DPW2, DPW2, DM1C, B1;

DBA_SQ: B1, DM1A, DHV2,VCM,HCM,SQ,DHV2, GS, DISP,
      GE, DM1D, DPW2, DPW2, DM1C, B1;


LINE: DH0, GS, HID_SQ, GE, DH4C, DBA, DL4B, GS, INV(LID), GE, DL0,  
      DL0, GS, LID, GE, DL4B, DBA_SQ, DH4C, GS, INV(HID), GE, DH0;


RING: 15*LINE, CAV;

{RING: LINE, CAV;}

CELL: RING, SYMMETRY  = 1;

END;
