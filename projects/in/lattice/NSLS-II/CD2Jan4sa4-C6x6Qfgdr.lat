define lattice;
{ CD2-Jan4sa4-C6x6Qfgdr EX_2.06 TPW H(9.3) L(6.6M) PMTPW(0.40M)
  with SH2 and CORH1 switch in the High Beta ID sextupoles retuned }
Energy = 3.0;

dP = 1e-6; CODeps = 1e-10;

Meth = 4; Nbend = 4; Nquad = 4;

pi = 4.0*arctan(1.0);

BPM: Beam Position Monitor ;
HCM: Corrector, Horizontal, Method= Meth;
VCM: Corrector, Vertical, Method= Meth;
BHV: BPM, HCM, VCM ; 

DH0      : Drift, L = 4.650000;
DH1A     : Drift, L = 0.175000;
DH2A     : Drift, L = 0.157500;
DCH1     : Drift, L = 0.200000;
