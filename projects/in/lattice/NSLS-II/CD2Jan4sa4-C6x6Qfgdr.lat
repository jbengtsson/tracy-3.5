SH4      : Sextupole, K = -0.229858, N = 1, Method = Meth;

{ Oct12s4.opa
SL1      : Sextupole, K = -0.409410, N = 1, Method = Meth;
SL2      : Sextupole, K =  2.730370, N = 1, Method = Meth;
SL3      : Sextupole, K = -2.790977, N = 1, Method = Meth;
SM1      : Sextupole, K = -2.260337, N = 1, Method = Meth;
SM2      : Sextupole, K =  3.194935, N = 1, Method = Meth;
SH1      : Sextupole, K = -0.208117, N = 1, Method = Meth;
SH2      : Sextupole, K =  2.593428, N = 1, Method = Meth;
