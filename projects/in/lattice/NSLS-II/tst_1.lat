define lattice; ringtype = 1;

Energy = 3.0;

dP = 1e-8; CODeps = 1e-14;

Meth = 4; Nbend = 10; Nquad = 1;

pi = 4.0*arctan(1.0);

c0 = 2.99792458e8; h_rf = 1320; C = 10.1586800; Brho = 1e9*Energy/c0;

CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 5.00e6/2, Harnum = h_rf;

D1: Drift, L = 1.19015;

Lb = 1.0; phib = 3.0;

BH: Bending, L = Lb/2.0, K = 0.0, T = phib/2.0, T1 = 0.0, T2 = 0.0,
    N = Nbend, Method = Meth;

rho = Lb/(phib*pi/180.0); 

Lb2 = 0.1706;

B1: Bending, L = Lb2, K = 0.0, T = Lb2/rho*180.0/pi, T1 = 0.0, T2 = 0.0,
    N = Nbend, Method = Meth;

QD:  Quadrupole, L = 0.0, K = -1.25,  N = Nquad, Method = Meth;
QF1: Quadrupole, L = 0.0, K =  3.64164, N = Nquad, Method = Meth;
QF2: Quadrupole, L = 0.0, K =  1.43676, N = Nquad, Method = Meth;

HUCELL: QD, BH, QF1, D1;

FUCELL: INV(HUCELL), HUCELL;

MCELL: B1, QF2;

LINE: MCELL, 1*FUCELL, INV(MCELL);

CELL: LINE, SYMMETRY = 1;

END;
