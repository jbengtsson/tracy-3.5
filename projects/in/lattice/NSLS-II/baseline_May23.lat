
define lattice;
{ New W3E4LS3S5-C6x6Qfgdr EX_2.0 TPW H(8.6) L(6.6M)PMTPW(0.40M) }
Energy = 3.0;

dP = 1e-8; CODeps = 1e-14;

Meth = 4; Nbend = 4; Nquad = 4;

pi = 4.0*arctan(1.0);

BPM: Beam Position Monitor ;
HCM: Corrector, Horizontal, Method= Meth;
VCM: Corrector, Vertical, Method= Meth;
BHV: BPM, HCM, VCM ; 

D0:   Drift, L = 4.27863333;
D1A:  Drift, L = 0.15;
D1BH:  Drift, L = 0.2;
D2A:  Drift, L = 0.15;
D3A:  Drift, L = 0.15;
D3B:  Drift, L = 0.15;
D4A:  Drift, L = 0.15;
D4B1: Drift, L = 0.3;
D4B2: Drift, L = 0.39;
D5B:  Drift, L = 0.3;
D5W:  Drift, L = 0.2;
DPW:  Drift, L = 0.2;
D5C:  Drift, L = 0.25;
D5A:  Drift, L = 0.15;
D6A:  Drift, L = 0.2550026;
D6B:  Drift, L = 0.15;
D7:   Drift, L = 0.255;
DCH:  Drift, L = 0.15;
D44A:  Drift, L = 0.2;
DHVC:  Drift, L = 0.15;
D4L1:  Drift, L = 0.135;
D4L2:  Drift, L = 0.135;
D33A: Drift, L = 0.15;
D33B: Drift, L = 0.15;
D22AH: Drift, L = 0.2;
D22B: Drift, L = 0.15;  
D11A: Drift, L = 0.0;
D11B: Drift, L = 0.15;
D00:  Drift, L = 3.3;
DSX: Drift,  L = 0.1;
DSD: Drift,  L = 0.125;

{ W3E4LSPER EX_2.0 H(8.6) L(6.6M) 5-TPW(0.2M-2MRAD }                     
Q1       : Quadrupole, L = 0.000, K = 0.000,  N = Nquad, Method = Meth;
Q2       : Quadrupole, L = 0.3, K = -0.861961,  N = Nquad, Method = Meth;
Q3       : Quadrupole, L = 0.4, K = 1.810584,  N = Nquad, Method = Meth;
Q4       : Quadrupole, L = 0.3, K = -1.422767,  N = Nquad, Method = Meth;
QF1      : Quadrupole, L = 0.3, K = 1.579689,  N = Nquad, Method = Meth;
QD1      : Quadrupole, L = 0.3, K = -1.110382,  N = Nquad, Method = Meth;
QCH      : Quadrupole, L = 0.1, K = -0.467777,  N = Nquad, Method = Meth;
Q44      : Quadrupole, L = 0.3, K = -1.653400,  N = Nquad, Method = Meth;
Q33      : Quadrupole, L = 0.5, K = 1.869403,  N = Nquad, Method = Meth;
Q22      : Quadrupole, L = 0.3, K = -1.312489,  N = Nquad, Method = Meth;

B1: Bending, L = 2.62, T =  6.0000,
    T1 =  3.000, T2 =  3.0000, N = Nbend, Method = Meth;
{ W3E4LS36.OPA } 
{S1       : Sextupole, K =  -1.14, N = 1, Method = Meth;
S2       : Sextupole, K =  1.98, N = 1, Method = Meth;
S3       : Sextupole, K =  -1.13, N = 1, Method = Meth;
SD1      : Sextupole, K =   -0.41, N = 1, Method = Meth;
SF1      : Sextupole, K = -2.0, N = 1, Method = Meth;
SF2      : Sextupole, K =  1.96, N = 1, Method = Meth;
SL1      : Sextupole, K =  2.0, N = 1, Method = Meth;
SL2      : Sextupole, K =  1.84, N = 1, Method = Meth;
SL3      : Sextupole, K =  -1.87, N = 1, Method = Meth;
SL4      : Sextupole, K =  -1.99, N = 1, Method = Meth;}



S1: Sextupole, L = 0.000000, K = -0.528180, N = 1, Method = Meth;
S2: Sextupole, L = 0.000000, K =  1.860000, N = 1, Method = Meth;
S3: Sextupole, L = 0.000000, K = -1.729760, N = 1, Method = Meth;
SD1: Sextupole, L = 0.000000, K = -0.540429, N = 1, Method = Meth;
SF1: Sextupole, L = 0.000000, K = -1.889836, N = 1, Method = Meth;
SF2: Sextupole, L = 0.000000, K =  1.929146, N = 1, Method = Meth;
SL1: Sextupole, L = 0.000000, K =  0.221280 , N = 1, Method = Meth;
SL2: Sextupole, L = 0.000000, K =  1.999996, N = 1, Method = Meth;
SL3: Sextupole, L = 0.000000, K = -0.657187, N = 1, Method = Meth;
SL4: Sextupole, L = 0.000000, K = -1.999998, N = 1, Method = Meth;


SQ: Multipole, N = 1, Method = Meth;

MP : Marker;
GS: Multipole, N = 1, Method = Meth;
GE: Multipole, N = 1, Method = Meth;

TPW: Multipole, N = 1, Method = Meth,
     HOM = (2, 0.0, 0.0,
	    3, 0.0, 0.0);

c0 = 2.99792458e8  ; h_rf = 1320; C = 791.959 ;
Brho = 1e9*Energy/c0;

{ Mini Gap Undulator }
lambda_CPMU = 19e-3; n_CPMU = 160; B_CPMU = 2.2/(0.934*1e2*lambda_CPMU);
L_CPMU = n_CPMU*lambda_CPMU;

D_CPMU: Drift, L = -L_CPMU/2.0;

CPMU1: Wiggler, L = L_CPMU/2.0, lambda = lambda_CPMU,
       kxV = 0.0, BoBrhoV = B_CPMU/Brho, N = n_CPMU*4, Method = 1;

CPMU: D_CPMU, CPMU1;

CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 5.00e6, Harnum = h_rf;

LB: D11A,DSX,S1,DSX, D11B, BPM,Q22, D22AH,HCM,VCM,D22AH, 
    DSX, S2, DSX, D22B, Q33, D33A, 
    DSX, S3, DSX, D33B, Q44, BPM, D44A, 
    D4L1, DHVC, HCM, VCM;

HB: DSX,SL1,DSX,D1A,Q2,BPM, D2A, DSX,SL2,DSX, 
    D1BH, HCM, VCM, D1BH, Q3, D3A, 
    DSX, SL3, DSX, D3B, Q4, BPM, D4A, 
    DSX, SL4, DSX , D4B1, HCM, VCM;

HB_SQ: DSX,SL1,DSX,D1A,Q2,BPM, D2A, DSX,SL2,DSX, 
    D1BH, SQ, HCM,VCM, D1BH,Q3, D3A, 
    DSX, SL3, DSX, D3B, Q4, BPM, D4A, 
    DSX, SL4, DSX , D4B1, HCM, VCM;

DISP:  D5C, VCM, HCM,  D5B, DSD, SD1, DSD, 
      D5A,BPM, QD1, D6A, DSD, SF1, DSD, D6B, QF1,D7,
      DSX, SF2, DSX ; 

DISP_SQ: D5C,VCM, HCM,SQ,D5B, DSD, SD1, DSD, 
      D5A,BPM, QD1, D6A, DSD, SF1, DSD, D6B, QF1,D7,
      DSX, SF2, DSX ; 

DBA: B1, D5W,DPW,  
     GS, DISP,DCH, QCH, MP, QCH, DCH, INV(DISP), GE, 
     DPW,D5W, B1;

DBA_SQ: B1, D5W,DPW, 
      GS, DISP_SQ,DCH, QCH, MP, QCH, DCH, INV(DISP), GE, 
      DPW,D5W, B1;

LINE: D0, GS, HB_SQ, GE, D4B2, DBA_SQ, D4L2, GS, INV(LB), GE, D00, 
      D00, GS, LB, GE, D4L2, DBA, D4B2, GS, INV(HB), GE, D0;


RING: 15*LINE, CAV;

{RING: LINE, CAV;}

CELL: RING, SYMMETRY  = 1;

END;
