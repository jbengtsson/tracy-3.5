define lattice; ringtype = 1;

Energy = 3.0;

dP = 1e-8; CODeps = 1e-14;  

Meth = 4; Nbend = 10; Nquad = 10; Nsext = 1;

BRHO = 3.33564051648;

NCEL  = 20.0;
NDIP  = 7.0*NCEL;

{ Set energy in machine file. }
CAV: Cavity, Frequency = 0.0, Voltage = 0.0, Harnum = 0;

{S1: Sextupole, L = 0.0, K = -1.5952931978210194, N = Nsext, Method = Meth;
S2: Sextupole, L = 0.0, K =  5.3555742679989384, N = Nsext, Method = Meth;
S3: Sextupole, L = 0.0, K =  9.5140522410889776, N = Nsext, Method = Meth;
S4: Sextupole, L = 0.0, K =  3.4042999826587952, N = Nsext, Method = Meth;
S5: Sextupole, L = 0.0, K = -3.3699562880652505, N = Nsext, Method = Meth;}

S1: Sextupole, L = 0.0, K = -2.5290448104858791, N = Nsext, Method = Meth;
S2: Sextupole, L = 0.0, K =  4.5786710136100224, N = Nsext, Method = Meth;
S3: Sextupole, L = 0.0, K = -3.2337517665322983, N = Nsext, Method = Meth;
S4: Sextupole, L = 0.0, K =  2.9935324581980969, N = Nsext, Method = Meth;
S5: Sextupole, L = 0.0, K = -2.8033707893277411, N = Nsext, Method = Meth;

O:   DRIFT, L = 0.075;

B2:  BENDING, L = 1.2,     T = 360.0/NDIP, N = Nbend, Method = Meth;
B2H: BENDING, L = 1.2/2.0, T = 180.0/NDIP, N = Nbend, Method = Meth;

{QF2: QUADRUPOLE, L = 0.19,  K =  6.264956775412/BRHO, N = Nquad, Method = Meth;
QD2: QUADRUPOLE, L = 0.175, K = -5.110902822157/BRHO, N = Nquad, Method = Meth;
QF3: QUADRUPOLE, L = 0.3,   K =  5.0647577/BRHO, N = Nquad, Method = Meth;
QD3: QUADRUPOLE, L = 0.22,  K = -4.0962475/BRHO, N = Nquad, Method = Meth;}

QF2: Quadrupole, L = 0.19,  K =  1.8781867504021315, N = Nquad, Method = Meth;
QD2: Quadrupole, L = 0.175, K = -1.5322103723586962, N = Nquad, Method = Meth;
QF3: Quadrupole, L = 0.3,   K =  1.5183765942798479, N = Nquad, Method = Meth;
QD3: Quadrupole, L = 0.22,  K = -1.2280239816417604, N = Nquad, Method = Meth;

FODOH: QD2, O, B2, O, QF2;
FODO:  S1, FODOH, S2, INV(FODOH), S3;

OFW: DRIFT, L = 0.57500541;
O1F: DRIFT, L = 0.28861085;
O2F: DRIFT, L = 0.40592937;

NC0: FODO, QD2, O, B2;

HCELL: OFW, QF3, S4, QF3, O1F, QD3, S5, QD3, O2F, B2H;

FEL:  1*(NC0, HCELL, INV(NC0, HCELL)), CAV;

CELL: FEL, SYMMETRY = 1;  

END;
