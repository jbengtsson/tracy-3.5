{ Title = SLS STANDARD OPERATING MODE D2R; }

define lattice;

Energy = 2.4;

dP = 1e-5; CODeps = 1e-10;

Meth = 4; Nbend = 4; Nquad = 4;

AAA:    Drift, L = 0.000000;
D050:   Drift, L = 0.500000;
D1:     Drift, L = 0.400000;
D2:     Drift, L = 0.540000;
D3:     Drift, L = 0.360000;
D4:     Drift, L = 0.400000;
DL1:    Drift, L = 0.540000;
DL2:    Drift, L = 0.360000;
DL3:    Drift, L = 0.540000;
DL4:    Drift, L = 0.360000;
DLPLUS: Drift, L = 0.880000;
DM1:    Drift, L = 0.580000;
DM2:    Drift, L = 0.480000;
DM3:    Drift, L = 0.360000;
DS1:    Drift, L = 0.580000;
DS2:    Drift, L = 0.480000;
DS3:    Drift, L = 0.360000;
DSX:    Drift, L = 0.260000;

QAL: Quadrupole, L = 0.200000, K = -1.447758;
QAM: Quadrupole, L = 0.200000, K = -1.376348;
QAS: Quadrupole, L = 0.200000, K = -1.643860;
QBL: Quadrupole, L = 0.320000, K =  1.104624;
QBM: Quadrupole, L = 0.320000, K =  0.965160;
QBS: Quadrupole, L = 0.320000, K =  1.139877;
QCL: Quadrupole, L = 0.440000, K =  1.882414;
QCM: Quadrupole, L = 0.440000, K =  1.979731;
QCS: Quadrupole, L = 0.440000, K =  1.891626;
QDL: Quadrupole, L = 0.320000, K = -1.852900;
QDM: Quadrupole, L = 0.320000, K = -2.042879;
QDS: Quadrupole, L = 0.320000, K = -1.978389;
QL1: Quadrupole, L = 0.200000, K = -0.100000;
QL2: Quadrupole, L = 0.440000, K =  1.847864;
QL3: Quadrupole, L = 0.440000, K = -1.858092;
QL4: Quadrupole, L = 0.200000, K =  2.194842;
QM1: Quadrupole, L = 0.200000, K = -0.662943;
QM2: Quadrupole, L = 0.440000, K =  2.216547;
QM3: Quadrupole, L = 0.320000, K = -1.654406;
QS1: Quadrupole, L = 0.200000, K = -0.914157;
QS2: Quadrupole, L = 0.440000, K =  2.554125;
QS3: Quadrupole, L = 0.440000, K = -1.921995;

{ bend data: L length, T angle in deg, K gradient, T1 entrance edge,
  T2 exit edge, full Gap , K1, K2 fringe field parameters,
  Ax, Ay hor and vert apertures }

BEH1: Bending, L = 0.400000, T =  4.00000, K =  0.000000,
     T1 =  4.00000, T2 =  0.00000;
BEH2: Bending, L = 0.400000, T =  4.00000, K =  0.000000,
     T1 =  0.00000, T2 =  4.00000;
BX0: Bending, L = 0.350000, T =  3.50000, K =  0.000000,
     T1 =  0.00000, T2 =  0.00000;
BX11: Bending, L = 0.350000, T =  3.50000, K =  0.000000,
     T1 =  7.00000, T2 =  0.00000;
BX12: Bending, L = 0.350000, T =  3.50000, K =  0.000000,
     T1 =  0.00000, T2 =  7.00000;

SD:  Sextupole, K = -3.949799;
SE:  Sextupole, K = -2.033546;
SF:  Sextupole, K =  4.247511;
SL1: Sextupole, K = -7.420078;
SL2: Sextupole, K =  2.898742;
SM1: Sextupole, K = -3.857892;
SM2: Sextupole, K =  3.400525;
SS1: Sextupole, K = -7.244432;
SS2: Sextupole, K =  4.186648;

{ optical functions at BX center }

OMB: Marker;

{----- Table of segments ----------------------------------------------------}

{ full BE 8 degree bend and half of BX 14 degree bend }

BE : BEH, INV(BEH);
BXH: BX1, BX0;

{  straight sections in 1/2 meter slices: Long, Medium, Short }

DL : 10*D050, DLPLUS;
DM : 7*D050;
DS : 4*D050;

{ from mid BX bend to BE bends, for Long, Medium and Short straight arcs}

TL : INV(BXH), D1, QAL, DSX, SD, D2, QBL, DSX, SF, DSX, QCL, D3, SE,
     DSX, QDL, D4, BE;
TM : INV(BXH), D1, QAM, DSX, SD, D2, QBM, DSX, SF, DSX, QCM, D3, SE,
     DSX, QDM, D4, BE;
TS : INV(BXH), D1, QAS, DSX, SD, D2, QBS, DSX, SF, DSX, QCS, D3, SE,
     DSX, QDS, D4, BE;

{from BE exit to straight center for L, M, S }

ML : DL1, SL1, DSX, QL1, DL2, QL2, DSX, SL2, DL3, QL3, DL4, QL4, DL;
MM : DM1, SM1, DSX, QM1, DM2, QM2, DSX, SM2, DM3, QM3, DM;
MS : DS1, SS1, DSX, QS1, DS2, QS2, DSX, SS2, DS3, QS3, DS;

TML: OMB, TL, ML;
TMM: OMB, TM, MM;
TMS: OMB, TS, MS;

{ ring/6, ring/3 = 1 period, and full ring}

SIX:  INV(TML), TMS, INV(TMS), TMM;
PER:  SIX, INV(SIX);
RING: 3*PER;

CELL: RING, SYMMETRY = 1;

END;
