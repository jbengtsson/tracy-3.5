Q3B : quadrupole, L=0.307000, K=-0.86649632, method=intmeth, N=Nq;}

{** bending **}
gap_JR = 0.0466; gap_JB = 0.89/0.5*gap_JR;
 BB2 : bending, L= 0.933/4, T= 7.5, T1=3.75, T2=0.000, K=0.0, N=4,
	gap=gap_JB, method=intmeth;	
 BB3 : bending, L= 0.933/4, T= 7.5/4, T1=0.000, T2=0.000, K=0.0, N=4,
	gap=gap_JB, method=intmeth;
 BB4 : bending, L= 0.933/4, T= 7.5/4, T1=0.000, T2=3.75, K=0.0, N=4,
	gap=gap_JB, method=intmeth;
 BB  : BB2, BB3, BB3, BB4;

{BB : bending, L= 0.933, T= 7.5, T1=3.75, T2=3.75, K=0.0, N=4,
     method=intmeth;}
{BB: Fieldmap, scaling = 1.0, L = 0.933, T = 7.5, N = 1,
    file1 = "dip.int.lis";}

{ NSLS-II }
{BB: Bending, L = 2.62, T = 6.0, T1 = 3.0, T2 = 3.0, N = 4, Method = intmeth;}
{BB: Fieldmap, scaling = -1.0, L = 2.62, T = -6.0, N = 1,
    file1 = "d35_ref_finer_grid.table";}

NqSx=1; {Number of slices}
 
{** Sextupoles from dls715, scaled for 29cm/19cm sextupoles **} 
DS:    drift, L=0.005;
{*
SS1A : sextupole, L=0.29, K =  5.449444/0.29, method=intmeth, N = NqSx;
SS2A : sextupole, L=0.19, K = -3.349528/0.19, method=intmeth, N = NqSx;
