{** Marker **}
 FIN : marker;
 DEBUT : marker;
 K1 : marker;
 K2 : marker;

{**BPMs**}
 MBPM: marker;

{**Correctors**}
 hstr : corrector, horizontal,method=intmeth;
 vstr : corrector, vertical,method=intmeth;

BEGIN_S: marker;
END_S: marker;

{**Superperiods**}
S1A_L: BEGIN_S, DS, SS1A_L, hstr, vstr, DS, END_S;
S2A_L: BEGIN_S, DS, SS2A_L, hstr, vstr, DS, END_S;
S1B_L: BEGIN_S, DS, SS1B_L, hstr, vstr, DS, END_S;
S2B_L: BEGIN_S, DS, SS2B_L, hstr, vstr, DS, END_S;
S1C_L: BEGIN_S, DS, SS1C_L, hstr, vstr, DS, END_S;
S2C_L: BEGIN_S, DS, SS2C_L, hstr, vstr, DS, END_S;
S1D_L: BEGIN_S, DS, SS1D_L, hstr, vstr, DS, END_S;
S2D_L: BEGIN_S, DS, SS2D_L, hstr, vstr, DS, END_S;

S1A_R: BEGIN_S, DS, SS1A_R, hstr, vstr, DS, END_S;
S2A_R: BEGIN_S, DS, SS2A_R, hstr, vstr, DS, END_S;
S1B_R: BEGIN_S, DS, SS1B_R, hstr, vstr, DS, END_S;
S2B_R: BEGIN_S, DS, SS2B_R, hstr, vstr, DS, END_S;
S1C_R: BEGIN_S, DS, SS1C_R, hstr, vstr, DS, END_S;
S2C_R: BEGIN_S, DS, SS2C_R, hstr, vstr, DS, END_S;
S1D_R: BEGIN_S, DS, SS1D_R, hstr, vstr, DS, END_S;
S2D_R: BEGIN_S, DS, SS2D_R, hstr, vstr, DS, END_S;

