define lattice;

intmeth= 4;

{***** System parameters *****}
Energy= 3.00;    { GeV }
dP    = 1.0d-10;
CODeps= 1.0d-14;

{***** drift space *****}
 dD1D2 :      drift, L=4.3775/5;
