 dD1BEnd2 :   drift, L=1.8775/5;
 KD1 :       drift, L=0.8930;
 KD2 :       drift, L=0.3978;
 D2B :       drift, L=0.1468;
 D3B :       drift, L=0.23185;
 D4B :       drift, L=0.45835;
 D4Ba :      drift, L=0.1730;
 D4Bb :      drift, L=0.28535;
 D5B :       drift, L=0.1965;
 D6B :       drift, L=0.6690;
 D6Ba :      drift, L=0.1850;
 D6Bb :      drift, L=0.4840;
 D1A :       drift, L=0.2347;
 D1Aa :      drift, L=0.1187;
 D1Ab :      drift, L=0.1160;
 D2A :       drift, L=0.1952;
 D3A :       drift, L=0.4218;
 D3Aa :      drift, L=0.1583;
 D3Ab :      drift, L=0.2635;
 D4A :       drift, L=0.5858;
 D4Aa :      drift, L=0.1018;
 D4Ab :      drift, L=0.4840;

 D1D2 : dD1D2, dD1D2, dD1D2, dD1D2,  dD1D2;
 D1BCentre : dD1BCentre, dD1BCentre, dD1BCentre, dD1BCentre, dD1BCentre;
 D1BEnd2 : dD1BEnd2, dD1BEnd2, dD1BEnd2, dD1BEnd2, dD1BEnd2;

{** Quadrupole **}
 Nq=32/2; {Number of slices}

{*

Q1Dh :  quadrupole, L=0.4064/2, K=-0.7035492, method=intmeth,N=Nq;
Q2Dh :  quadrupole, L=0.6063/2, K= 1.2621846, method=intmeth,N=Nq;
Q3Dh :  quadrupole, L=0.3070/2, K=-0.9868547, method=intmeth,N=Nq;
Q2ADh : quadrupole, L=0.4064/2, K=-0.9787708, method=intmeth,N=Nq;
