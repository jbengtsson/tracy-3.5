Q1Bh :  quadrupole, L=0.4064/2, K=-1.2289552, method=intmeth,N=Nq; 

 Q1D : Q1Dh, Q1Dh;
 Q2D : Q2Dh, Q2Dh;
 Q3D : Q3Dh, Q3Dh;
 Q2AD : Q2ADh, Q2ADh;
 Q1AD : Q1ADh, Q1ADh;
 Q1AB : Q1ABh, Q1ABh;
 Q2AB : Q2ABh, Q2ABh;
 Q3B : Q3Bh, Q3Bh;
 Q2B : Q2Bh, Q2Bh;
 Q1B : Q1Bh, Q1Bh;

*}

{ [27.22, 12.36] }
Q2AB : quadrupole, L=0.4064, K=-1.0331410, method=intmeth,N=Nq;
Q1D :  quadrupole, L=0.4064, K=-0.7035492, method=intmeth,N=Nq;
