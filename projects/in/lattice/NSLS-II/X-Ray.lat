{ X-ray ring lattice, PUE positions modified 10/27/93. }                  

define lattice;

Energy = 2.8;

dP = 1d-8;   COdeps = 1d-10;   dK = 1d-6;

Meth = 4; Nbend = 10; Nquad = 10; Nsext = 10;

pi = 4.0*arctan(1.0);

c0 = 2.99792458e8; Brho = 1e9*Energy/c0; m_e = 0.51099906e6;

h_rf = 30; C = 170.08;

CAV: Cavity, Frequency=c0/C*h_rf, Voltage=1.0d6, harnum=h_rf;

{ James optics, tune adjusted to: (9.83, 5.71) }
{QB: Quadrupole, L=0.8000, K= 1.3769, N=Nquad, Method=Meth;}
