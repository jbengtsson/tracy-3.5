define lattice; ringtype = 1;

Energy = 3.0;

dP = 1e-8; CODeps = 1e-14;

Meth = 4; Nbend = 25; Nquad = 1;

pi = 4.0*arctan(1.0);

c0 = 2.99792458e8; h_rf = 1320; C = 10.1586800; Brho = 1e9*Energy/c0;

CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 5.00e6/2, Harnum = h_rf;

Lb = 1.0; phib = 3.0;

D1: Drift, L = 0.374762*Lb;

D2: Drift, L = 0.182094;
D3: Drift, L = 0.655956;
D4: Drift, L = 2.5;

BH: Bending, L = Lb/2.0, K = 0.0, T = phib/2.0, T1 = 0.0, T2 = 0.0,
    N = Nbend, Method = Meth;

QF: Quadrupole, L = 0.0, K =  1.84912/Lb, N = Nquad, Method = Meth;
QD: Quadrupole, L = 0.0, K = -1.05/Lb   , N = Nquad, Method = Meth;

QD1: Quadrupole, L = 0.0, K = -1.77209, N = Nquad, Method = Meth;
QF1: Quadrupole, L = 0.0, K =  1.27555, N = Nquad, Method = Meth;

HUCELL: QD, BH, QF, D1;

FUCELL: INV(HUCELL), HUCELL;

IFUCELL: HUCELL, INV(HUCELL);

HMCELL: D1, QF, BH, D2, QD1, D3, QF1, D4;

HCELL: FUCELL, HMCELL;

FCELL: INV(HCELL), HCELL;

LINE: FUCELL, CAV;

{LINE: IFUCELL, CAV;}

{LINE:  INV(HMCELL), FUCELL, HMCELL, CAV;}

{LINE:  1*FCELL, CAV;}

CELL: LINE, SYMMETRY = 1;

END;
