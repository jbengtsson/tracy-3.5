!-- This job should be run with madX
!   July 13, 2012 
setplot,ascale=1,lscale=1.5,sscale=3,rscale=1.5,xsize=28,ysize=20, 
        post=1,font=-4,lwidth=5;
setplot,ascale=2,lscale=2,sscale=1.5,rscale=2,xsize=28,ysize=16, 
        post=1,font=-4,lwidth=10;

!-- Define lattice for the FEL ARC
title,"FEL amplifier";

// ------Electrons  at 1 GeV energy, 

 beam, mass = 510.998918e-06, charge = 1, gamma = 1956.95130611, exn = 20.0e-06, eyn = 20.0e-06, sige = 0.001;

 BRHO=3.33564051648;

! dipole lengths:
	BL   = 1.2000;
	QL   = 0.3800;
        QL0  = 0.3800;
	QLD  = 0.3500;
	QLF  = 0.3800;

	NCEL = 20.0;
	NDIP = 7.0*NCEL;
	ANG  = 2.0*PI/NDIP;
	ANGB2  = ANG/2.0;
	BY2  = ANG*BRHO/BL;
 
	LBH2 = BL/2.0;


	QLH  = QLF/2.0;
	QLDH = QLD/2.0;
	QLFH = QLF/2.0;
	BL2  = BL/2.0; 


	!   quad lengths:


	KSF0 = -1.9779533;
	KSD0 = 31.298327;
	KSX1 = 0.0;
	KSV2 = 0.0;
         

	SEXH :SEXTUPOLE, l=0.000000001D0,k2=KSF0;
	SEXV :SEXTUPOLE, l=0.000000001D0,k2=KSD0;
	SEX1 :SEXTUPOLE, l=0.000000001D0,k2=KSX1;
	SEV2 :SEXTUPOLE, l=0.000000001D0,k2=KSV2;

	GF0  = 6.264948739604;
        GD0  = -5.110899380489;
	KF0  = GF0/BRHO;
	KD0  = GD0/BRHO;


 
 ! FODO CELL:

! DRIFTS:
	O   : DRIFT, l=0.075;
	OO  : DRIFT, l=0.075;
	OOO : DRIFT, l=1.000;
!DIPOLE
	B2   : SBEND, l=BL,angle=ANG;
	B2H  : SBEND, l=BL2,angle=ANGB2;
!FODO QUADS
	QF  :QUADRUPOLE, l=QL,k1=KF0;
	QF2  :QUADRUPOLE, l=QLFH,k1=KF0;
	QD2  :QUADRUPOLE, l=QLDH,k1=KD0;
!FODO CELL
	BNHC   : line=(QD2,O,B2,O,QF2);
	ANHC   : line=(QF2,O,B2,O,QD2);
	CEL    : line=(BNHC,ANHC);

! Gradients, drift lengths, and quad lengths for the dispersion switch cell:
	GF3    =  5.0653576;
	GD3    = -4.0970890;
	OFFW   =  0.57500194;
	O1     =  0.28839503;
	O2     =  0.40612007;

	QLF3   =  0.300;
	QLD3   =  0.220;
!DRIFTS
	OFW  : DRIFT, l=OFFW;
	O1F  : DRIFT, l=O1;
	O2F  : DRIFT, l=O2;

	KF3  = GF3/BRHO;
	KD3  = GD3/BRHO;
!QUADS
	QF3  :QUADRUPOLE, l=QLF3,k1=KF3;
	QD3  :QUADRUPOLE, l=QLD3,k1=KD3;


!  FUNDAMENTAL BLOCK:


		NC0  : line=(SEXV,QD2,O,B2,O,QF2,SEXH,QF2,O,B2,O,QD2,SEXV,QD2,O,B2);
		NC1  : line=(-NC0);
		SNSA : line=(OFW,QF3,SEX1,QF3,O1F,QD3,QD3,O2F,SEXV, B2H);
		SNSB : line=(SNSA,B2H SEXV,O2F,QD3,QD3,O1F,QF3,SEX1,QF3,OFW);

		BLOCK: line=(NC0,SNSB,NC1);
		FEL  : line= (20(BLOCK));
!*************************************************************************************
use,period=FEL;
survey,file="FEL.survey";
select,flag=twiss,column=name,s,betx,alfx,mux,dx,dpx,x,px,bety,alfy,muy,dy,dpy,y,py,t,pt;
system,"rm FEL-July13-2012.lis";
system,"rm ps2-february20_ptc.lis";
twiss,table,file="FEL-July13-2012-twiss.lis";
plot,file="FFEL-July13-2012",haxis=s,vaxis1=rbetx,rbety,vaxis2=dx,colour=100,interpolate,noversion;
system,"del tmp.lis";
twiss,table,deltap=0.0010:-0.0010:-0.0005,file="tmp.lis";
system,"type tmp.lis >> FEL-July13-twiss.lis";
system,"del summ.lis";
write,table=summ,file="FEL-July13-2012_twiss.lis";
plot,table=summ,haxis=deltap,vaxis=q1,q2,colour=100,interpolate,noversion;
plot,table=summ,haxis=deltap,vaxis1=betxmax,betymax,vaxis2=dxmax,colour=100,
interpolate,noversion;
plot,table=summ,haxis=deltap,vaxis=xcomax,colour=100,interpolate,noversion;

!-- Use twiss to get tables for all values of dpp
stop

!-- Use ptc_twiss
ptc_create_universe; 
ptc_create_layout,model=2,method=6,nst=30,exact; 
select,flag=ptc_twiss,column=name,s,beta11,alfa11,mu1,disp1,
beta22,alfa22,mu2,disp2,x,px,y,py,t,pt; 
ptc_twiss,closed_orbit,icase=5,file="ps2-february20_ptc.lis"; 
ptc_end;
dpp=+0.0050;
while(dpp >= -0.0050)
{
system,"del ptc.lis";
ptc_create_universe; 
ptc_create_layout,model=2,method=6,nst=30,exact; 
select,flag=ptc_twiss,column=name,s,beta11,alfa11,mu1,disp1,
 beta22,alfa12,mu2,disp2,x,px,y,py,t,pt; 
ptc_twiss,closed_orbit,icase=5,deltap=dpp,file="ptc.lis"; 
ptc_end;
system,"type ptc.lis >> ps2-february20_ptc.lis"; 
dpp=dpp-0.0010;
}

!-- Compute fields and gradients
beam,particle=proton,pc=49.991195681;
use,period=cell;
kinE:=beam->energy-beam->mass;
emu:=(beam->energy-beam->mass)*amu/beam->mass;
brho:=beam->pc*1e9/clight/beam->charge;
fieldBF:=bf->angle*brho/bf->l;
fieldBD:=bd->angle*brho/bd->l;

value,beam->energy,beam->mass,beam->charge;               
value,kinE,emu,brho;
value,fieldBF,fieldBD;
value,beam->beta,beam->gamma,beam->beta*beam->gamma;
value,brho/fieldBF,brho/fieldBD;

stop;
