define lattice;
{ New D3QA4R3S4C6x6Qfgdr 3Q,10-Sext Families Rho=25m }

Energy = 3.0; ringtype = 1;

dP = 1e-6; CODeps = 1e-16;

Meth = 4; Nbend = 4; Nquad = 4;

pi = 4.0*arctan(1.0);

BPM: Beam Position Monitor ;
HCM: Corrector, Horizontal, Method= Meth;
VCM: Corrector, Vertical, Method= Meth;
BHV: BPM, HCM, VCM ; 

D0:    Drift, L = 5.0;
D1A:   Drift, L = 0.240;
D1B:   Drift, L = 0.4 ;
D1B2:  Drift, L = 0.2 ;
D2A:   Drift, L = 0.15 ;
D2B:   Drift, L = 0.15 ;
D3A:   Drift, L = 0.15;
D3B:   Drift, L = 0.230;
D4A:   Drift, L = 0.15;
D4B:   Drift, L = 0.550;
D4B1:  Drift, L = 0.30;
D4B2:  Drift, L = 0.250;
D5:    Drift, L = 0.5500;
D51:   Drift, L = 0.3000;
D52:   Drift, L = 0.2500;
D5A:   Drift, L = 0.1500;
D6A:   Drift, L = 0.215;
D6B:   Drift, L = 0.305;
D7:    Drift, L = 0.35;
D71:   Drift, L = 0.175;
D4L:   Drift, L = 0.55;
D4L1:  Drift, L = 0.30;
D4L2:  Drift, L = 0.25;
D4:    Drift, L = 0.15;

D33A:  Drift, L = 0.2000;
D33B:  Drift, L = 0.1500;
D22A:  Drift, L = 0.400;
D22A2: Drift, L = 0.200;  
D22B:  Drift, L = 0.2000 ;  
D11A:  Drift, L = 0.3000;
D11B:  Drift, L = 0.350000;
D00:   Drift, L = 2.5000;
DSX:   Drift,  L = 0.1000;
DSD:   Drift,  L = 0.125;
DSL:   Drift,  L = 0.15;

QF2: Quadrupole, L = 0.300000, K =  1.389740, N = Nquad, Method = Meth;
QD3: Quadrupole, L = 0.300000, K = -1.016797, N = Nquad, Method = Meth;

Q1:  Quadrupole, L = 0.300000, K = -0.917086, N = Nquad, Method = Meth;
Q2:  Quadrupole, L = 0.300000, K =  1.052650, N = Nquad, Method = Meth;
Q3:  Quadrupole, L = 0.300000, K =  1.236946, N = Nquad, Method = Meth;
Q4:  Quadrupole, L = 0.300000, K = -1.260314, N = Nquad, Method = Meth;

Q44: Quadrupole, L = 0.300000, K = -1.796951, N = Nquad, Method = Meth;
Q33: Quadrupole, L = 0.400000, K =  2.271336, N = Nquad, Method = Meth;
Q22: Quadrupole, L = 0.300000, K = -0.896245, N = Nquad, Method = Meth;
Q11: Quadrupole, L = 0.300000, K =  0.000000, N = Nquad, Method = Meth;

DUQ1: Drift, L = 0.0;
DDQ1: Drift, L = 0.0;
QQ1:  DUQ1, Q1, DDQ1;
DUQ2: Drift, L = 0.0;
DDQ2: Drift, L = 0.0;
QQ2:  DUQ2, Q2, DDQ2;
DUQ3: Drift, L = 0.0;
DDQ3: Drift, L = 0.0;
QQ3:  DUQ3, Q3, DDQ3;
DUQ4: Drift, L = 0.0;
DDQ4: Drift, L = 0.0;
QQ4:  DUQ4, Q4, DDQ4;

DUQ22: Drift, L = 0.0;
DDQ22: Drift, L = 0.0;
QQ22:  DUQ22, Q22, DDQ22;
DUQ33: Drift, L = 0.0;
DDQ33: Drift, L = 0.0;
QQ33:  DUQ33, Q33, DDQ33;
DUQ44: Drift, L = 0.0;
DDQ44: Drift, L = 0.0;
QQ44:  DUQ44, Q44, DDQ44;

B1: Bending, L = 2.62, T =  6.0000,
    T1 =  3.000, T2 =  3.0000, N = Nbend, Method = Meth;

S1:  Sextupole, K =  0.000000, N = 1, Method = Meth;
S2:  Sextupole, K =  2.999846, N = 1, Method = Meth;
S3:  Sextupole, K = -0.981100, N = 1, Method = Meth;
S4:  Sextupole, K = -1.780948, N = 1, Method = Meth;
SD1: Sextupole, K =  0.303082, N = 1, Method = Meth;
SF1: Sextupole, K = -2.770214, N = 1, Method = Meth;
SF2: Sextupole, K =  4.313256, N = 1, Method = Meth;
SL1: Sextupole, K =  2.857560, N = 1, Method = Meth;
SL2: Sextupole, K = -0.726019, N = 1, Method = Meth;
SL3: Sextupole, K = -0.541424, N = 1, Method = Meth;
SL4: Sextupole, K = -2.032589, N = 1, Method = Meth;

SQ: Multipole, N = 1, Method = Meth;

MP: Marker;
SS: Marker;
LS: Marker;

GS: Multipole, N = 1, Method = Meth;
GE: Multipole, N = 1, Method = Meth;

c0 = 2.99792458e8  ; h_rf = 1300; C = 780.30 ;

CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 5.00e6, Harnum = h_rf;

Brho = 1e9*Energy/c0;

{ Note, the negative drift will mess up the integer tune }
L_U19 = 2.945;

U19D: insertion, scaling = 1, N = 10,
      file2 = "../in/lattice/u19kickmap7periods5th.txt";

{lambda_U19 = 19e-3; n_U19 = 158; B_U19 = 2.2/(0.934*1e2*lambda_U19);
L_U19 = n_U19*lambda_U19;

U19D: Wiggler, L = L_U19/2.0, lambda = lambda_U19, kx = 0.0, 
      BoBrho = B_U19/Brho, N = n_U19*4, Method = 1;}

D_U19: Drift, L = -L_U19/2.0;

U19: D_U19, U19D, D_U19;


LB: D11B, BPM, QQ22, D22A2, HCM,VCM, D22A2, 
    DSX, S2, DSX, D22B, QQ33, D33A, 
    DSX, S3, DSX, D33B, QQ44, BPM, D4, 
    DSX, S4, DSX, D4L1, HCM, VCM;

HB: QQ1, D1A, 
    DSX, SL1, DSX, D1B2, HCM, VCM, D1B2,BPM,  QQ2, D2A, 
    DSX, SL2, DSX, D2B, QQ3, D3A, 
    DSX, SL3, DSX, D3B, QQ4, BPM, D4A, 
    DSX, SL4, DSX , D4B1, HCM, VCM;

HB_SQ: QQ1, D1A, 
    DSX, SL1,DSX, D1B2, SQ, HCM, VCM, D1B2,BPM, QQ2, D2A, 
    DSX, SL2, DSX, D2B, QQ3, D3A, 
    DSX, SL3, DSX, D3B, QQ4, BPM, D4A, 
    DSX, SL4, DSX , D4B1, HCM, VCM;

DISP: VCM, HCM, D51, DSD, SD1, DSD, 
      D5A,BPM,  QD3, D6A, DSD, SF1, DSD, D6B, QF2; 

DISP_SQ: VCM, HCM,SQ,  D51, DSD, SD1, DSD, 
         D5A,BPM,  QD3, D6A, DSD, SF1, DSD, D6B, QF2; 

DBA: B1, D52, GS, DISP,D7, DSL, SF2, MP, DSL, D71, D71, INV(DISP), GE, 
     D52, B1;

DBA_SQ: B1, D52, GS, DISP_SQ,D7, DSL, SF2, MP, DSL, D71, D71, INV(DISP), GE, 
        D52, B1;

LINE: LS, D0, GS, HB_SQ, GE, D4B2, DBA_SQ, D4L2, GS, INV(LB), GE, D00, 
      SS, D00, GS, LB, GE, D4L2, DBA, D4B2, GS, INV(HB), GE, D0;

LINE_U19: LS, D0, GS, HB_SQ, GE, D4B2, DBA_SQ, D4L2, GS, INV(LB), GE, D00, 
          U19, D00, GS, LB, GE, D4L2, DBA, D4B2, GS, INV(HB), GE, D0;


RING: 1*LINE, CAV;

{RING: 14*LINE, LINE_U19, CAV;}

CELL: RING, SYMMETRY  = 1;

END;
