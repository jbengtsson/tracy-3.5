{ TITLE "ring20n-20080222" }

define lattice; ringtype = 1;

Energy = 3.0;

{making dP smaller speeds up runtime}
dP = 1e-6; CODeps = 1e-14;

Meth = 4; Nbend = 4; Nquad = 4; Nsext = 4; Ncorr = 1;
{Meth = 4; Nbend = 10; Nquad = 10; Nsext = 10; Ncorr = 1;}

pi = 4.0*arctan(1.0);
c0 = 2.99792458e8;
Brho = 1e9*Energy/c0;


STR0500:   DRIFT, L= 5.0000000000E-01;
STRx403:   DRIFT, L= 4.0311000000E-01;
STR0302:   DRIFT, L= 3.0200000000E-01;
STRx263:   DRIFT, L= 2.6268000000E-01;
STR0100:   DRIFT, L= 1.0000000000E-01;
STR0075:   DRIFT, L= 7.5000000000E-02;
STR0050:   DRIFT, L= 5.0000000000E-02;
STR0025:   DRIFT, L= 2.5000000000E-02;
STR0010:   DRIFT, L= 1.0000000000E-02;
STR0006:   DRIFT, L= 6.0000000000E-03;


{ Beam Position Monitors }
HVPU_DH : Drift, L = 5.0e-2/2.0;
BPM: Beam Position Monitor;
HVPU: HVPU_DH, BPM, HVPU_DH;

{ Horizontal and vertical corrector }
HVCORR_DH: Drift, L=0.0/4.0;
CORRH: Corrector, Horizontal, Method= Meth;
CORRV: Corrector, Vertical, Method= Meth;
HVCORR: HVCORR_DH, CORRH, 2*HVCORR_DH, CORRV, HVCORR_DH;


{T3 and OPA quad/sext strengths are normalized}
{m->m/2 for MAD8->T3}
{m->m/2 for MAD8->OPA}

DISPscale=1.0;QDmaster = 1.0;QFscale = 1.0;QDscale = 1.0;WQDscale = 1.0;WQFscale = 1.0;
{original OPA values}
QDmaster = -1.001268/Brho;
{for disp-free straights}
DISPscale = 1.003;
{for 42.20/14.28 in bare RING}
QFscale = 0.999066174;QDscale = 1.000586382;


D0:   BENDING, L= 3.6189000000E-01, T= 1.08567,
      K=8.6837*QDmaster*QDscale, T1= 0.0, T2= 0.0,
      N = Nbend, Method = Meth;

Df1:  BENDING, L= 5.0000000000E-02, T= 0.14994,
      K=8.6798*QDmaster*QDscale, T1= 0.0, T2= 0.0,
      N = Nbend, Method = Meth;

Df2:  BENDING, L= 5.0000000000E-02, T= 0.14969,
      K=8.6723*QDmaster*QDscale, T1= 0.0, T2= 0.0,
      N = Nbend, Method = Meth;

Df3:  BENDING, L= 5.0000000000E-02, T= 0.10783,
      K=5.9235*QDmaster*QDscale, T1= 0.0, T2= 0.0,
      N = Nbend, Method = Meth;

Df4:  BENDING, L= 5.0000000000E-02, T= 0.00535,
      K=-0.06434*QDmaster*QDscale, T1= 0.0, T2= 0.0,
      N = Nbend, Method = Meth;

Df5:  BENDING, L= 5.0000000000E-02, T= 0.00154,
      K=-0.00121*QDmaster*QDscale, T1= 0.0, T2= 0.0,
      N = Nbend, Method = Meth;

Dm6:  BENDING, L= 5.0000000000E-02, T= 0.00406,
      K=0.006906*QDmaster*QDscale, T1= 0.0, T2= 0.0,
      N = Nbend, Method = Meth;

Dm5:  BENDING, L= 5.0000000000E-02, T= 0.05375,
      K=0.288127*QDmaster*QDscale, T1= 0.0, T2= 0.0,
      N = Nbend, Method = Meth;

Dm4:  BENDING, L= 5.0000000000E-02, T= 0.07342,
      K=4.177838*QDmaster*QDscale, T1= 0.0, T2= 0.0,
      N = Nbend, Method = Meth;

Dm3:  BENDING, L= 5.0000000000E-02, T= 0.07620,
      K=4.234645*QDmaster*QDscale, T1= 0.0, T2= 0.0,
      N = Nbend, Method = Meth;

Dm2:  BENDING, L= 5.0000000000E-02, T= 0.11612,
      K=6.076819*QDmaster*QDscale, T1= 0.0, T2= 0.0,
      N = Nbend, Method = Meth;

Dm1:  BENDING, L= 5.0000000000E-02, T= 0.14196,
      K=8.6805*QDmaster*QDscale, T1= 0.0, T2= 0.0,
      N = Nbend, Method = Meth;

Dm0:  BENDING, L= 2.0432000000E-01, T= 0.61300,
      K=8.6837*QDmaster*QDscale, T1= 0.0, T2= 0.0,
      N = Nbend, Method = Meth;

DIP:  Df5, Df4, Df3, Df2, Df1, D0;
DIPm: Dm6, Dm5, Dm4, Dm3, Dm2, Dm1, Dm0, Df1, Df2, Df3, Df4, Df5;


QF:     QUADRUPOLE, L= 1.5000000000E-01, K= 4.037809*QFscale,
        N = Nquad, Method = Meth;

QFm:    QUADRUPOLE, L= 1.5000000000E-01, K= 3.779556*DISPscale*QFscale,
        N = Nquad, Method = Meth;

QFend:  QUADRUPOLE, L= 2.5000000000E-01, K= 3.533676,
        N = Nquad, Method = Meth;

QDend:  QUADRUPOLE, L= 2.5000000000E-01, K=-2.239578,
        N = Nquad, Method = Meth;


SD:     SEXTUPOLE, L= 1.0000000000E-01, K=-117.918877,
        N = Nsext, Method = Meth;

SDends: SEXTUPOLE, L= 5.0000000000E-02, K=-134.000000,
        N = Nsext, Method = Meth;

SFms:   SEXTUPOLE, L= 5.0000000000E-02, K=160.000000,
        N = Nsext, Method = Meth;

SFos:   SEXTUPOLE, L= 5.0000000000E-02, K=170.000000,
        N = Nsext, Method = Meth;

SFis:   SEXTUPOLE, L= 5.0000000000E-02, K=214.767155,
        N = Nsext, Method = Meth;

SDend:  SDends, HVCORR, SDends;
SFm:    SFms, HVCORR, SFms;
SFo:    SFos, HVCORR, SFos;
SFi:    SFis, HVCORR, SFis;

SQFm:   QFm, STR0075, SFm, HVPU, STR0025, QFm;
SQFo:   QF,  STR0075, SFo, HVPU, STR0025, QF;
SQFi:   QF,  STR0075, SFi, HVPU, STR0025, QF;


OXX:   MULTIPOLE, L = 1.0e-1, HOM=(4,-113.4464/1.0e-1,0),
       N = Nsext, Method = Meth;

OXY:   MULTIPOLE, L = 1.0e-1, HOM=(4,193.8099/1.0e-1,0),
       N = Nsext, Method = Meth;

OYY:   MULTIPOLE, L = 1.0e-1, HOM=(4,-53.9818/1.0e-1,0),
       N = Nsext, Method = Meth;


h_rf = 176; C =  528.0;
CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 1.50e6, Harnum = h_rf;


LongStr:  5*STR0500;
LongStrW: 3*STR0500;
ShortStr: 2*STR0500, STR0302;
UC1:      SQFm, STRx403, SD, STR0010, DIP, INV(DIP), STR0010, SD, STRx403;
UC2:      SQFo, STRx403, SD, STR0010, DIP, INV(DIP), STR0010, SD, STRx403;
UC3:      SQFi, STRx403, SD, STR0010, DIP, INV(DIP), STR0010, SD, STRx403;
UC4:      SQFi, STRx403, SD, STR0010, DIP, INV(DIP), STR0010, SD, STRx403;
UC5:      SQFo, STRx403, SD, STR0010, DIP, INV(DIP), STR0010, SD, STRx403, SQFm;
MC:       HVPU, OXX, STR0025, QFend, STR0025, OXY, STR0100, QDend,
          STR0006, DIPm, OYY, STRx263, SDend;

UCELL:    HVCORR, SFos,
          HVPU, STR0025, QF,
	  STRx403, SD, STR0010, DIP, INV(DIP), STR0010, SD, STRx403,
          QF,  STR0075, SFis, HVCORR;

LINE:     LongStr, MC, ShortStr, UC1, UC2, UC3, UC4, UC5,
          INV(ShortStr), INV(MC), INV(LongStr);

{LINE:     UCELL;}

{RING: LINE, CAV;}
{RING: LINESw, CAV;}
RING: 20*LINE, CAV;

CELL: RING, SYMMETRY = 1;

END;
