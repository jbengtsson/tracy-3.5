Q4: Quadrupole, L = 0.300000, K = -0.971945, N = Nquad, Method = Meth;

B1: Bending, L = 2.62, T =  6.0000,
    T1 =  3.000, T2 =  3.0000, N = Nbend, Method = Meth;


{S1: Sextupole, K =  0.000487, N = 1, Method = Meth;
S2: Sextupole, K =  3.499769, N = 1, Method = Meth;
S3: Sextupole, K =  -2.524475, N = 1, Method = Meth;
S4: Sextupole, K = -0.532215, N = 1, Method = Meth;
SD1: Sextupole, K = -0.635643, N = 1, Method = Meth;
