CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 5.00e6, Harnum = h_rf;

LB: D11B, BPM, QQ22, D22A2, HCM,VCM, D22A2, 
    DSX, S2, DSX, D22B, QQ33, D33A, 
    DSX, S3, DSX, D33B, QQ44, BPM, D4, 
    DSX, S4, DSX, D4L1, HCM, VCM;

HB: QQ1, D1A, 
    DSX, SL1, DSX, D1B2, HCM, VCM, D1B2,BPM,  QQ2, D2A, 
    DSX, SL2, DSX, D2B, QQ3, D3A, 
    DSX, SL3, DSX, D3B, QQ4, BPM, D4A, 
    DSX, SL4, DSX , D4B1, HCM, VCM;

HB_SQ: QQ1, D1A, 
    DSX, SL1,DSX, D1B2, SQ, HCM, VCM, D1B2,BPM,  QQ2, D2A, 
    DSX, SL2, DSX, D2B, QQ3, D3A, 
    DSX, SL3, DSX, D3B, QQ4, BPM, D4A, 
    DSX, SL4, DSX , D4B1, HCM, VCM;

