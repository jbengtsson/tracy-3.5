Q11: Quadrupole, L = 0.300000, K =  0.000000,   N = Nquad, Method = Meth;

DUQ1: Drift, L = 0.0;
DDQ1: Drift, L = 0.0;
QQ1:  DUQ1, Q1, DDQ1;
DUQ2: Drift, L = 0.0;
