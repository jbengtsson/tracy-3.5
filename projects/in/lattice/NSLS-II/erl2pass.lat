{ New DBA30HLC16Es2rng7x7s.opa H(8m) L(5m)Rho = 25m }

define lattice; ringtype = 1;

Energy = 5e-3; { GeV }

dP = 1e-7; CODeps = 1e-14;  
  
Meth = 4; Nbend = 4; Nquad = 4; Nsol = 10;
  
pi = 4.0*arctan(1.0);  

c0 = 2.99792458e8; Brho = 1e9*Energy/c0;
  
{ =========== parameters = }
KQ1 =  2.7e+01;
KQ2 = -2.024544E+01; 
KQ3 =  2.170359E+01; 

KQM1 = -7.561273E+00;
KQM2 =  1.077235E+01;
KQM3 = -7.687403E+00;
KQM4 =  9.953484E+00;

KQM5 = KQM4;
KQM6 = KQM3;
KQM7 = KQM2;
KQM8 = KQM1;

KQ11 =  1.918820E+01; 
KQ12 = -1.437320E+01;    
KQ13 =  8.747422E+00;   
KQ14 = -7.981809E+00;
KQ15 =  1.248077E+01;

kq2_1 =  18; 
KQ2_2 = -3.046624E+01; 
KQ2_3 =  2.589606E+01;    
KQ2_4 =  2.617295E+01;    
KQ2_5 = -2.770166E+01;
Kq2_6 =  kq2_4;
 
{ ??? }
{KQ2_11 =  1.384717E+01;
KQ2_12 = -1.548660E+01;
KQ2_13 =  1.444575E+01;
KQ2_14 = -1.428051E+01;}

KQ2_11 =  1.384717E+01;
KQ2_12 = -1.548660E+01; 
KQ2_13 =  1.444575E+01; 
KQ2_14 = -1.428051E+01;

{ ========== Dipoles ============================ }
R1 = 0.2; {m}
R2 = 0.2; {m}
R3 = 0.2; {m}

E1 = Energy;
E2 = E1+25e-3; {GeV}

{Angle in bending magnet in the first pass (deg)}
alpha1 = 60.0;
{Angle in bending magnet the second pass(deg)}
alpha2 = 60.0;
{Angle in bending magnet in the first pass (deg)}
alpha3 = 180.0-alpha1*E1/E2-2*alpha2;

{ at energy E1 }
BM1: BENDING, L = R1*alpha1*pi/180.0, T = alpha1, T1 = alpha1/4, T2 = alpha1/4,
     N = Nbend, Method = Meth;
{ at energy E2 }
BM2: BENDING, L = R2*alpha2*pi/180.0, T = alpha2, T1 = alpha2/4, T2 = alpha2/4,
     N = Nbend, Method = Meth;
{ at energy E2 }
BM3: BENDING, L = R3*alpha3*pi/180.0, T = alpha3, T1 = alpha3/4, T2 = alpha3/4,
     N = Nbend, Method = Meth;

{ ========== Quadrupoles ====================}
L_Q = 0.15; 

{ ----------------------------First pass---------------------------------- }
{first pass arcs quadrupole }
Q1_1: QUADRUPOLE, L = L_Q, K = KQ1, N = Nquad, Method = Meth;
{first pass arcs quadrupole }
Q1_2: QUADRUPOLE, L = L_Q, K = KQ2, N = Nquad, Method = Meth;
{first pass arcs quadrupole }
Q1_3: QUADRUPOLE, L = L_Q, K = KQ3, N = Nquad, Method = Meth;

Q1_11: QUADRUPOLE, L = L_Q,   K = KQ11, N = Nquad, Method = Meth;
Q1_12: QUADRUPOLE, L = L_Q,   K = KQ12, N = Nquad, Method = Meth;
Q1_13: QUADRUPOLE, L = L_Q,   K = KQ13, N = Nquad, Method = Meth;
Q1_14: QUADRUPOLE, L = L_Q,   K = KQ14, N = Nquad, Method = Meth;
Q1_15: QUADRUPOLE, L = L_Q/2, K = KQ15, N = Nquad, Method = Meth;

{ ----------------------------Common section--------------------------------- }
{matching section after linac quadrupole}
Qm1: QUADRUPOLE, L = L_Q, K = KQm1, N = Nquad, Method = Meth;
{matching section after linac quadrupole}
Qm2: QUADRUPOLE, L = L_Q, K = KQm2, N = Nquad, Method = Meth;
{matching section after linac quadrupole}
Qm3: QUADRUPOLE, L = L_Q, K = KQm3, N = Nquad, Method = Meth;
{matching section after linac quadrupole}
Qm4: QUADRUPOLE, L = L_Q, K = KQm4, N = Nquad, Method = Meth;

{matching section before linac quadrupole}
Qm5: QUADRUPOLE, L = L_Q, K = KQm5, N = Nquad, Method = Meth;
{matching section before linac quadrupole}
Qm6: QUADRUPOLE, L = L_Q, K = KQm6, N = Nquad, Method = Meth;
{matching section before linac quadrupole}
Qm7: QUADRUPOLE, L = L_Q, K = KQm7, N = Nquad, Method = Meth;
{matching section before linac quadrupole}
Qm8: QUADRUPOLE, L = L_Q, K = KQm8, N = Nquad, Method = Meth;

{ ----------------------------Second pass---------------------------------- }
{second pass arcs quadrupole }
Q2_1: QUADRUPOLE, L = L_Q, K = KQ2_1, N = Nquad, Method = Meth;
{second pass arcs quadrupole }
Q2_2: QUADRUPOLE, L = L_Q, K = KQ2_2, N = Nquad, Method = Meth;
{second pass arcs quadrupole }
Q2_3: QUADRUPOLE, L = L_Q, K = KQ2_3, N = Nquad, Method = Meth;
{second pass arcs quadrupole }
Q2_4: QUADRUPOLE, L = L_Q, K = KQ2_3, N = Nquad, Method = Meth;
{second pass arcs quadrupole }
Q2_5: QUADRUPOLE, L = L_Q, K = KQ2_3, N = Nquad, Method = Meth;
{second pass arcs quadrupole }
Q2_6: QUADRUPOLE, L = L_Q, K = KQ2_3, N = Nquad, Method = Meth;

KQ21 =  1.384717E+01;
KQ22 = -1.548660E+01; 
KQ23 =  1.444575E+01; 
KQ24 = -1.428051E+01;

Q2_11: QUADRUPOLE, L = L_Q, K = KQ21, N = Nquad, Method = Meth;
Q2_12: QUADRUPOLE, L = L_Q, K = KQ22, N = Nquad, Method = Meth;
Q2_13: QUADRUPOLE, L = L_Q, K = KQ23, N = Nquad, Method = Meth;
Q2_14: QUADRUPOLE, L = L_Q, K = KQ24, N = Nquad, Method = Meth;


{ ============ Drifts ===================== }
Lstr1 = 0.1*40+0.008;
D0:    DRIFT, L = 0.05;
D1:    DRIFT, L = 0.1;
D1fit: DRIFT, L = Lstr1/40;

Lstr2 = 62*0.1-0.25+0.018;
Ladj2 = 0.1*16+0.035;
D2:    DRIFT, L = Lstr2/62;
D3:    DRIFT, L = Ladj2/16;
{ ??? }
{D2fit: DRIFT, L = Ladj/16;}
D2fit: DRIFT, L = Ladj2/16;

Dm0: DRIFT, L = 0.5;
Dm1: DRIFT, L = 0.1;
Dm2: DRIFT, L = 0.15-0.1;
Dm3: DRIFT, L = 0.30-0.00;
Dm4: DRIFT, L = 0.289+0.15+0.1;
Dm5: DRIFT, L = 0.322;
Dm6: DRIFT, L = 1.803; {1.111}
DM7: Drift, L = 1.80;  {1.1575}

Dstr1: DRIFT, L = 0.1;
Dstr2: DRIFT, L = 4.35-4.5*L_Q-16*0.1;
{ ========================= Solenoids =================== }
KS1 = 1;
S1: solenoid, L = 0.2,  BoBrho = 0.0, N = Nsol;
S2: solenoid, L = 0.2,  BoBrho = 0.0, N = Nsol;
S3: solenoid, L = 0.2,  BoBrho = 0.0, N = Nsol;
S4: solenoid, L = 0.2,  BoBrho = 0.0, N = Nsol;
dS: solenoid, L = 0.05, BoBrho = 0.0, N = Nsol;

Spr: spreader;
Rec: recombiner;

start: marker;
LS1:   marker;
LE1:   marker;
LS2:   marker;
LE2:   marker;
exit:  marker;

{ ========================= RF Cavity ========================== }
Dcav:  Drift, L = 1.48;
CAV: Cavity, Frequency = 703e6, Voltage = 20e6, phi = 0.0, Harnum = 0;  
Linac: Dcav, CAV;
{ ======================= loop1 ================================== }
{ loop1 starts from the spreader exit, goes throug the first pass arcs and
  ends at the recombiner entrance                                             }

Arc1_1: 3*(D1), Q1_1, 2*(D1), Q1_2, 2*(D1), Q1_3, 3*(D1), BM1, 3*(D1), Q1_3,
        2*(D1), Q1_2, 2*(D1), Q1_1, 3*(D1), BM1;
Arc1_2: BM1, 3*(D1), Q1_1, 2*(D1), Q1_2, 2*(D1), Q1_3, 3*(D1), BM1, 3*(D1), 
        Q1_3, 2*(D1), Q1_2, 2*(D1), Q1_1, 3*(D1);
{ ??? }
{Line1:  4*(D1fit), Q1_11, 4*(D1), Q12, 4*(D1), Q1_13, 16*(D1fit), Q1_14,
         4*(D1), Q1_15;}
Line1:  4*(D1fit), Q1_11, 4*(D1), Q1_12, 4*(D1), Q1_13, 16*(D1fit), Q1_14,
        4*(D1), Q1_15;

Loop1: Arc1_1, Line1, inv(Line1), Arc1_2;

{ ===================== Common part ============================== }
{ Common part includes: recombiner- matching quadrupoles Qm5, Qm6, Qm7, 
  Qm8 - Linac - matching quadrupoles Qm1, Qm2, Qm3, Qm4 - spreader            }

match1: Ds, S1, Ds, S2, Dm1, s3, dS, s4, Dm2, Qm1, Dm3, Qm2, Dm3, Qm3, Dm3,
        Qm4, Dm4;
match2: Ds, S1, Ds, S2, Dm1, s3, dS, s4, Dm2, Qm8, Dm3, Qm7, Dm3, Qm6, Dm3,
        Qm5, Dm4;

CLine: BM1, inv(match2), linac, match1, BM1;

{ ======================= loop2 ================================== }
{ loop2 starts from the exit of spreader, goes throug the second pass arcs and
   ends at the entrance of recombiner                                         }

Cell1:   BM3, 4*(D1), D0, Q2_1, D1, D0, Q2_2, D1, D0, Q2_3, D0, 4*(D1), BM2;

Cell2:   BM2, 4*(D1), D0, Q2_3, D1, D0, Q2_2, D1, D0, Q2_1, D0, 4*(D1), BM3;

Line2_0: D2Fit, 3*(D3), D0, Q2_4, D1, D0, Q2_5, D1, D0, Q2_6, D0, 4*(D3);

Arc2_1:  4*(D1), D0, Q2_1, D1, D0, Q2_2, D1, D0, Q2_3, D0, 4*(D1), BM2,
         line2_0, cell2;

Arc2_2:  Cell1, inv(Line2_0), BM2, 4*(D1), D0, Q2_3, D1, D0, Q2_2, D1, D0,
         Q2_1, D0, 4*(D1);

Line2:   8*(D2), Q2_11, 3*(D0), Q2_12, 15*(D2), Q2_13, 3*(D0), Q2_14, 8*(D2);

Loop2:   Arc2_1, Line2, inv(line2), Arc2_2;

{ ======================= ERL  30MeV- 55 MeV - 30 MeV =========== }

{ ERL is a sequences of the sections is: Loop1-> CLine->Loop2->CLine->Loop1 }

ERL_sections: Start, Rec, CLine, Spr, LS1, Loop1, LE1, LS2, Loop2, LE2;

CELL: ERL_sections, SYMMETRY = 1;

end;
