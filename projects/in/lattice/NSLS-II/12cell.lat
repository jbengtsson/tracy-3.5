{ TITLE "ring12n" }

define lattice; ringtype = 1;

Energy = 3.0;

dP = 1e-8; CODeps = 1e-14;

Meth = 4; Nbend = 10; Nquad = 10; Nsext = 10;

pi = 4.0*arctan(1.0);

SS0_5M:   DRIFT, L = 5.0000000000E-01;
SS1M:     DRIFT, L = 1.0000000000E+00;
SS0_3:    DRIFT, L = 3.0000000000E-01;
SSMATCH2: DRIFT, L = 1.5000000000E+00;
SHORTSTR: DRIFT, L = 5.0000000000E-01;
SS100:    DRIFT, L = 1.0000000000E-01;
SSMATCH1: DRIFT, L = 4.8280222400E-01;

QFEND: QUADRUPOLE, L= 2.0000000000E-01, K= 4.0000000000E+00,
       N = Nquad, Method = Meth;
QDEND: QUADRUPOLE, L= 2.0000000000E-01, K=-2.5000000000E+00,
       N = Nquad, Method = Meth;

QFMATCH:      BENDING, L= 1.2700333334E-01, K= 4.0767849591E+00,
              N = Nbend, Method = Meth,
              HOM = (3, 7.1000000000E+01/2.0, 0.0);

QF:           BENDING, L= 1.5000000000E-01, K= 3.9384932470E+00,
              N = Nbend, Method = Meth,
              HOM = (3, 7.1782994526E+01/2.0, 0.0);

SOFTENDMATCH: BENDING, L= 1.5000000000E-01, T= 7.0000000000E-03*180.0/pi,
              K=-4.3000000000E-01, N = Nbend, Method = Meth;
DIPMATCH:     BENDING, L= 4.0000000000E-01, T= 3.6633200000E-02,
              K=-8.5442500000E-01, N = Nbend, Method = Meth;
SOFTEND:      BENDING, L= 1.5000000000E-01, T= 7.0000000000E-03*180.0/pi,
              K=-4.3000000000E-01, N = Nbend, Method = Meth;
DIP:          BENDING, L= 4.0000000000E-01, T= 3.6633200000E-02*180.0/pi,
              K=-8.5814808600E-01, N = Nbend, Method = Meth;

DS: SEXTUPOLE, L= 1.0000000000E-01, K=-1.4489926377E+02/2.0,
    N = Nsext, Method = Meth;


BM: SOFTENDMATCH, DIPMATCH;
MS: SS0_5M, SS1M, SS1M, QFEND, SS0_3, QDEND, SS0_3, BM,
    SSMATCH1, DS, SSMATCH2,
    QFMATCH, QFMATCH;
B:  SOFTEND, 2*DIP, SOFTEND;
BS: SHORTSTR, DS, SS100, B, SS100, DS, SHORTSTR;
UC: QF, BS, QF;

c0 = 2.99792458e8; h_rf = 1000; C = 200.0;
CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 5.00e6, Harnum = h_rf;

ring: MS, BS, QF, 3*UC, QF, BS, INV(MS), CAV;

CELL: RING, SYMMETRY  = 1;

END;
