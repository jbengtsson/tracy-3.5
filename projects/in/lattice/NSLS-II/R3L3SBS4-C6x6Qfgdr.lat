SQ: Multipole, N = 1, Method = Meth;

MP: Marker;
SS: Marker;
LS: Marker;
GS: Multipole, N = 1, Method = Meth;
GE: Multipole, N = 1, Method = Meth;

c0 = 2.99792458e8; h_rf = 1300; C = 791.958; Brho = 1e9*Energy/c0;

CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 5.00e6, Harnum = h_rf;

{ Damping Wigglers }
lambda_DW = 8e-2; n_DW = 88; L_DW = n_DW*lambda_DW; B_DW = 1.81246;

DW_80: Wiggler, L = L_DW, lambda = lambda_DW, kxV = 0*5.0341,
       BoBrhoV = B_DW/Brho, N = n_DW*5, Method = 1{,
       harm = (3,  1.9917,  0.044716/Brho*1, 0, 0, 0,
               5,  1.0064, -0.060881/Brho*1, 0, 0, 0,
               7,  1.0000, -0.007070/Brho*1, 0, 0, 0,
               9,  0.9996,  0.004144/Brho*1, 0, 0, 0)};

{L_DW = 7.02;
DW_90: insertion, scaling = 1.0, N = 50,
       file2 = "/home/bengtsson/projects/in/lattice/w90v5_7m_5th.txt";}

D_DW: Drift, L = -L_DW/2.0;
DW:   D_DW, DW_80, D_DW;

L_U19 = 2.983;
U19: insertion, scaling = 1.0, N = 50,
     file2 = "/home/bengtsson/projects/in/lattice/U19_3m_5th.txt";

D_U19:  Drift, L = -L_U19/2.0;
ID_U19: D_U19, U19, D_U19;

L_U52 = 3.952;
{ linear mode }
{U52: insertion, scaling = 1.0, N = 50,
     file2 = "/home/bengtsson/projects/in/lattice/u52gap10mmph0mm5th.txt";}
{ linear helical mode }
U52: insertion, scaling = 1.0, N = 50,
     file2 = "/home/bengtsson/projects/in/lattice/u52gap10mmph27mm5th.txt";

D_U52:  Drift, L = -L_U52/2.0;
ID_U52: D_U52, U52, D_U52;

LB: DSX,S1,DSX, D11A, BPM,Q11,D22A2,HCM,VCM,D22A2, DSX,S2,DSX, D22B,
    Q22, D33A, DSX,S3,DSX, D33B, Q33, BPM, 
    D44B2, HCM,VCM;

HB: DSX,SL1,DSX, D0A, BPM, Q1, D1A2,HCM,VCM,D1A2, DSX,SL2,DSX, D1B,
    Q2, D3A, DSX,SL3,DSX, D3B, Q3, BPM, D4A,
    DSX,SL4,DSX, D4B1,HCM,VCM;

HB_SQ: DSX,SL1,DSX, D0A, BPM, Q1, D1A2,HCM,VCM,SQ,D1A2,DSX,SL2,DSX,D1B,
       Q2, D3A, DSX,SL3,DSX, D3B, Q3, BPM, D4A,
       DSX,SL4,DSX, D4B1,HCM,VCM;

DISP: DHVC,VCM,HCM,   DHVC, BPM,QD1,
      D6A, DSD,SF1,DSD, D6B, QF1; 

DISP_SQ: DHVC,VCM,HCM,SQ,DHVC, BPM,QD1,
         D6A, DSD,SF1,DSD, D6B, QF1; 

DBA: B1, D5W,DPW, GS, D5C,
     DISP,D7, DSL, SF2,MP, DSL,D7, INV(DISP), 
     D5C, GE, DPW2,DPW2,D5W, B1;

DBA_SQ: B1, D5W,DPW, GS, D5C,
        DISP_SQ,D7, DSL, SF2,MP, DSL,D7, INV(DISP), 
        D5C, GE, DPW2,DPW2,D5W, B1;

LINE: D0, GS, HB_SQ, GE, D4B2, DBA_SQ, D44B2, GS, INV(LB), GE, D00, SS, 
      D00, GS, LB, GE, D44B2, DBA, D4B2, GS, INV(HB), GE, D0, LS;

LINE_CPMU: D0, GS, HB_SQ, GE, D4B2, DBA_SQ, D44B2, GS, INV(LB), GE,
           D00, SS, U19, D00,
           GS, LB, GE, D44B2, DBA, D4B2, GS, INV(HB), GE, D0, LS;


{RING: LINE, CAV;}

{ 3 DWs }
RING: LINE, DW, 4*LINE, CAV;

{ 5 DWs }
{RING: LINE, DW, 2*LINE, CAV;}

{ CPMUs }
N_CPMU = 1; N_LINE = 15 - N_CPMU;
{RING: N_CPMU*LINE, N_LINE*LINE, CAV;}

CELL: RING, SYMMETRY = 1;

END;
