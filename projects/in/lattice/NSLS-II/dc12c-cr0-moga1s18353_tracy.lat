{----- table of segments ----------------------------------------------------}

{dss    : dss0, mgp;}
bs     : bsom, bs00, bs01, bs02, bs03, bs04, bs05, bs06, bs07, bs08,
         bs09, bs10, bs11;
i_bs   : i_bs11, i_bs10, i_bs09, i_bs08, i_bs07, i_bs06, i_bs05,
         i_bs04, i_bs03, i_bs02, i_bs01, i_bs00, bsom;
bsl    : bs, lgbs;
i_bsl  : lgbs, i_bs;
bn     : bnom, bn00, bn01, bn02, bn03, bn04, bn05, bn06;
i_bn   : i_bn06, i_bn05, i_bn04, i_bn03, i_bn02, i_bn01, i_bn00, bnom;
bnl    : bn, lgbn;
i_bnl  : lgbn, i_bn;
bnsup  : lgbe, bn, lgbe;
i_bnsup: lgbe, i_bn, lgbe;
cc     : ch, cv;
sxx_m  : sxx_mh, cc, sxx_mh;
sxy_m  : sxy_mh, cc, sxy_mh;
syy_m  : syy_mh, cc, syy_mh;
hnc    : bnl, dnvb, vb, dnm1, sd, dnm2, an;
i_hnc  : i_an, dnm2, sd, dnm1, i_vb, dnvb, i_bnl;
hsc    : bsl, dbs, dnvb, vb_bs, dnm1, sd, dnm2, an_bs;
i_hsc  : i_an_bs, dnm2, sd, dnm1, i_vb_bs, dnvb, dbs, i_bsl;
mpfho  : doc, ocxx2, doc, sfh;
mpfh_  : doc, mon, doc, sfh;
mpf    : mpfh_, cc, inv(mpfho);
ncell  : inv(mpfho), i_hnc, hnc, mpfh_;
i_ncell: inv(mpfh_), i_hnc, hnc, mpfho;
ncellr : hnc, mpfh_, inv(mpfho), i_hnc;
i_ncellr: hnc, mpfho, inv(mpfh_), i_hnc;
scell  : inv(mpfho), i_hsc, hsc, mpfh_;
i_scell: inv(mpfh_), i_hsc, hsc, mpfho;
mpfx   : doc, mon, doc, sfxh, cc, sfxh, doc, ocxx, doc;
hcor   : xm, hnc, mpf, i_hnc, xo, hnc, mpf, i_hnc, xo;
i_hcor : xo, hnc, inv(mpf), i_hnc, xo, hnc, inv(mpf), i_hnc, xm;
hscor  : hsc, mpf, i_hnc, hnc, mpf, i_hnc;
i_hscor: hnc, inv(mpf), i_hnc, hnc, inv(mpf), i_hsc;
moxy_m : doc, oxy_m, doc, sxy_m, doc;
moxx_m : doc, oxx_m, doc, sxx_m, doc;
moyy_m : doc, oyy_m, doc, syy_m, doc;
dsupm  : hnc, mpfx, anm, dxm, sdx, dnm1, i_vbm, dnvb, i_bnsup;
i_dsupm: bnsup, dnvb, vbm, dnm1, sdx, dxm, i_anm, inv(mpfx), i_hnc;
matm   : moyy_m, dmon, mon, dme, qm1, dm1, dmon, mon, moxy_m, qm2,
         moxx_m, dmon, mon, dm2, qm3, dms;
tm     : dsupm, matm;
i_tm   : inv(matm), i_dsupm;
hm     : hcor, tm;
i_hm   : i_tm, i_hcor;
hsm    : hscor, tm;
i_hsm  : i_tm, i_hscor;
marc   : hm, i_hm;
i_marc : hm, i_hm;
per    : center, xs, i_hm, hm, xs, i_hsm, hsm, xs, i_hm, hm, xs, i_hm, hm;
i_per  : i_hm, hm, xs, i_hm, hm, xs, i_hsm, hsm, xs, i_hm, hm, xs, center;
arcn   : center, xs, i_hm, hm;
i_arcn : i_hm, hm, xs, center;

{ring   : 12*arcn, cav;}
ring   : 1*arcn, cav;

i_ring : 12*i_arcn, cav;

cell: ring, symmetry=1;

end;