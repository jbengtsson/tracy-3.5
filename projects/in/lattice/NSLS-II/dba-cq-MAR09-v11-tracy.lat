D7H:  Drift, L=0.19818557;  
  
  
QD3: Quadrupole, L = 0.3, K= -1.198228454249498, N = Nquad, Method = Meth;  
QF2: Quadrupole, L = 0.3, K=  1.720465896846606, N = Nquad, Method = Meth;  
  
Q1:  Quadrupole, L = 0.3, K= -0.814208396280907,  N = Nquad, Method = Meth;  
Q2:  Quadrupole, L = 0.3, K=  0.859984872357432,  N = Nquad, Method = Meth;  
Q3:  Quadrupole, L = 0.3, K=  1.442454465506598,  N = Nquad, Method = Meth;  
Q4:  Quadrupole, L = 0.3, K= -1.312658875379822,  N = Nquad, Method = Meth;  
  
Q22: Quadrupole, L = 0.3, K = -1.801462413555000, N = Nquad, Method = Meth;  
Q33: Quadrupole, L = 0.4, K =  2.515966716214825, N = Nquad, Method = Meth;  
Q44: Quadrupole, L = 0.3, K = -1.635950410434655, N = Nquad, Method = Meth;  

QCH: Quadrupole, L = 0.15, K = -0.420869644678188, N = Nquad, Method = Meth;   
  
DUQ1: Drift, L = -0.000304;  
DDQ1: Drift, L = 0.000304;  
DUQ2: Drift, L = -0.001999;  
DDQ2: Drift, L = 0.001999;  
DUQ3: Drift, L = -0.003263;  
DDQ3: Drift, L = 0.003263;  
DUQ4: Drift, L = -0.003458;  
DDQ4: Drift, L = 0.003458;  
DDQ22: Drift, L = -0.001325;  
DUQ22: Drift, L = 0.001325;  
DDQ33: Drift, L = -0.030091;  
DUQ33: Drift, L = 0.030091;  
DDQ44: Drift, L = 0.006343;  
DUQ44: Drift, L = -0.006343;  
  
  
QQ1:  DUQ1, Q1, DDQ1;  
QQ2:  DUQ2, Q2, DDQ2;  
QQ3:  DUQ3, Q3, DDQ3;  
QQ4:  DUQ4, Q4, DDQ4;  
  
QQ22:  DUQ22, Q22, DDQ22;  
QQ33:  DUQ33, Q33, DDQ33;  
QQ44:  DUQ44, Q44, DDQ44;  
  
B1: Bending, L = 2.62, T = 6.0, T1 = 3.0, T2 = 3.0, N = Nbend, Method = Meth;  
  
S2: Sextupole, L = 0.2, K = 0.000000000000000, N = 1, Method = Meth;  
S3: Sextupole, L = 0.2, K = 0.000000000000000, N = 1, Method = Meth;  
S4: Sextupole, L = 0.2, K = 0.000000000000000, N = 1, Method = Meth;  
SD1: Sextupole, L = 0.25, K = 0.000000000000000, N = 1, Method = Meth;  
SF1: Sextupole, L = 0.25, K = 0.000000000000000, N = 1, Method = Meth;  
SF2H: Sextupole, L = 0.2, K = 0.000000000000000, N = 1, Method = Meth;  
SL1: Sextupole, L = 0.2, K = 0.000000000000000, N = 1, Method = Meth;  
