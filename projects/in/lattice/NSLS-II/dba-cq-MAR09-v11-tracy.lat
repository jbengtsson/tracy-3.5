SS: Marker;  
LS: Marker;  
MP: Marker;  
GS: Multipole, N = 1, Method = Meth;  
GE: Multipole, N = 1, Method = Meth;  
  
phi1 = 0*2e-3*180.0/pi; L_P = 2e-2;  
DB1: Bending, L = L_P/2.0, T = -phi1/2.0, T1 = -0*phi1/4.0,  
      N = 1, Method = Meth;  
DB:  Bending, L = L_P, T = phi1, N = 1, Method = Meth;  
DB2: Bending, L = L_P/2.0, T = -phi1/2.0, T2 = -0*phi1/4.0,  
      N = 1, Method = Meth;  
  
D_TPW: Drift, L = -L_P;  
  
TPW: D_TPW, DB1, DB, DB2, D_TPW;  

D1_JB:  Drift, L = 0.5;
D00_JB: Drift, L = 2.5 - 3*D1_JB.L;  
Q1_JB:  Quadrupole, L = 0.0, K = 0.0, N = Nquad, Method = Meth;
Q2_JB:  Quadrupole, L = 0.0, K = 0.0, N = Nquad, Method = Meth;
Q3_JB:  Quadrupole, L = 0.0, K = 0.0, N = Nquad, Method = Meth;
Q4_JB:  Quadrupole, L = 0.0, K = 0.0, N = Nquad, Method = Meth;

DUQ1_JB: Drift, L = 0.0;
DDQ1_JB: Drift, L = 0.0;
DUQ2_JB: Drift, L = 0.0;
DDQ2_JB: Drift, L = 0.0;
DUQ3_JB: Drift, L = 0.0;
DDQ3_JB: Drift, L = 0.0;

QQ1_JB:  DUQ1_JB, Q1_JB, DDQ1_JB;  
QQ2_JB:  DUQ2_JB, Q2_JB, DDQ2_JB;  
QQ3_JB:  DUQ3_JB, Q3_JB, DDQ3_JB;  

PT_JB: QQ1_JB, D1_JB, QQ2_JB, D1_JB, QQ3_JB, D1_JB;
  
  
c0 = 2.99792458e8; h_rf = 1300; C = 778.63108700844987;  
  
CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 5.00e6, Harnum = h_rf;  
  

LB: D11B, BPM, QQ22, D22A, HCM, VCM, S2, D22B, QQ33, D33A, S3,   
    D33B, QQ44, BPM, D44A, S4, D44B, HCM, VCM;  
  
HB: QQ1, D1A, SL1, HCM, VCM, D1B, BPM, QQ2, D2A, SL2,   
    D2B, QQ3, D3A, SL3, D3B, QQ4, BPM, D4A, SL4, D4B, HCM, VCM;  
  
DISP: HCM, VCM, SD1, D5A, BPM, QD3, D6A, SF1, D6B, QF2;  
  
DBA: B1, TPW, D5, GS, DISP, BPM, D7H, D7H, SF2H, QCH, MP, QCH, SF2H,   
     D7H, HCM, D7H, INV(DISP), GE, D5, B1;  
  
ONEP: D0, GS, HB, DBA, INV(LB), GE,  D00, SS,   
      D00, GS, LB, DBA, INV(HB), GE, D0, LS;  

ONEP_JB: D0, GS, HB, DBA, INV(LB), GE, D00_JB, PT_JB, Q4_JB, SS,   
         INV(PT_JB), D00_JB, GS, LB, DBA, INV(HB), GE, D0, LS;  

SCELL: ONEP_JB;
  
RING: SCELL, CAV;
  
{RING: 1*ONEP, CAV;}
  
CELL: RING, SYMMETRY = 1;  
  
END;
