Q33      : Quadrupole, L = 0.300000, K =  -1.555071,  N = Nquad, Method = Meth;
Q22      : Quadrupole, L = 0.400000, K = 2.042877,  N = Nquad, Method = Meth;
Q11      : Quadrupole, L = 0.300000, K = -1.227585,  N = Nquad, Method = Meth;

{Q1: Quadrupole, L = 0.300000, K = -0.189756, N = Nquad, Method = Meth;
Q2: Quadrupole, L = 0.400000, K =  1.406332, N = Nquad, Method = Meth;
Q3: Quadrupole, L = 0.300000, K = -1.621228, N = Nquad, Method = Meth;
Q11: Quadrupole, L = 0.300000, K = -0.989603, N = Nquad, Method = Meth;
Q22: Quadrupole, L = 0.400000, K =  1.991594, N = Nquad, Method = Meth;
Q33: Quadrupole, L = 0.300000, K = -1.597717, N = Nquad, Method = Meth;}

B1: Bending, L = 2.62, T =  6.0000,
    T1 =  3.000, T2 =  3.0000, N = Nbend, Method = Meth;

S1       : Sextupole, K =  0.000000, N = 1, Method = Meth;
S2       : Sextupole, K =  0.000000, N = 1, Method = Meth;
S3       : Sextupole, K =  0.000000, N = 1, Method = Meth;
SD1      : Sextupole, K =  0.000000, N = 1, Method = Meth;
SF1      : Sextupole, K = -2.651508, N = 1, Method = Meth;
SF2      : Sextupole, K =  3.652038, N = 1, Method = Meth;
SL1      : Sextupole, K =  0.000000, N = 1, Method = Meth;
SL2      : Sextupole, K =  0.000000, N = 1, Method = Meth;
SL3      : Sextupole, K =  0.000000, N = 1, Method = Meth;
SL4      : Sextupole, K =  0.000000, N = 1, Method = Meth;

{S1: Sextupole, L = 0.000000, K = -3.343039, N = 1, Method = Meth;
