SF2: Sextupole, L = 0.000000, K =  3.783709, N = 1, Method = Meth;
SL1: Sextupole, L = 0.000000, K =  0.974819, N = 1, Method = Meth;
SL2: Sextupole, L = 0.000000, K =  0.816749, N = 1, Method = Meth;
SL3: Sextupole, L = 0.000000, K = -2.811771, N = 1, Method = Meth;
SL4: Sextupole, L = 0.000000, K =  1.321229, N = 1, Method = Meth;}


SQ: Multipole, N = 1, Method = Meth;

MP: Marker;
SS: Marker;
LS: Marker;
GS: Multipole, N = 1, Method = Meth;
GE: Multipole, N = 1, Method = Meth;

c0 = 2.99792458e8  ; h_rf = 1300; C = 791.958 ;

{ Damping wiggler }
L_DW_80 = 6.8;
DW_80: insertion, scaling = 1.0, N = 50,
       file2 = "/home/bengtsson/projects/in/lattice/w80_7m_5th.txt";

L_DW_100 = 7.0;
DW_100: insertion, scaling = 0.0, N = 50,
        file2 = "/home/bengtsson/projects/in/lattice/w100v5_7m_5th.txt";

D_DW: Drift, L = -L_DW_100/2.0;
DW:   D_DW, DW_100, D_DW;


CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 5.00e6, Harnum = h_rf;

LB: DSX,S1,DSX, D11A, BPM,Q11,D22A2,HCM,VCM,D22A2, DSX,S2,DSX, D22B,
    Q22, D33A, DSX,S3,DSX, D33B, Q33, BPM, 
    D44B2, HCM,VCM ;

HB: DSX,SL1,DSX, D0A, BPM, Q1, D1A2,HCM,VCM,D1A2, DSX,SL2,DSX, D1B,
    Q2, D3A, DSX,SL3,DSX, D3B, Q3, BPM, D4A,
    DSX,SL4,DSX, D4B1,HCM,VCM;


HB_SQ: DSX,SL1,DSX, D0A, BPM, Q1, D1A2,HCM,VCM,SQ,D1A2,DSX,SL2,DSX,D1B,
    Q2, D3A, DSX,SL3,DSX, D3B, Q3, BPM, D4A,
    DSX,SL4,DSX, D4B1,HCM,VCM;

DISP:    DHVC,VCM,HCM,   DHVC, BPM,QD1,
      D6A, DSD,SF1,DSD, D6B, QF1; 

DISP_SQ: DHVC,VCM,HCM,SQ,DHVC, BPM,QD1,
      D6A, DSD,SF1,DSD, D6B, QF1; 


DBA:    B1, D5W,DPW, GS, D5C,
     DISP,D7, DSL, SF2,MP, DSL,D7, INV(DISP), 
     D5C, GE, DPW2,DPW2,D5W, B1;

DBA_SQ: B1, D5W,DPW, GS, D5C,
     DISP_SQ,D7, DSL, SF2,MP, DSL,D7, INV(DISP), 
     D5C, GE, DPW2,DPW2,D5W, B1;


LINE: D0, GS, HB_SQ, GE, D4B2, DBA_SQ, D44B2, GS, INV(LB), GE, D00, SS, 
      D00, GS, LB, GE, D44B2, DBA, D4B2, GS, INV(HB), GE, D0, LS;

{ 5 DW, use [Q11, Q22, Q33] }
{RING: 5*(LINE, DW, 2*LINE), CAV;}

RING: 1*LINE, CAV;

CELL: RING, SYMMETRY  = 1;

END;
