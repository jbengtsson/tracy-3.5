define lattice;
{ New J3L3SB3S0-C6x6Qfgdr EX_2.044 TPW H(9.1) L(6.1M) PMTPW(0.40M)}
Energy = 3.0;

dP = 1e-6; CODeps = 1e-10;

Meth = 4; Nbend = 4; Nquad = 4;

pi = 4.0*arctan(1.0);

BPM: Beam Position Monitor ;
HCM: Corrector, Horizontal, Method= Meth;
VCM: Corrector, Vertical, Method= Meth;
BHV: BPM, HCM, VCM ; 

D0:   Drift, L = 4.53860;
D0A:  Drift, L = 0.15000;
D1A:  Drift, L = 0.4900;
