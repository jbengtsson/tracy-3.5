D6B:  Drift, L = 0.62000;
D7:   Drift, L = 0.250;
D44A:  Drift, L = 0.15000;
D44B:  Drift, L = 0.55000;
D44B2:  Drift, L = 0.27500;
D33A: Drift, L = 0.50000;
D33B: Drift, L = 0.15000;
D22A: Drift, L = 0.50000;
D22A2: Drift, L = 0.250000;
D21B: Drift, L = 0.1500;
D22B: Drift, L = 0.2500 ;  
D11A: Drift, L = 0.15000;
D11B: Drift, L = 0.25000;
D00:  Drift, L = 3.30000;
DSX: Drift,  L = 0.1000;
DSD: Drift,  L = 0.125;
DSL: Drift,  L = 0.15;

QF1      : Quadrupole, L = 0.300000, K =  1.110444,  N = Nquad, Method = Meth;
QD1      : Quadrupole, L = 0.300000, K = -0.535699,  N = Nquad, Method = Meth;
Q1       : Quadrupole, L = 0.300000, K =-0.449523,  N = Nquad, Method = Meth;
Q2       : Quadrupole, L = 0.400000, K = 1.588770,  N = Nquad, Method = Meth;
