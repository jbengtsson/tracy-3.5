{ ..cuments\accelerators\newmachinestudies\lattices\nmacstudy_140801_e.opa }
 
{----- global parameters (units: gev, m, rad) -------------------------------}
 
define lattice; ringtype = 1;

Energy = 3.0;

dP = 1e-8; CODeps = 1e-14;

Meth = 4; Nbend = 4; Nquad = 4; Nsext = 2;

pi = 4.0*arctan(1.0);

c0 = 2.99792458e8; h_rf = 1320; C = 791.958; Brho = 1e9*Energy/c0;

cav: Cavity, Frequency = c0/C*h_rf, Voltage = 3.30e6, Harnum = h_rf;

{----- table of elements (units: m, m^-2, deg, t; mm, mrad) ---------------- }
{      conventions: quadrupole: k>0 horizontally focusing                    }
{                   sextupole : k=m*l, m:=bpoletip/r^2/(b*rho)               }
 
l1: drift, l = 0.050000;
l2: drift, l = 0.100000;
l4: drift, l = 0.154311;
l5: drift, l = 0.756190;
ls: drift, l = 2.500000;
l6: drift, l = 0.173080;
l3h: drift, l = 0.030029;

qf:  quadrupole, l = 0.075000, k =  21.889700, N = Nquad, Method = Meth;
qfe: quadrupole, l = 0.100000, k =  23.402022, N = Nquad, Method = Meth;
qde: quadrupole, l = 0.100000, k = -19.788989, N = Nquad, Method = Meth;
qm:  quadrupole, l = 0.150000, k =  18.290790, N = Nquad, Method = Meth;

bh: bending, l = 0.166667, t = 0.500000, k = -7.009950, 
      t1 = 0.000000, t2 = 0.000000, gap = 0.00, N = Nbend, Method = Meth;
bm: bending, l = 0.166667, t = 0.500000, k = -3.000000, 
      t1 = 0.000000, t2 = 0.000000, gap = 0.00, N = Nbend, Method = Meth;

sd: sextupole,  l = 0.100000, k = -1971.546180, N = Nsext, Method = Meth;
sf: sextupole,  l = 0.050000, k =  3356.914090, N = Nsext, Method = Meth;
sde: sextupole, l = 0.100000, k =  0.000000,    N = Nsext, Method = Meth;
sfe: sextupole, l = 0.100000, k =  0.000000,    N = Nsext, Method = Meth;

sga: sextupole, l = 0.000000, k =  0.000000,    N = Nsext, Method = Meth;
sgb: sextupole, l = 0.000000, k =  0.000000,    N = Nsext, Method = Meth;
sgc: sextupole, l = 0.000000, k =  0.000000,    N = Nsext, Method = Meth;
sgd: sextupole, l = 0.000000, k =  0.000000,    N = Nsext, Method = Meth;
sge: sextupole, l = 0.000000, k =  0.000000,    N = Nsext, Method = Meth;

sd1: sextupole, l = 0.100000, k = -6611.404500, N = Nsext, Method = Meth;
sf1: sextupole, l = 0.050000, k =  3326.180000, N = Nsext, Method = Meth;
sd2: sextupole, l = 0.100000, k = -6611.404500, N = Nsext, Method = Meth;
sf2: sextupole, l = 0.050000, k =  3326.180000, N = Nsext, Method = Meth;
sd3: sextupole, l = 0.100000, k = -6611.404500, N = Nsext, Method = Meth;
sf3: sextupole, l = 0.050000, k =  3326.180000, N = Nsext, Method = Meth;
sd4: sextupole, l = 0.100000, k = -6611.404500, N = Nsext, Method = Meth;
sf4: sextupole, l = 0.050000, k =  5027.292930, N = Nsext, Method = Meth;
sd5: sextupole, l = 0.100000, k = -6611.404500, N = Nsext, Method = Meth;
sf5: sextupole, l = 0.050000, k =  3326.180000, N = Nsext, Method = Meth;
sd6: sextupole, l = 0.100000, k = -6611.404500, N = Nsext, Method = Meth;
sf6: sextupole, l = 0.050000, k =  3326.180000, N = Nsext, Method = Meth;
sd7: sextupole, l = 0.100000, k = -6611.404500, N = Nsext, Method = Meth;
sf7: sextupole, l = 0.050000, k =  3326.180000, N = Nsext, Method = Meth;
sd8: sextupole, l = 0.100000, k = -6611.404500, N = Nsext, Method = Meth;
sf8: sextupole, l = 0.050000, k =  3326.180000, N = Nsext, Method = Meth;

o1: multipole, N = 1, Method = Meth;
o2: multipole, N = 1, Method = Meth;
o3: multipole, N = 1, Method = Meth;
 
{----- table of segments ----------------------------------------------------}
 
uch: sf, l1, qf, l2, sd, bh;
uc : uch, inv(uch);
ucb: inv(uch), uch;
mcb: ls, o1, sga, qfe, sgb, l3h, o2, l3h, qde, sgc, l4, sfe,
            o3, bm, sde, l5, sgd, qm, l6, sge, bh;

mcblinear : ls, qfe, l3h, l3h, qde, l4, sfe, bm, sde, l5, qm, l6,
            bh;

uch1: sf1, l1, qf, l2, sd, bh;
ucb1: inv(uch1), uch1;
uch2: sf2, l1, qf, l2, sd, bh;
ucb2: inv(uch2), uch2;
uch3: sf3, l1, qf, l2, sd, bh;
ucb3: inv(uch3), uch3;
uch4: sf4, l1, qf, l2, sd, bh;
ucb4: inv(uch1), uch1;
uch5: sf5, l1, qf, l2, sd, bh;
ucb5: inv(uch5), uch5;
uch6: sf6, l1, qf, l2, sd, bh;
ucb6: inv(uch6), uch6;
uch7: sf7, l1, qf, l2, sd, bh;
ucb7: inv(uch7), uch7;
uch8: sf8, l1, qf, l2, sd, bh;
ucb8: inv(uch8), uch8;
hper: mcb, 8*ucb;

{ 20 cells }
per: hper, inv(hper), cav;

hpera: mcb, ucb1, ucb2, ucb3, ucb4, ucb5, ucb6, ucb7, ucb8;

{ 20 cells }
pera: hpera, inv(hpera), cav;

{ 360 cells }
perucs: ucb, cav;
 
cell: per, symmetry = 1;

end;
