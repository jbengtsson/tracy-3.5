{ New R3L3SBS4-C6x6Qfgdr EX_2.002 TPW H(9.3) L(6.6M) PMTPW(0.40M)}

define lattice; ringtype = 1;

Energy = 3.0;

dP = 1e-7; CODeps = 1e-14;

Meth = 4; Nbend = 4; Nquad = 4;

pi = 4.0*arctan(1.0);

BPM: Beam Position Monitor;

HCM: Corrector, Horizontal, Method= Meth;
VCM: Corrector, Vertical, Method= Meth;

DH0:  Drift, L = 4.650;
DL0:  Drift, L = 3.30;
DH1A: Drift, L = 0.15000;
DH2A: Drift, L = 0.24500;
DH2B: Drift, L = 0.24500;
DH2C: Drift, L = 0.1500;
DH3A: Drift, L = 0.1900;
DH3B: Drift, L = 0.20000;
DH4A: Drift, L = 0.15000;
DH4B: Drift, L = 0.250;
DH4C: Drift, L = 0.300;

DM1A: Drift, L = 0.2000;
DPW:  Drift, L = 0.20000;
DM1B: Drift, L = 0.4000;
DM1C: Drift, L = 0.1500;

DM2A: Drift, L = 0.15000;
DM2B: Drift, L = 0.62000;
DM2C: Drift, L = 0.250;

DL3A: Drift, L = 0.38860;
DL3B: Drift, L = 0.15000;

DL4A: Drift, L = 0.2750;
DL4B: Drift, L = 0.27500;

DL1A: Drift, L = 0.150000;
DL2A: Drift, L = 0.250000;
DL2B: Drift, L = 0.250000;
DL2C: Drift, L = 0.2500;  

DSX:  Drift, L = 0.1000;
DSD:  Drift, L = 0.125;
DSC:  Drift, L = 0.075;
DSL:  Drift, L = 0.15;

QH1: Quadrupole, L = 0.300000, K = -0.621453, N = Nquad, Method = Meth;
QH2: Quadrupole, L = 0.400000, K =  1.668877, N = Nquad, Method = Meth;
QH3: Quadrupole, L = 0.300000, K = -1.551548, N = Nquad, Method = Meth;
QM2: Quadrupole, L = 0.300000, K =  1.159750, N = Nquad, Method = Meth;
QM1: Quadrupole, L = 0.300000, K = -0.685803, N = Nquad, Method = Meth;
QL3: Quadrupole, L = 0.300000, K = -1.538644, N = Nquad, Method = Meth;
QL2: Quadrupole, L = 0.400000, K =  2.117711, N = Nquad, Method = Meth;
QL1: Quadrupole, L = 0.300000, K = -1.316453, N = Nquad, Method = Meth;

{QH1: Quadrupole, L = 0.300000, K = -0.55500, N = Nquad, Method = Meth;
QH2: Quadrupole, L = 0.400000, K =  1.59663, N = Nquad, Method = Meth;
QH3: Quadrupole, L = 0.300000, K = -1.42299, N = Nquad, Method = Meth;
QL1: Quadrupole, L = 0.300000, K = -1.42726, N = Nquad, Method = Meth;
QL2: Quadrupole, L = 0.400000, K =  2.09269, N = Nquad, Method = Meth;
QL3: Quadrupole, L = 0.300000, K = -1.37820, N = Nquad, Method = Meth;
QM1: Quadrupole, L = 0.300000, K = -0.81289, N = Nquad, Method = Meth;
QM2: Quadrupole, L = 0.300000, K =  1.19920, N = Nquad, Method = Meth;}

B1: Bending, L = 2.62, T =  6.0000, T1 =  3.000, T2 =  3.0000,
    N = Nbend, Method = Meth;

{SL1: Sextupole, K =  1.996040, N = 1, Method = Meth;
SL2: Sextupole, K =  1.999802, N = 1, Method = Meth;
SL3: Sextupole, K = -1.997541, N = 1, Method = Meth;
SM1: Sextupole, K = -2.219245, N = 1, Method = Meth;
SM2: Sextupole, K =  3.100800, N = 1, Method = Meth;
SH1: Sextupole, K =  0*0.975485, N = 1, Method = Meth;
SH2: Sextupole, K =  1.576651, N = 1, Method = Meth;
SH3: Sextupole, K = -1.884663, N = 1, Method = Meth;
SH4: Sextupole, K = -0.968570, N = 1, Method = Meth;

SH1_DW: Sextupole, K =  0*0.975485, N = 1, Method = Meth;
SH2_DW: Sextupole, K =  1.576651, N = 1, Method = Meth;
SH3_DW: Sextupole, K = -1.884663, N = 1, Method = Meth;
SH4_DW: Sextupole, K = -0.968570, N = 1, Method = Meth;}

{OM1: Multipole, N = 1, Method = Meth, HOM = ( 4, 1e-10, 0.0 );
OM2: Multipole, N = 1, Method = Meth, HOM = ( 4, 1e-10, 0.0 );}

SH1:    Sextupole, K = 0.0, N = 1, Method = Meth;
SH1_DW: Sextupole, K = 0.0, N = 1, Method = Meth;

SL1: Sextupole, L = 0.000000, K = -2.562123, N = 1, Method = Meth;
SL2: Sextupole, L = 0.000000, K =  4.188084, N = 1, Method = Meth;
SL3: Sextupole, L = 0.000000, K = -2.901043, N = 1, Method = Meth;
SM1: Sextupole, L = 0.000000, K = -2.451465, N = 1, Method = Meth;
SM2: Sextupole, L = 0.000000, K =  3.174421, N = 1, Method = Meth;
SH2: Sextupole, L = 0.000000, K =  0.851833, N = 1, Method = Meth;
SH3: Sextupole, L = 0.000000, K =  0.585622, N = 1, Method = Meth;
SH4: Sextupole, L = 0.000000, K = -1.947421, N = 1, Method = Meth;

SH2_DW: Sextupole, K = -0.0013753, N = 1, Method = Meth;
SH3_DW: Sextupole, K =  2.4296287, N = 1, Method = Meth;
SH4_DW: Sextupole, K = -4.2437732, N = 1, Method = Meth;

OM1: Multipole, L = 0.000000, N = 1, Method = Meth,
     HOM = (5,   618.930009, 0.0);
OM2: Multipole, L = 0.000000, N = 1, Method = Meth,
     HOM = (5,  -958.306644, 0.0);
SQ: Multipole, N = 1, Method = Meth;

MP: Marker;
SS: Marker;

{LS: Marker;}
{ For ID correction }
LS: Sextupole, K = 0.0, N = 1, Method = Meth;

GS: Multipole, N = 1, Method = Meth;
GE: Multipole, N = 1, Method = Meth;

c0 = 2.99792458e8; h_rf = 1300; C = 791.958; Brho = 1e9*Energy/c0;

CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 5.00e6, Harnum = h_rf;

{ Damping Wiggler }

{ Toshi's standard DW poles }
{lambda_DW = 0.08; n_DW = 88; L_DW = n_DW*lambda_DW; B_DW = 1.81246;
DW_80:
  Wiggler, L = L_DW, lambda = lambda_DW, kxV = 0*5.0341,
  BoBrhoV = B_DW/Brho, N = n_DW*8, Method = 2,
  harm = (3,  1.9917,  0.044716/Brho, 0, 0, 0,
          5,  1.0064, -0.060881/Brho, 0, 0, 0,
          7,  1.0000, -0.007070/Brho, 0, 0, 0,
          9,  0.9996,  0.004144/Brho, 0, 0, 0);}

{L_DW = 6.8;
DW_80:
  insertion, scaling = 1.0, N = 50,
  file2 = "/home/ria34843/git_repos/tracy-3.5/projects/in/lattice/lattice_nsls-ii/w80_7m_5th.txt";}

{lambda_DW = 0.09; n_DW = 78; L_DW = n_DW*lambda_DW; B_DW = 1.8;
DW_90:
  Wiggler, L = L_DW, lambda = lambda_DW, kxV = 0.0,
  BoBrhoV = B_DW/Brho, N = n_DW*8, Method = 2;}

{L_DW = 7.02;
DW_90:
  insertion, scaling = 1.0, N = 50,
  file2 = "/home/ria34843/git_repos/tracy-3.5/projects/in/lattice/lattice_nsls-ii/w90_060109.txt";}
{  file2 = "/home/ria34843/git_repos/tracy-3.5/projects/in/lattice/lattice_nsls-ii/w90v5_7m_5th.txt";}

{lambda_DW = 0.10; n_DW = 70; L_DW = n_DW*lambda_DW; B_DW = 1.813;
DW_100:
  Wiggler, L = L_DW, lambda = lambda_DW, kxV = 0.0,
  BoBrhoV = B_DW/Brho, N = n_DW*8, Method = 2;}

L_DW = 7.0;
DW_100:
  insertion, scaling = 1.0, N = 50,
  file2 = "/home/ria34843/git_repos/tracy-3.5/projects/in/lattice/lattice_nsls-ii/w100_pole90mm_40div_7m_060611.txt";
{  file2 = "/home/ria34843/git_repos/tracy-3.5/projects/in/lattice/lattice_nsls-ii/w100_pole90mm_40div_7m.txt";}

{ n: number of repetitions. }
{L_DW = 0.0;
DW_100_FM:
  fieldmap, l = 0.0, scaling = 1.0, n = 1,
  file1 = "/home/ria34843/git_repos/tracy-3.5_temp/projects/src/python/w100_srw.out";
B_DW: Multipole, L = 0.0, HOM = (1, 1.7183656776530501e-05/2, 0.0), Method = Meth;
DW_100: B_DW, DW_100_FM, B_DW;}

D_DW: Drift, L = -L_DW/2.0;
DW:   D_DW, DW_100, D_DW;

{ CPMU }
{lambda_U19 = 19e-3; n_U19 = 160; B_U19 = 2.2/(0.934*1e2*lambda_U19);
L_U19 = n_U19*lambda_U19;
U19: Wiggler, L = L_U19, lambda = lambda_U19,
     kxV = 0.0, BoBrhoV = B_U19/Brho, N = n_U19*8, Method = 2;}

L_U19 = 2.983;
U19: insertion, scaling = 1.0, N = 50,
     file2 = "/home/ria34843/git_repos/tracy-3.5/projects/in/lattice/lattice_nsls-ii/u19_3m_5th.txt";

D_U19: Drift, L = -L_U19/2.0;
CPMU:  D_U19, U19, D_U19;

{ SCU }
lambda_SCU = 14e-3; n_SCU = 143; B_SCU = 2.2/(0.934*1e2*lambda_SCU);
L_SCU = n_SCU*lambda_SCU;
U14: Wiggler, L = L_SCU, lambda = lambda_SCU, kxV = 0.0, 
      BoBrhoV = B_SCU/Brho, N = n_SCU*8, Method = 2;

D_SCU: Drift, L = -L_SCU/2.0;

SCU: D_SCU, U14, D_SCU;

{ SCW }
lambda_6T = 10e-2; n_6T = 10; L_6T = n_6T*lambda_6T; B_6T = -6.2962;
W6T1: Wiggler, L = L_6T, lambda = lambda_6T, kxV = -0*1.2810, 
      BoBrhoV = B_6T/Brho, N = n_6T*8, Method = 2{,
      harm = (3, 0.9521, -0.2239/Brho, 0, 0, 0,
              5, 0.0000,  0.0097/Brho, 0, 0, 0)};

D_6T: Drift, L = -L_6T/2.0;

W6T: D_6T, W6T1, D_6T;

{ EPU }
L_U45 = 3.87;
{U45: insertion, scaling = 1.0, N = 50,
     file2 = "/home/ria34843/git_repos/tracy-3.5/projects/in/lattice/lattice_nsls-ii/u45gap10mmphase0mm5th.txt";}
{U45: insertion, scaling = 1.0, N = 50,
     file2 = "/home/ria34843/git_repos/tracy-3.5/projects/in/lattice/lattice_nsls-ii/u45gap10mmphase13mm5th.txt";}
U45: insertion, scaling = 1.0, N = 50,
     file2 = "/home/ria34843/git_repos/tracy-3.5/projects/in/lattice/lattice_nsls-ii/u45gap10mmphase22mm5th.txt";

D_U45:  Drift, L = -L_U45/2.0;
EPU: D_U45, U45, D_U45;

LB: DSX, SL1, DSX, DL1A, BPM, QL1, DL2A, HCM, VCM, DL2B, DSX, SL2, DSX,
    DL2C, QL2, DL3A, DSX, SL3, DSX, DL3B, QL3, BPM, DL4A, HCM, VCM;

HB: DSX, SH1, DSX, DH1A, BPM, QH1, DH2A, HCM, VCM, DH2B, DSX, SH2, DSX,
    DH2C, QH2, DH3A, DSX, SH3, DSX, DH3B, QH3, BPM, DH4A, DSX, SH4, DSX,
    DH4B, HCM, VCM;

HB_DW: DSX, SH1_DW, DSX, DH1A, BPM, QH1, DH2A, HCM, VCM, DH2B, DSX,
       SH2_DW, DSX, DH2C, QH2, DH3A, DSX, SH3_DW, DSX, DH3B, QH3, BPM,
       DH4A, DSX, SH4_DW, DSX, DH4B, HCM, VCM;

HB_SQ: DSX, SH1, DSX, DH1A, BPM, QH1, DH2A, HCM, VCM, SQ, DH2B, DSX,
       SH2, DSX, DH2C, QH2, DH3A, DSX, SH3, DSX, DH3B, QH3, BPM, DH4A, DSX,
       SH4, DSX, DH4B, HCM, VCM;

HB_SQ_DW: DSX, SH1_DW, DSX, DH1A, BPM, QH1, DH2A, HCM, VCM, SQ, DH2B, DSX,
          SH2_DW, DSX, DH2C, QH2, DH3A, DSX, SH3_DW, DSX, DH3B, QH3, BPM,
          DH4A, DSX, SH4_DW, DSX, DH4B, HCM, VCM;

DISP: DM1B, HCM, VCM, DM1C, BPM, QM1, DM2A, DSD, SM1, DSD, DM2B, QM2, DM2C;

DISP_O1: DM1B, HCM, VCM, DM1C, BPM, QM1, DM2A, DSD, SM1, OM1, DSD, DM2B,
         QM2, DM2C;

DISP_O2: DM1B, HCM, VCM, DM1C, BPM, OM2, QM1, DM2A, DSD, SM1, DSD, DM2B,
         QM2, DM2C;

DBA: GS, B1, DM1A, DPW, GE,
     GS, DISP_O2, DSL, SM2, MP, DSL, INV(DISP_O1), GE,
     GS, DPW, DM1A, B1, GE;

DBA_SQ: GS, B1, DM1A, DPW, GE,
        GS, DISP_O1, DSL, SM2, SQ, MP, DSL, INV(DISP_O2), GE,
        GS, DPW, DM1A, B1, GE;

LINE: LS, DH0,
      GS, HB_SQ, GE,
      DH4C, DBA_SQ, DL4B,
      GS, INV(LB), GE,
      GS, DL0, SS, DL0, GE,
      GS, LB, GE,
      DL4B, DBA, DH4C,
      GS, INV(HB), GE,
      DH0;

LINE_DW: LS, DH0, GS, HB_SQ, GE, DH4C, DBA_SQ, DL4B, GS, INV(LB), GE,
         GS, DL0, SS, DL0, GE, GS, LB, GE, DL4B, DBA, DH4C,
         GS, INV(HB_DW), GE, DH0;

DW_LINE: LS, DH0, GS, HB_SQ_DW, GE, DH4C, DBA_SQ, DL4B, GS, INV(LB), GE,
         GS, DL0, SS, DL0, GE, GS, LB, GE, DL4B, DBA, DH4C,
         GS, INV(HB), GE, DH0;

LINE_CPMU: LS, DH0, GS, HB_SQ, GE, DH4C, DBA_SQ, DL4B, GS, INV(LB), GE,
           GS, DL0, CPMU, SS, DL0, GE, GS, LB, GE, DL4B, DBA, DH4C,
           GS, INV(HB), GE, DH0;

LINE_SCU: LS, DH0, GS, HB_SQ, GE, DH4C, DBA_SQ, DL4B, GS, INV(LB), GE,
          GS, DL0, SCU, SS, DL0, GE, GS, LB, GE, DL4B, DBA, DH4C,
          GS, INV(HB), GE, DH0;

LINE_EPU: LS, DH0, GS, HB_SQ, GE, DH4C, DBA_SQ, DL4B, GS, INV(LB), GE,
          GS, DL0, EPU, SS, DL0, GE, GS, LB, GE, DL4B, DBA, DH4C,
          GS, INV(HB), GE, DH0;

{RING: 1*LINE, CAV;}
{RING: LINE_DW, DW, DW_LINE, CAV;}

{ 1 DW }
{RING: LINE, DW, 14*LINE, CAV;}

{ 3 DWs }
RING: 1*(LINE_DW, DW, DW_LINE, 3*LINE), CAV;

{ CPMUs }
{N_CPMU = 1; N_LINE = 15 - N_CPMU;
RING: N_CPMU*(LINE_CPMU), N_LINE*LINE, CAV;}

{ 1 CPMU long straight }
{RING: LINE, CPMU, 14*LINE, CAV;}

{ 1 DW }
{RING: LINE, DW, 14*LINE, CAV;}
{RING: LINE, DW, CAV;}

{ 3 DWs and 15 CPMUs }
{RING: 3*(LINE_CPMU, DW, 4*LINE_CPMU), CAV;}

{ 1 SCU }
{RING: LINE_SCU, 14*LINE, CAV;}

{ 1 SCW }
{RING: LINE, W6T, 14*LINE, CAV;}

{ 1 EPU }
{RING: LINE_EPU, 14*LINE, CAV;}

CELL: RING, SYMMETRY  = 1;

END;
