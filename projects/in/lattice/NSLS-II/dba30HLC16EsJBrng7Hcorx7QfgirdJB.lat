define lattice;
{ New DBA30HLC16EsJBrng7Hcorx7QfgirdJB H(8m) L(5m)Rho=25m }

ringtype = 1;

Energy = 3.0;

dP = 1e-6; CODeps = 1e-10;

Meth = 4; Nbend = 4; Nquad = 4;

pi = 4.0*arctan(1.0);

BPM: Beam Position Monitor ;
HCM: Corrector, Horizontal, Method= Meth;
VCM: Corrector, Vertical, Method= Meth;
BHV: BPM, HCM, VCM ; 

TWK1: Drift, L = 0.0;
TWK2: Drift, L = 0.0;
TWK3: Drift, L = 0.0;
TWK4: Drift, L = 0.0;

D0:   Drift, L = 4.0;
D1A:  Drift, L = 0.240;
D1B:  Drift, L = 0.4 ;
D1B2:  Drift, L = 0.2 ;
D2A:  Drift, L = 0.15 ;
D2B:  Drift, L = 0.15 ;
D3A:  Drift, L = 0.15;
D3B:  Drift, L = 0.240;
D4A:  Drift, L = 0.15;
D4B:  Drift, L = 0.550;
D4B1:  Drift, L = 0.30;
D4B2:  Drift, L = 0.250;
D5:   Drift, L = 0.5500;
D51:   Drift, L = 0.3000;
D52:   Drift, L = 0.2500;
D5A:  Drift, L = 0.1500;
D6A:  Drift, L = 0.215;
D6B:  Drift, L = 0.305;
D7:   Drift, L = 0.35;
D71:   Drift, L = 0.175;
D4L:  Drift, L = 0.55;
D4L1:  Drift, L = 0.30;
D4L2:  Drift, L = 0.25;
D4:   Drift, L = 0.15;

D33A: Drift, L = 0.2000;
D33B: Drift, L = 0.1500;
D22A: Drift, L = 0.400;
D22A2: Drift, L = 0.200;  
D22B: Drift, L = 0.2000 ;  
D11A: Drift, L = 0.5000;
D11B: Drift, L = 0.350000;
D00:  Drift, L = 2.5000;
DSX: Drift,  L = 0.1000;
DSD: Drift,  L = 0.125;
DSL: Drift,  L = 0.15;

Q1       : Quadrupole, L = 0.300000, K = -0.647296,  N = Nquad, Method = Meth;
Q2       : Quadrupole, L = 0.300000, K =  0.536991,  N = Nquad, Method = Meth;
Q3       : Quadrupole, L = 0.300000, K =  1.646253,  N = Nquad, Method = Meth;
Q4       : Quadrupole, L = 0.300000, K = -1.397866,  N = Nquad, Method = Meth;
QF2      : Quadrupole, L = 0.300000, K =  1.389740,  N = Nquad, Method = Meth;
QD3      : Quadrupole, L = 0.300000, K = -1.016797,  N = Nquad, Method = Meth;
Q44      : Quadrupole, L = 0.300000, K = -1.622952,  N = Nquad, Method = Meth;
Q33      : Quadrupole, L = 0.400000, K =  1.989407,  N = Nquad, Method = Meth;
Q22      : Quadrupole, L = 0.300000, K = -0.198948,  N = Nquad, Method = Meth;
Q11      : Quadrupole, L = 0.300000, K = -1.108371,  N = Nquad, Method = Meth;

B1: Bending, L = 2.62, T =  6.0000,
    T1 =  3.000, T2 =  3.0000, N = Nbend, Method = Meth;


S1: Sextupole, K =  0.660096, N = 1, Method = Meth;
S2: Sextupole, K =  1.043489, N = 1, Method = Meth;
S3: Sextupole, K =  0.024780, N = 1, Method = Meth;
S4: Sextupole, K = -2.005888, N = 1, Method = Meth;
SD1: Sextupole, K = -0.269011, N = 1, Method = Meth;
SF1: Sextupole, K = -1.934119, N = 1, Method = Meth;
SF2: Sextupole, K =  3.500000, N = 1, Method = Meth;
SL1: Sextupole, K =  1.029098, N = 1, Method = Meth;
SL2: Sextupole, K =  1.858553, N = 1, Method = Meth;
SL3: Sextupole, K = -3.319335, N = 1, Method = Meth;
SL4: Sextupole, K =  0.646088, N = 1, Method = Meth;

SQ: Multipole, N = 1, Method = Meth;

MP : Marker;
SS : Marker;
LS : Marker;
GS: Multipole, N = 1, Method = Meth;
GE: Multipole, N = 1, Method = Meth;

c0 = 2.99792458e8; h_rf = 1300; C = 780.30 ;

Brho = 1e9*Energy/c0;

{CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 2.5e6, Harnum = h_rf;}
CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 5.0e6, Harnum = h_rf;

{ EPU }
lambda_EPU = 40e-3; n_EPU = 100; B_EPU = 3.3/(0.934*1e2*lambda_EPU);
L_EPU = n_EPU*lambda_EPU;

D_EPU: Drift, L = -L_EPU/2.0;

EPU1: Wiggler, L = L_EPU/2.0, lambda = lambda_EPU, kxV = 0.0, Roll = 90.0,
      BoBrhoH = B_EPU/Brho*1, BoBrhoV = B_EPU/Brho*1, phi = 1.571*0.0,
      N = n_EPU*4, Method = 1;

EPU: D_EPU, EPU1;

{ Mini Gap Undulator }
lambda_CPMU = 19e-3; n_CPMU = 158/2; B_CPMU = 2.2/(0.934*1e2*lambda_CPMU);
L_CPMU = n_CPMU*lambda_CPMU;

D_CPMU: Drift, L = -L_CPMU/2.0;

CPMU1: Wiggler, L = L_CPMU/2.0, lambda = lambda_CPMU,
       kxV = 0.0, BoBrhoV = B_CPMU/Brho, N = n_CPMU*4, Method = 1;

CPMU: D_CPMU, CPMU1;

CANT_UP: Multipole, HOM = (1,  0e-3, 0.0), N = 1, Method = Meth;
CANT_UN: Multipole, HOM = (1, -0e-3, 0.0), N = 1, Method = Meth;

{ Damping wiggler }
lambda_DW = 10e-2; n_DW = 70; B_DW = 1.8;

D_DW: Drift, L = -n_DW*lambda_DW/2.0;

DW1: Wiggler, L = lambda_DW, lambda = lambda_DW, kxV = 0.0, 
     BoBrhoV = B_DW/Brho, N = 100, Method = 1;
{DW1: Fieldmap, L = lambda_DW, N = 20, file1 = "../in/lattice/w100bzvert.txt";}

DW: D_DW, n_DW*DW1, D_DW;

CANT_P: Multipole, HOM = (1,  0e-3, 0.0), N = 1, Method = Meth;
CANT_N: Multipole, HOM = (1, -0e-3, 0.0), N = 1, Method = Meth;

{ Super Conducting Undulator }
lambda_SCU = 14e-3; n_SCU = 143; B_SCU = 2.2/(0.934*1e2*lambda_SCU);
L_SCU = n_SCU*lambda_SCU;

D_SCU: Drift, L = -L_SCU/2.0;

SCU1: Wiggler, L = L_SCU/2.0, lambda = lambda_SCU, kxV = 0.0, 
      BoBrhoV = B_SCU/Brho, N = n_SCU*4, Method = 1;

SCU: D_SCU, SCU1;

{ Super Conducting Wiggler }
{lambda_u = 10e-2; n_u = 50; B_u = 13.076/(0.934*1e2*lambda_u);}

phi1 = 0*2e-3*180.0/pi; L_P = 2e-2;
DB1: Bending, L = L_P/2.0, T = -phi1/2.0, T1 = -0*phi1/4.0,
     N = 1, Method = Meth;
DB:  Bending, L = L_P, T = phi1, N = 1, Method = Meth;
DB2: Bending, L = L_P/2.0, T = -phi1/2.0, T2 = -0*phi1/4.0,
     N = 1, Method = Meth;

D_TPW: Drift, L = -L_P;

TPW: D_TPW, DB1, DB, DB2, D_TPW;

LB: Q11, D11A, 
    DSX, S1, DSX, D11B,BPM,  Q22, D22A2, HCM, VCM, D22A2, 
    DSX, S2, DSX, D22B, Q33, D33A, 
    DSX, S3, DSX, D33B, Q44, BPM, D4, 
    DSX, S4, DSX, D4L1, HCM, VCM;

HB: Q1, D1A, 
    DSX, SL1, DSX, D1B2, HCM, VCM, D1B2, BPM,  Q2, D2A, 
    DSX, SL2, DSX, D2B, Q3, D3A, 
    DSX, SL3, DSX, D3B, Q4, BPM, D4A, 
    DSX, SL4, DSX , D4B1, HCM, VCM;

HB_SQ: Q1, D1A, 
       DSX, SL1, SQ, DSX, D1B2, HCM, VCM, D1B2,BPM,  Q2, D2A, 
       DSX, SL2, DSX, D2B, Q3, D3A, 
       DSX, SL3, DSX, D3B, Q4, BPM, D4A, 
       DSX, SL4, DSX , D4B1, HCM, VCM;

DISP: VCM, HCM, D51, DSD, SD1, DSD, 
      D5A, BPM,  QD3, D6A, DSD, SF1, DSD, D6B, QF2; 

DISP_SQ: VCM, HCM, D51, DSD, SD1, SQ, DSD, 
         D5A, BPM,  QD3, D6A, DSD, SF1, DSD, D6B, QF2; 

DBA: B1, D52, 
     GS, DISP, BPM, D7, DSL, SF2, MP, DSL, D71, HCM, D71, INV(DISP), GE, 
     D52, B1;

DBA_TPW: B1, TPW, D52, 
         GS, DISP, BPM, D7, DSL, SF2, MP, DSL, D71, HCM, D71, INV(DISP), GE, 
         D52, B1;

DBA_SQ: B1, D52, 
        GS, DISP_SQ, BPM, D7, DSL, SF2, MP, DSL, D71, HCM, D71, INV(DISP),
        GE, D52, B1;

LINE: D0, GS, HB_SQ, GE, D4B2, DBA_SQ, D4L2, GS, INV(LB), GE, D00, 
      SS, D00, GS, LB, GE, D4L2, DBA, D4B2, GS, INV(HB), GE, D0, LS;

LINE_TPW: D0, GS, HB_SQ, GE, D4B2, DBA_TPW, D4L2, GS, INV(LB), GE, D00, 
          SS, D00, GS, LB, GE, D4L2, DBA_TPW, D4B2, GS, INV(HB), GE, D0, LS;

LINE_DW1: D0, GS, HB_SQ, GE, D4B2, DBA_SQ, D4L2, GS, INV(LB), GE, D00, 
          D00, GS, LB, GE, D4L2, DBA, D4B2, GS, INV(HB),
          GE, CANT_P, D0, LS, DW, CANT_N;

LINE_DW2: CANT_N, DW1, D_DW, D0, CANT_P, GS, HB_SQ, GE, D4B2, DBA_SQ, D4L2, GS,
          INV(LB), GE, D00, SS, D00, GS, LB, GE, D4L2, DBA, D4B2, GS, INV(HB),
          GE, CANT_P, D0, LS, DW, CANT_N;

LINE_CPMU: D0, GS, HB_SQ, GE, D4B2, DBA_SQ, D4L2, GS, INV(LB), GE,
           CANT_UP, D00, CPMU, CANT_UN, SS, CANT_UN, INV(CPMU), D00,
           CANT_UP, GS, LB, GE, D4L2, DBA, D4B2, GS, INV(HB), GE, D0, LS;

LINE_CPMU_LS: D0, GS, HB_SQ, GE, D4B2, DBA_SQ, D4L2, GS, INV(LB), GE,
              CANT_UP, D00, SS, D00,
              CANT_UP, GS, LB, GE, D4L2, DBA, D4B2, GS, INV(HB), GE, D0,
              CPMU, LS, INV(CPMU);

LINE_SCU: D0, GS, HB_SQ, GE, D4B2, DBA_SQ, D4L2, GS, INV(LB), GE,
          D00, SCU, SS, SCU1, D_SCU, D00,
          GS, LB, GE, D4L2, DBA, D4B2, GS, INV(HB), GE, D0;


{RING: 10*LINE_TPW, 5*LINE, CAV;}

RING: 15*LINE, CAV;

{RING: 1*LINE_CPMU_LS, 14*LINE, CAV;}

{RING: n_DW*DW1;}

{ Use: [Q11, Q22, Q44] }
{N_IDs = 7; No_IDs = 15 - N_IDs;
RING: N_IDs*LINE_CPMU, No_IDs*LINE, CAV;}

{ 1 CPMU, use: [Q11, Q22, Q44] }
{RING: 1*LINE_CPMU, 14*LINE, CAV;}

{ 15 CPMU, use: [Q11, Q22, Q44] }
{RING: 15*LINE_CPMU, CAV;}

{ 1 SCU, use: [Q11, Q22, Q44] }
{RING: 1*LINE_SCU, 14*LINE, CAV;}

{ 15 SCU, use: [Q11, Q22, Q44] }
{RING: 15*LINE_SCU, CAV;}

{ 1 DW, use [Q11, Q22, Q44] }
{RING: LINE_DW1, INV(LINE_DW1), 13*LINE, CAV;}

{ 2 DW, use [Q11, Q22, Q44] }
{RING: 2*(LINE_DW1, INV(LINE_DW1), 5*LINE), LINE, CAV;}

{ 3 DW, use [Q11, Q22, Q44] }
{RING: 3*(LINE_DW1, INV(LINE_DW1), 3*LINE), CAV;

{ 5 DW, use [Q11, Q22, Q44] }
{RING: 5*(LINE_DW1, INV(LINE_DW1), LINE), CAV;}

{ 8 DW, use: [Q11, Q22, Q44] }
{RING: LINE_DW1, LINE_DW2, INV(LINE_DW1), 6*(LINE_DW1, INV(LINE_DW1)), CAV;}

{ Use: [Q1, Q2, Q4, Q11, Q22, Q44] }
{N_DW = 5; N1 = N_DW - 2; N2 = 2*(8-N_DW) - 1;
RING: LINE_DW1, LINE_DW2, INV(LINE_DW1), N1*(LINE_DW1, INV(LINE_DW1)),
      N2*LINE, LINE, CAV;}

CELL: RING, SYMMETRY  = 1;

END;
