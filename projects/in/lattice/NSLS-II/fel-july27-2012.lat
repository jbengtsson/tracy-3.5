define lattice; ringtype = 1;

Energy = 3.0;

dP = 1e-8; CODeps = 1e-14;  

Meth = 4; Nbend = 10; Nquad = 10; Nsext = 1;

BRHO = 3.33564051648;

NCEL  = 20.0;
NDIP  = 7.0*NCEL;

{ Set energy in machine file. }
CAV: Cavity, Frequency = 0.0, Voltage = 0.0, Harnum = 0;


O:   DRIFT, L = 0.075;

B2:  BENDING, L = 1.2,     T = 360.0/NDIP, N = Nbend, Method = Meth;
B2H: BENDING, L = 1.2/2.0, T = 180.0/NDIP, N = Nbend, Method = Meth;

QF2: Quadrupole, L = 0.19,  K =  1.8947137135501870, N = Nquad, Method = Meth;
QD2: Quadrupole, L = 0.175, K = -1.5392672781755190, N = Nquad, Method = Meth;
QF3: Quadrupole, L = 0.28,  K =  1.8128812598838404, N = Nquad, Method = Meth;
QD3: Quadrupole, L = 0.20,  K = -1.4427225156729524, N = Nquad, Method = Meth;

S1: Sextupole, L = 0.0, K =  0.7947061492234074, N = Nsext, Method = Meth;
S2: Sextupole, L = 0.0, K =  2.3928819055199204, N = Nsext, Method = Meth;
S3: Sextupole, L = 0.0, K = -6.1843506192412336, N = Nsext, Method = Meth;

S4: Multipole, L = 0.0, N = 1, Method = Meth,
    HOM = (3,   1.927709443186250, 0.0),
    HOM = (4, -31.7658700913190870, 0.0);
S5: Multipole, L = 0.0, N = 1, Method = Meth,
    HOM = (3,   0.6809101113294360, 0.0),
    HOM = (4, 155.7135302066802751, 0.0);

FODOH: QD2, O, B2, O, QF2;
FODO:  S1, FODOH, S2, INV(FODOH), S3;

OFW: DRIFT, L = 0.33878254;
O1F: DRIFT, L = 0.20012356;
O2F: DRIFT, L = 0.33371989;

NC0: FODO, QD2, O, B2;

HCELL: OFW, QF3, S4, QF3, O1F, QD3, S5, QD3, O2F, B2H;

FEL:  1*(NC0, HCELL, INV(NC0, HCELL)), CAV;

CELL: FEL, SYMMETRY = 1;  

END;
