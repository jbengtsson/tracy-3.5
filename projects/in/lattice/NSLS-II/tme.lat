define lattice; ringtype = 1;

Energy = 3.0;

dP = 1e-8; CODeps = 1e-14;

Meth = 4; Nbend = 10; Nquad = 10;

pi = 4.0*arctan(1.0);

c0 = 2.99792458e8; h_rf = 1320; C = 10.1586800; Brho = 1e9*Energy/c0;

CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 5.00e6/2, Harnum = h_rf;


D1: Drift, L = 0.7; 
D2: Drift, L = 0.11; 
D3: Drift, L = 3.15998; 

BH: Bending, L = 1.0/2.0, Phi = 3.0/2.0, Phi_1 = 0.0, Phi_2 = 0.0,
    N = Nbend, Method = Meth;

QF: Quadrupole, L = 0.0, B_2 =  2.75856, N = Nquad, Method = Meth;
QD: Quadrupole, L = 0.0, B_2 = -2.23013, N = Nquad, Method = Meth;

HCELL: BH, D1, QF, D2, QD, D3;

LINE: INV(HCELL), HCELL, CAV;

CELL: LINE, SYMMETRY = 1;

END;
