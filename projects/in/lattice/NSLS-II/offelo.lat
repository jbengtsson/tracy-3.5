QF3: Quadrupole, L = 0.3,   K =  1.5185496248200228, N = Nquad, Method = Meth;
QD3: Quadrupole, L = 0.22,  K = -1.2282747865631987, N = Nquad, Method = Meth;

QF2: KQUAD,L=0.19,K1=1.29423206800674
QD2: KQUAD,L=0.175,K1=-1.296222014193225
