DL2C : Drift, L=0.25;
DL3A : Drift, L=0.3886;
DL3B : Drift, L=0.15;
DL4A : Drift, L=0.15;
DL4B : Drift, L=0.15;
DM1A : Drift, L=0.365;
DM1B : Drift, L=0.31;
DM1C : Drift, L=0.2;
DM1D : Drift, L=0.175;
DM1E : Drift, L=0.1;
DM2A : Drift, L=0.2;
DM2B : Drift, L=0.67;
DM2C : Drift, L=0.3;
DPW : Drift, L=0.2;
DSCH : Drift, L=0.1; 

B1: Bending, L = 2.62, T = 6, T1 = 3, T2 = 3, N = Nbend, Method = Meth;   

QH1: Quadrupole,L = 0.25, K=-0.731795403217026, N = Nquad, Method = Meth;  
QH2: Quadrupole,L = 0.4, K=1.67928033360746, N = Nquad, Method = Meth;  
QH3: Quadrupole,L = 0.25, K=-1.88015199224219, N = Nquad, Method = Meth;  
QL1: Quadrupole,L = 0.25, K=-1.71137747234932, N = Nquad, Method = Meth;  
QL2: Quadrupole,L = 0.4, K=2.16334674085661, N = Nquad, Method = Meth;  
QL3: Quadrupole,L = 0.25, K=-1.81060794349248, N = Nquad, Method = Meth;  
QM1: Quadrupole,L = 0.25, K=-0.824646043890212, N = Nquad, Method = Meth;  
QM2: Quadrupole,L = 0.25, K=1.38770751012921, N = Nquad, Method = Meth;   

SH1: Sextupole, L = 0.2, K = 0.975485, N = 1, Method = Meth; 
SH2: Sextupole, L = 0.2, K = 1.576651, N = 1, Method = Meth; 
SH3: Sextupole, L = 0.2, K = -1.884663, N = 1, Method = Meth; 
SH4: Sextupole, L = 0.2, K = -0.96857, N = 1, Method = Meth; 
SL1: Sextupole, L = 0.2, K = 1.99604, N = 1, Method = Meth; 
SL2: Sextupole, L = 0.2, K = 1.999802, N = 1, Method = Meth; 
SL3: Sextupole, L = 0.2, K = -1.997541, N = 1, Method = Meth; 
SM1: Sextupole, L = 0.2, K = -2.219245, N = 1, Method = Meth; 
SM2H: Sextupole, L = 0.125, K = 1.5504, N = 1, Method = Meth; 

SS: Marker;  
LS: Marker;  
MP: Marker;  
GS: Multipole, N = 1, Method = Meth;  
GE: Multipole, N = 1, Method = Meth;  
  
phi1 = 0*2e-3*180.0/pi; L_P = 2e-2;  
DB1: Bending, L = L_P/2.0, T = -phi1/2.0, T1 = -0*phi1/4.0,  
      N = 1, Method = Meth;  
DB:  Bending, L = L_P, T = phi1, N = 1, Method = Meth;  
DB2: Bending, L = L_P/2.0, T = -phi1/2.0, T2 = -0*phi1/4.0,  
      N = 1, Method = Meth;  
  
D_TPW: Drift, L = -L_P;  
  
TPW: D_TPW, DB1, DB, DB2, D_TPW;  

c0 = 2.99792458e8; h_rf = 1320; C = 791.95799999999986;  
  
CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 5.00e6, Harnum = h_rf;  



LB: SL1,DL1A,P1,QL1,DL2A,DSCH,CL1X,CL1Y,DSCH,DL2B,SL2,DL2C,QL2,DL3A,SL3,DL3B,QL3,
 P2,DL4A,DFCH,CL2X,CL2Y,DFCH;

HB: SH1,DH1A,P1,QH1,DH2A,DSCH,CH1X,CH1Y,DSCH,DH2B,SH2,DH2C,QH2,DH3A,SH3,DH3B,QH3,
 P2,DH4A,SH4,DH4B,DFCH,CH2X,CH2Y,DFCH;

DCON1: B1,DM1A,DFCH,CM1X,CM1Y,DFCH,DM1B;

DCON2: B1,DM1C,DPW,DM1D,GS,GE,DFCH,CM1X,CM1Y,DFCH,DM1E;

DISP: P3,QM1,DM2A,SM1,DM2B,QM2,DM2C;

DBA: GS,DCON1,GE,GS,DISP,SM2H,MP,SM2H,p4,INV(DISP),INV(DCON2),GE;

ONESP: LS,DH0,GE,GS,HB,GE,DH4C,DBA,DL4B,GS,INV(LB),GE,GS,DL0,SS,DL0,GE,GS,
 LB,GE,DL4B,DBA,DH4C,GS,INV(HB),GE,GS,DH0;

RING: 1*ONESP, CAV;

CELL: RING, SYMMETRY = 1;  

END;
