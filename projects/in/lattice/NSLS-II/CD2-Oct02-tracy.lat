
{ New DBA30HLC16Es2rng7x7s.opa H(8m) L(5m)Rho = 25m }

define lattice; ringtype = 1;

Energy = 3.0;

dP = 1e-8; CODeps = 1e-14;  
  
Meth = 4; Nbend = 4; Nquad = 4;  
  
pi = 4.0*arctan(1.0);  
  
BPM: Beam Position Monitor ;  
HCM: Corrector, Horizontal, Method =  Meth;  
VCM: Corrector, Vertical, Method =  Meth;  

P1: marker; 
P2: marker; 
P3: marker; 
P4: marker; 
CL1X: marker; 
CL1Y: marker; 
CL2X: marker; 
CL2Y: marker; 
CH1X: marker; 
CH1Y: marker; 
CH2X: marker; 
CH2Y: marker; 
CM1X: marker; 
CM1Y: marker; 
CM2X: marker; 
CM2Y: marker; 

DFCH : Drift, L=0.15;
DH0 : Drift, L=4.65;
DH1A : Drift, L=0.175;
DH2A : Drift, L=0.1575;
DH2B : Drift, L=0.1575;
DH2C : Drift, L=0.15;
DH3A : Drift, L=0.19;
DH3B : Drift, L=0.195;
DH4A : Drift, L=0.175;
DH4B : Drift, L=0.1;
DH4C : Drift, L=0.18;
DL0 : Drift, L=3.35;
DL1A : Drift, L=0.175;
DL2A : Drift, L=0.1375;
