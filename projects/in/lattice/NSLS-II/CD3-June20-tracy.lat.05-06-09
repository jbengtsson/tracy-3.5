{ New DBA30HLC16Es2rng7x7s.opa H(8m) L(5m)Rho = 25m }

define lattice; ringtype = 1;

Energy = 3.0;

dP = 1e-7; CODeps = 1e-14;  
  
Meth = 4; Nbend = 4; Nquad = 4;  
  
pi = 4.0*arctan(1.0);  

c0 = 2.99792458e8; h_rf = 1320; C = 791.958; Brho = 1e9*Energy/c0;
  
CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 5.00e6, Harnum = h_rf;  

 
CH: Corrector, Horizontal, Method= Meth;
CV: Corrector, Vertical, Method= Meth; 

BPM: Beam Position Monitor ; 

GE: Multipole, N = 1, Method = Meth;
GS: Multipole, N = 1, Method = Meth; 

DBPM : Drift, L=0.0875;
DFCH : Drift, L=0.15;
DH0G1A : Drift, L=4.65;
DH1AG2A : Drift, L=0.0875;
DH1AG6B : Drift, L=0.0875;
DH2AG2A : Drift, L=0.1575;
DH2AG6B : Drift, L=0.1325;
DH2BG2A : Drift, L=0.1575;
DH2BG6B : Drift, L=0.1825;
DH2CG2A : Drift, L=0.15;
DH2CG6B : Drift, L=0.15;
DH3AG2A : Drift, L=0.19;
DH3AG6B : Drift, L=0.19;
DH3BG2A : Drift, L=0.195;
DH3BG6B : Drift, L=0.195;
DH4AG2A : Drift, L=0.0875;
DH4AG6B : Drift, L=0.0875;
DH4BG2A : Drift, L=0.2485;
DH4BG6B : Drift, L=0.07714;
DH4CG3A : Drift, L=0.0315;
DH4CG6B : Drift, L=0.20286;
DL0G1A : Drift, L=3.3;
DL1AG2A : Drift, L=0.0875;
DL1AG6B : Drift, L=0.0875;
DL2AG2A : Drift, L=0.1375;
DL2AG6B : Drift, L=0.1375;
DL2BG2A : Drift, L=0.1375;
DL2BG6B : Drift, L=0.1375;
DL2CG2A : Drift, L=0.25;
DL2CG6B : Drift, L=0.25;
DL3AG2A : Drift, L=0.6136;
DL3AG6B : Drift, L=0.6136;
DL3BG2A : Drift, L=0.0875;
DL3BG6B : Drift, L=0.0875;
DL4AG2A : Drift, L=0.2817;
DL4AG6B : Drift, L=0.0822;
DL4BG3A : Drift, L=0.0183;
DL4BG6B : Drift, L=0.2178;
DM1AG3A : Drift, L=0.365;
DM1BG3A : Drift, L=0.31;
DM1CG5B : Drift, L=0.2;
DM1DG5B : Drift, L=0.0554;
DM1EG4B : Drift, L=0.2196;
DM2A2G4A : Drift, L=0.2;
DM2AG4B : Drift, L=0.1125;
DM2B2G4B : Drift, L=0.67;
DM2BG4A : Drift, L=0.5825;
DM2CG4A : Drift, L=0.2;
DM2CG4B : Drift, L=0.2;
DPWG5B : Drift, L=0.2;
DSCH : Drift, L=0.1; 

B1: Bending, L = 2.62, T = 6, T1 = 3, T2 = 3, N = Nbend, Method = Meth;  

QH1: Quadrupole,L = 0.25, K=-0.688256, N = Nquad, Method = Meth;  
QH2: Quadrupole,L = 0.4, K=1.65522, N = Nquad, Method = Meth;  
QH3: Quadrupole,L = 0.25, K=-1.8739, N = Nquad, Method = Meth;  
QL1: Quadrupole,L = 0.25, K=-1.78299, N = Nquad, Method = Meth;  
QL2: Quadrupole,L = 0.4, K=2.01175, N = Nquad, Method = Meth;  
QL3: Quadrupole,L = 0.25, K=-1.55768, N = Nquad, Method = Meth;  
QM1: Quadrupole,L = 0.25, K=-0.824645, N = Nquad, Method = Meth;  
QM2: Quadrupole,L = 0.25, K=1.38771, N = Nquad, Method = Meth;  
SQ1H: Quadrupole,L = 0.1, K=0, N = Nquad, Method = Meth;  
SQ2H: Quadrupole,L = 0.15, K=0, N = Nquad, Method = Meth;   

SL1: Sextupole, L = 0.200000, K =  -7.082275, N = 1, Method = Meth;
SL2: Sextupole, L = 0.200000, K =  17.300233, N = 1, Method = Meth;
SL3: Sextupole, L = 0.200000, K = -15.858235, N = 1, Method = Meth;
SM1: Sextupole, L = 0.200000, K = -13.312748, N = 1, Method = Meth;
SM2: Sextupole, L = 0.250000, K =  13.017847, N = 1, Method = Meth;
SH1: Sextupole, L = 0.200000, K =  13.000488, N = 1, Method = Meth;
SH3: Sextupole, L = 0.200000, K =  -4.410458, N = 1, Method = Meth;
SH4: Sextupole, L = 0.200000, K =  -5.635047, N = 1, Method = Meth;

{ not used }
SH2: Sextupole, L = 0.0, K = 0.0, N = 1, Method = Meth; 
SL4: Sextupole, L = 0.0, K = 0.0, N = 1, Method = Meth; 

OM1: Multipole, L = 0.0, N = 1, Method = Meth,
     HOM = (3, 0.0, 0.0);
OM2: Multipole, L = 0.0, N = 1, Method = Meth,
     HOM = (3, 0.0, 0.0);
OM3: Multipole, L = 0.0, N = 1, Method = Meth,
     HOM = (3, 0.0, 0.0);

MP: Marker;
SS: Marker;
LS: Marker;

lambda_DW = 0.09; n_DW = 78; L_DW = n_DW*lambda_DW; B_DW = 1.8;
DW_90: Wiggler, L = L_DW, lambda = lambda_DW, kxV = 0.0,
       BoBrhoV = B_DW/Brho, N = n_DW*8, Method = 2;

{L_DW = 7.02;
DW_90: insertion, scaling = 1.0, N = 50, Method = 1,
file2 = "/home/bengtsson/projects/in/lattice/w90v5_pole80mm_finemesh_7m.txt";}

DH0G1A_DW : Drift, L=4.65 - L_DW/2.0;

D_DW: Drift, L = -L_DW/2.0;
{DW:   D_DW, DW_90, D_DW;}
DW: DW_90;

{lambda_IVU = 0.020; n_IVU = 150; L_IVU = n_IVU*lambda_IVU;
B_IVU = 1.86/(0.934*1e2*lambda_IVU);
IVU_20: Wiggler, L = L_IVU, lambda = lambda_IVU, kxV = 0.0,
        BoBrhoV = B_IVU/Brho, N = n_IVU*8, Method = 2;}

L_IVU = 3.0;
IVU_20: insertion, scaling = 1.0, N = 50, Method = 2,
        file2 = "/home/bengtsson/projects/in/lattice/u20_3m_finemesh_5th.txt";

D_IVU: Drift, L = -L_IVU/2.0;
IVU: D_IVU, IVU_20, D_IVU;

{L_LIVU = 3.0;}
L_LIVU = 3.916;
IVU_20_g59: insertion, scaling = 1.0, N = 50, Method = 2,
{  file2 = "/home/bengtsson/projects/in/lattice/u20_3m_59mm.txt";}
{  file2 = "/home/bengtsson/projects/in/lattice/u22_pole60mm_finemesh_4m.txt";}
  file2 = "/home/bengtsson/projects/in/lattice/u22_pole80mm_finemesh_4m.txt";

D_LIVU: Drift, L = -L_LIVU/2.0;
IVU_g59: D_LIVU, IVU_20_g59, D_LIVU;

{ EPU: helical-, vertical linear-, and 45 deg inclined mode. }
L_EPU = 3.96;
U55: insertion, scaling = 1.0, N = 50, Method = 2,
 file2 = "/home/bengtsson/projects/in/lattice/u55gap115mm_155mm5th_rev1.txt";
{ file2 = "/home/bengtsson/projects/in/lattice/u55gap115mmph275mm5th_rev1.txt";}
{ file2 = "/home/bengtsson/projects/in/lattice/u55gap115mm_inclined_293mm5th_rev1.txt";}
D_EPU: Drift, L = -L_EPU/2.0;
EPU:   D_EPU, U55, D_EPU;

Girder1C30: DH0G1A,GE;

Girder2C30: GS,SH1,DH1AG2A,BPM,DBPM,QH1,DH2AG2A,SQ1H,
CH,CV,SQ1H,DH2BG2A,SH2,DH2CG2A,QH2,DH3AG2A,
SH3,DH3BG2A,QH3,DH4AG2A,BPM,DBPM,SH4,DH4BG2A,
DFCH,CH,CV,DFCH,GE,DH4CG3A;

Girder3C30: GS,B1,DM1AG3A,DFCH,CH,CV,DFCH,DM1BG3A,
GE;

Girder4C30: GS,OM3,OM2,QM1,DM2A2G4A,SM1,DM2BG4A,BPM,DBPM,QM2,
DM2CG4A,SM2,DM2CG4B,QM2,DM2B2G4B,SM1,DM2AG4B,
BPM,DBPM,QM1,OM1,DM1EG4B,DFCH,CV,CH,DFCH,
GE;

Girder5C30: GS,DM1DG5B,DPWG5B,DM1CG5B,B1,GE,DL4BG6B;

Girder6C30: GS,DFCH,CV,CH,DFCH,DL4AG6B,SL4,QL3,DBPM,
BPM,DL3BG6B,SL3,DL3AG6B,QL2,DL2CG6B,SL2,DL2BG6B,
DSCH,CV,CH,DSCH,DL2AG6B,QL1,DL1AG6B,BPM,
DBPM,SL1,GE;

Girder1C01: GS,DL0G1A,SS,DL0G1A,GE;

Girder2C01: GS,SL1,DL1AG2A,BPM,DBPM,QL1,DL2AG2A,DSCH,
CH,CV,DSCH,DL2BG2A,SL2,DL2CG2A,QL2,DL3AG2A,
SL3,DL3BG2A,BPM,DBPM,QL3,SL4,DL4AG2A,DFCH,CH,
CV,DFCH,GE,DL4BG3A;

Girder3C01: GS,B1,DM1AG3A,SQ2H,CH,CV,SQ2H,DM1BG3A,
GE;

Girder4C01: GS,OM1,OM3,QM1,DM2A2G4A,SM1,DM2BG4A,BPM,DBPM,QM2,
DM2CG4A,SM2,DM2CG4B,QM2,DM2B2G4B,SM1,DM2AG4B,
BPM,DBPM,QM1,OM2,DM1EG4B,DFCH,CV,CH,DFCH,
GE;

Girder5C01: GS,DM1DG5B,DPWG5B,DM1CG5B,B1,GE,DH4CG6B;

Girder6C01: GS,DFCH,CV,CH,DFCH,DH4BG6B,SH4,DH4AG6B,
BPM,DBPM,QH3,DH3BG6B,SH3,DH3AG6B,QH2,DH2CG6B,
SH2,DH2BG6B,DSCH,CV,CH,DSCH,DH2AG6B,QH1,
DH1AG6B,BPM,DBPM,SH1,GE;

Girder1C02H: GS,DH0G1A;


SPC30C01: Girder1C30,Girder2C30,Girder3C30,Girder4C30,Girder5C30,Girder6C30,
          Girder1C01,Girder2C01,Girder3C01,Girder4C01,Girder5C01,Girder6C01,
          Girder1C02H,LS;


{Girder2C30_DW, Girder6C01_DW, DW_Girder6C30, DW_Girder2C01}

Girder1C02H_DW: GS,DH0G1A_DW;

SPC30C01_DW:
  Girder1C30,Girder2C30,Girder3C30,Girder4C30,Girder5C30,Girder6C30,
  Girder1C01,Girder2C01,Girder3C01,Girder4C01,Girder5C01,Girder6C01,
  Girder1C02H_DW,LS;

Girder1C30_DW: DH0G1A_DW,GE;

DW_SPC30C01:
  Girder1C30_DW,Girder2C30,Girder3C30,Girder4C30,Girder5C30,
  Girder6C30,
  Girder1C01,Girder2C01,Girder3C01,Girder4C01,Girder5C01,Girder6C01,
  Girder1C02H,LS;


Girder1C01_IVU: GS,DL0G1A,IVU,DL0G1A,GE;

SPC30C01_IVU: Girder1C30,Girder2C30,Girder3C30,Girder4C30,Girder5C30,
              Girder6C30,Girder1C01_IVU,Girder2C01,Girder3C01,Girder4C01,
              Girder5C01,Girder6C01,Girder1C02H,LS;

DW_SPC30C01_IVU: Girder1C30_DW,Girder2C30,Girder3C30,Girder4C30,Girder5C30,
              Girder6C30,Girder1C01_IVU,Girder2C01,Girder3C01,Girder4C01,
              Girder5C01,Girder6C01,Girder1C02H,LS;

Girder1C01_EPU: GS,DL0G1A,EPU,DL0G1A,GE;

SPC30C01_EPU: Girder1C30,Girder2C30,Girder3C30,Girder4C30,Girder5C30,
              Girder6C30,Girder1C01_EPU,Girder2C01,Girder3C01,Girder4C01,
              Girder5C01,Girder6C01,Girder1C02H,LS;


RING: 1*SPC30C01, CAV;

{ 1 IVU in long straight }
{RING: SPC30C01, IVU_g59, 14*SPC30C01, CAV;}

{ 1 DW (1 super cell) }
{RING: SPC30C01_DW, DW, DW_SPC30C01, CAV;}

{ 3 DWs }
{RING: 1*(SPC30C01_DW, DW, DW_SPC30C01, 3*SPC30C01), CAV;}

{ 3 DWs, 3 IVUs }
{RING: SPC30C01_DW, DW, DW_SPC30C01, SPC30C01_IVU, SPC30C01,     SPC30C01,
      SPC30C01_DW, DW, DW_SPC30C01, SPC30C01,     SPC30C01_IVU, SPC30C01,
      SPC30C01_DW, DW, DW_SPC30C01, SPC30C01,     SPC30C01,     SPC30C01_IVU,
      CAV;}

{ 3 DWs, 5 IVUs }
{RING: SPC30C01_DW, DW, DW_SPC30C01, SPC30C01_IVU, SPC30C01,     SPC30C01_IVU,
      SPC30C01_DW, DW, DW_SPC30C01, SPC30C01,     SPC30C01_IVU, SPC30C01,
      SPC30C01_DW, DW, DW_SPC30C01, SPC30C01,     SPC30C01_IVU, SPC30C01_IVU,
      CAV;}

{ 3 DWs, 10 IVUs }
{RING: SPC30C01_DW, DW, DW_SPC30C01_IVU, SPC30C01_IVU, SPC30C01_IVU,
      SPC30C01_IVU,
      SPC30C01_DW, DW, DW_SPC30C01, SPC30C01_IVU, SPC30C01_IVU, SPC30C01_IVU,
      SPC30C01_DW, DW, DW_SPC30C01, SPC30C01_IVU, SPC30C01_IVU, SPC30C01_IVU,
      CAV;}

{ 3 DWs, 1 IVU in long straight }
{RING: SPC30C01_DW, DW, DW_SPC30C01, SPC30C01,              SPC30C01, SPC30C01,
      SPC30C01_DW, DW, DW_SPC30C01, SPC30C01,     IVU_g59, SPC30C01, SPC30C01,
      SPC30C01_DW, DW, DW_SPC30C01, SPC30C01,              SPC30C01, SPC30C01,
      CAV;}

{ 3 DWs, 5 IVUs, 1 IVU in long straight }
{RING:
  SPC30C01_DW, DW, DW_SPC30C01, SPC30C01_IVU,          SPC30C01,     SPC30C01_IVU,
  SPC30C01_DW, DW, DW_SPC30C01, SPC30C01,     IVU_g59, SPC30C01_IVU, SPC30C01,
  SPC30C01_DW, DW, DW_SPC30C01, SPC30C01,              SPC30C01_IVU, SPC30C01_IVU,
  CAV;}

{ 3 DWs, 1 EPU }
{RING: SPC30C01_DW, DW, DW_SPC30C01, SPC30C01_EPU, SPC30C01, SPC30C01,
      SPC30C01_DW, DW, DW_SPC30C01, SPC30C01,     SPC30C01, SPC30C01,
      SPC30C01_DW, DW, DW_SPC30C01, SPC30C01,     SPC30C01, SPC30C01,
      CAV;}


CELL: RING, SYMMETRY = 1;

END;
