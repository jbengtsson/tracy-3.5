DH1AG6A,BPM,DBPM,SH1,GE;

Girder1C03H: GS,DH0G1A;

SPC01C02: Girder1C01,Girder2C01,Girder3C01,Girder4C01,Girder5C01,Girder6C01,
          Girder1C02,Girder2C02,Girder3C02,Girder4C02,Girder5C02,Girder6C02,
          Girder1C03H, LS;

RING: 1*SPC01C02, CAV;

{ 3 DWs }
{RING: 1*(SPC01C02, DW, 4*SPC01C02), CAV;}

