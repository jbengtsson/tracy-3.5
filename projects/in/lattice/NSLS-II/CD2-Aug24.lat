define lattice;
{ New R3L3SBS4-C6x6Qfgdr EX_2.002 TPW H(9.3) L(6.6M) PMTPW(0.40M)}
Energy = 3.0;

dP = 1e-6; CODeps = 1e-10;

Meth = 4; Nbend = 4; Nquad = 4;

pi = 4.0*arctan(1.0);

{P1: Beam Position Monitor ;
P2: Beam Position Monitor ;
P3: Beam Position Monitor ;}

BPM: Beam Position Monitor;

{CL1X: Corrector, Horizontal, Method= Meth;
CL2X: Corrector, Horizontal, Method= Meth;
CH1X: Corrector, Horizontal, Method= Meth;
CH2X: Corrector, Horizontal, Method= Meth;
CM1X: Corrector, Horizontal, Method= Meth;
CL1Y: Corrector, Vertical, Method= Meth;
CL2Y: Corrector, Vertical, Method= Meth;
CH1Y: Corrector, Vertical, Method= Meth;
CH2Y: Corrector, Vertical, Method= Meth;
CM1Y: Corrector, Vertical, Method= Meth;}

HCM: Corrector, Horizontal, Method= Meth;
VCM: Corrector, Vertical, Method= Meth;

DH0:   Drift, L = 4.650;
DL0:   Drift, L = 3.30;
DH1A:  Drift, L = 0.15000;
DH2A:  Drift, L = 0.24500 ;
DH2B:  Drift, L = 0.24500 ;
DH2C:  Drift, L = 0.1500;
DH3A:  Drift, L = 0.1900;
DH3B:  Drift, L = 0.20000;
DH4A:  Drift, L = 0.15000;
DH4B: Drift, L = 0.250;
DH4C: Drift, L = 0.300;

DM1A:   Drift, L = 0.2000;
DPW:  Drift, L = 0.20000;
DM1B:   Drift, L = 0.4000;
DM1C:  Drift, L = 0.1500;

DM2A:  Drift, L = 0.15000;
DM2B:  Drift, L = 0.62000;
DM2C:   Drift, L = 0.250;

DL3A: Drift, L = 0.38860;
DL3B: Drift, L = 0.15000;

DL4A: Drift, L = 0.2750;
DL4B:  Drift, L = 0.27500;

DL1A: Drift, L = 0.150000;
DL2A: Drift, L = 0.250000;
DL2B: Drift, L = 0.250000;
DL2C: Drift, L = 0.2500 ;  

DSX: Drift,  L = 0.1000;
DSD: Drift,  L = 0.125;
DSC: Drift,  L = 0.075;
DSL: Drift,  L = 0.15;

QH1       : Quadrupole, L = 0.300000, K =-0.621453,  N = Nquad, Method = Meth;
QH2       : Quadrupole, L = 0.400000, K = 1.668877,  N = Nquad, Method = Meth;
QH3       : Quadrupole, L = 0.300000, K = -1.551548,  N = Nquad, Method = Meth;
QM2      : Quadrupole, L = 0.300000, K =  1.159750,  N = Nquad, Method = Meth;
QM1      : Quadrupole, L = 0.300000, K = -0.685803,  N = Nquad, Method = Meth;
QL3      : Quadrupole, L = 0.300000, K =  -1.538644,  N = Nquad, Method = Meth;
QL2      : Quadrupole, L = 0.400000, K = 2.117711,  N = Nquad, Method = Meth;
QL1      : Quadrupole, L = 0.300000, K = -1.316453,  N = Nquad, Method = Meth;

B1: Bending, L = 2.62, T =  6.0000,
    T1 =  3.000, T2 =  3.0000, N = Nbend, Method = Meth;

SL1      : Sextupole, K =  1.996040, N = 1, Method = Meth;
SL2      : Sextupole, K =  1.999802, N = 1, Method = Meth;
SL3      : Sextupole, K = -1.997541, N = 1, Method = Meth;
SM1      : Sextupole, K = -2.219245, N = 1, Method = Meth;
SM2      : Sextupole, K =  3.100800, N = 1, Method = Meth;
SH1      : Sextupole, K =  0.975485, N = 1, Method = Meth;
SH2      : Sextupole, K =  1.576651, N = 1, Method = Meth;
SH3      : Sextupole, K = -1.884663, N = 1, Method = Meth;
SH4      : Sextupole, K = -0.968570, N = 1, Method = Meth;


SQ: Multipole, N = 1, Method = Meth;

MP : Marker;
SS : Marker;
LS : Marker;
SEPTUM: Marker; 
GS: Multipole, N = 1, Method = Meth;
GE: Multipole, N = 1, Method = Meth;

c0 = 2.99792458e8; h_rf = 1300; C = 791.958;
Brho = 1e9*Energy/c0;

{ Mini Gap Undulator }
lambda_CPMU = 19e-3; n_CPMU = 160; B_CPMU = 2.2/(0.934*1e2*lambda_CPMU);
L_CPMU = n_CPMU*lambda_CPMU;

D_CPMU: Drift, L = -L_CPMU/2.0;

CPMU1: Wiggler, L = L_CPMU/2.0, lambda = lambda_CPMU,
       kxV = 0.0, BoBrhoV = B_CPMU/Brho, N = n_CPMU*4, Method = 1;

CPMU: D_CPMU, CPMU1;


{    /************************************************************************
      Wiggler
    *************************************************************************

    <name>: Wiggler,
            L       = <length [m]>,
            BoBrhoV = <B/Brho [1/m]>,
            BoBrhoH = <B/Brho [1/m]>,
            Lambda  = <period [m]>,
            kxV     = <[m]>,
            kxH     = <[m]>,
            phi     = <phase [deg]>,
            harm(n, kxV, BoBrhoV, kxH, BoBrhoH, phi)
            ...
            N       = <no of integration steps>,
            Method  = <method>,

    Example

      U143: wiggler, L=4.80, K=0.5, Lambda=0.15, N=20, Method=0;

      EPU:  wiggler, L=4.80, Lambda=0.15, N=20, Method=0,
            harm=(3, kxV_3, BoBrhoV_3, kxH_3, BoBrhoH_3, phi_3,
                  ...
                  5, kxV_5, BoBrhoV_5, kxH_5, BoBrhoH_5, phi_5);
 
    **************************************************************************/}

{ Damping wiggler }
lambda_DW = 8e-2; n_DW = 88; L_DW = n_DW*lambda_DW; B_DW=1.81246*1;

D_DW: Drift, L = -L_DW/2.0;

{DW1: Wiggler, L = L_DW/2.0, lambda = lambda_DW, kxV = 0.0, 
     BoBrhoV = B_DW/Brho, N = n_DW*4, Method = 1;}
{Toshi's standard DW poles}
DW1: Wiggler, L = L_DW/2.0, lambda = lambda_DW, kxV = 5.0341*0, 
     BoBrhoV = B_DW/Brho, N = n_DW*5, Method = 1{,
     harm = (3,  1.9917*1,  0.044716/Brho*1, 0, 0, 0,
             5,  1.0064*1, -0.060881/Brho*1, 0, 0, 0,
             7,  1.0000*1, -0.007070/Brho*1, 0, 0, 0,
             9,  0.9996*1,  0.004144/Brho*1, 0, 0, 0)};

DW: D_DW, DW1;

{EPU}
lambda_EPU = 19e-3; n_EPU = 158; B_EPU = 1.0*2.2/(0.934*1e2*lambda_EPU);
L_EPU = n_EPU*lambda_EPU;
D_EPU: Drift, L = -L_EPU/2.0;
EPU1: Wiggler, L = L_EPU/2.0, lambda = lambda_EPU, kxV = 0.0, kxH = 0.0,
      BoBrhoV = B_EPU/Brho*1.0, BoBrhoH = B_EPU/Brho*1.0, phi=1.571, N = n_EPU*4, Method = 1;
EPU: D_EPU, EPU1;



CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 5.00e6, Harnum = h_rf;

LB: DSX,SL1,DSX,DL1A,BPM,QL1,DL2A,HCM,VCM,DL2B,DSX,SL2,DSX,DL2C,QL2,DL3A,
DSX,SL3,DSX,DL3B,QL3,BPM,DL4A,HCM,VCM;


HB: DSX,SH1,DSX,DH1A,BPM,QH1,DH2A,HCM,VCM,DH2B,DSX,SH2,DSX,DH2C,QH2,DH3A,DSX,
 SH3,DSX,DH3B,QH3,BPM,DH4A,DSX,SH4,DSX,DH4B,HCM,VCM ;

HB_SQ: DSX,SH1,DSX,DH1A,BPM,QH1,DH2A,HCM,VCM,SQ,DH2B,DSX,SH2,DSX,DH2C,QH2,DH3A,DSX,
 SH3,DSX,DH3B,QH3,BPM,DH4A,DSX,SH4,DSX,DH4B,HCM,VCM ;


DISP: DM1B,HCM,VCM,DM1C,BPM,QM1,DM2A,DSD,SM1,DSD,DM2B,QM2,DM2C;

DISP_SQ: DM1B,HCM,VCM,SQ,DM1C,BPM,QM1,DM2A,DSD,SM1,DSD,DM2B,QM2,DM2C;

DBA: GS,B1,DM1A,DPW,GE,GS,DISP,DSL,SM2,MP,DSL,INV(DISP),GE,GS,DPW,DM1A,B1,GE;

DBA_SQ: GS,B1,DM1A,DPW,GE,GS,DISP_SQ,DSL,SM2,MP,DSL,INV(DISP),GE,GS,DPW,DM1A,B1,GE;

ONESP: LS,DH0,GE,GS,HB_SQ,GE,DH4C,DBA_SQ,DL4B,GS,INV(LB),GE,GS,DL0,SS,DL0,GE,
GS,LB,GE,DL4B,DBA,DH4C,GS,INV(HB),GE,GS,DH0 ;


ONESP_DW1: LS,DH0,GE,GS,HB_SQ,GE,DH4C,DBA_SQ,DL4B,GS,INV(LB),GE,GS,DL0,SS,DL0,GE,
GS,LB,GE,DL4B,DBA,DH4C,GS,INV(HB),GE,GS,DH0, DW;

ONESP_CPMU: LS,DH0,GE,GS,HB_SQ,GE,DH4C,DBA_SQ,DL4B,GS,INV(LB),GE,GS,DL0,SS,CPMU,INV(CPMU),DL0,GE,
GS,LB,GE,DL4B,DBA,DH4C,GS,INV(HB),GE,GS,DH0;

ONESP_EPU: LS,DH0,GE,GS,HB_SQ,GE,DH4C,DBA_SQ,DL4B,GS,INV(LB),GE,GS,DL0,SS,EPU,INV(EPU),DL0,GE,
GS,LB,GE,DL4B,DBA,DH4C,GS,INV(HB),GE,GS,DH0;

{ 14 DW, use [Q11, Q22, Q44] }
{RING: SEPTUM,. 14*ONESP_DW1, 1*ONESP, CAV;}

{3 DW}
{RING: SEPTUM, 3*ONESP_DW1, 12*ONESP, CAV;}

{RING: SEPTUM, 3*(ONESP_DW1, INV(DW)), 
      3*ONESP_CPMU, 9*ONESP, CAV;}

{RING: SEPTUM, 3*(3*ONESP, ONESP_DW1, INV(DW), ONESP_CPMU),CAV;}

{RING: SEPTUM, 3*(4*ONESP, ONESP_DW1, INV(DW)),CAV;}

{3 DW, 1CPMU, 1EPU}
{RING: SEPTUM, 2*(ONESP_DW1, INV(DW), 4*ONESP), 
      1*(ONESP_DW1, INV(DW), 2*ONESP, 1*ONESP_CPMU, 1*ONESP_EPU), CAV;}


RING: 1*ONESP, CAV;

CELL: RING, SYMMETRY  = 1;

END;
