{ New DBA30HLC16Es2rng7x7s.opa H(8m) L(5m)Rho = 25m }

define lattice; ringtype = 1;

Energy = 3.0;

dP = 1e-8; CODeps = 1e-14;

Meth = 4; Nbend = 4; Nquad = 4;

pi = 4.0*arctan(1.0);

BPM: Beam Position Monitor ;
HCM: Corrector, Horizontal, Method =  Meth;
VCM: Corrector, Vertical, Method =  Meth;

D0:   Drift, L = 4.965566636697073;
D00:  Drift, L = 2.5;
D1:   Drift, L = 0.6459099617090653;
D1H:  Drift, L = D1.L/2.0;
D11B: Drift, L = 0.3779617347127556;
D2:   Drift, L = 0.5276275246723442;
D2H:  Drift, L = D2.L/2.0;
D22:  Drift, L = 0.7413591880419107;
D22H: Drift, L = D22.L/2.0;
D3:   Drift, L = 0.5737570260333396;
D3H:  Drift, L = D3.L/2.0;
D33:  Drift, L = 0.6481901984324447;
D33H: Drift, L = D33.L/2.0;
D4:   Drift, L = 0.5129067044527214;
D4H:  Drift, L = D4.L/2.0;
D44:  Drift, L = 0.5146505141674383;
D44H: Drift, L = D44.L/2.0;
D5:   Drift, L = 1.300490669282677;
D5H:  Drift, L = D5.L/2.0;
D6:   Drift, L = 0.5524894063352802;
D6A:  Drift, L = D6.L/2.0;
D6B:  Drift, L = D6.L/2.0;
D7:   Drift, L = 0.8499696941756416;
D7H:  Drift, L = D7.L/2.0;

QD3: Quadrupole, L = 0.3, K = -0.9773474213287056, N = Nquad, Method = Meth;
QF2: Quadrupole, L = 0.3, K =  1.438711005207947,  N = Nquad, Method = Meth;
{Q1:  Quadrupole, L = 0.3, K = -0.9290874082851831, N = Nquad, Method = Meth;
Q2:  Quadrupole, L = 0.3, K =  1.165762569933891,  N = Nquad, Method = Meth;
Q3:  Quadrupole, L = 0.3, K =  1.319528846035364,  N = Nquad, Method = Meth;
Q4:  Quadrupole, L = 0.3, K = -1.466929530923339,  N = Nquad, Method = Meth;
Q22: Quadrupole, L = 0.3, K = -1.804792229768912,  N = Nquad, Method = Meth;
Q33: Quadrupole, L = 0.4, K =  2.479004780085707,  N = Nquad, Method = Meth;
Q44: Quadrupole, L = 0.3, K = -1.686171735340237,  N = Nquad, Method = Meth;}

Q22: Quadrupole, L = 0.300000, K = -2.316785, N = Nquad, Method = Meth;
Q33: Quadrupole, L = 0.400000, K =  2.403590, N = Nquad, Method = Meth;
Q44: Quadrupole, L = 0.300000, K = -1.237149, N = Nquad, Method = Meth;
Q1:  Quadrupole, L = 0.300000, K = -0.880090, N = Nquad, Method = Meth;
Q2:  Quadrupole, L = 0.300000, K =  1.235982, N = Nquad, Method = Meth;
Q3:  Quadrupole, L = 0.300000, K =  1.171453, N = Nquad, Method = Meth;
Q4:  Quadrupole, L = 0.300000, K = -1.425402, N = Nquad, Method = Meth;

{DUQ1:  Drift, L = 0.0;
DDQ1:  Drift, L = 0.0;
DUQ2:  Drift, L = 0.0;
DDQ2:  Drift, L = 0.0;
DUQ3:  Drift, L = 0.0;
DDQ3:  Drift, L = 0.0;
DUQ4:  Drift, L = 0.0;
DDQ4:  Drift, L = 0.0;
DUQ22: Drift, L = 0.0;
DDQ22: Drift, L = 0.0;
DUQ33: Drift, L = 0.0;
DDQ33: Drift, L = 0.0;
DUQ44: Drift, L = 0.0;
DDQ44: Drift, L = 0.0;}

DUQ1:  Drift, L =  0.000421;
DDQ1:  Drift, L = -0.000421;
DUQ2:  Drift, L = -0.002571;
DDQ2:  Drift, L =  0.002571;
DUQ3:  Drift, L = -0.001328;
DDQ3:  Drift, L =  0.001328;
DUQ4:  Drift, L = -0.003133;
DDQ4:  Drift, L =  0.003133;
DDQ22: Drift, L =  0.006834;
DUQ22: Drift, L = -0.006834;
DDQ33: Drift, L = -0.023710;
DUQ33: Drift, L =  0.023710;
DDQ44: Drift, L =  0.003919;
DUQ44: Drift, L = -0.003919;

QQ1:  DUQ1, Q1, DDQ1;
QQ2:  DUQ2, Q2, DDQ2;
QQ3:  DUQ3, Q3, DDQ3;
QQ4:  DUQ4, Q4, DDQ4;

QQ22:  DUQ22, Q22, DDQ22;
QQ33:  DUQ33, Q33, DDQ33;
QQ44:  DUQ44, Q44, DDQ44;

B1: Bending, L = 2.62, T = 6.0, T1 = 3.0, T2 = 3.0, N = Nbend, Method = Meth;

{S1:  Sextupole, K = 1e-10, N = 1, Method = Meth;
S2:  Sextupole, K = 1e-10, N = 1, Method = Meth;
S3:  Sextupole, K = 1e-10, N = 1, Method = Meth;
S4:  Sextupole, K = 1e-10, N = 1, Method = Meth;
SD1: Sextupole, K = 1e-10, N = 1, Method = Meth;
SF1: Sextupole, K = 1e-10, N = 1, Method = Meth;
SF2: Sextupole, K = 1e-10, N = 1, Method = Meth;
SL1: Sextupole, K = 1e-10, N = 1, Method = Meth;
SL2: Sextupole, K = 1e-10, N = 1, Method = Meth;
SL3: Sextupole, K = 1e-10, N = 1, Method = Meth;
SL4: Sextupole, K = 1e-10, N = 1, Method = Meth;}

S2: Sextupole, K = -2.211753, N = 1, Method = Meth;
S3: Sextupole, K =  4.000000, N = 1, Method = Meth;
S4: Sextupole, K = -4.000000, N = 1, Method = Meth;
SD1: Sextupole, K = -2.221011, N = 1, Method = Meth;
SF1: Sextupole, K = -0.619104, N = 1, Method = Meth;
SF2: Sextupole, K =  2.647302, N = 1, Method = Meth;
SL1: Sextupole, K = -1.493074, N = 1, Method = Meth;
SL2: Sextupole, K =  3.863057, N = 1, Method = Meth;
SL3: Sextupole, K = -4.000000, N = 1, Method = Meth;
SL4: Sextupole, K =  1.428114, N = 1, Method = Meth;

SS: Marker;
LS: Marker;
MP: Marker;
GS: Multipole, N = 1, Method = Meth;
GE: Multipole, N = 1, Method = Meth;

c0 = 2.99792458e8; h_rf = 1300; C = 781.6149;

CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 5.00e6, Harnum = h_rf;


{ Note, the negative drift will mess up the integer tune }
{L_TPW = 0.1176;

TPWD: insertion, scaling = 1, N = 10,
     file2 = "lattice/3polewedge20mmmiddle.txt";}

phi = 0*2e-3*180.0/pi; L_P = 2e-2;
DB: Bending, L = L_P, T = phi, N = 1, Method = Meth;
DBH: Bending, L = L_P/2.0, T = -phi/2.0, N = 1, Method = Meth;

D_TPW: Drift, L = -L_P;

TPW: D_TPW, DBH, DB, DBH, D_TPW;


LB:D11B, BPM, QQ22, D22H, HCM, VCM, S2, D22H, QQ33, D33H, S3, 
    D33H, QQ44, BPM, D44H, S4, D44H, HCM, VCM;

HB: QQ1, D1H, SL1, HCM, VCM, D1H, BPM, QQ2, D2H, SL2, 
    D2H, QQ3, D3H, SL3, D3H, QQ4, BPM, D4H, SL4, D4H, HCM, VCM;

DISP: HCM, VCM, SD1, D5H, BPM, QD3, D6A, SF1, D6B, QF2;

DBA: B1, TPW, D5H, GS, DISP, BPM, D7H, D7H, SF2, MP, 
     D7H, HCM, D7H, INV(DISP), GE, D5H, B1;

ONEP: D0, GS, HB, DBA, INV(LB), GE,  D00, SS, 
      D00, GS, LB, DBA, INV(HB), GE, D0, LS;

RING: 1*ONEP, CAV;

CELL: RING, SYMMETRY = 1;

END;

