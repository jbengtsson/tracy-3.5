define lattice; ringtype = 1;

Energy = 3.0;

dP = 1e-7; CODeps = 1e-14;  
  
Meth = 4; Nbend = 4; Nquad = 4;  
  
pi = 4.0*arctan(1.0);  

c0 = 2.99792458e8; Brho = 1e9*Energy/c0;
  
d1: drift, L = 1.0;
d2: drift, L = 1.0;
d3: drift, L = 1.0;
d4: drift, L = 1.0;
d5: drift, L = 1.0;
d6: drift, L = 1.0;
d7: drift, L = 1.0;
d8: drift, L = 1.0;

s1: spreader;
r1: recombiner;

line: d1, d2, s1, d3, d4, d5, d6, r1, d7, d8;

cell: line, symmetry = 1;

end;
