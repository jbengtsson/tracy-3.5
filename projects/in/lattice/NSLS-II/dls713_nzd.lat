define lattice;

intmeth= 4;

{***** System parameters *****}
Energy= 3.00;    { GeV }
dP    = 1.0d-10;
CODeps= 1.0d-15;

{***** drift space *****}

 D1D2 : drift, L= 4.940500;
 D1BCentre: drift, L= 1.000000;
 D1BEnd2: drift, L= 2.440500;
 D1A  : drift, L= 0.238500;
 D2A  : drift, L= 0.199000;
 D2B  : drift, L= 0.150000;
 D3A  : drift, L= 0.425000;
 D3B  : drift, L= 0.235000;
 D4A  : drift, L= 0.587500;
 D4B  : drift, L= 0.465000;
 D5B  : drift, L= 0.200000;
 D6B  : drift, L= 0.667500;
 KD1  : drift, L= 0.330000;
 KD2  : drift, L= 0.401000;
 KD3  : drift, L= 0.330000;
 KD4  : drift, L= 0.401000;
 DS1A : drift, L= 0.15;
 DS2A : drift, L= 0.10;
 
{** Quadrupole **}
Nq=16/2; {Number of slices}

 Q1D : quadrupole, L=0.40,K= -0.712625, method=intmeth,N=Nq;
 Q2D : quadrupole, L=0.60,K=  1.272800, method=intmeth,N=Nq;
 Q3D : quadrupole, L=0.30,K= -1.007140, method=intmeth,N=Nq;
 Q2AD: quadrupole, L=0.40,K= -0.989630, method=intmeth,N=Nq;
 Q1AD: quadrupole, L=0.40,K=  1.263560, method=intmeth,N=Nq;
 Q1AB: quadrupole, L=0.40,K=  1.286190, method=intmeth,N=Nq;
 Q2AB: quadrupole, L=0.40,K= -1.044950, method=intmeth,N=Nq;
 Q3B : quadrupole, L=0.30,K= -0.884370, method=intmeth,N=Nq;
 Q2B : quadrupole, L=0.60,K=  1.475330, method=intmeth,N=Nq;
 Q1B : quadrupole, L=0.40,K= -1.246210, method=intmeth,N=Nq;


{** bending **}
 BB  : bending, L= 0.936, T= 7.5, T1=3.75, T2=3.75, K=0.0, N=4,
	method=intmeth;

NqSx=1; {Number of slices}
 
{** Sextupole **} 
MS1A : sextupole, K =  5.323935, method=intmeth, N = NqSx;
MS2A : sextupole, K = -3.29728, method=intmeth, N = NqSx;
MS1B : sextupole, K =  2.988495, method=intmeth, N = NqSx;
MS2B : sextupole, K = -4.500225, method=intmeth, N = NqSx;
MS1C : sextupole, K =  2.407965, method=intmeth, N = NqSx;
MS2C : sextupole, K = -2.924715, method=intmeth, N = NqSx;
MS1D : sextupole, K =  2.33046, method=intmeth, N = NqSx;
MS2D : sextupole, K = -4.71717, method=intmeth, N = NqSx;


{** Marker **}
 FIN : marker;
 DEBUT : marker;
 MBA: marker;
 MBB: marker;
 MBC: marker;
 MBD: marker;
 MBD2: marker;
 MBE: marker; 
 K1 : marker;
 K2 : marker;

{**Superperiods**}
S1A: DS1A, MS1A, DS1A;
S2A: DS2A, MS2A, DS2A;
S1B: DS1A, MS1B, DS1A;
S2B: DS1A, MS2B, DS1A;
S1C: DS1A, MS1C, DS1A;
S2C: DS1A, MS2C, DS1A;
S1D: DS1A, MS1D, DS1A;
S2D: DS1A, MS2D, DS1A;

PERIOD: DEBUT, D1D2, 
 MBD2, K2, KD3, K2, KD4,
 Q1D, D2B, S1D, D3B, Q2D, D4B,
 Q3D, MBC, D5B,  S2D, D6B,  BB,
 D4A, MBE, Q2AD, D3A, S2A,  D2A,
 Q1AD, D1A, S1A,  MBA, D1A,  Q1AB,
 D2A, MBB, S2A,  D3A, Q2AB, D4A,
 BB, D6B, MBC,  S2C, D5B,  Q3B,
 D4B, Q2B, D3B,  S1C, D2B,  Q1B,
 KD2, K1,  KD1,  K1,  MBD,  D1BEnd2,
 D1BCentre, D1BCentre,  D1BEnd2,  MBD, K1, KD1,
 K1, KD2, Q1B,  D2B, S1B,  D3B,
 Q2B, D4B, Q3B,  MBC, D5B,  S2B,
 D6B, BB,  D4A,  MBE, Q2AB, D3A,
 S2A, D2A, Q1AB, D1A, S1A,  MBA,
 D1A, Q1AB,D2A,  MBB, S2A,  D3A,
 Q2AB, D4A,  BB,  D6B, MBC,  S2B,
 D5B, Q3B,  D4B, Q2B, D3B,  S1B,
 D2B, Q1B,  KD2, K1,  KD1,  K1,
 MBD, D1BEnd2, D1BCentre, D1BCentre, D1BEnd2, MBD,
 K1, KD1,  K1,  KD2, Q1B,  D2B,
 S1B, D3B,  Q2B, D4B, Q3B,  MBC,
 D5B, S2B,  D6B, BB,  D4A,  MBE,
 Q2AB, D3A,  S2A, D2A, Q1AB, D1A,
 S1A, MBA,  D1A, Q1AB,D2A,  MBB,
 S2A, D3A,  Q2AB,D4A, BB,   D6B,
 MBC, S2B,  D5B, Q3B, D4B,  Q2B,
 D3B, S1B,  D2B, Q1B, KD2,  K1,
 KD1, K1,   MBD, D1BEnd2,   D1BCentre,  D1BCentre,
 D1BEnd2, MBD, K1,KD1, K1,   KD2,
 Q1B, D2B,  S1C, D3B, Q2B,  D4B,
 Q3B, MBC,  D5B, S2C, D6B,  BB,
 D4A, MBE,  Q2AB,D3A, S2A,  D2A,
 Q1AB, D1A,  S1A, MBA, D1A,  Q1AD,
 D2A, MBB,  S2A, D3A, Q2AD, D4A,
 BB, D6B,  MBC, S2D, D5B,  Q3D,
 D4B, Q2D,  D3B, S1D, D2B,  Q1D,
 KD4, K2,   KD3, K2,  MBD2,  D1D2;

CAV: Cavity, Frequency=499.66d6, Voltage=3.3d6;

{RING: PERIOD,PERIOD,PERIOD,PERIOD,PERIOD,PERIOD,CAV;}

RING: PERIOD, CAV;

{***** Define CELL structure ****}
 CELL:	RING, symmetry = 1;

end;
