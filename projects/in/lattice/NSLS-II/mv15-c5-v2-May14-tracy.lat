DH3BG2A,QH3SP01,DH4AG2A,BPM,DBPM,SH4,DH4BG2A,DFCH,
CHV,DFCH,GE,DH4CG3A;

Girder3C08: GS,B1SP01,DM1AG3A,DFCH,CHV,SM3,DFCH,DM1BG3A,GE;

Girder4C08: GS,QM1SP01,DM2AG4A,SM1A,DM2BG4A,BPM,DBPM,QM2SP01,
DM2CG4A,SM2,DM2CG4B,QM2SP01,DM2BG4B,SM1B,DM2AG4B,
BPM,DBPM,QM1SP01,DM1EG4B,DFCH,SM3,CHV,DFCH,GE;

Girder5C08: GS,DM1DG5B,DPWG5B,DM1CG5B,B1SP01,GE,DL4BG6B;

Girder6C08: GS,DFCH,CHV,DFCH,DL4AG6B,QL3SP01,DBPM,BPM,
DL3BG6B,SL3,DL3AG6B,QL2SP01,DL2CG6B,SL2,DL2BG6B,DSCH,
CHV,DSCH,DL2AG6B,QL1SP01,DL1AG6B,BPM,DBPM,SL1,
GE;

Girder1C09: GS,DL0G1A,DL0G1A,GE;

Girder2C09: GS,SL1,DL1AG2A,BPM,DBPM,QL1SP01,DL2AG2A,DSCH,
CHV,DSCH,DL2BG2A,SL2,DL2CG2A,QL2SP01,DL3AG2A,SL3,
DL3BG2A,BPM,DBPM,QL3SP01,DL4AG2A,DFCH,CHV,DFCH,
GE,DL4BG3A;

Girder3C09: GS,B1SP01,DM1AG3A,SQ2HSP01,CHV,SM3,SQ2HSP01,DM1BG3A,GE;

Girder4C09: GS,QM1SP01,DM2A2G4B,SM1A,DM2B2G4B,BPM,DBPM,QM2SP01,
DM2CG4A,SM2,DM2CG4B,QM2SP01,DM2B2G4A,SM1B,DM2A2G4A,
BPM,DBPM,QM1SP01,DM1EG4B,DFCH,SM3,CHV,DFCH,GE;

Girder5C09: GS,DM1DG5B,DPWG5B,DM1CG5B,B1SP01,GE,DH4CG6B;

Girder6C09: GS,DFCH,CHV,DFCH,DH4BG6B,SH4,DH4AG6B,BPM,
DBPM,QH3SP01,DH3BG6B,SH3,DH3AG6B,QH2SP01,DH2CG6B,SH2,
DH2BG6B,DSCH,CHV,DSCH,DH2AG6B,QH1SP01,DH1AG6B,BPM,
DBPM,SH1,GE;

Girder1C10: {GS,}DH0G1A;


SPC30C01:
  Girder1C30,Girder2C30,Girder3C30,Girder4C30,Girder5C30,Girder6C30,Girder1C01,
  Girder2C01,Girder3C01,Girder4C01,Girder5C01,Girder6C01,Girder1C02,Girder2C02,
  Girder3C02,Girder4C02,Girder5C02,Girder6C02,Girder1C03,Girder2C03,Girder3C03,
  Girder4C03,Girder5C03,Girder6C03,Girder1C04,Girder2C04,Girder3C04,Girder4C04,
  Girder5C04,Girder6C04,Girder1C05,Girder2C05,Girder3C05,Girder4C05,Girder5C05,
  Girder6C05,Girder1C06,Girder2C06,Girder3C06,Girder4C06,Girder5C06,Girder6C06,
  Girder1C07,Girder2C07,Girder3C07,Girder4C07,Girder5C07,Girder6C07,
  Girder1C08,Girder2C08,Girder3C08,Girder4C08,Girder5C08,Girder6C08,Girder1C09,
  Girder2C09,Girder3C09,Girder4C09,Girder5C09,Girder6C09,Girder1C10;

LINE:
  Girder1C30,
  Girder2C08,Girder3C08,Girder4C08,Girder5C08,Girder6C08,
  Girder1C09,
  Girder2C09,Girder3C09,Girder4C09,Girder5C09,Girder6C09,
  Girder1C10;

LINE_IVU:
  Girder1C30,
  Girder2C08,Girder3C08,Girder4C08,Girder5C08,Girder6C08,
  {Girder1C09,}
  GS,DL0G1A,IVU,DL0G1A,GE,
  Girder2C09,Girder3C09,Girder4C09,Girder5C09,Girder6C09,
  Girder1C10;

LINE_EPU:
  Girder1C30,
  Girder2C08,Girder3C08,Girder4C08,Girder5C08,Girder6C08,
  {Girder1C09,}
  GS,DL0G1A,EPU,DL0G1A,GE,
  Girder2C09,Girder3C09,Girder4C09,Girder5C09,Girder6C09,
  Girder1C10;

LINE_SCW:
  Girder1C30,
  Girder2C08,Girder3C08,Girder4C08,Girder5C08,Girder6C08,
  {Girder1C09,}
  GS,DL0G1A,SCW,DL0G1A,GE,
  Girder2C09,Girder3C09,Girder4C09,Girder5C09,Girder6C09,
  Girder1C10;

RING: 1*LINE, CAV;

{RING: 1*(LINE, DW, 4*LINE), CAV;}

{ 3 DWs, 3 IVUs, 1 EPU, 1 LIVU }
{RING:
  LINE, DW, LINE_IVU,       LINE_EPU, LINE,     LINE,
  LINE, DW, LINE,     LIVU, LINE_IVU, LINE,     LINE,
  LINE, DW, LINE,           LINE,     LINE_IVU, LINE,
  CAV;}

{ 3 DWs, 5 IVUs }
{RING:
  LINE, DW, LINE_IVU, LINE_IVU, LINE,     LINE,
  LINE, DW, LINE,     LINE_IVU, LINE_IVU, LINE,
  LINE, DW, LINE,     LINE,     LINE_IVU, LINE,
  CAV;}

{ 3 DWs, 10 IVUs }
{RING:
  LINE,     DW, LINE_IVU, LINE_IVU, LINE_IVU, LINE_IVU,
  LINE_IVU, DW, LINE,     LINE_IVU, LINE_IVU, LINE_IVU,
  LINE,     DW, LINE_IVU, LINE,     LINE_IVU, LINE,
  CAV;}

{ 3 DWs, 15 IVUs }
{RING:
  LINE_IVU, DW, LINE_IVU, LINE_IVU, LINE_IVU, LINE_IVU,
  LINE_IVU, DW, LINE_IVU, LINE_IVU, LINE_IVU, LINE_IVU,
  LINE_IVU, DW, LINE_IVU, LINE_IVU, LINE_IVU, LINE_IVU,
  CAV;}

{ 3 DWs, 1 EPU }
{RING:
  LINE, DW, LINE, LINE_EPU, LINE, LINE,
  LINE, DW, LINE  LINE,     LINE, LINE,
  LINE, DW, LINE, LINE,     LINE, LINE,
  CAV;}

{ 3 DWs, 3 EPUs }
{RING:
  LINE, DW, LINE, LINE_EPU, LINE, LINE,
  LINE, DW, LINE  LINE_EPU, LINE, LINE,
  LINE, DW, LINE, LINE_EPU, LINE, LINE,
  CAV;}

{ 3 DWs, 1 SCW }
{RING:
  LINE, DW, 3*LINE, LINE_SCW,
  2*(LINE, DW, LINE, LINE, LINE, LINE), CAV;}

{ 3 DWs, 14 IVUs, 1 SCW }
{RING:
  LINE_IVU, DW, LINE_IVU, LINE_IVU, LINE_SCW, LINE_IVU,
  LINE_IVU, DW, LINE_IVU, LINE_IVU, LINE_IVU, LINE_IVU,
  LINE_IVU, DW, LINE_IVU, LINE_IVU, LINE_IVU, LINE_IVU,
  CAV;}

{ 3 DWs, 13 IVUs, 1 EPU, 1 SCW }
{RING:
  LINE_IVU, DW, LINE_EPU, LINE_IVU, LINE_SCW, LINE_IVU,
  LINE_IVU, DW, LINE_IVU, LINE_IVU, LINE_IVU, LINE_IVU,
  LINE_IVU, DW, LINE_IVU, LINE_IVU, LINE_IVU, LINE_IVU,
  CAV;}

{ 12 DWs, 15 IVUs for error tolerances }
{RING:
  LINE_IVU, DW, LINE_IVU, DW, LINE_IVU, DW, LINE_IVU, DW, LINE_IVU,
  LINE_IVU, DW, LINE_IVU, DW, LINE_IVU, DW, LINE_IVU, DW, LINE_IVU,
  LINE_IVU, DW, LINE_IVU, DW, LINE_IVU, DW, LINE_IVU, DW, LINE_IVU,
  CAV;}

CELL: RING, SYMMETRY = 1;  

END;
