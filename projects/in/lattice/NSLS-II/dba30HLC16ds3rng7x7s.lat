c0 = 2.99792458e8  ; h_rf = 1300; C = 780.30 ;

CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 5.00e6, Harnum = h_rf;

LB: D00, Q11, TWK1, D11A, DSX, S1, SQ, DSX, BPM, D11B, Q22, TWK2, D22A,
    DSX, S2, HCM, VCM, DSX, D22B, Q33, TWK3, D33A, DSX, S3, DSX, D33B,
