    DSX, D2B, Q3, D3A, DSX, SL3, DSX, D3B, Q4, D4A, BPM, DSX, SL4, HCM, VCM,
    DSX, D4B;

DISP: B1, D5, DSD, VCM, HCM, SD1, SQ, DSD, BPM, D5A, QD3, D6A, DSD, SF1, DSD,
      D6B, QF2; 

DBA: DISP, D7, BPM,  DSL, SF2, MP, HCM, VCM, DSL, D7, INV(DISP);

LINE: LS, HB, DBA, INV(LB), SS, LB, DBA, INV(HB);


RING: 1*LINE, CAV;

{RING: LINE, CAV;}

CELL: RING, SYMMETRY  = 1;

END;
