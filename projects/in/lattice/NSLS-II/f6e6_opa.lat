 
define lattice; 
energy = 2.400000;
dp = 1.0d-10;  codeps = 1.0d-16;  dk = 1.0d-6;
meth   = 4; nbend = 4; nquad = 4;
 
bpm: beam position monitor;
hcm: corrector, horizontal, method=meth;
vcm: corrector, vertical, method=meth;
{hvm: hcm, vcm, bpm;}
aaa             : drift, l = 0.000000;
d1              : drift, l = 0.385000;
d2              : drift, l = 0.525000;
d3              : drift, l = 0.345000;
d4              : drift, l = 0.385000;
dft             : drift, l = 0.320000;
dl              : drift, l = 5.865000;
dl1             : drift, l = 0.540000;
dl2             : drift, l = 0.330000;
dl3             : drift, l = 0.525000;
dl4             : drift, l = 0.330000;
dlm1            : drift, l = 0.363333;
dlm2            : drift, l = 0.479000;
dm              : drift, l = 3.485000;
dm1             : drift, l = 0.580000;
dm2             : drift, l = 0.450000;
dm3             : drift, l = 0.345000;
dnomo           : drift, l = 6.380000;
drad            : drift, l = 0.041500;
ds              : drift, l = 1.985000;
ds1             : drift, l = 0.580000;
ds2             : drift, l = 0.450000;
ds3             : drift, l = 0.345000;
dsx             : drift, l = 0.245000;
dsx1: drift, l=0.1825;
dsx2: drift, l=0.0625;
lr01             : drift, l = 0.137000;
lr02             : drift, l = 0.572000;
lr03             : drift, l = 0.359000;
lr2             : drift, l = 0.665000;
mgp             : drift, l = 0.500000;
dl4r            : drift, l = 0.230000;
db              : drift, l = 0.925777;
dcic1           : drift, l = 0.665000;
dcic2           : drift, l = 0.462491;
lm1             : drift, l = 0.142000;
lm2             : drift, l = 0.212000;
dmod            : drift, l = 0.025000;
dbfc1           : drift, l = 0.023500;
dbfc2           : drift, l = 0.019500;
dbfc3           : drift, l = 0.014500;
wopen           : drift, l = 2.346000;

qla             : quadrupole, l = 0.230000, k = -1.410370, n=nquad, method=meth;
qma             : quadrupole, l = 0.230000, k = -1.160808, n=nquad, method=meth;
qsa             : quadrupole, l = 0.230000, k = -1.416137, n=nquad, method=meth;
qlb             : quadrupole, l = 0.350000, k = 1.136272, n=nquad, method=meth;
qmb             : quadrupole, l = 0.350000, k = 0.857522, n=nquad, method=meth;
qsb             : quadrupole, l = 0.350000, k = 1.016299, n=nquad, method=meth;
qlc             : quadrupole, l = 0.470000, k = 1.696283, n=nquad, method=meth;
qmc             : quadrupole, l = 0.470000, k = 1.875992, n=nquad, method=meth;
qsc             : quadrupole, l = 0.470000, k = 1.796969, n=nquad, method=meth;
qld             : quadrupole, l = 0.350000, k = -1.634796, n=nquad, method=meth;
qmd             : quadrupole, l = 0.350000, k = -1.897226, n=nquad, method=meth;
qsd             : quadrupole, l = 0.350000, k = -1.842187, n=nquad, method=meth;
qft1            : quadrupole, l = 0.350000, k = 1.628623, n=nquad, method=meth;
qft2            : quadrupole, l = 0.470000, k = -1.748895, n=nquad, method=meth;
qft3            : quadrupole, l = 0.230000, k = -0.675635, n=nquad, method=meth;
qle             : quadrupole, l = 0.230000, k = -0.308883, n=nquad, method=meth;
qlf             : quadrupole, l = 0.470000, k = 1.800657, n=nquad, method=meth;
qlg             : quadrupole, l = 0.470000, k = -1.713493, n=nquad, method=meth;
qlgm            : quadrupole, l = 0.470000, k = -1.861988, n=nquad, method=meth;
qlgr            : quadrupole, l = 0.470000, k = -2.505515, n=nquad, method=meth;
qlh             : quadrupole, l = 0.230000, k = 1.835731, n=nquad, method=meth;
qlhm            : quadrupole, l = 0.230000, k = 1.924920, n=nquad, method=meth;
qlhr            : quadrupole, l = 0.350000, k = 2.132387, n=nquad, method=meth;
qme             : quadrupole, l = 0.230000, k = -0.681354, n=nquad, method=meth;
qmf             : quadrupole, l = 0.470000, k = 2.112219, n=nquad, method=meth;
qmg             : quadrupole, l = 0.350000, k = -1.534180, n=nquad, method=meth;
qse             : quadrupole, l = 0.230000, k = -0.829678, n=nquad, method=meth;
qsf             : quadrupole, l = 0.470000, k = 2.413352, n=nquad, method=meth;
qsg             : quadrupole, l = 0.470000, k = -1.808166, n=nquad, method=meth;

b               : bending, l = 0.800000, t = 8.00000, k = 0.000000, 
                  t1 = 3.40000, t2 = 3.40000, gap = 0.04,n=nbend, method=meth;

bx             : bending, l = 1.400000, t = 14.00000, k = 0.000000, 
                  t1 = 6.40000, t2 = 6.40000, gap = 0.04,n=nbend, method=meth;
bxin           : bending, l = 1.4/2.0, t = 14.0/2.0, k = 0.0, 
                  t1 = 6.4, t2 = 0.0, gap = 0.04, n=nbend, method=meth;
bxout          : bending, l = 1.4/2.0, t = 14.0/2.0, k = 0.0, 
                  t1 = 0.0, t2 = 6.4, gap = 0.04, n=nbend, method=meth;

bfc10           : bending, l = 0.273000, t = -2.36200, k = 0.000000, 
                  t1 = -1.18100, t2 = -1.18100, gap = 0.00,n=nbend, method=meth;

bfc20           : bending, l = 0.713000, t = 7.33800, k = 0.000000, 
                  t1 = 3.67400, t2 = 3.66400, gap = 0.00,n=nbend, method=meth;

bfc30           : bending, l = 0.483000, t = -4.98240, k = 0.000000, 
                  t1 = -2.49300, t2 = -2.48940, gap = 0.00,n=nbend, method=meth;

sd              : sextupole, k = -5.675095;
se              : sextupole, k = -1.315528;
sf              : sextupole, k = 4.555272;
sla             : sextupole, k = -4.551533;
slb             : sextupole, k = 3.383458;
sma             : sextupole, k = -5.930860;
smb             : sextupole, k = 2.842334;
ssa             : sextupole, k = -5.898854;
ssb             : sextupole, k = 3.844900;

u19             : drift, l = 0.912000; {undulator}
w138            : drift, l = 2.346000; {undulator}

omid            : marker; {opticsmarker}
oml0            : marker; {opticsmarker}
orad            : marker; {opticsmarker}
omb             : marker; {opticsmarker}
omod            : marker; {opticsmarker}

mp              : marker;
ss              : marker;
ms              : marker;
ls              : marker;
 
{----- table of segments ----------------------------------------------------}
 
hvm: hcm, vcm, dsx1, bpm, dsx2;

bfc1             :dbfc1, bfc10, dbfc1;
bfc2             :dbfc2, bfc20, dbfc2;
bfc3             :dbfc3, bfc30, dbfc3;
trip             :qft1, dft, qft2, omid, dft, qft3;
rad              :lr01, bpm, lr02, hcm, vcm, lr03, drad, u19, orad, aaa, u19, drad, lr2;
radin            :dl3, qlgr, dl4r, qlhr;
modin            :dl3, qlgm, dl4, qlhm;
mod              :lm1, omod, dmod, wopen, dmod, lm2;
chic             :dcic1, bfc1, mod, bfc2, db, bfc3, dcic2;
femto            :modin, chic, trip, rad, inv(radin);
tl               :d1, qla, inv(hvm), sd, d2, qlb, dsx, sf, dsx, 
                  qlc, d3, se, hvm,  qld, d4, b;
tm               :d1, qma, inv(hvm), sd, d2, qmb, dsx, sf, dsx, 
                  qmc, d3, se, hvm,  qmd, d4, b;
ts               :d1, qsa, inv(hvm), sd, d2, qsb, dsx, sf, dsx, 
                  qsc, d3, se, hvm,  qsd, d4, b;
ml0              :dl1, sla, dsx, qle, dl2, qlf, inv(hvm), slb;
ml1              :dl3, qlg, dl4, qlh, dl;
ml               :ml0, ml1;
mm               :dm1, sma, dsx, qme, dm2, qmf, inv(hvm), smb, dm3, qmg, dm;
                  
ms1              :ds1, ssa, dsx, qse, ds2, qsf, inv(hvm), ssb, ds3, qsg, ds;
                  
tml              :tl, ml;
tmm              :tm, mm;
tms              :ts, ms1;
six              :inv(tml), bx, tms, inv(tms), bx, tmm;
per              :six, inv(six);

c0 = 2.99792458e8; h_rf = 480; C = 288.0;

CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 2.6e6, Harnum = h_rf;

{ring: six, inv(tmm), bx, tms, inv(tms), bx, tl, ml0, line, inv(ml0), inv(tl),
      bx, tms, inv(tms), bx, tmm, inv(six), six, inv(six), cav;}

line: inv(tml), bxin, mp, bxout, tms, ss, inv(tms), bxin, mp, bxout, tmm, ms
      inv(tmm), bxin, mp, bxout, tms, ss, inv(tms), bxin, mp, bxout, tml, ls;

full: inv(tml), bx, tms, inv(tms), bx, tmm,
      inv(tmm), bx, tms, inv(tms), bx, tl, 
             ml0, femto, inv(ml0), 
      inv(tl),  bx, tms, inv(tms), bx, tmm,
      inv(tmm), bx, tms, inv(tms), bx, tml,
      line;

{ring: line, cav;}

ring: full, cav;

cell: ring, symmetry=1;
 
end;
