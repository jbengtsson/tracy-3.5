IVU_LS: D_IVU_LS, IVU22, D_IVU_LS;


L_SCW_ESRF = 0.6;
SCW_ESRF: insertion, scaling = 1.0, N = 50, Method = 1,
  file2 = "/home/bengtsson/projects/in/lattice/esrf_3tw_kickmap.txt";

D_SCW_ESRF: Drift, L = -L_SCW_ESRF/2.0;
SCW3:   D_SCW_ESRF, SCW_ESRF, D_SCW_ESRF;


SS: Multipole, L = 0.0;
LS: Multipole, L = 0.0;


G1C30: DH02G1A, DFH2, FXH2, FYH2, DFH2, DH1G1A{, GE};

G2C30: GS, SH1, DH1AG2A, PH1, DBPM2, QH1, DH2AG2A, SQ1H,
 CXSQ1H, CYSQ1H, SQ1H, DH2BG2A, QH2, DH3AG2A, SH3, DH3BG2A,
 QH3, DH4AG2A, PH2, DBPM, SH4, DH4BG2A, DCH2, CXH2, CYH2,
 DCH2, GE, DH4CG3A;

G3C30: GS, B1, DM1AG3A, DCM1, CXM1, CYM1, SM3, DCM1,
 DM1BG3A, GE;

G4C30: GS, QM1, DM2AG4A, SM1A, DFT1G4A, DFM1, FXM1, FYM1,
 DFM1, DM2BG4A, PM1, DBPM1, QM2, DM2CG4A, SM2, DM2CG4B,
 QM2, DM2BG4B, SM1B, DM2AG4B, PM1, DBPM, QM1, DM1EG4B, DCM1G4C30B,
 SM3, CXM1G4C30B, CYM1G4C30B, DCM1G4C30B, GE;

G5C30: GS, DM1DG5B, DPWG5B, DM1CG5B, B1, GE, DL4BG6B;

G6C30: GS, DL4AG6B, QL3, DBPM2, PL2, DL3CG6B, SL3, DL3BG6B,
 DCL2, CXL2, CYL2, DCL2, DL3AG6B, QL2, DL2CG6B, SL2,
 DL2BG6B, DCL1, CXL1, CYL1, DCL1, DL2AG6B, QL1, DL1AG6B,
 PL1, DBPM, SL1, GE;

G1C1: GS, DL0BG1A, DFL1, FXL1, FYL1, DFL1, DFT2G1A,
 DLDKG1A, DL01G1A, SS, DL02G1A, DLDKG1A, DFT2G1A, DFL2, FXL2, FYL2,
 DFL2, DL0AG1A, GE;

G1C1_IVU: GS, DL0BG1A, DFL1, FXL1, FYL1, DFL1, DFT2G1A,
 DLDKG1A, DL01G1A, IVU, DL02G1A, DLDKG1A, DFT2G1A, DFL2, FXL2,
 FYL2, DFL2, DL0AG1A, GE;

G1C1_EPU: GS, DL0BG1A, DFL1, FXL1, FYL1, DFL1, DFT2G1A,
 DLDKG1A, DL01G1A, EPU_SS, DL02G1A, DLDKG1A, DFT2G1A, DFL2, FXL2,
 FYL2, DFL2, DL0AG1A, GE;

G1C1_SCW1: GS, DL0BG1A, DFL1, FXL1, FYL1, DFL1, DFT2G1A,
 DLDKG1A, DL01G1A, SCW1, DL02G1A, DLDKG1A, DFT2G1A, DFL2, FXL2,
 FYL2, DFL2, DL0AG1A, GE;

G1C1_SCW2: GS, DL0BG1A, DFL1, FXL1, FYL1, DFL1, DFT2G1A,
 DLDKG1A, DL01G1A, SCW2, DL02G1A, DLDKG1A, DFT2G1A, DFL2, FXL2,
 FYL2, DFL2, DL0AG1A, GE;

G1C1_SCW3: GS, DL0BG1A, DFL1, FXL1, FYL1, DFL1, DFT2G1A,
 DLDKG1A, DL01G1A, SCW3, DL02G1A, DLDKG1A, DFT2G1A, DFL2, FXL2,
 FYL2, DFL2, DL0AG1A, GE;

G2C1: GS, SL1, DL1AG2A, PL1, DBPM2, QL1, DL2AG2A, DCL1,
 CXL1, CYL1, DCL1, DL2BG2A, SL2, DL2CG2A, QL2, DL3AG2A,
 DCL2, CXL2, CYL2, DCL2, DL3BG2A, SL3, DL3CG2A, PL2, DBPM2,
 QL3, DL4AG2A, GE;

G3C1: DL4BG3A, GS, B1, DM1AG3A, SM3, SQ2H, CXSQ2H, CYSQ2H,
 SQ2H, DM1BG3A, GE;

G4C1: GS, QM1, DM2A2G4A, SM1A, DFT1G4A, DFM1, FXM1, FYM1,
 DFM1, DM2B2G4A, PM1, DBPM1, QM2, DM2CG4A, SM2, DM2CG4B,
 QM2, DM2B2G4B, SM1B, DM2A2G4B, PM1, DBPM, QM1, DM1EG4B,
 DCM1G4C01B, CXM1G4C01B, CYM1G4C01B, SM3, DCM1G4C01B, GE;

G5C1: GS, DM1DG5B, DPWG5B, DM1CG5B, B1, GE, DH4CG6B;

G6C1: GS, DCH2, CXH2, CYH2, DCH2, DH4BG6B, SH4, DH4AG6B,
 PH2, DBPM2, QH3, DH3BG6B, SH3, DH3AG6B, QH2, DH2BG6B, DCH1,
 CXH1, CYH1, DCH1, DH2AG6B, QH1, DH1AG6B, PH1, DBPM, SH1,
 GE;

G1C2: {GS,} DH2G1A, DFH1, FXH1, FYH1, DFH1, DH01G1A;

{ Low-beta long straight }

G2C30LB: GS, SH1, DH1AG2A, PH1, DBPM2, QH1NEW, DH2AG2A, SQ1H,
 CXSQ1H, CYSQ1H, SQ1H, DH2BG2A, QH2NEW, DH3AG2A, SH3, DH3BG2A,
 QH3NEW, DH4AG2A, PH2, DBPM, SH4, DH4BG2A, DCH2, CXH2,
 CYH2, DCH2, GE, DH4CG3A;

G6C1LB: GS, DCH2, CXH2, CYH2, DCH2, DH4BG6B, SH4, DH4AG6B,
 PH2, DBPM2, QH3NEW, DH3BG6B, SH3, DH3AG6B, QH2NEW, DH2BG6B,
 DCH1, CXH1, CYH1, DCH1, DH2AG6B, QH1NEW, DH1AG6B,
 PH1, DBPM, SH1, GE;


LINE:
  G1C30, G2C30, G3C30, G4C30, G5C30, G6C30, G1C1, G2C1, G3C1, G4C1, G5C1,
  G6C1, G1C2, LS;

LB_LINE_LB:
  G1C30, G2C30LB, G3C30, G4C30, G5C30, G6C30, G1C1, G2C1, G3C1, G4C1, G5C1,
  G6C1LB, G1C2;

LB_LINE:
  G1C30, G2C30LB, G3C30, G4C30, G5C30, G6C30, G1C1, G2C1, G3C1, G4C1, G5C1,
  G6C1, G1C2;

LINE_LB:
  G1C30, G2C30, G3C30, G4C30, G5C30, G6C30, G1C1, G2C1, G3C1, G4C1, G5C1,
  G6C1LB, G1C2;

LINE_IVU:
 G1C30, G2C30, G3C30, G4C30, G5C30, G6C30, G1C1_IVU, G2C1, G3C1, G4C1, G5C1,
 G6C1, G1C2;

LINE_EPU:
 G1C30, G2C30, G3C30, G4C30, G5C30, G6C30, G1C1_EPU, G2C1, G3C1, G4C1, G5C1,
 G6C1, G1C2;

LINE_SCW1:
 G1C30, G2C30, G3C30, G4C30, G5C30, G6C30, G1C1_SCW1, G2C1, G3C1, G4C1, G5C1,
 G6C1, G1C2;

LINE_SCW2:
 G1C30, G2C30, G3C30, G4C30, G5C30, G6C30, G1C1_SCW2, G2C1, G3C1, G4C1, G5C1,
 G6C1, G1C2;

LINE_SCW3:
 G1C30, G2C30, G3C30, G4C30, G5C30, G6C30, G1C1_SCW3, G2C1, G3C1, G4C1, G5C1,
 G6C1, G1C2;


RING: 15*LINE, CAV;

{RING: 1*(LINE, DW, 4*LINE), CAV;}

{RING: LB_LINE_LB, CAV;}

{ 5 DWs }
{RING:
  LINE, DW, LINE, LINE,     LINE,     LINE,
  LINE, DW, LINE, LINE, DW, LINE, DW, LINE,
  LINE, DW, LINE, LINE,     LINE,     LINE,
  CAV;}

{ 8 DWs }
{RING:
  LINE, DW, LINE, LINE, DW  LINE, DW, LINE,
  LINE, DW, LINE, LINE, DW, LINE, DW, LINE,
  LINE, DW, LINE, LINE, DW, LINE,     LINE,
  CAV;}

{ 3 DWs, 5 IVUs }
{RING:
  LINE, DW, LINE_IVU, LINE_IVU, LINE,     LINE,
  LINE, DW, LINE,     LINE_IVU, LINE_IVU, LINE,
  LINE, DW, LINE,     LINE,     LINE_IVU, LINE,
  CAV;}

{ 3 DWs, 10 IVUs }
{RING:
  LINE,     DW, LINE_IVU, LINE_IVU, LINE_IVU, LINE_IVU,
  LINE_IVU, DW, LINE,     LINE_IVU, LINE_IVU, LINE_IVU,
  LINE,     DW, LINE_IVU, LINE,     LINE_IVU, LINE,
  CAV;}

{ 3 DWs, 15 IVUs }
{RING:
  LINE_IVU, DW, LINE_IVU, LINE_IVU, LINE_IVU, LINE_IVU,
  LINE_IVU, DW, LINE_IVU, LINE_IVU, LINE_IVU, LINE_IVU,
  LINE_IVU, DW, LINE_IVU, LINE_IVU, LINE_IVU, LINE_IVU,
  CAV;}

{ 3 DWs, 1 EPU }
{RING:
  LINE, DW, LINE, LINE_EPU, LINE, LINE,
  LINE, DW, LINE  LINE,     LINE, LINE,
  LINE, DW, LINE, LINE,     LINE, LINE,
  CAV;}

{ 3 DWs, 3 EPUs }
{RING:
  LINE, DW, LINE, LINE_EPU, LINE, LINE,
  LINE, DW, LINE  LINE_EPU, LINE, LINE,
  LINE, DW, LINE, LINE_EPU, LINE, LINE,
  CAV;}

{ 3 DWs, 1 SCW }
{RING:
  LINE, DW, 3*LINE, LINE_SCW1,
  2*(LINE, DW, LINE, LINE, LINE, LINE), CAV;}

{ 3 DWs, 2 SCW }
{RING:
  LINE, DW, 2*LINE, LINE_SCW1, LINE_SCW2,
  2*(LINE, DW, LINE, LINE, LINE, LINE), CAV;}

{ 3 DWs, 14 IVUs, 1 SCW }
{RING:
  LINE_IVU, DW, LINE_IVU, LINE_IVU, LINE_SCW, LINE_IVU,
  LINE_IVU, DW, LINE_IVU, LINE_IVU, LINE_IVU, LINE_IVU,
  LINE_IVU, DW, LINE_IVU, LINE_IVU, LINE_IVU, LINE_IVU,
  CAV;}

{ 3 DWs, 1 SCW_ESRF }
{RING:
  LINE, DW, 3*LINE, LINE_SCW3,
  2*(LINE, DW, LINE, LINE, LINE, LINE), CAV;}

{ 3 DWs, 13 IVUs, 1 EPU, 1 SCW }
{RING:
  LINE_IVU, DW, LINE_EPU, LINE_IVU, LINE_SCW, LINE_IVU,
  LINE_IVU, DW, LINE_IVU, LINE_IVU, LINE_IVU, LINE_IVU,
  LINE_IVU, DW, LINE_IVU, LINE_IVU, LINE_IVU, LINE_IVU,
  CAV;}

{ 3 DWs, 1 EPU_LSs }
{RING:
  LINE, DW, LINE, LINE, EPU_LS2, LINE, LINE,
  LINE, DW, LINE, LINE,          LINE, LINE,
  LINE, DW, LINE, LINE,          LINE, LINE,
  CAV;}

{ 3 DWs, 2 EPU_LSs }
{RING:
  LINE, DW, LINE, LINE, EPU_LS, LINE, LINE,
  LINE, DW, LINE, LINE, EPU_LS, LINE, LINE,
  LINE, DW, LINE, LINE,         LINE, LINE,
  CAV;}

{ 3 DWs, 2 IVU_LSs, 2 EPU_LSs }
{RING:
  LINE, DW, LINE, IVU_LS, LINE, EPU_LS, LINE, LINE,
  LINE, DW, LINE, IVU_LS, LINE, EPU_LS, LINE, LINE,
  LINE, DW, LINE,         LINE,         LINE, LINE,
  CAV;}

{ 3 DWs, 15 IVUs, 2 IVU_LSs, 2 EPU_LSs }
{RING:
  LINE_IVU, DW, LINE_IVU, IVU_LS, LINE_IVU, EPU_LS, LINE_IVU, LINE_IVU,
  LINE_IVU, DW, LINE_IVU, IVU_LS, LINE_IVU, EPU_LS, LINE_IVU, LINE_IVU,
  LINE_IVU, DW, LINE_IVU,         LINE_IVU,         LINE_IVU, LINE_IVU,
  CAV;}

{ 12 DWs, 15 IVUs for error tolerances }
{RING:
  LINE_IVU, DW, LINE_IVU, DW, LINE_IVU, DW, LINE_IVU, DW, LINE_IVU,
  LINE_IVU, DW, LINE_IVU, DW, LINE_IVU, DW, LINE_IVU, DW, LINE_IVU,
  LINE_IVU, DW, LINE_IVU, DW, LINE_IVU, DW, LINE_IVU, DW, LINE_IVU,
  CAV;}

CELL: RING, SYMMETRY = 1;

END;
