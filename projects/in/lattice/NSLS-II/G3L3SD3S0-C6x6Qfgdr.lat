define lattice;
{ New G3L3SD3S2-C6x6Qfgdr EX_2.047 TPW H(9.1) L(6.1M) PMTPW(0.40M)}
Energy = 3.0;

dP = 1e-6; CODeps = 1e-10;

Meth = 4; Nbend = 4; Nquad = 4;

pi = 4.0*arctan(1.0);

BPM: Beam Position Monitor ;
HCM: Corrector, Horizontal, Method= Meth;
VCM: Corrector, Vertical, Method= Meth;
BHV: BPM, HCM, VCM ; 

D0:   Drift, L = 4.53860;
D0A:  Drift, L = 0.15000;
D1A:  Drift, L = 0.4900;
D1A2:  Drift, L = 0.24500 ;
D1B:  Drift, L = 0.1500;
D2A:  Drift, L = 0.15000;
D3A:  Drift, L = 0.2300;
D3B:  Drift, L = 0.20000;
D4A:  Drift, L = 0.15000;
D4B:  Drift, L = 0.55000;
D4B2: Drift, L = 0.300;
D4B1: Drift, L = 0.250;
D5 :   Drift, L = 0.5500;
D5W:   Drift, L = 0.2000;
DPW:  Drift, L = 0.20000;
DPW2:  Drift, L = 0.1000;
D5C:   Drift, L = 0.2500;
DHVC:  Drift, L = 0.1500;
DDW:  Drift, L = 0.2200;
D5A:  Drift, L = 0.1500;
D6A:  Drift, L = 0.15000;
D6B:  Drift, L = 0.70000;
D7:   Drift, L = 0.150;
D44A:  Drift, L = 0.15000;
D44B:  Drift, L = 0.55000;
D44B2:  Drift, L = 0.27500;
D33A: Drift, L = 0.50000;
D33B: Drift, L = 0.15000;
D22A: Drift, L = 0.50000;
D22A2: Drift, L = 0.250000;
D21B: Drift, L = 0.1500;
D22B: Drift, L = 0.2500 ;  
D11A: Drift, L = 0.15000;
D11B: Drift, L = 0.25000;
D00:  Drift, L = 3.30000;
DSX: Drift,  L = 0.1000;
DSD: Drift,  L = 0.125;
DSL: Drift,  L = 0.15;

Q1       : Quadrupole, L = 0.300000, K =-1.2501284,  N = Nquad, Method = Meth;
Q2       : Quadrupole, L = 0.400000, K = 1.8481069,  N = Nquad, Method = Meth;
Q3       : Quadrupole, L = 0.300000, K = -1.1097983,  N = Nquad, Method = Meth;
QF1      : Quadrupole, L = 0.300000, K =  1.2010400,  N = Nquad, Method = Meth;
QD1      : Quadrupole, L = 0.300000, K = -0.93964356,  N = Nquad, Method = Meth;
Q44      : Quadrupole, L = 0.300000, K = 0.000000,  N = Nquad, Method = Meth;
Q33      : Quadrupole, L = 0.300000, K =  -1.0685784,  N = Nquad, Method = Meth;
Q22      : Quadrupole, L = 0.400000, K = 1.9924515,  N = Nquad, Method = Meth;
Q11      : Quadrupole, L = 0.300000, K = -1.5674561,  N = Nquad, Method = Meth;

B1: Bending, L = 2.62, T =  6.0000,
    T1 =  3.000, T2 =  3.0000, N = Nbend, Method = Meth;

S1       : Sextupole, K =  0.000000, N = 1, Method = Meth;
S2       : Sextupole, K =  0.000000, N = 1, Method = Meth;
S3       : Sextupole, K =  0.000000, N = 1, Method = Meth;
S4       : Sextupole, K =  0.000000, N = 1, Method = Meth;
SD1      : Sextupole, K =  0.000000, N = 1, Method = Meth;
SF1      : Sextupole, K = -1.511748, N = 1, Method = Meth;
SF2      : Sextupole, K =  2.124139, N = 1, Method = Meth;
SL1      : Sextupole, K =  0.000000, N = 1, Method = Meth;
SL2      : Sextupole, K =  0.000000, N = 1, Method = Meth;
SL3      : Sextupole, K =  0.000000, N = 1, Method = Meth;
SL4      : Sextupole, K =  0.000000, N = 1, Method = Meth;



SQ: Multipole, N = 1, Method = Meth;

MP: Marker;
SS: Marker;
LS: Marker;
GS: Multipole, N = 1, Method = Meth;
GE: Multipole, N = 1, Method = Meth;

c0 = 2.99792458e8  ; h_rf = 1300; C = 791.958 ;

CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 5.00e6, Harnum = h_rf;

LB: DSX,S1,DSX, D11A, BPM,Q11,D22A2,HCM,VCM,D22A2, DSX,S2,DSX, D22B,
    Q22, D33A, DSX,S3,DSX, D33B, Q33, BPM, 
    D44B2, HCM,VCM ;

HB: DSX,SL1,DSX, D0A, BPM, Q1, D1A2,HCM,VCM,D1A2, DSX,SL2,DSX, D1B,
    Q2, D3A, DSX,SL3,DSX, D3B, Q3, BPM, D4A,
    DSX,SL4,DSX, D4B1,HCM,VCM;


HB_SQ: DSX,SL1,DSX, D0A, BPM, Q1, D1A2,HCM,VCM,SQ,D1A2,DSX,SL2,DSX,D1B,
    Q2, D3A, DSX,SL3,DSX, D3B, Q3, BPM, D4A,
    DSX,SL4,DSX, D4B1,HCM,VCM;

DISP:    DHVC,VCM,HCM,   DHVC, BPM,QD1,
      D6A, DSD,SF1,DSD, D6B, QF1; 

DISP_SQ: DHVC,VCM,HCM,SQ,DHVC, BPM,QD1,
      D6A, DSD,SF1,DSD, D6B, QF1; 


DBA:    B1, D5W,DPW, GS, D5C,
     DISP,D7, DSL, SF2,MP, DSL,D7, INV(DISP), 
     D5C, GE, DPW2,DPW2,D5W, B1;

DBA_SQ: B1, D5W,DPW, GS, D5C,
     DISP_SQ,D7, DSL, SF2,MP, DSL,D7, INV(DISP), 
     D5C, GE, DPW2,DPW2,D5W, B1;


LINE: D0, GS, HB_SQ, GE, D4B2, DBA_SQ, D44B2, GS, INV(LB), GE, D00, SS, 
      D00, GS, LB, GE, D44B2, DBA, D4B2, GS, INV(HB), GE, D0, LS;


RING: 1*LINE, CAV;

{RING: LINE, CAV;}

CELL: RING, SYMMETRY  = 1;

END;
