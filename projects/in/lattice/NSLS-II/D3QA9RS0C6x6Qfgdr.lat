define lattice;
{D3QA9RS0C6x6Qfgdr 3Qsid,10-Sext,Qx,y=33.35,16.28, etax2=-12.8 }
Energy = 3.0;

dP = 1e-6; CODeps = 1e-10;

Meth = 4; Nbend = 4; Nquad = 4;

pi = 4.0*arctan(1.0);

BPM: Beam Position Monitor ;
HCM: Corrector, Horizontal, Method= Meth;
VCM: Corrector, Vertical, Method= Meth;
BHV: BPM, HCM, VCM ; 

D0:   Drift, L = 5.0;
D1A:  Drift, L = 0.240;
D1B:  Drift, L = 0.4 ;
D1B2:  Drift, L = 0.2 ;
D2A:  Drift, L = 0.15 ;
D2B:  Drift, L = 0.15 ;
D3A:  Drift, L = 0.15;
D3B:  Drift, L = 0.230;
D4A:  Drift, L = 0.15;
D4B:  Drift, L = 0.550;
D4B1:  Drift, L = 0.30;
D4B2:  Drift, L = 0.250;
D5:   Drift, L = 0.5500;
D51:   Drift, L = 0.3000;
D52:   Drift, L = 0.2500;
D5A:  Drift, L = 0.1500;
D6A:  Drift, L = 0.215;
D6B:  Drift, L = 0.305;
D7:   Drift, L = 0.35;
D71:   Drift, L = 0.175;
D4L:  Drift, L = 0.55;
D4L1:  Drift, L = 0.30;
D4L2:  Drift, L = 0.25;
D4:   Drift, L = 0.15;

D33A: Drift, L = 0.2000;
D33B: Drift, L = 0.1500;
D22A: Drift, L = 0.400;
D22A2: Drift, L = 0.200;  
D22B: Drift, L = 0.2000 ;  
D11A: Drift, L = 0.3000;
D11B: Drift, L = 0.350000;
D00:  Drift, L = 2.5000;
DSX: Drift,  L = 0.1000;
DSD: Drift,  L = 0.125;
DSL: Drift,  L = 0.15;

{ d3qa9ps0.str Ex=2.1nm Qx,y=33.35,16.28,Cx,y=-3.0,-3.18  }

Q1       : Quadrupole, L = 0.300000, K = -0.8851824,  N = Nquad, Method = Meth;
Q2       : Quadrupole, L = 0.300000, K =  1.117929,  N = Nquad, Method = Meth;
Q3       : Quadrupole, L = 0.300000, K =  1.120963,  N = Nquad, Method = Meth;
Q4       : Quadrupole, L = 0.300000, K = -1.232597,  N = Nquad, Method = Meth;
QF2      : Quadrupole, L = 0.300000, K =  1.389740,  N = Nquad, Method = Meth;
QD3      : Quadrupole, L = 0.300000, K = -1.016797,  N = Nquad, Method = Meth;
Q44      : Quadrupole, L = 0.300000, K = -1.416140,  N = Nquad, Method = Meth;
Q33      : Quadrupole, L = 0.400000, K =  2.426771,  N = Nquad, Method = Meth;
Q22      : Quadrupole, L = 0.300000, K = -2.035863,  N = Nquad, Method = Meth;
Q11      : Quadrupole, L = 0.300000, K =  0.000000,  N = Nquad, Method = Meth;
B1: Bending, L = 2.62, T =  6.0000,
    T1 =  3.000, T2 =  3.0000, N = Nbend, Method = Meth;

S1       : Sextupole, K = 0.000000, N = 1, Method = Meth;
S2       : Sextupole, K = 0.000000, N = 1, Method = Meth;
S3       : Sextupole, K = 0.000000, N = 1, Method = Meth;
S4       : Sextupole, K = 0.000000, N = 1, Method = Meth;
SD1      : Sextupole, K = 0.000000, N = 1, Method = Meth;
SF1      : Sextupole, K = 0.000000, N = 1, Method = Meth;
SF2      : Sextupole, K = 0.000000, N = 1, Method = Meth;
SL1      : Sextupole, K = 0.000000, N = 1, Method = Meth;
SL2      : Sextupole, K = 0.000000, N = 1, Method = Meth;
SL3      : Sextupole, K = 0.000000, N = 1, Method = Meth;
SL4      : Sextupole, K = 0.000000, N = 1, Method = Meth;


SQ: Multipole, N = 1, Method = Meth;

MP : Marker;
GS: Multipole, N = 1, Method = Meth;
GE: Multipole, N = 1, Method = Meth;

c0 = 2.99792458e8  ; h_rf = 1300; C = 780.30 ;

CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 5.00e6, Harnum = h_rf;

LB: D11B, BPM,Q22, D22A2, HCM,VCM, D22A2, 
    DSX, S2, DSX, D22B, Q33, D33A, 
    DSX, S3, DSX, D33B, Q44, BPM, D4, 
    DSX, S4, DSX, D4L1, HCM, VCM;

HB: Q1, D1A, 
    DSX, SL1, DSX, D1B2, HCM, VCM, D1B2,BPM,  Q2, D2A, 
    DSX, SL2, DSX, D2B, Q3, D3A, 
    DSX, SL3, DSX, D3B, Q4, BPM, D4A, 
    DSX, SL4, DSX , D4B1, HCM, VCM;

HB_SQ: Q1, D1A, 
    DSX, SL1,DSX, D1B2, SQ, HCM, VCM, D1B2,BPM,  Q2, D2A, 
    DSX, SL2, DSX, D2B, Q3, D3A, 
    DSX, SL3, DSX, D3B, Q4, BPM, D4A, 
    DSX, SL4, DSX , D4B1, HCM, VCM;

DISP: VCM, HCM, D51, DSD, SD1, DSD, 
      D5A,BPM,  QD3, D6A, DSD, SF1, DSD, D6B, QF2; 

DISP_SQ: VCM, HCM,SQ,  D51, DSD, SD1, DSD, 
      D5A,BPM,  QD3, D6A, DSD, SF1, DSD, D6B, QF2; 

DBA: B1, D52, 
     GS, DISP,D7, DSL, SF2, MP, DSL, D71, D71, INV(DISP), GE, 
     D52, B1;

DBA_SQ: B1, D52, 
        GS, DISP_SQ,D7, DSL, SF2, MP, DSL, D71, D71, INV(DISP), GE, 
        D52, B1;

LINE: D0, GS, HB_SQ, GE, D4B2, DBA_SQ, D4L2, GS, INV(LB), GE, D00, 
      D00, GS, LB, GE, D4L2, DBA, D4B2, GS, INV(HB), GE, D0;


RING: 15*LINE, CAV;

{RING: LINE, CAV;}

CELL: RING, SYMMETRY  = 1;

END;
