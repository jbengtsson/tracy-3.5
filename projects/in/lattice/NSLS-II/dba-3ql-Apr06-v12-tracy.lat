{ New DBA30HLC16Es2rng7x7s.opa H(8m) L(5m)Rho = 25m }

define lattice; ringtype = 1;

Energy = 3.0;

dP = 1e-8; CODeps = 1e-12;  
  
Meth = 4; Nbend = 4; Nquad = 4;  
  
pi = 4.0*arctan(1.0);  
  
BPM: Beam Position Monitor ;  
HCM: Corrector, Horizontal, Method =  Meth;  
VCM: Corrector, Vertical, Method =  Meth;  
  
  
D0: Drift,L=4.;  
D00: Drift,L=2.5;  
D1A: Drift, L=0.15;  
D1B: Drift, L=0.4;  
D11A: Drift,L=0.65;  
D11B: Drift,L=0.15;  
D2A: Drift, L=0.15;  
D2B: Drift, L=0.15;  
D22A: Drift, L=0.4;  
D22B: Drift, L=0.15;  
D3A: Drift, L=0.15;  
D3B: Drift, L=0.15;  
D33A: Drift, L=0.15;  
D33B: Drift, L=0.15;  
D4A: Drift, L=0.15;  
D4B: Drift, L=0.69;   
D44B: Drift, L=0.62;  
D44A: Drift, L=0;  
D5: Drift,L=0.95;  
D5A: Drift, L=0.15;  
D6A: Drift, L=0.26;  
D6B: Drift, L=0.15;  
D7H: Drift, L=0.2;  
  
  
QD3: Quadrupole,L = 0.3,K=-1.073782437344913, N = Nquad, Method = Meth;  
QF2: Quadrupole,L = 0.3,K=1.666589892110670, N = Nquad, Method = Meth;  
QCH: Quadrupole,L = 0.15,K=-0.531377041349928, N = Nquad, Method = Meth;  
  
  
Q1:  Quadrupole,L = 0,K=0,  N = Nquad, Method = Meth;  
Q2:  Quadrupole,L = 0.3,K=-0.940649289212790,  N = Nquad, Method = Meth;  
Q3:  Quadrupole,L = 0.3,K=2.556740367293800,  N = Nquad, Method = Meth;  
Q4:  Quadrupole,L = 0.3,K=-1.482296423605620,  N = Nquad, Method = Meth;  
  
Q22: Quadrupole, L = 0.3, K = -1.854045531200604, N = Nquad, Method = Meth;  
Q33: Quadrupole, L = 0.4, K = 2.428820617072962, N = Nquad, Method = Meth;  
Q44: Quadrupole, L = 0.3, K = -1.461427225688968, N = Nquad, Method = Meth;  
  
  
DUQ1: Drift, L = 0;  
DDQ1: Drift, L = 0;  
DUQ2: Drift, L = 0.;  
DDQ2: Drift, L = 0.;  
DUQ3: Drift, L = 0.;  
DDQ3: Drift, L = 0.;  
DUQ4: Drift, L = 0.;  
DDQ4: Drift, L = 0.;  
DDQ22: Drift, L = 0.;  
DUQ22: Drift, L = 0.;  
DDQ33: Drift, L = 0.;  
DUQ33: Drift, L = 0.;  
DDQ44: Drift, L = 0.;  
DUQ44: Drift, L = 0.;  
  
  
QQ1:  DUQ1, Q1, DDQ1;  
QQ2:  DUQ2, Q2, DDQ2;  
QQ3:  DUQ3, Q3, DDQ3;  
QQ4:  DUQ4, Q4, DDQ4;  
  
QQ22:  DUQ22, Q22, DDQ22;  
QQ33:  DUQ33, Q33, DDQ33;  
QQ44:  DUQ44, Q44, DDQ44;  
  
B1: Bending, L = 2.62, T = 6.0, T1 = 3.0, T2 = 3.0, N = Nbend, Method = Meth;  

  
S4: Sextupole, L = 0, K = 0, N = 1, Method = Meth;  
{S1: Sextupole, L = 0.2, K = 0.000000000000000, N = 1, Method = Meth;  
S2: Sextupole, L = 0.2, K = 0.000000000000000, N = 1, Method = Meth;  
S3: Sextupole, L = 0.2, K = 0.000000000000000, N = 1, Method = Meth;  

SD1: Sextupole, L = 0.25, K = 0.000000000000000, N = 1, Method = Meth;  
SF1: Sextupole, L = 0.25, K = 0.000000000000000, N = 1, Method = Meth;  
SF2H: Sextupole, L = 0.2, K = 0.000000000000000, N = 1, Method = Meth;  
SL1: Sextupole, L = 0.2, K = 0.000000000000000, N = 1, Method = Meth;  
SL2: Sextupole, L = 0.2, K = 0.000000000000000, N = 1, Method = Meth;  
SL3: Sextupole, L = 0.2, K = 0.000000000000000, N = 1, Method = Meth;  
SL4: Sextupole, L = 0.2, K = 0.000000000000000, N = 1, Method = Meth;}
  
S1: Sextupole, L = 0.200000, K = -11.685287, N = 1, Method = Meth;
S2: Sextupole, L = 0.200000, K = 20.000000, N = 1, Method = Meth;
S3: Sextupole, L = 0.200000, K = -11.401461, N = 1, Method = Meth;
SD1: Sextupole, L = 0.250000, K = -6.048120, N = 1, Method = Meth;
SF1: Sextupole, L = 0.250000, K = -3.247697, N = 1, Method = Meth;
SF2H: Sextupole, L = 0.200000, K =  7.684202, N = 1, Method = Meth;
SL1: Sextupole, L = 0.200000, K =  5.679996, N = 1, Method = Meth;
SL2: Sextupole, L = 0.200000, K = 13.086431, N = 1, Method = Meth;
SL3: Sextupole, L = 0.200000, K = -14.066496, N = 1, Method = Meth;
SL4: Sextupole, L = 0.200000, K = -6.473007, N = 1, Method = Meth;

SS: Marker;  
LS: Marker;  
MP: Marker;  
GS: Multipole, N = 1, Method = Meth;  
GE: Multipole, N = 1, Method = Meth;  
  
{phi1 = 0*2e-3*180.0/pi; L_P = 2e-2;  
DB1: Bending, L = L_P/2.0, T = -phi1/2.0, T1 = -phi1/4.0,  
      N = 1, Method = Meth;  
DB:  Bending, L = L_P, T = phi1, N = 1, Method = Meth;  
DB2: Bending, L = L_P/2.0, T = -phi1/2.0, T2 = -phi1/4.0,  
      N = 1, Method = Meth;  
D_TPW: Drift, L = -L_P;  
TPW: D_TPW, DB1, DB, DB2, D_TPW;}

c0 = 2.99792458e8; Brho = 1e9*Energy/c0;

{L_TPW = 3*0.082;
TPW1:  Wiggler, L = L_TPW, lambda = 0.082, BoBrhoV = 1.0/Brho,
       N = 50, Method = 1;}

L_TPW = 0.60;
TPW1: Fieldmap, L = L_TPW, N = 50, file1 = "../in/lattice/3polebzvert3.txt";

D_TPW: Drift, L = -L_TPW/2.0;
TPW: D_TPW, TPW1, D_TPW;
  
lambda_DW = 8e-2; n_DW = 88; L_DW = n_DW*lambda_DW;
D_DW: Drift, L = -L_DW/2.0;
{DW1: Wiggler, L = lambda_DW, lambda = lambda_DW, kxV = 0.0, 
     BoBrhoV = 1.8/Brho, N = 4, Method = 1;}
{ Harmonics 7 and 9 break DA. }
{DW1: Wiggler, L = lambda_DW, lambda = lambda_DW, kxV = 0.0026, 
     BoBrhoV = 1.81502/Brho, N = 4, Method = 1,
     harm = (3,  0,  0.0438/Brho, 0, 0, 0,
             5,  0, -0.0613/Brho, 0, 0, 0,
             7,  0, -0.0068/Brho, 0, 0, 0,
             9,  0,  0.0042/Brho, 0, 0, 0,
             11, 0,  0.0011/Brho, 0, 0, 0,
             13, 0, -0.0002/Brho, 0, 0, 0);}
DW1: Fieldmap, L = lambda_DW, N = 10, file1 = "../in/lattice/w80bzvert.txt";
DW: D_DW, n_DW*DW1, D_DW;

{ EPU }
lambda_EPU = 45e-3;

n_EPU = 1; L_EPU = n_EPU*lambda_EPU; B_EPU = 3.3/(0.934*1e2*lambda_EPU);

D_EPU: Drift, L = -n_EPU*L_EPU/2.0;
EPU1: Fieldmap, L = L_EPU, N = 10, file1 = "../in/lattice/u45bzvert_heli.txt";
EPU1: Fieldmap, L = L_EPU, N = 10, file2 = "../in/lattice/u45bz_heli.txt";
EPU: D_EPU, n_EPU*EPU1, D_EPU;
  
c0 = 2.99792458e8; h_rf = 1300; C = 780.60000000000719;  
  
CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 5.00e6, Harnum = h_rf;  
  

LB:D11A,S1,D11B, BPM, QQ22, D22A, HCM, VCM, S2, D22B, QQ33, D33A, S3,   
    D33B, QQ44, BPM, D44A, S4, D44B, HCM, VCM;  
  
HB: D1A, SL1, HCM, VCM, D1B, BPM, QQ2, D2A, SL2,   
    D2B, QQ3, D3A, SL3, D3B, QQ4, BPM, D4A, SL4, D4B, HCM, VCM;  
  
DISP: HCM, VCM, SD1, D5A, BPM, QD3, D6A, SF1, D6B, QF2;  
  
DBA_TPW: B1, TPW, D5, GS, DISP, BPM, D7H, D7H, SF2H, QCH, MP, QCH, SF2H,   
         D7H, HCM, D7H, INV(DISP), GE, D5, B1;  
  
DBA: B1, D5, GS, DISP, BPM, D7H, D7H, SF2H, QCH, MP, QCH, SF2H,   
     D7H, HCM, D7H, INV(DISP), GE, D5, B1;  
  
ONEP: D0, GS, HB, DBA, INV(LB), GE,  D00, SS,   
      D00, GS, LB, DBA, INV(HB), GE, D0, LS;  
  
ONEP_TPW: D0, GS, HB, DBA_TPW, INV(LB), GE,  D00, SS,   
          D00, GS, LB, DBA, INV(HB), GE, D0, LS;  
  
ONEP_DW: D0, GS, HB, DBA, INV(LB), GE,  D00, SS,   
          D00, GS, LB, DBA, INV(HB), GE, D0, DW, LS;  
  
{RING: ONEP_DW, 14*ONEP, CAV;}
  
{RING: 15*ONEP, CAV;}

RING: 14*ONEP, 1*ONEP_TPW, CAV;
  
CELL: RING, SYMMETRY = 1;  
  
END;
