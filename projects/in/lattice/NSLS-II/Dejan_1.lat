define lattice; ringtype = 1;

Energy = 1.0;

dP = 1e-8; CODeps = 1e-14;  

Meth = 4; Nbend = 10; Nquad = 10; Nsext = 1;

Brho = 3.33564051648;


NCEL   = 20.0;
NDIP   = 7.0*NCEL;
 
S1: SEXTUPOLE, L = 0.0, K = 1e-10, N = Nsext, Method = Meth;
S2: SEXTUPOLE, L = 0.0, K = 1e-10, N = Nsext, Method = Meth;
S3: SEXTUPOLE, L = 0.0, K = 1e-10, N = Nsext, Method = Meth;
S4: SEXTUPOLE, L = 0.0, K = 1e-10, N = Nsext, Method = Meth;
S5: SEXTUPOLE, L = 0.0, K = 1e-10, N = Nsext, Method = Meth;
S6: SEXTUPOLE, L = 0.0, K = 1e-10, N = Nsext, Method = Meth;

D1: DRIFT, L = 0.075;

B2:  BENDING, L = 1.2,   T = 360/NDIP,     N = Nbend, Method = Meth;
B2H: BENDING, L = 1.2/2, T = 360/(2*NDIP), N = Nbend, Method = Meth;

QF2: QUADRUPOLE, L = 0.38/2, K =  6.264948739604/BRHO, N = Nquad,
     Method = Meth;
QD2: QUADRUPOLE, L = 0.35/2, K = -5.11089938048/BRHO, N = Nquad,
     Method = Meth;

{ FODO CELL }
BNHC: QD2, D1, S4, B2, S4, D1, QF2;
ANHC: QF2, D1, S5, B2, S5, D1, QD2;
FODO: S2, BNHC, S1, ANHC, S2;

D2: DRIFT, L = 0.57500194;
D3: DRIFT, L = 0.28839503;
D4: DRIFT, L = 0.40612007;

QF3: QUADRUPOLE, L = 0.300, K = 5.0653576/BRHO,  N = Nquad, Method = Meth;
QD3: QUADRUPOLE, L = 0.220, K = -4.0970890/BRHO, N = Nquad, Method = Meth;

NC0: FODO, QD2, D1, S6, B2, S6;
NC1: INV(NC0);
SNS: D2, QF3, S3, QF3, D3, QD3, S4, QD3, D4, S2, B2H,
     B2H, S2, D4, QD3, S4, QD3, D3, QF3, S3, QF3, D2;

BLOCK: NC0, SNS, NC1;

FEL: 1*BLOCK;

CELL: FEL, SYMMETRY = 1;  

END;
