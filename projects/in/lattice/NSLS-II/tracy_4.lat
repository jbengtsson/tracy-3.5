        DH4CG6B);

G6C1:
  LINE=(GSSP01, DCH2SP01, CXH2SP01, CYH2SP01, DCH2SP01, DH4BG6B,
        SH4, DH4AG6B, PH2SP01, DBPM2, QH3SP01, DH3BG6B, SH3,
        DH3AG6B, QH2SP01, DH2BG6B, DCH1SP01, CXH1SP01, CYH1SP01,
        DCH1SP01, DH2AG6B, QH1SP01, DH1AG6B, PH1SP01, DBPM, SH1,
