Beam, energy = 3e9;

Lattice, cod_delta = 1e-8, cod_eps = 1e-14;

Nbend = 4; Nquad = 4; Nsext = 1;

pi = 4.0*arctan(1.0);

c0 = 2.99792458e8; h_rf = 1320; C = 791.958; Brho = 1e9*Energy/c0;

