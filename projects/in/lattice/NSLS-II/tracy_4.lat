        DL4BG6B);

G6C30:
  LINE=(GSSP01, DL4AG6B, QL3SP01, DBPM2, PL2SP01, DL3CG6B, SL3,
        DL3BG6B, DCL2SP01, CXL2SP01, CYL2SP01, DCL2SP01,
        DL3AG6B, QL2SP01, DL2CG6B, SL2, DL2BG6B, DCL1SP01,
        CXL1SP01, CYL1SP01, DCL1SP01, DL2AG6B, QL1SP01, DL1AG6B,
        PL1SP01, DBPM, SL1, GESP01);

G1C1:
  LINE=(GSSP01, DL0BG1A, DFL1SP01, FXL1SP01, FYL1SP01, DFL1SP01,
        DFT2G1A, DLDKG1A, DL01G1A, DL02G1A, DLDKG1A, DFT2G1A,
