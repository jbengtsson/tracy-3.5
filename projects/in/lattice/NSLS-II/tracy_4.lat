        PH2SP01, DBPM, SH4, DH4BG2A, DCH2SP01, CXH2SP01,
        CYH2SP01, DCH2SP01, GESP01, DH4CG3A);

G3C30:
  LINE=(GSSP01, B1SP01, DM1AG3A, DCM1SP01, CXM1SP01, CYM1SP01,
        DCM1SP01, DM1BG3A, GESP01);

G4C30:
