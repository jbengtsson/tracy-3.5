SH3:  Sextupole, L = 0.200000, b3 = -11.309930, N = Nsext;
SH4:  Sextupole, L = 0.200000, b3 =  -2.516449, N = Nsext;

CAV: Cavity, f = c0/C*h_rf, V = 5.00e6, h = h_rf;

// Girders

G1C30:
  LINE=(DH02G1A, DFH2SP01, FXH2SP01, FYH2SP01, DFH2SP01, DH1G1A
        /*, GESP01*/);

G2C30:
  LINE=(GSSP01, SH1, DH1AG2A, PH1SP01, DBPM2, QH1SP01, DH2AG2A,
        SQ1HSP01, CXSQ1HSP01, CYSQ1HSP01, SQ1HSP01, DH2BG2A,
