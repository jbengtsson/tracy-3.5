define lattice; ringtype = 1;

Energy = 1.7; { Beam momentum [GeV]. }

dP = 1e-8; CODeps = 1e-14;

Meth = 4; Nbend = 10; Nquad = 10; Nsext = 2;

pi = 4.0*arctan(1.0); c0 = 2.99792458e8;

{ ##### AMOUNT OF CANONCICAL KICKS ##### }
qkicks = 20;
skicks = 10;
bkicks = 40;

{ ##### DIAGNOSTICS ##### }
wpinject: Marker; { watch }
wpsliced: Marker; { watch }
pinh3fd2l: Marker; { watch }
pinh9fd5l: Marker; { watch }
ibsm1fd2l: Marker; { watch }
filpatapd: Marker; { watch }
diagkick1: Drift, L = 0;
diagkick2: Drift, L = 0;
m1: Marker; { malign }
m2: Marker; { malign }
rc: Marker;

{ #### VIRTUAL ELEMENTS #### }
{  no effect on beam since L=0 (even if K != 0) }
{  used for tune- & chromaticity optimization by linking to real elements }
{  outside achromat quads & chromatic (zero-dispersion) sexts }
vqf: Quadrupole, L = 0, K = 0, N = Nquad, Method = 4;
vqd: Quadrupole, L = 0, K = 0, N = Nquad, Method = 4;
vcsf: Sextupole, L = 0, K = 0/2.0, N = Nsext, Method = 4;
vcsd: Sextupole, L = 0, K = 0/2.0, N = Nsext, Method = 4;
vhsf: Sextupole, L = 0, K = 0/2.0, N = Nsext, Method = 4;
vhsd: Sextupole, L = 0, K = 0/2.0, N = Nsext, Method = 4;

{ ##### DRIFTS ##### }
{ # Naming convention: D+previous element at first appearence }
dq1: Drift, L = 0.288;
ds1: Drift, L = 0.16;
dq2: Drift, L = 0.42;
ds2: Drift, L = 0.307;
db: Drift, L = 0.42;
ds3: Drift, L = 0.153;
dq3: Drift, L = 0.153;
dl: Drift, L = 2.80600;
dk: Drift, L = 2.45300;
dcavl: Drift, L = 0.937;
docav: Drift, L = 0.3755;
dicav: Drift, L = 0.376;
dcavr: Drift, L = 0.682;

{ #### CAVITY #### }
ncc: Cavity, L = 0.0, Frequency = 499636607.63099074, Voltage = 1.5e6, phi = 0*173.30369619408094, n = 1;
cavh1t8r: Cavity, L = 0.54, Frequency = 499636607.63099074, Voltage = 0.35e6, phi = 0*173.30369619408094, n = 1;
cavh2t8r: Cavity, L = 0.54, Frequency = 499636607.63099074, Voltage = 0.35e6, phi = 0*173.30369619408094, n = 1;
cavh3t8r: Cavity, L = 0.54, Frequency = 499636607.63099074, Voltage = 0.35e6, phi = 0*173.30369619408094, n = 1;
cavh4t8r: Cavity, L = 0.54, Frequency = 499636607.63099074, Voltage = 0.35e6, phi = 0*173.30369619408094, n = 1;
cavitystraight: 
  dcavl, cavh1t8r, docav, cavh2t8r, dicav, cavh3t8r, docav, cavh4t8r, dcavr;
{ # CHECK:                                     DK + DK = 2.45300 + 2.45300 = 4.906 }
{ #         .937 + .54 +  .3755 + .54 +  .376 + .54 +  .3755 + .54 +  .682 = 4.906 }


{ ##### DIPOLES ##### }
{  edge_order=2 gives relevant change for dnuy/dp }
{  and consistent results with mad-x and ptc exact }
{  -> important for nonlinear dynamics }
len = 0.855;
angle = pi / 16;
rho = len / angle;
hangle = angle / 2;
{  standard BESSY II Dipole }
b: Bending, L = len, T = (angle)*180.0/pi, T1 = (hangle)*180.0/pi, T2 = (hangle)*180.0/pi, GAP = 4*0.0000001*0.7, N = Nbend, Method = 4;

{  split dipoles for diagnostic beamlines }
bp2d2r1: Bending, L = 0.2812, T = (0.2812 / rho)*180.0/pi, T1 = (hangle)*180.0/pi, GAP = 4*0.0000001*0.7, N = Nbend, Method = 4;

bp2d2r2: Bending, L = 0.0304, T = (0.0304 / rho)*180.0/pi, GAP = 4*1e-07*0.0, N = Nbend, Method = 4;
bp2d2r3: Bending, L = 0.0152, T = (0.0152 / rho)*180.0/pi, GAP = 4*1e-07*0.0, N = Nbend, Method = 4;
bp2d2r4: Bending, L = 0.5282, T = (0.5282 / rho)*180.0/pi, T2 = (hangle)*180.0/pi, GAP = 4*0.0000001*0.7, N = Nbend, Method = 4;
bp2d2r: bp2d2r1, pinh3fd2l, bp2d2r2, ibsm1fd2l, bp2d2r3, filpatapd, bp2d2r4;

bp2d5r1: Bending, L = 0.278008, T = (0.278008 / rho)*180.0/pi, T1 = (hangle)*180.0/pi, GAP = 4*0.0000001*0.7, N = Nbend, Method = 4;
bp2d5r2: Bending, L = 0.576992, T = (0.576992 / rho)*180.0/pi, T2 = (hangle)*180.0/pi, GAP = 4*0.0000001*0.7, N = Nbend, Method = 4;
bp2d5r: bp2d5r1, pinh9fd5l, bp2d5r2;

{  dipoles for chicane in femto slicing straight }
b1id: Bending, L = 0.28, T = (0.0578788879)*180.0/pi, T1 = (0)*180.0/pi, T2 = (0.0578788879)*180.0/pi, GAP = 4*0.0000001*0.7, N = Nbend, Method = 4;
b2id: Bending, L = 0.56, T = (-0.1117010721)*180.0/pi, T1 = (-0.0578788879)*180.0/pi, T2 = (-0.0538221842)*180.0/pi, GAP = 4*0.0000001*0.7, N = Nbend, Method = 4;
b3id: Bending, L = 0.28, T = (0.0538221842)*180.0/pi, T1 = (0.0538221842)*180.0/pi, T2 = (0)*180.0/pi, GAP = 4*0.0000001*0.7, N = Nbend, Method = 4;

{ # opts=defaults: }
{ # FINT=0.5, SYNCH_RAD=0, ISR=0, ISR1PART=1 (only active if ISR=1), USE_RAD_DIST=0 }
{ # EDGE1 EFFECTS=1, EDGE2 EFFECTS=1, EDGE ORDER=1 }
{ # DIPOLES 1: 4degree beamline + 6.7degree beamline }
{ # DIPOLES 2: 2degree beamline }

{ ##### QUADRUPOLES ##### }
qit6: Quadrupole, L = 0.122, K = -1.07648848, N = Nquad, Method = 4;
q1: Quadrupole, L = 0.25, K = 2.44020173, N = Nquad, Method = 4;
q2: Quadrupole, L = 0.2, K = -1.85345599, N = Nquad, Method = 4;
