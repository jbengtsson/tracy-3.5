q3t7: Quadrupole, L = 0.25, K = -2.43362878, N = Nquad, Method = 4;
q4p1t1: Quadrupole, L = 0.5, K = 2.63676727, N = Nquad, Method = 4;
q4p1t6: Quadrupole, L = 0.5, K = 2.25321827, N = Nquad, Method = 4;
