!##### AMOUNT OF CANONCICAL KICKS #####
% 24 sto bkicks
% 146 sto qkicks
% 32 sto skicks

!##### DIAGNOSTICS #####
WPINJECT  : WATCH, filename="%s.WP_INJECT.coo", mode=coordinate, disable=1
WPSLICED  : WATCH, filename="%s.WP_SLICED_%03ld.coo", mode=coordinate, disable=1
PINH3FD2L : WATCH, filename="%s.WP_PINH3FD2L.coo", mode=coordinate, disable=1
PINH9FD5L : WATCH, filename="%s.WP_PINH9FD5L.coo", mode=coordinate, disable=1
IBSM1FD2L : WATCH, filename="%s.WP_IBSM1FD2L.coo", mode=coordinate, disable=1
FILPATAPD : WATCH, filename="%s.WP_FILPATAPD.coo", mode=coordinate, disable=1
M1        : MALIGN
M2        : MALIGN
RC        : MARK

!#### VIRTUAL ELEMENTS ####
! no effect on beam since L=0 (even if K != 0)
! used for tune- & chromaticity optimization by linking to real elements
! outside achromat quads & chromatic (zero-dispersion) sexts
VQF  : KQUAD, L=0, K1=0
VQD  : KQUAD, L=0, K1=0
VCSF : KSEXT, L=0, K2=0
VCSD : KSEXT, L=0, K2=0
VHSF : KSEXT, L=0, K2=0
VHSD : KSEXT, L=0, K2=0

!!##### DRIFTS #####
! naming convention: D + previous element at first appearence
DQ1  : DRIF, L=0.288
DS1  : DRIF, L=0.16
DQ2  : DRIF, L=0.42
DS2  : DRIF, L=0.307   
DB   : DRIF, L=0.42
DS3  : DRIF, L=0.153
DQ3  : DRIF, L=0.153
DL   : DRIF, L=2.80600
DK   : DRIF, L=2.45300
DS4D6: DRIF, L=0.164000
DB1ID: DRIF, L=2.020140
DB2ID: DRIF, L=2.216250
DB3ID: DRIF, L=0.100000
! EMIL quadrupole position estimated
DQ5T6: drif, L=2.2976 
DQIT6: drif, L=2.3644

!##### DIPOLES #####
! edge_order=2 gives relevant change for dnuy/dp
! and consistent results with mad-x and ptc exact
! -> important for nonlinear dynamics
% 0.855 sto L
% pi 16 / sto angle
% L angle / sto rho
% angle 2 / sto hangle
! standard BESSY II Dipole
B       : CSBEND, n_kicks="bkicks", L="L", ANGLE="angle", E1="hangle", E2="hangle", &
          EDGE_ORDER=2, EDGE1_EFFECTS=2, EDGE2_EFFECTS=2, FSE_CORRECTION=1, &
          HGAP=0.0000001, FINT=0.7
          
! split dipoles for diagnostic beamlines
BP2D2R1 : CSBEND, n_kicks="bkicks", L=0.2812,   ANGLE="0.2812 rho /",   E1="hangle", &
          EDGE_ORDER=2, EDGE1_EFFECTS=2, EDGE2_EFFECTS=0, FSE_CORRECTION=1, &
          HGAP=0.0000001, FINT=0.7
          
BP2D2R2 : CSBEND, n_kicks="bkicks", L=0.0304,   ANGLE="0.0304 rho /",&
          HGAP=1e-07,FINT=0.,N_KICKS=160,EDGE1_EFFECTS=0,EDGE2_EFFECTS=0,EDGE_ORDER=0,FSE_CORRECTION=1
BP2D2R3 : CSBEND, n_kicks="bkicks", L=0.0152,   ANGLE="0.0152 rho /",&
          HGAP=1e-07,FINT=0.,N_KICKS=160,EDGE1_EFFECTS=0,EDGE2_EFFECTS=0,EDGE_ORDER=0,FSE_CORRECTION=1
BP2D2R4 : CSBEND, n_kicks="bkicks", L=0.5282,   ANGLE="0.5282 rho /",   E2="hangle", &
          EDGE_ORDER=2, EDGE1_EFFECTS=0, EDGE2_EFFECTS=2, FSE_CORRECTION=1, &
          HGAP=0.0000001, FINT=0.7
          
BP2D5R1 : CSBEND, n_kicks="bkicks", L=0.278008, ANGLE="0.278008 rho /", E1="hangle", &
          EDGE_ORDER=2, EDGE1_EFFECTS=2, EDGE2_EFFECTS=2, FSE_CORRECTION=1, &
          HGAP=0.0000001, FINT=0.7
          
BP2D5R2 : CSBEND, n_kicks="bkicks", L=0.576992, ANGLE="0.576992 rho /", E2="hangle", &
          EDGE_ORDER=2, EDGE1_EFFECTS=2, EDGE2_EFFECTS=2, FSE_CORRECTION=1, &
          HGAP=0.0000001, FINT=0.7
          
! dipoles for chicane in femto slicing straight
B1ID    : CSBEND, n_kicks="bkicks", L=0.28, ANGLE=0.0578788879,  E1=0,             E2=0.0578788879, &
          EDGE_ORDER=2, EDGE1_EFFECTS=2, EDGE2_EFFECTS=2, FSE_CORRECTION=1, &
          HGAP=0.0000001, FINT=0.7
          
B2ID    : CSBEND, n_kicks="bkicks", L=0.56, ANGLE=-0.1117010721, E1=-0.0578788879, E2=-0.0538221842, &
          EDGE_ORDER=2, EDGE1_EFFECTS=2, EDGE2_EFFECTS=2, FSE_CORRECTION=1, &
          HGAP=0.0000001, FINT=0.7
          
B3ID    : CSBEND, n_kicks="bkicks", L=0.28, ANGLE=0.0538221842,  E1=0.0538221842,  E2=0, &
          EDGE_ORDER=2, EDGE1_EFFECTS=2, EDGE2_EFFECTS=2, FSE_CORRECTION=1, &
          HGAP=0.0000001, FINT=0.7
          

!#### CAVITY ####
% 1.5e6 sto NCCVOLT
% 4.996366081528583e+08 sto NCCFREQ
% 1.729810237412622e+02 sto NCCPHASE
NCC: RFCA, L=0.0, VOLT="NCCVOLT", FREQ="NCCFREQ", PHASE="NCCPHASE", T_REFERENCE=0

