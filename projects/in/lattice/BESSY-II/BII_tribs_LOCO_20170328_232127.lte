T5RH : LINE=(DK,Q5T5,DQ3,S4T,DQ3,Q4T5,DS3,S3T,DQ3,Q3T5,DB)
D6LH : LINE=(DB,Q3D6,DQ3,S3D,DS3,Q4D6,DQ3,S4D,DS4D6,FEMTOC)
D6RH : LINE=(S4D,DQ3,Q4D6,DS3,S3D,DQ3,Q3D6,DB)
