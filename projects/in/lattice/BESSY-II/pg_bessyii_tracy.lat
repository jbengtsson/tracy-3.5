{bii standard user}

{opa to tracy-2 export}

define lattice;
energy = 1.700000;
dp = 1.0d-10;  codeps = 1.0d-6;  dk = 1.0d-6;
meth = 4; nbend = 10; nquad = 10;

{----- variables ----------------------------------------------------}


{----- table of elements ----------------------------------------------------}

dq1     : drift, l = 0.288000;
ds1     : drift, l = 0.160000;
dq2     : drift, l = 0.420000;
ds2     : drift, l = 0.307000;
db      : drift, l = 0.420000;
ds3     : drift, l = 0.153000;
dq      : drift, l = 0.153000;
dl      : drift, l = 2.806000;
dk      : drift, l = 2.453000;

q1      : quadrupole, l = 0.250000, k = 2.451900, n=nquad, method=meth;
q2      : quadrupole, l = 0.200000, k = -1.897570, n=nquad, method=meth;
q3d     : quadrupole, l = 0.250000, k = -2.020250, n=nquad, method=meth;
q4d     : quadrupole, l = 0.500000, k = 1.408159, n=nquad, method=meth;
q3t     : quadrupole, l = 0.250000, k = -2.463190, n=nquad, method=meth;
q4t     : quadrupole, l = 0.500000, k = 2.620810, n=nquad, method=meth;
q5t     : quadrupole, l = 0.200000, k = -2.600000, n=nquad, method=meth;

b       : bending, l = 0.855000, t = 11.250000, k = 0.000000,
          t1 = 5.625000, t2 = 5.625000, gap = 0.0200, n=nbend, method=meth;

s1      : sextupole, l = 0.105000, k = 24.679000, n = 1, method=meth;
s2      : sextupole, l = 0.160000, k = -20.760000, n = 1, method=meth;
s3d     : sextupole, l = 0.160000, k = -23.330000, n = 1, method=meth;
s4d     : sextupole, l = 0.160000, k = 13.450000, n = 1, method=meth;
s3t     : sextupole, l = 0.160000, k = -29.552500, n = 1, method=meth;
s4t     : sextupole, l = 0.160000, k = 42.360000, n = 1, method=meth;

t2match : marker;


{----- table of segments ----------------------------------------------------}

drh   : s4d, dq, q4d, ds3, s3d, dq, q3d;
dbd   : db, b, dq2;
achlh : q2, ds2, s2, dq1, q1, ds1, s1;
tlh   : q3t, dq, s3t, ds3, q4t, dq, s4t, dq, q5t;
sp    : dl, drh, dbd, achlh, inv(achlh), inv(dbd), tlh, dk, dk,
        inv(tlh), dbd, achlh, inv(achlh), inv(dbd), inv(drh), dl;
ring  : 1*sp;

cell: ring, symmetry=1;

end;

