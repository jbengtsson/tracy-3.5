q5t7: Quadrupole, L = 0.2, K = -2.610663634349188, N = Nquad, Method = 4;

s1: Sextupole, L = 0.105, K = 53.71159807/2.0, N = Nsext, Method = 4;
s2: Sextupole, L = 0.16, K = -44.96887307/2.0, N = Nsext, Method = 4;

{  harm sextupole reference settings }
s3d: Sextupole, L = 0.16, K = -42.735/2.0, N = Nsext, Method = 4;
s3d1: Sextupole, L = 0.16, K = -39.96/2.0, N = Nsext, Method = 4;
s3t: Sextupole, L = 0.16, K = -43.8795/2.0, N = Nsext, Method = 4;
s3p1t6: Sextupole, L = 0.16, K = -43.8795/2.0, N = Nsext, Method = 4;
s3p2t6: Sextupole, L = 0.16, K = -43.8795/2.0, N = Nsext, Method = 4;

s4d: Sextupole, L = 0.16, K = 38.2185/2.0, N = Nsext, Method = 4;
s4d1: Sextupole, L = 0.16, K = 27.0435/2.0, N = Nsext, Method = 4;
s4t: Sextupole, L = 0.16, K = 55.0/2.0, N = Nsext, Method = 4;
s4p1t6: Sextupole, L = 0.16, K = 41.25/2.0, N = Nsext, Method = 4;
s4p2t6: Sextupole, L = 0.16, K = 41.25/2.0, N = Nsext, Method = 4;

dq1: Drift, L = 0.288;
ds1: Drift, L = 0.16;
dq2: Drift, L = 0.42;
ds2: Drift, L = 0.307;
db: Drift, L = 0.42;
ds3: Drift, L = 0.153;
dq3: Drift, L = 0.153;
dl: Drift, L = 2.806;
dk: Drift, L = 2.453;
b: Bending, L = 0.855, T = (0.196349540849362)*180.0/pi, T1 = (0.09817477042)*180.0/pi, T2 = (0.09817477042)*180.0/pi, N = Nbend, Method = 4;
b1id: Bending, L = 0.28, T = (0.0578788879)*180.0/pi, T1 = (0)*180.0/pi, T2 = (0.0578788879)*180.0/pi, N = Nbend, Method = 4;
b2id: Bending, L = 0.56, T = (-0.1117010721)*180.0/pi, T1 = (-0.0578788879)*180.0/pi, T2 = (-0.0538221842)*180.0/pi, N = Nbend, Method = 4;
b3id: Bending, L = 0.28, T = (0.0538221842)*180.0/pi, T1 = (0.0538221842)*180.0/pi, T2 = (0)*180.0/pi, N = Nbend, Method = 4;
ds4d6: Drift, L = 0.164;
db1id: Drift, L = 2.02014;
db2id: Drift, L = 2.21625;
db3id: Drift, L = 0.1;
dq5t6: Drift, L = 2.2976;
dqit6: Drift, L = 2.3644;

start: Marker;

{ extra watch points }
watchsep: Marker; { watch }

septum: Drift, L = 0.56;
injdr1: Drift, L = 0.0555;
injdr2: Drift, L = 0.245;
kicker3: Drift, L = 0.595;
dki: Drift, L = 0.456;
kicker4: Drift, L = 0.595;
injdr3: Drift, L = 0.2995;

{ FOMZ2D1: watch,filename="%s.wFOMZ2D1",mode="coordinates", interval=1 }
fomz2d1: Marker; { watch }
fomz1d2: Marker; { watch }
fomz1d3: Marker; { watch }
fomz1d8: Marker; { watch }
fomz1d1: Marker; { watch }

injr: 
  start, septum, watchsep, injdr1, fomz2d1, injdr2, kicker3, dki, kicker4, injdr3;

{ D1RH: LINE=(DL, S4D1, DQ3, Q4D1, DS3, S3D1, DQ3, Q3D1, DB) }
d1rh: 
  injr, s4d1, dq3, q4d1, ds3, s3d1, dq3, q3d1, db;
achlh: 
  dq2, q2d, ds2, s2, dq1, q1d, ds1, s1;
d1r: d1rh, b, achlh;

achrh: 
  s1, ds1, q1d, dq1, s2, ds2, q2d, dq2;

t1lh: 
  db, q3p1t1, dq3, s3t, ds3, q4p1t1, dq3, s4t, dq3, q5p1t1, 
  dk;
t1rh: 
  dk, q5p2t1, dq3, s4t, dq3, q4p2t1, ds3, s3t, dq3, q3p2t1, 
  db;
t11: achrh, b, t1lh, t1rh, b, achlh;

{  first half }
d2d1: Drift, L = 0.3;
d2d2: Drift, L = 2.806 - 0.3 - 0.3;
nlk: Drift, L = 0.3;
nlkinv: Drift, L = 0.30;
wnlkin: Marker; { watch }
wnlkout: Marker; { watch }
dld2l: d2d1, wnlkin, nlk, wnlkout, d2d2;

{  second half }
d2d3: Drift, L = 2.4;
d2d4: Drift, L = 2.806 - 2.4;
dld2r: d2d3, fomz1d2, d2d4;

d2lh: 
  db, q3d2, dq3, s3d, ds3, q4d2, dq3, s4d, dld2l;
d2rh: 
  dld2r, s4d, dq3, q4d2, ds3, s3d, dq3, q3d2, db;
d2: achrh, b, d2lh, d2rh, b, achlh;

d2nlk: 
  achrh, b, db, q3d2, dq3, s3d, ds3, q4d2, dq3, s4d, 
  d2d1;


t2lh: 
  db, q3t2, dq3, s3t, ds3, q4t2, dq3, s4t, dq3, q5t2, 
  dk;
t2rh: 
  dk, q5t2, dq3, s4t, dq3, q4t2, ds3, s3t, dq3, q3t2, 
  db;
t22: achrh, b, t2lh, t2rh, b, achlh;

d3lh: 
  db, q3d3, dq3, s3d, ds3, q4d3, dq3, s4d, dl;

{  second half }
d3d3: Drift, L = 2.4;
d3d4: Drift, L = 2.806 - 2.4;
dld3r: d3d3, fomz1d3, d3d4;

d3rh: 
  dld3r, s4d, dq3, q4d2, ds3, s3d, dq3, q3d2, db;
d3: achrh, b, d3lh, d3rh, b, achlh;

t3lh: 
  db, q3t3, dq3, s3t, ds3, q4t3, dq3, s4t, dq3, q5t3, 
  dk;
t3rh: 
  dk, q5t3, dq3, s4t, dq3, q4t3, ds3, s3t, dq3, q3t3, 
  db;
t3: achrh, b, t3lh, t3rh, b, achlh;

d4lh: 
  db, q3d4, dq3, s3d, ds3, q4d4, dq3, s4d, dl;
d4rh: 
  dl, s4d, dq3, q4d4, ds3, s3d, dq3, q3d4, db;
d4: achrh, b, d4lh, d4rh, b, achlh;
t4lh: 
  db, q3t4, dq3, s3t, ds3, q4t4, dq3, s4t, dq3, q5t4, 
  dk;
t4rh: 
  dk, q5t4, dq3, s4t, dq3, q4t4, ds3, s3t, dq3, q3t4, 
  db;
t4: achrh, b, t4lh, t4rh, b, achlh;

d5lh: 
  db, q3d5, dq3, s3d, ds3, q4d5, dq3, s4d, dl;
d5rh: 
  dl, s4d, dq3, q4d5, ds3, s3d, dq3, q3d5, db;
d5: achrh, b, d5lh, d5rh, b, achlh;
t5lh: 
  db, q3t5, dq3, s3t, ds3, q4t5, dq3, s4t, dq3, q5t5, 
  dk;
t5rh: 
  dk, q5t5, dq3, s4t, dq3, q4m2t5, ds3, s3t, dq3, q3t5, 
  db;
t5: achrh, b, t5lh, t5rh, b, achlh;

d6lh: 
  db, q3d6, dq3, s3d, ds3, q4d6, dq3, s4d, ds4d6, b1id, 
  db1id, b2id, db2id, b3id, db3id;
d6rh: 
  s4d, dq3, q4d6, ds3, s3d, dq3, q3d6, db;
d6: achrh, b, d6lh, d6rh, b, achlh;


extra: Drift, L = 0.0;
t6lh: 
  db, q3p1t6, dq3, s3p1t6, extra, ds3, q4p1t6, dq3, s4p1t6, dq3, 
  q5p1t6, dq5t6, qit6, qit6, dqit6;
t6rh: 
  q5p2t6, dq3, s4p2t6, dq3, q4p2t6, ds3, s3p2t6, dq3, q3p2t6, db;
t6: achrh, b, t6lh, t6rh, b, achlh;

d7lh: 
  db, q3d7, dq3, s3d, ds3, q4d7, dq3, s4d, dl;
d7rh: 
  dl, s4d, dq3, q4d7, ds3, s3d, dq3, q3d7, db;
d7: achrh, b, d7lh, d7rh, b, achlh;
t7lh: 
  db, q3t7, dq3, s3t, ds3, q4t7, dq3, s4t, dq3, q5t7, 
  dk;
t7rh: 
  dk, q5t7, dq3, s4t, dq3, q4t7, ds3, s3t, dq3, q3t7, 
  db;
t7: achrh, b, t7lh, t7rh, b, achlh;

d8lh: 
  db, q3d8, dq3, s3d, ds3, q4d8, dq3, s4d, dl;
d8rh: 
  dl, s4d, dq3, q4d8, ds3, s3d, dq3, q3d8, db;
d8: achrh, b, d8lh, d8rh, b, achlh;
t8lh: 
  db, q3p1t8, dq3, s3t, ds3, q4p1t8, dq3, s4t, dq3, q5p1t8, 
  dk;
t8rh: 
  dk, q5p2t8, dq3, s4t, dq3, q4p2t8, ds3, s3t, dq3, q3p2t8, 
  db;
t8: achrh, b, t8lh, t8rh, b, achlh;


end_m: Marker;
injdr0: Drift, L = 0.56;
kicker1: Drift, L = 0.595;
kicker2: Drift, L = 0.595;

injl: 
  injdr3, kicker1, dki, kicker2, injdr2, fomz1d1, injdr1, injdr0, end_m;

{ D1LH: LINE=(DB, Q3D1, DQ3, S3D1, DS3, Q4D1, DQ3, S4D1, DL) }
d1lh: 
  db, q3d1, dq3, s3d1, ds3, q4d1, dq3, s4d1, injl;
d1l: achrh, b, d1lh;

ikv: Marker; { malign }

ring: 
  ikv, d1r, t11, d2, t22, d3, t3, d4, t4, d5, 
  t5, d6, t6, d7, t7, d8, t8, d1l;

cell: ring, symmetry = 1;

end;