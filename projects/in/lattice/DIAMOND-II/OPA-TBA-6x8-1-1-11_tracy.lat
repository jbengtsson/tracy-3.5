{opa to tracy-2 export}

define lattice;
energy = 3.500000;
dp = 1.0d-10;  codeps = 1.0d-6;  dk = 1.0d-6;
meth = 4;

{----- variables ----------------------------------------------------}

dp      = 1e-10;
codeps  = 1e-6;
dk      = 1e-6;
nbend   = 10;
nquad   = 10;
nsext   = 2;
f       = 0.8;

{----- table of elements ----------------------------------------------------}

cav: Cavity, L = 0.0, Frequency = 499654096.667, Voltage = 2200000, phi = 0.0;

d5       : drift, l = 0.073642;
d6       : drift, l = 0.430954;
d7       : drift, l = 0.105044;

d_ms     : drift, l = 1.400000;
d_ss     : drift, l = 2.400000;
d_ls     : drift, l = 3.900000;

ss       : marker;
ms       : marker;
ls       : marker;

b1       : bending, l = 1.200000*f, t = 2.942714, k = -1.055971,
           t1 = 1.471357, t2 = 1.471357, n=nbend, method=meth;
b2       : bending, l = 0.573951*f, t = 0.807286, k = -1.454000,
           t1 = 0.403643, t2 = 0.403643, n=nbend, method=meth;

qf1a_tba : quadrupole, l = 0.160018, k = 5.055000, n=nquad, method=meth;
qf1b_tba : quadrupole, l = 0.142448, k = 4.620000, n=nquad, method=meth;

{d8       : drift, l = 0.123008;
qf1_ms   : quadrupole, l = 0.199729, k = -2.902160, n=nquad, method=meth;
d9       : drift, l = 0.111389;
qd2_ms   : quadrupole, l = 0.148842, k = 8.582939, n=nquad, method=meth;}

d8:     drift, l =  0.12424090;
qf1_ms: quadrupole, l =  0.19999809, k = -2.98057536, n = nquad, method = 4;
d9:     drift, l =  0.11485885;
