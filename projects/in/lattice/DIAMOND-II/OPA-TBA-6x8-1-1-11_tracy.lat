d1       : drift, l =  0.075;
qf1_ls   : quadrupole, l = 0.1,      k =   0.0,      n=nquad, method=meth;}

d10      : drift, l = 0.347387;
qd3_ss   : quadrupole, l = 0.148765, k = -0.528000, n=nquad, method=meth;
d11      : drift, l = 0.165362;
qf2_ss   : quadrupole, l = 0.200592, k = 9.251656, n=nquad, method=meth;
d12      : drift, l = 0.075050;
qd1_ss   : quadrupole, l = 0.100917, k = -11.258085, n=nquad, method=meth;

d4:     drift, l =  0.07500089;
qd4_ls: quadrupole, l =  0.37726364, k = -5.29218657, n = nquad, method = 4;
d3:     drift, l =  0.23100836;
qf3_ls: quadrupole, l =  0.15799864, k = 14.69944622, n = nquad, method = 4;
