{ TITLE "alsu-7ba-ring" }

define lattice; ringtype = 1;

Energy = 2.0;

{making dP smaller speeds up runtime}
dP = 1e-6; CODeps = 1e-10;

{Meth = 4; Nbend = 4; Nquad = 4; Nsext = 4; Ncorr = 1;}
Meth = 4; Nbend = 10; Nquad = 10; Nsext = 10; Ncorr = 1;

pi = 4.0*arctan(1.0);
c0 = 2.99792458e8;

rbang     = 0.58;
klgb      = -8.5522879654378;
bendcorr  = (rbang-0.8069906)/2;
mcdrft    = 0.0700824999444334;

dx02:      DRIFT, L= 2.0000000000E-03;
dx25:      DRIFT, L= 2.5000000000E-02;
dx:        DRIFT, L= 4.8000000000E-02;
ssh2:      DRIFT, L= 2.693000/5;
md33:      DRIFT, L= mcdrft;
ssxtra:    DRIFT, L= 0.084-mcdrft;


{ Girder Markers }
GS: Multipole, N = 1, Method = Meth;
GE: Multipole, N = 1, Method = Meth;


{ Beam Position Monitors }
BPM_D: Drift, L = 5.0e-2/2.0;
BPM_M: Beam Position Monitor;
{BPM:   BPM_D, BPM_M, BPM_D;}
BPM:   BPM_M;

{ Horizontal and vertical corrector }
CORR_D:  Drift, L = 10.0e-2/4.0;
CORR_H:  Corrector, Horizontal, Method= Meth;
CORR_V:  Corrector, Vertical, Method= Meth;
CORR:    CORR_D, CORR_V, 2*CORR_D, CORR_H, CORR_D;
CORRs:   CORR_D, CORR_H, 3*CORR_D;
cm:      CORR_V, CORR_H;

b_t: marker;

b3h:   BENDING, L= 2.50000E-01, T= 2.5+rbang,
       K=-5.032084, T1= 0.0, T2= 0.0,
       N = Nbend, Method = Meth;

mb3h:  BENDING, L= 2.50000E-01, T= 2.5+rbang,
       K=-0.677751, T1= 0.0, T2= 0.0,
       N = Nbend, Method = Meth;

lgb00: BENDING, L= 3.2088E-02, T= 0.551167,
       K=0.0, T1= 0.0, T2= 0.551167,
       N = Nbend, Method = Meth;

lgb01: BENDING, L= 3.2088E-02, T= 0.551167,
       K=0.0, T1= -0.551167, T2= 1.102333,
       N = Nbend, Method = Meth;

lgb02: BENDING, L= 3.2088E-02, T= 0.551167,
       K=0.0, T1= -1.102333, T2= 1.653500,
       N = Nbend, Method = Meth;

lgb03: BENDING, L= 4.0000E-02, T= 0.551172,
       K=klgb, T1= -1.653500, T2= 2.204672,
       N = Nbend, Method = Meth;

lgb04: BENDING, L= 4.9897E-02, T= 0.543650+bendcorr,
       K=klgb, T1= -2.204672, T2= 2.748322+bendcorr,
       N = Nbend, Method = Meth;

lgb05: BENDING, L= 6.3885E-02, T= 0.558678+bendcorr,
       K=klgb, T1= -2.748322-bendcorr, T2= 3.307000+2*bendcorr,
       N = Nbend, Method = Meth;


q1:    QUADRUPOLE, L= 1.0000000000E-01, K= -10.915000,
       N = Nquad, Method = Meth;

q2:    QUADRUPOLE, L= 2.0000000000E-01, K= 15.366512,
       N = Nquad, Method = Meth;

q3:    QUADRUPOLE, L= 1.5000000000E-01, K= -15.120192,
       N = Nquad, Method = Meth;

q4:    QUADRUPOLE, L= 5.0000000000E-02, K= 6.552000,
       N = Nquad, Method = Meth;


{OPA had 1639.561130, gave -0.95,-1.39}
sf1:   SEXTUPOLE, L= 5.0000000000E-02, K= 1644.7272,
       N = Nsext, Method = Meth;

sf2:   SEXTUPOLE, L= 5.0000000000E-02, K= 1377.648440,
       N = Nsext, Method = Meth;

sf3:   SEXTUPOLE, L= 5.0000000000E-02, K= 1047.256460,
       N = Nsext, Method = Meth;

{OPA had -918.485853, gave -0.95,-1.39}
sd1h:  SEXTUPOLE, L= 5.0000000000E-02, K= -963.0474,
       N = Nsext, Method = Meth;

sd2h:  SEXTUPOLE, L= 5.0000000000E-02, K= -1469.641320,
       N = Nsext, Method = Meth;

sd3h:  SEXTUPOLE, L= 5.0000000000E-02, K= -998.545015,
       N = Nsext, Method = Meth;

sd4h:  SEXTUPOLE, L= 5.0000000000E-02, K= -1101.396970,
       N = Nsext, Method = Meth;

sh1:   SEXTUPOLE, L= 5.0000000000E-02, K= 1009.723100,
       N = Nsext, Method = Meth;

sh2:   SEXTUPOLE, L= 5.0000000000E-02, K= -1050.778590,
       N = Nsext, Method = Meth;

sh3:   SEXTUPOLE, L= 5.0000000000E-02, K= -368.940841,
       N = Nsext, Method = Meth;

{ Andreas. }
{sf1    : sextupole, l = 0.050000, k =  1837.904600, n = nsext, method = meth;
sf2    : sextupole, l = 0.050000, k =  1405.349820, n = nsext, method = meth;
sf3    : sextupole, l = 0.050000, k =   871.196054, n = nsext, method = meth;
sd1h   : sextupole, l = 0.050000, k = -1245.145300, n = nsext, method = meth;
sd2h   : sextupole, l = 0.050000, k = -1549.176160, n = nsext, method = meth;
sd3h   : sextupole, l = 0.050000, k =  -934.457526, n = nsext, method = meth;
sd4h   : sextupole, l = 0.050000, k =  -896.108121, n = nsext, method = meth;
sh1    : sextupole, l = 0.050000, k =  1180.892790, n = nsext, method = meth;
sh2    : sextupole, l = 0.050000, k = -1171.748790, n = nsext, method = meth;
sh3    : sextupole, l = 0.050000, k =  -384.918772, n = nsext, method = meth;}

{sf1     : sextupole, l = 0.05000, k =  1.18158e+03, n = nsext, Method = Meth;
sf2     : sextupole, l = 0.05000, k =  1.27737e+03, n = nsext, Method = Meth;
sf3     : sextupole, l = 0.05000, k =  1.56042e+03, n = nsext, Method = Meth;
sd1h    : sextupole, l = 0.05000, k = -6.96240e+02, n = nsext, Method = Meth;
sd2h    : sextupole, l = 0.05000, k = -1.51898e+03, n = nsext, Method = Meth;
sd3h    : sextupole, l = 0.05000, k = -1.30988e+03, n = nsext, Method = Meth;
sd4h    : sextupole, l = 0.05000, k = -5.02587e+02, n = nsext, Method = Meth;
sh1     : sextupole, l = 0.05000, k =  0.0,         n = nsext, Method = Meth;
sh2     : sextupole, l = 0.05000, k =  0.0,         n = nsext, Method = Meth;
sh3     : sextupole, l = 0.05000, k =  0.0,         n = nsext, Method = Meth;}


qfh:   BENDING, L= 1.20000E-01, T= -rbang,
       K= 16.141339, T1= 0.0, T2= 0.0,
       N = Nquad, Method = Meth;

mqfh:  BENDING, L= 1.20000E-01, T= -rbang,
       K= 14.128881, T1= 0.0, T2= 0.0,
       N = Nquad, Method = Meth;


{CAV is not actual cavity position; only used to calculate phi_s, delta_rf, etc.}
h_rf = 327; C =  195.94152;
CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 0.715e6, Harnum = h_rf, phi = 180.0;


ssh:    5*ssh2;
lgb:    lgb00, lgb01, lgb02, lgb03, lgb04, lgb05;
sd1:    2*sd1h;
sd2:    2*sd2h;
sd3:    2*sd3h;
sd4:    2*sd4h;
hcell1: lgb, dx, sd2, dx, dx, qfh, dx, sf1;
hcell2: lgb, dx, sd2, dx, dx, qfh, dx, bpm, cm, sf2;
hcell3: lgb, dx, sd3, dx, dx, qfh, dx, sf2;
hcell4: lgb, dx, sd3, dx, dx, qfh, dx, bpm, cm, sf3;
hcell5: lgb, dx, sd4, dx, dx, qfh, dx, sf3;
fcell:  INV(hcell3), hcell4;
ds:     mb3h, dx, sd1, md33, dx, dx, mqfh, dx, bpm, cm, sf1, INV(hcell1);
mc:     bpm, cm, q1, dx, 4*dx02, sh1, dx, q2, dx, sh2, dx, q3, dx, sh3, dx, q4, 
        INV(cm), bpm, dx25, 3*dx;
mcds:   ssh, ssxtra, mc, ds;
half:   mcds, hcell2, fcell, INV(hcell5);
achr:   half, b_t, INV(half);



{RING: ACHR, CAV;}
RING: 1*ACHR, b_t, CAV;

CELL: RING, SYMMETRY = 1;

END;
