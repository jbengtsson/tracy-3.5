qf2_ss:   quadrupole, l =  0.20138558, k =  9.76280045, n = nquad, method = 4;
d12:      drift, l =  0.07500012;
qd1_ss:   quadrupole, l =  0.10000001, k = -11.08009590, n = nquad, method = 4;

d4:       drift, l =  0.07504544;
qd4_ls:   quadrupole, l =  0.12564009, k =  2.78687814, n = nquad, method = 4;
