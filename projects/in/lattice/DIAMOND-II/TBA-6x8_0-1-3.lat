d2:       drift, l =  0.25716537;
qd2_ls:   quadrupole, l =  0.37877381, k = -4.01493298, n = nquad, method = 4;
d1:       drift, l =  0.14451852;
qf1_ls:   quadrupole, l =  0.13946339, k =  8.63476458, n = nquad, method = 4;

sfh:      sextupole, l =  0.05000000, k =  454.87062816, n = nsext, method = 4;
sd1a:     sextupole, l =  0.10000000, k = -728.79956164, n = nsext, method = 4;
sd1b:     sextupole, l =  0.10000000, k = -227.74207861, n = nsext, method = 4;

bpm      : beam position monitor;
ch       : corrector, horizontal;
cv       : corrector, vertical;

ps_rot: map;


{----- table of segments ----------------------------------------------------}

tba_1     : d5, sd1a, d6, qf1a_tba, d7, sfh;
tba_2     : d5, sd1b, d6, qf1b_tba, d7, sfh;
tba_hcell : b1, tba_1, inv(tba_2), b2;
tba_cell  : tba_hcell, inv(tba_hcell);
ms_mcell  : d8, qf1_ms, d9, qd2_ms, d_ms;
ss_mcell  : d_ss, qd1_ss, d12, qf2_ss, d11, qd3_ss, d10;
ls_mcell  : d_ls, qf1_ls, d1, qd2_ls, d2, qf3_ls, d3, qd4_ls, d4;
std_hcell : ss_mcell, tba_cell, ms_mcell;
std_cell  : inv(std_hcell), ss, std_hcell;
long_hcell: ls, ls_mcell, tba_cell, ms_mcell;
long_cell:  long_hcell, ms, inv(long_hcell);

ms_cell:  inv(ms_mcell), tba_cell, ms_mcell;
ss_cell:  ss_mcell, tba_cell, inv(ss_mcell);
sp_short: long_hcell, ms, std_cell, ms, inv(long_hcell);
sp:	  long_hcell, ms, std_cell, ms, std_cell, ms, std_cell, ms,
	  inv(long_hcell);

{ Single Pass. }
{line: ms, inv(ms_mcell), tba_cell, inv(ss_mcell), ss;}
{line: ms, inv(ms_mcell), tba_cell, inv(ls_mcell), ls;}
{ Periodic. }
{line: ms, std_cell, ms;}
{line: long_cell;}
{line: sp_short;}
line: sp;

ring: line, ps_rot, cav;

cell: ring, symmetry=1;

end;

