dp      = 1e-10;
codeps  = 1e-6;
dk      = 1e-6;
nbend   = 10;
nquad   = 10;
nsext   = 2;

{----- table of elements ----------------------------------------------------}

cav: Cavity, L = 0.0, Frequency = 499654096.667, Voltage = 2200000, phi = 0.0;

d_ls     : drift, l = 3.900000;
d_ms     : drift, l = 1.400000;
d_ss     : drift, l = 2.400000;

d5       : drift, l = 0.073642;
d6       : drift, l = 0.430954;
d7       : drift, l = 0.105044;

ss       : marker;
ms       : marker;
ls       : marker;

b1: bending, l =  0.51813071,
    t =  2.28624658, t1 =  1.14312329, t2 =  1.14312329, k = -2.18173934,
    n = nbend, method = 4;
b2: bending, l =  0.35291506,
