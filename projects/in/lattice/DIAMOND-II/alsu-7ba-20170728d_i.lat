{ TITLE "alsu-7ba-ring" }

define lattice; ringtype = 1;

Energy = 2.0;

{making dP smaller speeds up runtime}
dP = 1e-6; CODeps = 1e-14;

{Meth = 4; Nbend = 4; Nquad = 4; Nsext = 4; Ncorr = 1;}
Meth = 4; Nbend = 10; Nquad = 10; Nsext = 10; Ncorr = 1;

pi = 4.0*arctan(1.0);
c0 = 2.99792458e8;

rbang     = 0.732;
klgb      = -8.54986440356051;
bendcorr  = (rbang-0.8069906)/2;
mcdrft    = 0.033271125649209;

dx:        DRIFT, L= 4.8000000000E-02;
ssh:       DRIFT, L= 2.7200000000;
md33:      DRIFT, L= mcdrft;
ssxtra:    DRIFT, L= 0.084-mcdrft;


{ Girder Markers }
GS: Multipole, N = 1, Method = Meth;
GE: Multipole, N = 1, Method = Meth;


{ Beam Position Monitors }
BPM_D: Drift, L = 5.0e-2/2.0;
BPM_M: Beam Position Monitor;
BPM:   BPM_D, BPM_M, BPM_D;

{ Horizontal and vertical corrector }
CORR_D:  Drift, L = 10.0e-2/4.0;
CORR_H:  Corrector, Horizontal, Method= Meth;
CORR_V:  Corrector, Vertical, Method= Meth;
CORR:    CORR_D, CORR_V, 2*CORR_D, CORR_H, CORR_D;
CORRs:   CORR_D, CORR_H, 3*CORR_D;


b3h:   BENDING, L= 2.50000E-01, T= 2.5+rbang,
       K=-5.032084, T1= 0.0, T2= 0.0,
       N = Nbend, Method = Meth;

mb3h:  BENDING, L= 2.50000E-01, T= 2.5+rbang,
       K=-0.677751, T1= 0.0, T2= 0.0,
       N = Nbend, Method = Meth;

lgb00: BENDING, L= 3.2088E-02, T= 0.551167,
       K=0.0, T1= 0.0, T2= 0.551167,
       N = Nbend, Method = Meth;

lgb01: BENDING, L= 3.2088E-02, T= 0.551167,
       K=0.0, T1= -0.551167, T2= 1.102333,
       N = Nbend, Method = Meth;

lgb02: BENDING, L= 3.2088E-02, T= 0.551167,
       K=0.0, T1= -1.102333, T2= 1.653500,
       N = Nbend, Method = Meth;

lgb03: BENDING, L= 3.9955E-02, T= 0.551172,
       K=klgb, T1= -1.653500, T2= 2.204672,
       N = Nbend, Method = Meth;

lgb04: BENDING, L= 4.9897E-02, T= 0.543650+bendcorr,
       K=klgb, T1= -2.204672, T2= 2.748322,
       N = Nbend, Method = Meth;

lgb05: BENDING, L= 6.3885E-02, T= 0.558678+bendcorr,
       K=klgb, T1= -2.748322, T2= 3.307000,
       N = Nbend, Method = Meth;

i_lgb00: BENDING, L= 3.2088E-02, T= 0.551167,
         K=0.0, T2= 0.0, T1= 0.551167,
         N = Nbend, Method = Meth;

i_lgb01: BENDING, L= 3.2088E-02, T= 0.551167,
         K=0.0, T2= -0.551167, T1= 1.102333,
         N = Nbend, Method = Meth;

i_lgb02: BENDING, L= 3.2088E-02, T= 0.551167,
         K=0.0, T2= -1.102333, T1= 1.653500,
         N = Nbend, Method = Meth;

i_lgb03: BENDING, L= 3.9955E-02, T= 0.551172,
         K=klgb, T2= -1.653500, T1= 2.204672,
         N = Nbend, Method = Meth;

i_lgb04: BENDING, L= 4.9897E-02, T= 0.543650+bendcorr,
         K=klgb, T2= -2.204672, T1= 2.748322,
         N = Nbend, Method = Meth;

i_lgb05: BENDING, L= 6.3885E-02, T= 0.558678+bendcorr,
         K=klgb, T2= -2.748322, T1= 3.307000,
         N = Nbend, Method = Meth;


q1:    QUADRUPOLE, L= 2.0000000000E-01, K= -7.643930,
       N = Nquad, Method = Meth;

q2:    QUADRUPOLE, L= 2.0000000000E-01, K= 17.863469,
       N = Nquad, Method = Meth;

q3:    QUADRUPOLE, L= 2.0000000000E-01, K= -7.930494,
       N = Nquad, Method = Meth;

q4:    QUADRUPOLE, L= 2.0000000000E-01, K= -3.390829,
       N = Nquad, Method = Meth;


sf1:   SEXTUPOLE, L= 5.0000000000E-02, K= 1650.000000,
       N = Nsext, Method = Meth;

sf2:   SEXTUPOLE, L= 5.0000000000E-02, K= 1426.391740,
       N = Nsext, Method = Meth;

sf3:   SEXTUPOLE, L= 5.0000000000E-02, K= 1079.786660,
       N = Nsext, Method = Meth;

sh1:   SEXTUPOLE, K= 65.070462,
       N = Nsext, Method = Meth;

sh2:   SEXTUPOLE, K= -50.644266,
       N = Nsext, Method = Meth;

sh3:   SEXTUPOLE, K= -48.140907,
       N = Nsext, Method = Meth;

sd1:   SEXTUPOLE, L= 1.0000000000E-01, K= -1431.432220,
       N = Nsext, Method = Meth;

sd2:   SEXTUPOLE, L= 1.0000000000E-01, K= -1650.000000,
       N = Nsext, Method = Meth;

sd3:   SEXTUPOLE, L= 1.0000000000E-01, K= -592.190482,
       N = Nsext, Method = Meth;

sd4:   SEXTUPOLE, L= 1.0000000000E-01, K= -1202.973690,
       N = Nsext, Method = Meth;


qfh:   BENDING, L= 1.20000E-01, T= -rbang,
       K= 16.139275, T1= 0.0, T2= 0.0,
       N = Nquad, Method = Meth;

mqfh:  BENDING, L= 1.20000E-01, T= -rbang,
       K= 14.585615, T1= 0.0, T2= 0.0,
       N = Nquad, Method = Meth;


oxx:   MULTIPOLE, HOM=(4, -1486.53887222, 0),
       N = Nsext, Method = Meth;

oxy:   MULTIPOLE, HOM=(4, 1326.07484416, 0),
       N = Nsext, Method = Meth;

oyy:   MULTIPOLE, HOM=(4, 3028.78017509, 0),
       N = Nsext, Method = Meth;


{CAV is not actual cavity position; only used to calculate phi_s, delta_rf, etc.}
h_rf = 328; C =  195.936;
CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 0.83e6, Harnum = h_rf;


lgb:    lgb00, lgb01, lgb02, lgb03, lgb04, lgb05;
i_lgb:  i_lgb05, i_lgb04, i_lgb03, i_lgb02, i_lgb01, i_lgb00;

hcell1: dx, sd2, dx, dx, qfh, dx, sf1;
hcell2: dx, sd2, dx, dx, qfh, dx, sf2;
hcell3: dx, sd3, dx, dx, qfh, dx, sf2;
hcell4: dx, sd3, dx, dx, qfh, dx, sf3;
hcell5: dx, sd4, dx, dx, qfh, dx, sf3;

fcell:   INV(hcell3), i_lgb, lgb, hcell4;
i_fcell: INV(hcell4), i_lgb, lgb, hcell3; 

ds:     mb3h, dx, sd1, md33, dx, dx, mqfh, dx, sf1, INV(hcell1), i_lgb;
i_ds:   lgb, INV(mb3h, dx, sd1, md33, dx, dx, mqfh, dx, sf1, INV(hcell1));
mc:     oxy, q1, oxx, dx, sh1, q2, sh2, dx, q3, sh3, dx, q4, oyy, dx,
        dx, dx;
mcds:   ssh, ssxtra, mc, ds;
i_mcds: i_ds, INV(ssh, ssxtra, mc);
half:   mcds, lgb, hcell2, fcell, INV(hcell5), i_lgb;
i_half: lgb , hcell5, i_fcell, INV(hcell2), i_lgb, i_mcds;
achr:   bpm_m, half, i_half, bpm_m;


{RING: FCELL, CAV;}
RING: ACHR, CAV;
{RING: 12*ACHR, CAV;}

CELL: RING, SYMMETRY = 1;

END;
