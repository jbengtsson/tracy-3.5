ms_to_ss: match_ms, dip_cell, match_ss;

ms_to_ls: match_ms, dip_cell, match_ls;

std_cell: ms_to_ss, ss, b_t, inv(ms_to_ss);
sp:       ls, b_t, inv(ms_to_ls), 3*(ms, std_cell), ms, ms_to_ls, ls;

line: ss, inv(ms_to_ss), ms, ms_to_ss, ss;
{line: ms, ms_to_ls, ls;}
{line: ls, inv(ms_to_ls), ms, ms_to_ls, ls;}
{line: sp;}

ring: 1*line, ps_rot, b_t, cav;

cell: ring, symmetry=1;

end;

