oxx    : multipole, l = 0.0, hom = (4,0.0000,0);
oxy    : multipole, l = 0.0, hom = (4,0.0000,0);
oyy    : multipole, l = 0.0, hom = (4,0.0000,0);


{----- table of segments ----------------------------------------------------}

bn     : bn00, bn03, bn06;
i_bn   : i_bn06, i_bn03, i_bn00;
sd     : sdh, ocy, sdh;
sdm    : sdmh, ocym, sdmh;
sxx    : sxxh, sxxh;
sxy    : sxyh, sxyh;
syy    : syyh, syyh;
hnc    : bn, dnvb, vb, dnm1, sd, dnm2, an;
i_hnc  : i_an, dnm2, inv(sd), dnm1, i_vb, dnvb, i_bn;
mpfho  : doc, ocx, doc, sfh;
mpfh   : doc, doc, sfh;
mpf    : mpfh, inv(mpfho);
ncellr : hnc, mpfh, inv(mpfho), i_hnc;
i_ncellr: hnc, mpfho, inv(mpfh), i_hnc;
mpfm   : doc, doc, sfmh, sfmh, doc, ocxm, doc;
moxy   : doc, oxy, doc, sxy, doc;
moxx   : doc, oxx, doc, sxx, doc;
moyy   : doc, oyy, doc, syy, doc;
dsup   : hnc, mpfm, anm, dxm, sdm, dnm1, i_vbm, dnvb, i_bn;
i_dsup : bn, dnvb, vbm, dnm1, inv(sdm), dxm, i_anm, inv(mpfm), i_hnc;
mat    : bnom1, dme, inv(moyy), qml1, dmon, inv(moxy), qml2a, dmon,
         inv(moxx), qml2b, dm2, qml3, dls, bnom2;
mat1   : bnom1, dmem, inv(moyy), qm21, dmon, inv(moxy), qma2, dmon,
         dms1, bnom2;
mat2   : dmes, inv(moyy), qs1, dmon, inv(moxy), qs2a, dss;
tm     : dsup, mat;
i_tm   : inv(mat), i_dsup;
tm1    : dsup, mat1;
i_tm1  : inv(mat1), i_dsup;
tm2    : dsup, mat2;
i_tm2  : inv(mat2), i_dsup;
itm    : mat, inv(mat), i_dsup;
i_itm  : dsup, mat, inv(mat);
itm0   : inv(mat), i_dsup;
i_itm0 : dsup, mat;
itm1   : inv(mat1), i_dsup;
i_itm1 : dsup, mat1;
itm2   : inv(mat2), i_dsup;
i_itm2 : dsup, mat2;
ssh    : q1, l1, q2;
cell1   : ncellr;
i_cell1 : i_ncellr;
sp1    : i_tm1, tm2;
i_sp1  : i_tm2, tm1;
sp10   : sp1, i_sp1;
i_sp10 : sp1, i_sp1;
sp11   : itm0, i_itm1, sp1, i_sp1, itm1, i_itm2, i_sp1, sp1, itm2,
         i_itm1, itm1, i_itm0;
i_sp11 : itm0, i_itm1, itm1, i_itm2, i_sp1, sp1, itm2, i_itm1, sp1,
         i_sp1, itm1, i_itm0;
sp12   : sp1, i_sp1, sp1, i_sp1, sp1;
i_sp12 : i_sp1, sp1, i_sp1, sp1, i_sp1;
sp2    : itm1, itm2;
i_sp2  : i_itm2, i_itm1;
sp4    : bnom1, dmem, inv(moyy), qm21, dmon, inv(moxy), qma2, dmon,
         dms1, bnom2;
sp5    : bnom1, dme, inv(moyy), qml1, dmon, inv(moxy), qml2a, dmon,
         inv(moxx), qml2b, dm2, qml3, dls, bnom2;
sp6    : bnom1, dmes, inv(moyy), qs1, dmon, inv(moxy), qs2a, dmon,
         inv(moxx), qs2b, dss, bnom2;
sp     : sp11;
i_sp   : i_sp11;

unit_cell: sp1, i_sp1;

{ring: unit_cell, cav;}

ring: sp, cav;

cell: ring, symmetry=1;

end;

