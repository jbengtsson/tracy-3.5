syyh   : sextupole, l = 0.050000, k = 0.000000, n = 4, method=meth;

bnom1  : marker;
bnom2  : marker;
bnom3  : marker;

an     : bending, l = 0.300000, t = -aban, k = 4.301269, t1 = -aban,
