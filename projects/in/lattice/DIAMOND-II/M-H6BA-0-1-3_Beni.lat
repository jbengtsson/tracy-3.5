{line: ms, ls_hcell, ls;}
{line: ls, inv(ls_hcell), ms, ls_hcell, ls;}
{line: sp_short, cav;}
{line: sp, cav;}

ring: line, ps_rot, cav;

cell: ring, symmetry=1;

