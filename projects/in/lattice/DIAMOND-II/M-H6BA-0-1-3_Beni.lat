ls_hcell: inv(dip_cell, ms_mcell), ls_mcell, ls;

sp_short: ls, inv(ls_hcell), std_cell, ls_hcell, ls;

sp: ls, inv(ls_hcell), 3*std_cell, ls_hcell, ls;

