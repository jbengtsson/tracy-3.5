  dr_k2, dr_04ic1, ge, dr_03ic1, qf1ic1, dr_01ic1, idmarker_end;
inj: c1_inj_l, inv(c1_inj_r);

c0 = 2.99792458e8; h_rf = 484; Brho = 1e9*Energy/c0;

cav: Cavity, L = 0.0, Frequency = 499.654096667e6, Voltage = 6e6, Harnum = h_rf, phi = 0.0;
rfc0: Cavity, L = 0.0, Frequency = 499654096.667, Voltage = 2200000, phi = 171.686450695, n = 1;
rfc: Cavity, L = 0.0, Frequency = 499654096.6666667, Voltage = 2200000, phi = 170.5429374858628, n = 1;
rfc24: Cavity, L = 0.0, Frequency = 935, Voltage = 2200000, phi = 170.5429364470198, n = 1;
AP: Marker;
w3: Marker; { watch }
ring24: mal, rfc24, 24*c2, ap, w1;
ring24rf: mal, rfc, 24*c2, ap, w1;
sp_arcac2: mal, inv(c2), c2, ap, w1;
sp_arcac1: mal, c1, inv(c1), ap, w1;
sp: inv(c1), c2, c2, c1;
