{opa to tracy-2 export}

define lattice;
energy = 3.500000;
dp = 1.0d-10; codeps = 1.0d-6; dk = 1.0d-6;
meth = 4;

{----- variables ----------------------------------------------------}

dp      = 1e-10;
codeps  = 1e-6;
dk      = 1e-6;
nbend   = 10;
nquad   = 10;
nsext   = 2;

{----- table of elements ----------------------------------------------------}

cav: Cavity, L = 0.0, Frequency = 499654096.667, Voltage = 2200000, phi = 0.0;

d5: drift, l = 0.073642;
d6: drift, l = 0.430954;
d7: drift, l = 0.105044;

d_ms: drift, l = 1.500000;
d_ss: drift, l = 2.500000;
d_ls: drift, l = 4.000000;

ss: marker;
ms: marker;
ls: marker;

b1: bending, l = 1.200000, t = 2.942714, k = -1.055971,
    t1 = 1.471357, t2 = 1.471357, n=nbend, method=meth;
b2: bending, l = 0.573951, t = 0.807286, k = -1.560063,
    t1 = 0.403643, t2 = 0.403643, n=nbend, method=meth;

d8:   drift, l = 0.123008;
qf1a_tba: quadrupole, l = 0.150000, k =   4.810000, n=nquad, method=meth;
d9:   drift, l = 0.111389;
qf1b_tba: quadrupole, l = 0.150000, k =   4.810000, n=nquad, method=meth;

d1:     drift, l =  0.33961854;
qd1_ls: quadrupole, l =  0.15485030, k = -12.64733268, n = nquad, method = 4;
d2:     drift, l =  0.21484386;
qf2_ls: quadrupole, l =  0.15164723, k = 16.64275376, n = nquad, method = 4;
d3:     drift, l =  0.50984023;
qd3_ls: quadrupole, l =  0.32761852, k = -6.69501156, n = nquad, method = 4;

d10:    drift, l =  0.35000000;
qd3_ss: quadrupole, l =  0.10000000, k =  -0.50000000, n = nquad, method = 4;
d11:    drift, l =  0.34370577;
qf2_ss: quadrupole, l =  0.20000000, k =   8.60773466, n = nquad, method = 4;
d12:    drift, l =  0.07500000;
qd1_ss: quadrupole, l =  0.10000000, k = -10.56694541, n = nquad, method = 4;

qf1_ms:   quadrupole, l = 0.200000, k =  -2.484000, n=nquad, method=meth;
qd2_ms:   quadrupole, l = 0.150000, k =   8.028011, n=nquad, method=meth;

sfh:  sextupole, l = 0.050000, k =  234.108896, n = 4, method=meth;
sd1a: sextupole, l = 0.100000, k = -224.108514, n = 4, method=meth;
sd1b: sextupole, l = 0.100000, k = -278.276005, n = 4, method=meth;

bpm: beam position monitor;

ch: corrector, horizontal;
cv: corrector, vertical;

ps_rot: map;


{----- table of segments ----------------------------------------------------}

tba_1:     d5, sd1a, d6, qf1a_tba, d7, sfh;
tba_2:     d5, sd1b, d6, qf1b_tba, d7, sfh;
tba_hcell: b1, tba_1, inv(tba_2), b2;
tba_cell:  tba_hcell, inv(tba_hcell);

ms_mcell:  d8, qf1_ms, d9, qd2_ms, d_ms;
ss_mcell:  d_ss, qd1_ss, d12, qf2_ss, d11, qd3_ss, d10;
ls_mcell:  d_ls, qd1_ls, d1, qf2_ls, d2, qd3_ls, d3;

std_hcell: ss_mcell, tba_cell, ms_mcell, ms;
std_cell:  inv(std_hcell), ss, std_hcell;

line2:     ls, ls_mcell, tba_cell, ms_mcell;

sp1: line2, 1*std_cell, inv(line2);
sp:  line2, 3*std_cell, inv(line2);

{ring: inv(std_hcell), ss, std_hcell, cav;}
{ring:  ss, std_hcell, inv(line2), line2, inv(std_hcell), ss, cav;}
{ring: sp1, ps_rot, cav;}
ring: sp, ps_rot, cav;

cell: ring, symmetry=1;

end;

