d_ss     : drift, l = 2.400000;
d5       : drift, l = 0.073642;
d6       : drift, l = 0.430954;
d7       : drift, l = 0.105044;

ss       : marker;
ms       : marker;
ls       : marker;

b1       : bending, l = 0.525371, t = 2.393338, k = -2.517000,
           t1 = 1.196669, t2 = 1.196669, n=nbend, method=meth;
b2       : bending, l = 0.335976, t = 1.356662, k = -3.032000,
           t1 = 0.678331, t2 = 0.678331, n=nbend, method=meth;

qf1a_tba : quadrupole, l = 0.197289, k = 5.471000, n=nquad, method=meth;
qf1b_tba : quadrupole, l = 0.176008, k = 5.012075, n=nquad, method=meth;

d8       : drift, l = 0.128516;
