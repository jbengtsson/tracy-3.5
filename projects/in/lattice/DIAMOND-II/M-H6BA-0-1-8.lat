sh2: sextupole, l = 0.050000, k =    0.000000, n = 1, method=meth;

of1s: multipole, l = 0.0, hom = (4, 0.0, 0.0);

ms: marker;
ss: marker;
ls: marker;

ps_rot: map;

{----- table of segments ----------------------------------------------------}

ss_mcell: dr_01, qf1, dr_02, sh1, dr_03, qd2, dr_04;

dip_cell:
  bl1, dr_05, qd3, dr_06, sd1, dr_07,
  qf4, dr_08, sf1, sf1_ctr, sf1, dr_09,
  qf4, dr_10, of1s, dr_11, sd2, dr_12, qd5, dr_13, inv(bl2);

ms_mcell: dr_14, qf6, dr_15, dq1, dr_16, qf8, dr_17, sh2, dr_18;

ls_mcell: dl_15, qd2_c1, dl_16, sh1, dl_17, qf1_c1, dl_18, quad_add, dl_19;

std_cell:
  ms, inv(ss_mcell, dip_cell, ms_mcell), ss, ss_mcell, dip_cell, ms_mcell, ms;

ls_hcell: inv(dip_cell, ms_mcell), ls_mcell, ls;

sp: ls, inv(ls_hcell), 3*std_cell, ls_hcell, ls;

line: std_cell;
{line: ss, ss_mcell, dip_cell, ms_mcell, ms, inv(ss_mcell, dip_cell, ms_mcell);}
{line: ms, ls_hcell, ls;}
{line: sp, cav;}

ring: line, ps_rot, cav;

cell: ring, symmetry=1;

end;

