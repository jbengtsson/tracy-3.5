{opa to tracy-2 export}

define lattice;
energy = 3.500000;
dp = 1.0d-10;  codeps = 1.0d-6;  dk = 1.0d-6;
meth = 4;

{----- variables ----------------------------------------------------}

dp      = 1e-10;
codeps  = 1e-6;
dk      = 1e-6;
nbend   = 10;
nquad   = 10;
nsext   = 2;
f       = 0.8;

{----- table of elements ----------------------------------------------------}

cav: Cavity, L = 0.0, Frequency = 499654096.667, Voltage = 2200000, phi = 0.0;

d_ls     : drift, l = 3.900000;
d_ms     : drift, l = 1.400000;
d_ss     : drift, l = 2.400000;
d5       : drift, l = 0.073642;
d6       : drift, l = 0.430954;
d7       : drift, l = 0.105044;

ss       : marker;
ms       : marker;
ls       : marker;

b1: bending, l =  0.54772782,
    t =  2.29878696, t1 =  1.14939348, t2 =  1.14939348, k = -2.53287323,
    n = nbend, method = 4;
b2: bending, l =  0.35566478,
    t =  1.45121304, t1 =  0.72560652, t2 =  0.72560652, k = -2.72969519,
    n = nbend, method = 4;

qf1a_tba: quadrupole, l =  0.19727966, k =  5.56495496, n = nquad, method = 4;
qf1b_tba: quadrupole, l =  0.17642861, k =  4.94714105, n = nquad, method = 4;

d8:       drift, l =  0.09409871;
qf1_ms:   quadrupole, l =  0.20017238, k = -3.63837346, n = nquad, method = 4;
d9:       drift, l =  0.12097601;
qd2_ms:   quadrupole, l =  0.17603609, k =  9.15120521, n = nquad, method = 4;
d10:      drift, l =  0.30394676;
qd3_ss:   quadrupole, l =  0.27879528, k =  0.04948839, n = nquad, method = 4;
d11:      drift, l =  0.20722063;
qf2_ss:   quadrupole, l =  0.20201725, k = 10.15838785, n = nquad, method = 4;
d12:      drift, l =  0.07788657;
qd1_ss:   quadrupole, l =  0.10065445, k = -12.04990228, n = nquad, method = 4;

d4:       drift, l =  0.23339948;
qd4_ls:   quadrupole, l =  0.39825042, k =  1.87907639, n = nquad, method = 4;
d3:       drift, l =  0.19153332;
qf3_ls:   quadrupole, l =  0.15821693, k =  4.95158225, n = nquad, method = 4;
d2:       drift, l =  0.35000000;
qd2_ls:   quadrupole, l =  0.16589774, k = -10.47217101, n = nquad, method = 4;
d1:       drift, l =  0.10324356;
qf1_ls:   quadrupole, l =  0.13175778, k =  9.38078166, n = nquad, method = 4;

sfh:      sextupole, l =  0.05000000, k =  449.42986205, n = nsext, method = 4;
sd1a:     sextupole, l =  0.10000000, k = -604.32379266, n = nsext, method = 4;
sd1b:     sextupole, l =  0.10000000, k = -484.16006616, n = nsext, method = 4;

bpm      : beam position monitor;
ch       : corrector, horizontal;
cv       : corrector, vertical;

ps_rot: map;


{----- table of segments ----------------------------------------------------}

tba_1     : d5, sd1a, d6, qf1a_tba, d7, sfh;
tba_2     : d5, sd1b, d6, qf1b_tba, d7, sfh;
tba_hcell : b1, tba_1, inv(tba_2), b2;
tba_cell  : tba_hcell, inv(tba_hcell);
ms_mcell  : d8, qf1_ms, d9, qd2_ms, d_ms;
ss_mcell  : d_ss, qd1_ss, d12, qf2_ss, d11, qd3_ss, d10;
ls_mcell  : d_ls, qf1_ls, d1, qd2_ls, d2, qf3_ls, d3, qd4_ls, d4;
std_hcell : ss_mcell, tba_cell, ms_mcell;
std_cell  : inv(std_hcell), ss, std_hcell;
long_hcell: ls, ls_mcell, tba_cell, ms_mcell;
long_cell:  long_hcell, inv(long_hcell);

ms_cell:  inv(ms_mcell), tba_cell, ms_mcell;
ss_cell:  ss_mcell, tba_cell, inv(ss_mcell);
sp_short: long_hcell, ms, std_cell, ms, inv(long_hcell);
sp:	  long_hcell, ms, std_cell, ms, std_cell, ms, std_cell, ms,
	  inv(long_hcell);

{ Single Pass. }
{line: ms, inv(ms_mcell), tba_cell, inv(ss_mcell), ss;}
{line: ms, inv(ms_mcell), tba_cell, inv(ls_mcell), ls;}
{ Periodic. }
{line: ms, inv(ms_mcell), tba_cell, ms_mcell;}
{line: ms, inv(ms_mcell), tba_cell, inv(ss_mcell), ss,
       ss_mcell, tba_cell, ms_mcell, ms;}
{line: ss, ss_mcell, tba_cell, inv(ss_mcell), ss;}
{line: ms, std_cell, ms;}
{line: long_cell;}
{line: sp_short;}
line: sp;

ring: line, ps_rot, cav;

cell: ring, symmetry=1;

end;

