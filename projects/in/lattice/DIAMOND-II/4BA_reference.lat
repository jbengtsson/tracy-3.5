{ ---------------------------------
  modified 4BA lattice for DLS with 3.4 m middle straight
  Reduced ring's circumference to compensate 1cm beamline alignment tolerance
  Total ring circumference:561.0 m
  Results from MOGA Aperture, ex0: 270 pm-rad 
  combined dipole+quadrupole
  T. Pulampong :23/1/2014
  --------------------------------- }

{ magnet elements------------------ }

define lattice;

energy = 3.0;

dp = 1.0d-8; codeps = 1.0d-10; dk = 1.0d-5;

meth = 4; nbend = 10; nquad = 10; nsext = 2;

c0 = 2.99792458e8; h_rf = 935; C = 561.0000600; Brho = 1e9*Energy/c0;
pi = 4.0*arctan(1.0);
{pi = 3.141592654;}

DKA:  drift, L = 4.550005;
DK:   drift, L = 3.35;
D05:  drift, L = 0.05;
D025: drift, L = 0.025;
D10:  drift, L = 0.1;
D15:  drift, L = 0.15;
D20:  drift, L = 0.2;
D6B:  drift, L = 0.1;
D2B:  drift, L = 0.1;
D3B:  drift, L = 0.135;
D4B:  drift, L = 0.106781;
D5B:  drift, L = 0.2;
D1M:  drift, L = 0.1;
DMID: drift, L = 1.5;
D1S:  drift, L = 0.13838;
DLBM: drift, L = 0.35;
DRBM: drift, L = 0.18838;
DHS:  drift, L = 0.1;
DLB:  drift, L = 0.36822;

Q1_2:  quadrupole, L = 0.15, k =  5.307764128353847, n = nquad, method = meth;
Q1_2M: quadrupole, L = 0.3,  k =  5.081734885806986, n = nquad, method = meth;
Q1B:   quadrupole, L = 0.2,  k = -2.315363396997481, n = nquad, method = meth;
Q2B:   quadrupole, L = 0.25, k =  5.064812192967294, n = nquad, method = meth;
Q1D:   quadrupole, L = 0.2,  k = -4.487880830862382, n = nquad, method = meth;
Q2D:   quadrupole, L = 0.25, k =  4.433438315958,    n = nquad, method = meth;
Q3D:   quadrupole, L = 0.2,  k =  2.749422324290564, n = nquad, method = meth;

Q1_1M: quadrupole, L = 0.15, k =  0.0,               n = nquad, method = meth;
QB:    quadrupole, L = 0.15, k =  0.0,               n = nquad, method = meth;

BB41B: bending, L = 0.670431, t = 0.053598*180/pi, k = -1.438526621400908,
       t1 = 0.026799*180/pi, t2 = 0.026799*180/pi, gap = 0.0,
       n = nbend, method = meth;
BB41A: bending, L = 0.670431, t = 0.053598*180/pi, k = -1.269481610721041,
       t1 = 0.026799*180/pi, t2 = 0.026799*180/pi, gap = 0.0,
       n = nbend, method = meth;
BB42:  bending, L = 2*0.483464, t = 2*0.038651*180/pi, k = -1.438526621400908,
       t1 = 0.038651*180/pi, t2 = 0.038651*180/pi, gap = 0.0, n = nbend,
       method = meth;

S1B: sextupole, L = 0.25, k =  366.4387020758482/2.0, n = nsext, method = meth;
S1C: sextupole, L = 0.25, k =  359.3327838869847/2.0, n = nsext, method = meth;

S1D: sextupole, L = 0.25, k =  183.9180807730392/2.0, n = nsext, method = meth;

S2B: sextupole, L = 0.25, k = -431.1000249114079/2.0, n = nsext, method = meth;
S2C: sextupole, L = 0.25, k = -379.9127843925083/2.0, n = nsext, method = meth;

S2D: sextupole, L = 0.25, k = -346.5759165374033/2.0, n = nsext, method = meth;

SX1: sextupole, L = 0.25, k =  362.5118261207356/2.0, n = nsext, method = meth;
SY1: sextupole, L = 0.2,  k = -298.8621475655225/2.0, n = nsext, method = meth;

OXX: multipole, l = 0.0, n = nsext, method = meth;
OXY: multipole, l = 0.0, n = nsext, method = meth;
OYY: multipole, l = 0.0, n = nsext, method = meth;

BPM: beam position monitor;
CH:  corrector, horizontal, n = 1, method = meth;
CV:  corrector, vertical, n = 1, method = meth;
CHV: CH, CV;

B_T : marker;

{ line definitions---------- }
HALFA1:  DKA, BPM, Q3D, D10, Q1D, D2B, S1D, CHV, D3B, OXX, Q2D, D4B, D10, OXY,
 	 S2D, D05, D10, D6B;
HALFA2:  DK, BPM, Q1B, D2B, S1B, CHV, D3B, OXX, Q2B, D4B, D10, OXY, S2B, D05,
	 D10, D6B;
HALFA21: DK, BPM, Q1B, D2B, S1C, CHV, D3B, OXX, Q2B, D4B, D10, OXY, S2C, D05,
	 D10, D6B;

CELL4COM:  BB42, CHV, DRBM;
CELL4MID:  Q1_2M, D1M, BPM, D10, DMID, DMID, D10, BPM, D1M, Q1_2M;
CELL4MIDH: Q1_2M, D1M, Q1_1M, DMID;

EBMA:  HALFA1,
       OYY, BB41A, D20, BPM, D05, DLB, SY1, D1S, Q1_2, DHS,
       D025, SX1, CHV, D025, DHS, Q1_2, D1S, SY1, CHV, D05, BPM, DLBM;

ARC4:  CELL4COM, CELL4MID, inv(CELL4COM);

EBMB1: HALFA21,
       OYY, BB41B, D10, BPM, D15, DLB, SY1, D1S, Q1_2, DHS,
       D025, SX1, CHV, D025, DHS, Q1_2, D1S, SY1, CHV, D05, BPM, DLBM;

EBMB:  HALFA2,
       OYY, BB41B, BPM, D10, D15, DLB, SY1, D1S, Q1_2, DHS,
       D025, SX1, CHV, D025, DHS, Q1_2, D1S, SY1, CHV, D05, BPM, DLBM;

CELL1: EBMA, ARC4, inv(EBMB1);
CELL2: EBMB, ARC4, inv(EBMB);

SPERIOD: B_T, CELL1, CELL2, CELL2, inv(CELL1);

CAV: cavity, voltage = 3.3e6, phi = 0, harnum = h_rf, frequency = 500e6;

{RING: CELL1, inv(CELL1), CAV;}
{RING: CELL2, CAV;}

RING: 1*SPERIOD, CAV;
{RING: 6*SPERIOD, B_T, CAV;}

cell: ring, symmetry  =  1;

end;
