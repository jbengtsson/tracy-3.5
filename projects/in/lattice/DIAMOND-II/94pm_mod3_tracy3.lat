{c:\users\streun\opadat\sls-2\94pm_mod3.opa}
{all 3 adts well under control :-)}

{opa to tracy-3 export}

define lattice;
energy = 2.400000;
dp = 1.0d-10;  codeps = 1.0d-6;  dk = 1.0d-6;
meth = 4; nbend = 10; nquad = 10;

{----- variables ----------------------------------------------------}

c0 = 2.99792458e8; h_rf = 484; C = 12*24.2; Brho = 1e9*Energy/c0;

{cav: Cavity, Frequency = c0/C*h_rf, Voltage = 1.8e6, Harnum = h_rf,
     phi = 180.0;}
{ Optimized for alpha-buchets. }
cav: Cavity, Frequency = c0/C*h_rf, Voltage = 1.4e6, Harnum = h_rf,
     phi = 180.0;

aban  = 0.617090195910932;
kaba  = 5.49666164277774;
scv   = 0.729656144466909;
bnc1  = (1-0.7)*(aban-0.65);
bnc2  = aban*(0.7-scv);
ldvb  = 0.07+(0.7-scv)*0.22;
atta  = 0.845958984598378;
attv  = 0.373487427546671;
bec   = ((atta-1)-(attv-1)*scv)*aban;

{----- table of elements ----------------------------------------------------}

dmon    : drift, l = 0.050000;
d1      : drift, l = 0.060000;
d2      : drift, l = 0.156000;
d2m     : drift, l = 0.216000;
d3      : drift, l = 0.200000;
minigap : drift, l = 1.000000;
dm1     : drift, l = 0.100000;
dm2     : drift, l = 0.150000;
dstr    : drift, l = 1.750000;
doc     : drift, l = 0.050000;
dao     : drift, l = 0.025000;
dvb     : drift, l = ldvb;

center  : marker;

qm4     : quadrupole, l = 0.150000, k = -6.115831, n=nquad, method=meth;
qm2     : quadrupole, l = 0.150000, k = 6.030269, n=nquad, method=meth;
qm3     : quadrupole, l = 0.150000, k = 7.474435, n=nquad, method=meth;
qm1     : quadrupole, l = 0.150000, k = -7.321604, n=nquad, method=meth;
qof     : quadrupole, l = 0.025000, k = 0.000000, n=nquad, method=meth;
qofm    : quadrupole, l = 0.025000, k = 0.000000, n=nquad, method=meth;

bn00    : bending, l = 0.033621, t = 0.385000, k = 0.000000,
          t1 = 0.000000, t2 = 0.385000, n=nbend, method=meth;
bn01    : bending, l = 0.033621, t = 0.385000, k = 0.000000,
          t1 = -0.385000, t2 = 0.770000, n=nbend, method=meth;
bn02    : bending, l = 0.034991, t = 0.386038, k = 0.000000,
          t1 = -0.770000, t2 = 1.156038, n=nbend, method=meth;
bn03    : bending, l = 0.043659, t = 0.384828, k = 0.000000,
          t1 = -1.156038, t2 = 1.540866, n=nbend, method=meth;
bn04    : bending, l = 0.052355, t = 0.384611, k = 0.000000,
          t1 = -1.540866, t2 = 1.925476, n=nbend, method=meth;
bn05    : bending, l = 0.061339, t = 0.385068, k = 0.000000,
          t1 = -1.925476, t2 = 2.310544, n=nbend, method=meth;
bn06    : bending, l = 0.070414, t = 0.384456+bnc1+bnc2, k = 0.000000,
          t1 = -2.310544, t2 = 2.695000, n=nbend, method=meth;
bsoft   : bending, l = 0.050000, t = bec, k = 0.000000,
          t1 = -2.695000, t2 = 2.695+bec, n=nbend, method=meth;

sxxh    : sextupole, l = 0.050000, k = 145.782990, n = 3, method=meth;
sxyh    : sextupole, l = 0.050000, k = -326.820678, n = 3, method=meth;
syyh    : sextupole, l = 0.050000, k = 216.811652, n = 3, method=meth;
sdmh    : sextupole, l = 0.050000, k = -387.521485, n = 3, method=meth;
sfmh    : sextupole, l = 0.050000, k = 353.317898, n = 3, method=meth;
sdh     : sextupole, l = 0.050000, k = -280.036004, n = 3, method=meth;
sfh     : sextupole, l = 0.050000, k = 387.387619, n = 3, method=meth;

bnom    : marker;
beom    : marker;

vb      : bending, l = scv*0.22, t = aban*scv, k = -kaba,
          t1 = 0.000000, t2 = aban*scv, n=nbend, method=meth;
an      : bending, l = 0.220000, t = -aban, k = kaba, t1 = -aban,
          t2 = 0.000000, n=nbend, method=meth;
vbm     : bending, l = scv*0.22, t = attv*aban*scv, k = -attv*kaba,
          t1 = 0.000000, t2 = aban*scv, n=nbend, method=meth;
anm     : bending, l = 0.220000, t = -atta*aban, k = atta*kaba,
          t1 = -aban, t2 = 0.000000, n=nbend, method=meth;

xm      : marker;
xo      : marker;
xs      : marker;
xx      : marker;

lgbs    : marker;
lgbn    : marker;
lgbe    : marker;

oxx     : multipole, l = 0.0, hom = (4,95.3290,0);
oxy     : multipole, l = 0.0, hom = (4,31.7504,0);
oyy     : multipole, l = 0.0, hom = (4,32.5917,0);
ocxm    : multipole, l = 0.0, hom = (4,13.6211,0);
ocx1    : multipole, l = 0.0, hom = (4,36.3383,0);
ocx2    : multipole, l = 0.0, hom = (4,56.1347,0);

mon     : beam position monitor;

ch      : corrector, horizontal;

cv      : corrector, vertical;


{----- table of segments ----------------------------------------------------}

bn     : bnom, bn00, bn01, bn02, bn03, bn04, bn05, bn06;
be     : lgbe, bsoft, bn00, bn01, bn02, bn03, bn04, bn05, bn06, lgbe;
vbd    : dvb, vb;
cc     : ch, cv;
sd     : sdh, sdh;
sdm    : sdmh, sdmh;
oqc1   : dao, qof, ocx1, qof, dao;
oqc2   : dao, qof, ocx2, qof, dao;
oqcm   : dao, qofm, ocxm, qofm, dao;
mqo1   : oqc1, sfh;
mqo2   : oqc2, sfh;
mmon   : doc, mon, doc, sfh;
mp1    : mmon, cc, inv(mqo1);
mp2    : mmon, cc, inv(mqo2);
mpm    : doc, mon, doc, sfmh, cc, sfmh, oqcm;
mxy    : doc, oxy, doc, sxyh, sxyh, doc;
mxx    : doc, oxx, doc, sxxh, cc, sxxh, doc;
myy    : doc, oyy, doc, syyh, cc, syyh, doc;
bnl    : bn, lgbn;
hnc    : bnl, vbd, d1, sd, d2, an;
ncell  : inv(mqo1), inv(hnc), hnc, mmon;
ncellr : hnc, mp1, inv(hnc);
hcor   : xm, hnc, mp1, inv(hnc), xo, hnc, mp2, inv(hnc), xo;
dsup   : hnc, mpm, anm, d2m, sdm, d1, inv(vbm), dvb, inv(be);
mat    : d3, mon, inv(myy), qm1, dmon, inv(mxy), qm2, dmon, mon,
         inv(mxx), qm3, dm2, qm4, dstr, minigap;
tm     : dsup, mat;
hm     : hcor, tm;
marc   : hm, inv(hm);
arcn   : center, xs, inv(hm), hm;

line: 1*arcn, cav;

cell: line, symmetry=1;

end;

