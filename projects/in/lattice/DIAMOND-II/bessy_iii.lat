define lattice;
energy = 2.5;
dp = 1d-6;  codeps = 1d-6;  dk = 1d-6;
meth = 4; nbend = 10; nquad = 10; nsext = 2;

C = 12*20.6;

pi = 4.0*arctan(1.0);

D01:  drift, L = 2.5;
D02:  drift, L = 0.1;
D2:   drift, L = 0.15;
D30:  drift, L = 0.15;
D31:  drift, L = 0.1;
D321: drift, L = 0.1;
D32:  drift, L = 0.1;
D4:   drift, L = 0.1;
D51:  drift, L = 0.15;
D52:  drift, L = 0.15;
D6:   drift, L = 0.15;
D7:   drift, L = 0.15;
D8:   drift, L = 0.15;
D9:   drift, L = 0.15;
D10:  drift, L = 0.15;
D11:  drift, L = 0.15;

B1:   bending, L = 0.4,  t = 0.03068*180.0/pi,  k = -5.186033,
      n = nbend, method = 4;
B2:   bending, L = 0.7,  t = 0.061359*180.0/pi, k = -3.033762,
      n = nbend, method = 4;
B3:   bending, L = 0.7,  t = 0.061359*180.0/pi, k = -3.389511,
      n = nbend, method = 4;
B4:   bending, L = 0.7,  t = 0.061359*180.0/pi, k = -3.73029,
      n = nbend, method = 4;
B5:   bending, L = 0.35, t = 0.03068*180.0/pi,  k = -4.939935,
      n = nbend, method = 4;

Q4: bending, L = 0.4, t = -0.016362*180.0/pi, k = 6.895547,
    n = nquad, method = 4;
Q5: bending, L = 0.4, t = -0.016362*180.0/pi, k = 7.085718,
    n = nquad, method = 4;
Q6: bending, L = 0.4, t = -0.016362*180.0/pi, k = 6.972846,
    n = nquad, method = 4;

Q11:  quadrupole, L = 0.2, k = 5.104293, n = nquad, method = 4;
Q12:  quadrupole, L = 0.1, k = 5.942573, n = nquad, method = 4;
Q2:   quadrupole, L = 0.2, k = 5.981222, n = nquad, method = 4;
Q3:   quadrupole, L = 0.2, k = 7.756269, n = nquad, method = 4;

S1:   sextupole, L = 0.3,  k = 0.0, n = nsext, method = 4;
S2:   sextupole, L = 0.3,  k = 0.0, n = nsext, method = 4;
S3:   sextupole, L = 0.15, k = 0.0, n = nsext, method = 4;
S4:   sextupole, L = 0.1,  k = 0.0, n = nsext, method = 4;
S5:   sextupole, L = 0.1,  k = 0.0, n = nsext, method = 4;

LGB1OM:  marker;
LGB31OM: marker;
LGB41OM: marker;
SBOM:    marker;
PEAK:    marker;

cav: Cavity, L = 0.0, Frequency = 500e6, Voltage = 1.5e6, harnum = 300,
     phi = 0.0;

cell_h:
  D01, S4, D02, Q11, D02, Q12, D2, B1, D30, S5, D31, Q2, D321, S1, PEAK, D32,
  S2, D4, Q3, D51, S3, D52, B2, LGB1OM, D6, Q4, D6, B3, D8, Q5, D8, LGB31OM,
  B4, D10, Q6, D10, B5, SBOM;

sp: cell_h, inv(cell_h);

LINE: 1*sp;
{LINE: 16*sp;}

ring: 1*line, cav;

cell: ring, symmetry = 1;

end;
