{ TITLE "alsu-7ba-ring" }

define lattice; ringtype = 1;

Energy = 2.0;

{making dP smaller speeds up runtime}
dP = 1e-6; CODeps = 1e-10;

{Meth = 4; Nbend = 4; Nquad = 4; Nsext = 4; Ncorr = 1;}
Meth = 4; Nbend = 10; Nquad = 10; Nsext = 10; Ncorr = 1;

pi = 4.0*arctan(1.0);
c0 = 2.99792458e8;

rbang     = 0.58;
klgb      = -8.5522879654378;
bendcorr  = (rbang-0.8069906)/2;
mcdrft    = 0.0700824999444334;

dx02:      DRIFT, L= 2.0000000000E-03;
dx25:      DRIFT, L= 2.5000000000E-02;
dx:        DRIFT, L= 4.8000000000E-02;
ssh:       DRIFT, L= 2.693000;
md33:      DRIFT, L= mcdrft;
ssxtra:    DRIFT, L= 0.084-mcdrft;


{ Girder Markers }
GS: Multipole, N = 1, Method = Meth;
GE: Multipole, N = 1, Method = Meth;


{ Beam Position Monitors }
BPM_D: Drift, L = 5.0e-2/2.0;
BPM_M: Beam Position Monitor;
{BPM:   BPM_D, BPM_M, BPM_D;}
BPM:   BPM_M;

{ Horizontal and vertical corrector }
CORR_D:  Drift, L = 10.0e-2/4.0;
CORR_H:  Corrector, Horizontal, Method= Meth;
CORR_V:  Corrector, Vertical, Method= Meth;
CORR:    CORR_D, CORR_V, 2*CORR_D, CORR_H, CORR_D;
CORRs:   CORR_D, CORR_H, 3*CORR_D;
cm:      CORR_V, CORR_H;


b3h:   BENDING, L= 2.50000E-01, T= 2.5+rbang,
       K=-5.032084, T1= 0.0, T2= 0.0,
       N = Nbend, Method = Meth;

mb3h:  BENDING, L= 2.50000E-01, T= 2.5+rbang,
       K=-0.677751, T1= 0.0, T2= 0.0,
       N = Nbend, Method = Meth;

lgb00: BENDING, L= 3.2088E-02, T= 0.551167,
       K=0.0, T1= 0.0, T2= 0.551167,
       N = Nbend, Method = Meth;

lgb01: BENDING, L= 3.2088E-02, T= 0.551167,
       K=0.0, T1= -0.551167, T2= 1.102333,
       N = Nbend, Method = Meth;

lgb02: BENDING, L= 3.2088E-02, T= 0.551167,
       K=0.0, T1= -1.102333, T2= 1.653500,
       N = Nbend, Method = Meth;

lgb03: BENDING, L= 4.0000E-02, T= 0.551172,
       K=klgb, T1= -1.653500, T2= 2.204672,
       N = Nbend, Method = Meth;

lgb04: BENDING, L= 4.9897E-02, T= 0.543650+bendcorr,
       K=klgb, T1= -2.204672, T2= 2.748322+bendcorr,
       N = Nbend, Method = Meth;

lgb05: BENDING, L= 6.3885E-02, T= 0.558678+bendcorr,
       K=klgb, T1= -2.748322-bendcorr, T2= 3.307000+2*bendcorr,
       N = Nbend, Method = Meth;


qfh:   BENDING, L= 1.20000E-01, T= -rbang,
       K= 16.141339, T1= 0.0, T2= 0.0,
       N = Nquad, Method = Meth;

{ Symmetrized H_2, nu = [3.277, 1.238]. }
q1:       quadrupole, l =  0.10000000, k = -13.39329217, n = nquad, method = 4;
q2:       quadrupole, l =  0.20000000, k = 14.64409886, n = nquad, method = 4;
q3:       quadrupole, l =  0.15000000, k = -7.57859188, n = nquad, method = 4;
q4:       quadrupole, l =  0.05000000, k = -14.28193395, n = nquad, method = 4;
mqfh:     bending, l =  0.12000000,
    t = -0.58000000, t1 =  0.00000000, t2 =  0.00000000, k = 14.14108786,
    n = nbend, method = 4;

sf      : sextupole, l = 0.05000, k =  1.33935e+03, n = nsext, Method = Meth;
sd      : sextupole, l = 0.10000, k = -1.12327e+03, n = nsext, Method = Meth;

sh1     : sextupole, l = 0.05000, k =  9.69350e+02, n = nsext, Method = Meth;
sh2     : sextupole, l = 0.05000, k = -7.64451e+02, n = nsext, Method = Meth;
sh3     : sextupole, l = 0.05000, k = -9.82627e+02, n = nsext, Method = Meth;
sh4     : sextupole, l = 0.00000, k =  7.26439e+01, n = nsext, Method = Meth;

{CAV is not actual cavity position; only used to calculate phi_s, delta_rf,
     etc.}
h_rf = 327; C =  195.94152;
CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 0.715e6, Harnum = h_rf,
     phi = 180.0;


lgb:    lgb00, lgb01, lgb02, lgb03, lgb04, lgb05;

hcell1: lgb, dx, sd, dx, dx, qfh, dx, sf;
hcell2: lgb, dx, sd, dx, dx, qfh, dx, bpm, cm, sf;
hcell3: lgb, dx, sd, dx, dx, qfh, dx, sf;
hcell4: lgb, dx, sd, dx, dx, qfh, dx, bpm, cm, sf;
hcell5: lgb, dx, sd, dx, dx, qfh, dx, sf;

fcell:  INV(hcell3), hcell4;

ds:     mb3h, dx, sd, md33, dx, dx, mqfh, dx, bpm, cm, sf, INV(hcell1);
mc:     bpm, cm, q1, dx, 4*dx02, sh1, dx, q2, dx, sh2, dx, q3, dx, sh3, dx, q4, 
        INV(cm), bpm, dx25, 2*dx, sh4, dx;
mcds:   ssh, ssxtra, mc, ds;
half:   mcds, hcell2, fcell, INV(hcell5);
achr:   half, INV(half);

line: 1*ACHR, CAV;

CELL: line, SYMMETRY = 1;

END;
