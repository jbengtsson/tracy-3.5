{ TITLE "alsu-v20r-ring" }
{ 
2/1/18, MV: v20r lattice translated from elegant, including BPMs as laid out by Sol in the Arc + two additional BPMs adjacent to the harmonic sextupoles. Total of 20 BPMs. (We may not need all of them.)
2/1/18, SCL: reduced CODeps because 1e-14 was overkill; k1 -> k; csbend -> bending; introduced bpm_m marker for compatibility; introduced (thin) CMs for future OCO studies; fixed length of D11A.
2/6/18, SCL: for sector with BPMs added CMs to all sextupoles and RBs (none installed at QF/D1 to limit no. of CMs to below no. of BPMs).
2/12/18, SCL: included girder marker definition to prevent m4.cc from crashing when calling OCO.
}
              
define lattice; ringtype = 1;

Energy = 2.0;

{making dP smaller speeds up runtime}
dP = 1e-6; CODeps = 1e-10;

{Meth = 4; Nbend = 4; Nquad = 4; Nsext = 4; Ncorr = 1;}
Meth = 4; Nbend = 10; Nquad = 10; NquadRev =10; Nsext = 10; Ncorr = 1;

pi = 4.0*arctan(1.0);
c0 = 2.99792458e8;

{ Girder Markers }
GS: Multipole, N = 1, Method = Meth;
GE: Multipole, N = 1, Method = Meth;

D11:  DRIFT, L=0.5145;
D12:  DRIFT, L=0.075;
D13A: DRIFT, L=0.075;
D13B: DRIFT, L=0.075;
D13C: DRIFT, L=0.075;
D14A: DRIFT, L=0.075;
D14B: DRIFT, L=0.075;
D15:  DRIFT, L=0.225;
D33:  DRIFT, L=0.075;
DQF2: DRIFT, L=0.075;

{ Drifts elements accommodating the BPMs} 
DX:  DRIFT, L=0.0375;
{ Note:  D11A + D11B = D11 }
D11A:  DRIFT, L=0.4770;
D11B:  DRIFT, L=0.0375;


{ Main bending magnets }
b31:   BENDING, L= 3.40000E-01, T= 3.333333,
       K=-2.999999, T1= 0.0, T2= 0.0,
       N = Nbend, Method = Meth;

b32:   BENDING, L= 5.00000E-01, T=3.645685,
       K=-7.057403, T1= 0.0, T2= 0.0,
       N = Nbend, Method = Meth;

b3:    BENDING, L= 5.00000E-01, T= 3.762697,
       K=-7.057403, T1= 0.0, T2= 0.0,
       N = Nbend, Method = Meth;


{ Pure quadrupoles }
qf1:   QUADRUPOLE, L= 1.8E-01, K= 13.76775,
       N = Nquad, Method = Meth;

qd1:   QUADRUPOLE, L= 1.4E-01, K=-13.4318,
       N = Nquad, Method = Meth;


{ Quadrupoles with reverse bending }
QF2: BENDING, L=0.19, T=-0.0914561,
     K=10.22397, T1=0.0, T2=0.0,
     N = NquadRev, Method = Meth;

QF3: BENDING, L=0.115, T=-0.00621373,
     K=10.54612, T1=0.0, T2=0.0,
     N = NquadRev, Method = Meth;

QF4: BENDING, L=0.305, T=-0.429364,
     K=15.28256, T1=0.0, T2=0.0,
     N = NquadRev, Method = Meth;

QF5: BENDING, L=0.305, T=-0.429364,
     K=15.79571, T1=0.0, T2=0.0,
     N = NquadRev, Method = Meth;

QF6: BENDING, L=0.305, T=-0.429364,
     K=15.7612, T1=0.0, T2=0.0,
     N = NquadRev, Method = Meth;  


{ Note : Tracy Sext. K is one half of MAD/Elegant K2 } 
sf:    SEXTUPOLE, L= 2.8000000000E-01, K= 781.45580473,
       N = Nsext, Method = Meth;

sd:    SEXTUPOLE, L= 2.8000000000E-01, K= -658.494268,
       N = Nsext, Method = Meth;

shh:   SEXTUPOLE, L= 7.5000000000E-02, K= 38.85843,
       N = Nsext, Method = Meth;

shh2:  SEXTUPOLE, L= 7.5000000000E-02, K= -578.1924,
       N = Nsext, Method = Meth;


{ Beam Position Monitors }
BPM_M: Beam Position Monitor;
BPM0: BPM_M;
BPM1: BPM_M;
BPM2: BPM_M;
BPM3: BPM_M;
BPM4: BPM_M;
BPM5: BPM_M;
BPM6: BPM_M;
BPM7: BPM_M;
BPM8: BPM_M;
BPM9: BPM_M;
BPM10: BPM_M;
BPM11: BPM_M;
BPM12: BPM_M;
BPM13: BPM_M;
BPM14: BPM_M;
BPM15: BPM_M;
BPM16: BPM_M;
BPM17: BPM_M;
BPM18: BPM_M;
BPM19: BPM_M;

{ Horizontal and vertical corrector }
CORR_H:  Corrector, Horizontal, Method= Meth;
CORR_V:  Corrector, Vertical, Method= Meth;
CMs:    CORR_H, CORR_V;


{CAV is not actual cavity position; only used to calculate phi_s, delta_rf, etc.}
h_rf = 328; C =  196.5;
CAV: Cavity, Frequency = c0/C*h_rf, Voltage = 0.6e6, Harnum = h_rf;


sectorNoBPMs : d11, d11, d11, d11, d11, SHH, D12, QF1, D13A, QD1, D13B, SHH2, D13C, B31, D14A, SD, D14B, QF2, DQF2, SF, DQF2, QF3, D15, B32, D33, QF4, D33, B3, D33, QF5, D33, B3, D33, QF6, D33, B3, D33, QF6, D33, B3, D33, QF5, D33, B3, D33, QF4, D33, B32, D15, QF3, DQF2, SF, DQF2, QF2, D14B, SD, D14A, B31, D13C, SHH2, D13B, QD1, D13A, QF1, D12, SHH, d11, d11, d11, d11, d11 ;

{ Sector with BPMs }
sector : d11, d11, d11, d11, 
D11A, BPM0, D11B, 
CMs,
SHH, D12,
QF1, 
DX, BPM1, DX, 
QD1, 
DX, BPM2, DX, 
CMs,
SHH2, 
D13C, 
B31, 
DX, BPM3, DX, 
CMs,
SD, 
D14B, 
CMs,
QF2, 
DQF2, 
CMs,
SF, 
DX, BPM4, DX, 
CMs,
QF3, 
D15, 
B32, 
DX, BPM5, DX, 
CMs,
QF4, 
DX, BPM6, DX, 
B3, 
DX, BPM7, DX, 
CMs,
QF5, 
D33, 
B3, 
DX, BPM8,DX, 
CMs,
QF6, 
DX, BPM9,DX, 
B3, 
DX, BPM10,DX, 
QF6, 
CMs,
DX, BPM11,DX, 
B3, 
DX, BPM12,DX, 
QF5, 
CMs,
D33, 
B3, 
D33, 
QF4, 
CMs,
DX, BPM13,DX, 
B32, 
D15, 
QF3, 
CMs,
DQF2, 
SF, 
CMs,
DX, BPM14,DX,  
QF2, 
CMs,
D14B, 
SD, 
CMs,
DX, BPM15,DX, 
B31, 
DX, BPM16,DX,
SHH2, 
CMs,
DX, BPM17,DX,
QD1, 
DX, BPM18,DX,
QF1, 
D12, 
SHH, 
CMs,
D11B, BPM0, D11A, 
d11, d11, d11, d11 ;


{RING: sectorNoBPMs, CAV;}
{RING: sector, CAV;}
{RING: 12*sectorNoBPMs, CAV;}
RING: 1*sector, CAV;

CELL: RING, SYMMETRY = 1;

END;
