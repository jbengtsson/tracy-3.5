    n = nbend, method = 4;
dl1a_5:   bending, l =  0.20000000,
    t =  0.92612621, t1 = -0.60569115, t2 =  2.80377242, k = -0.03641367,
    n = nbend, method = 4;
dl2a_1:   bending, l =  0.16667000,
    t =  0.37752067, t1 =  0.00000000, t2 =  0.37752067, k = -0.36955676,
    n = nbend, method = 4;
dl2a_2:   bending, l =  0.16667000,
    t =  0.43456003, t1 = -0.37752067, t2 =  0.81208070, k = -0.36955676,
