dl2a_3:   bending, l =  0.33334000,
    t =  0.50874816, t1 = -0.43456003, t2 =  1.32082886, k = -0.36955676,
    n = nbend, method = 4;
dl2a_4:   bending, l =  0.16667000,
    t =  0.62896432, t1 = -0.50874816, t2 =  1.94979318, k = -0.36955676,
    n = nbend, method = 4;
dl2a_5:   bending, l =  0.16667000,
    t =  0.96171183, t1 = -0.62896432, t2 =  2.91150501, k = -0.36955676,
    n = nbend, method = 4;

qf4:      bending, l =  0.15000000,
    t = -0.21321986, t1 = -0.10660993, t2 = -0.10660993, k =  4.89105471,
    n = nbend, method = 4;
qf8:      bending, l =  0.25000000,
    t = -0.38964259, t1 = -0.19482130, t2 = -0.19482130, k =  6.37215924,
    n = nbend, method = 4;
dq1:      bending, l =  0.87000000,
    t =  2.60080489, t1 =  1.30040245, t2 =  1.30040245, k = -2.80732136,
    n = nbend, method = 4;

qd3:      quadrupole, l =  0.15000000, k = -3.19491855, n = nquad, method = 4;
qd5:      quadrupole, l =  0.10500000, k = -5.11885371, n = nquad, method = 4;
qd2:      quadrupole, l =  0.15000000, k = -7.46574590, n = nquad, method = 4;
qf1:      quadrupole, l =  0.20000000, k =  8.19209071, n = nquad, method = 4;
qf6:      quadrupole, l =  0.36000000, k =  7.69016183, n = nquad, method = 4;

qd2_c1:   quadrupole, l =  0.10500000, k = -2.08608882, n = nquad, method = 4;
qf1_c1:   quadrupole, l =  0.18500000, k = -3.80859522, n = nquad, method = 4;
quad_add: quadrupole, l =  0.18500000, k =  6.57129556, n = nquad, method = 4;

{sf1:      sextupole, l =  0.07000000, k =  167.80242054, n = nsext, method = 4;
sd1:      sextupole, l =  0.14000000, k = -176.18054570, n = nsext, method = 4;
sd2:      sextupole, l =  0.14000000, k = -134.26478299, n = nsext, method = 4;
s       : sextupole, l = 0.10000, k = 0.0, n = nsext, Method = Meth;
sh1     : sextupole, l = 0.100000, k = 0.000000, n = nsext, method = meth;
sh2     : sextupole, l = 0.10000, k = 0.0, n = nsext, Method = Meth;
of1     : multipole, l = 0.09000, hom = (4, 0.0, 0.0),
	  n = nsext, Method = Meth;
of2     : multipole, l = 0.09000, hom = (4, 0.0, 0.0),
	  n = nsext, Method = Meth;

{sf1     : sextupole, l = 0.07000, k =  1.59095e+02, n = nsext, Method = Meth;
sd1     : sextupole, l = 0.14000, k = -2.47578e+02, n = nsext, Method = Meth;
sd2     : sextupole, l = 0.14000, k = -2.21980e+01, n = nsext, Method = Meth;
sh1     : sextupole, l = 0.10000, k = -5.19471e+01, n = nsext, Method = Meth;
sh2     : sextupole, l = 0.10000, k = -1.63382e+01, n = nsext, Method = Meth;
s       : sextupole, l = 0.10000, k = -1.93888e+02, n = nsext, Method = Meth;
of1     : multipole, l = 0.09000,
          hom = (4,  4.80824e+03, 0e0),
          n = nsext, Method = Meth;
of2     : multipole, l = 0.09000, hom = (7, 0*3e11, 0.0),
	  n = nsext, Method = Meth;}

sf1     : sextupole, l = 0.07000, k =  1.58657e+02, n = nsext, Method = Meth;
sd1     : sextupole, l = 0.14000, k = -2.46780e+02, n = nsext, Method = Meth;
sd2     : sextupole, l = 0.14000, k = -1.85441e+01, n = nsext, Method = Meth;
sh1     : sextupole, l = 0.10000, k = -6.71805e+01, n = nsext, Method = Meth;
sh2     : sextupole, l = 0.10000, k = -2.51616e+01, n = nsext, Method = Meth;
s       : sextupole, l = 0.10000, k = -2.37906e+02, n = nsext, Method = Meth;
of1     : multipole, l = 0.09000,
          hom = (4,  4.12754e+03, 0e0),
          n = nsext, Method = Meth;
of2     : multipole, l = 0.09000, hom = (7, 0*3e11, 0.0),
	  n = nsext, Method = Meth;

bpm: beam position monitor;
ch:  corrector, horizontal, method = meth;
cv:  corrector, vertical, method = meth;
chv: ch, cv;

ps_rot:   map;
mI_rot:   map;

{----- table of segments ----------------------------------------------------}

dl1a     : inv(dl1a_5, dl1a_4, dl1a_3, dl1a_2, dl1a_1);
dl2a     : dl2a_5, dl2a_4, dl2a_3, dl2a_2, dl2a_1;

match_ss: dr_05, sh1, dr_03, chv, qd2, dr_04, qf1, dr_02, bpm, dr_01;

match_ms: d_01, bpm, d_02, chv, sh2, d_03, qf8, d_04;

match_ls: dl_20, sh1, dl_21, bpm, dl_22, chv, qd2_c1, dl_23,
          qf1_c1, dl_24, dcor1, chv, dcor1, dl_25, quad_add, dl_26,
          bpm, dl_27;

dip_cell: dq1, d_05, qf6, d_06, bpm, d_07, dcor, s, chv, dcor, d_08,
	  dl2a, d_09, qd5, d_10, sd2, chv, d_11,
          bpm, d_12, of1, d_13, qf4, d_14, sf1,
	  sf1, d_14, qf4, d_13, of2, d_12, bpm,
	  d_11, chv, sd1, d_10, qd3, d_09, dl1a;

ms_to_ss : match_ms, dip_cell, match_ss;

ms_to_ls : match_ms, dip_cell, match_ls;

std_cell : ms_to_ss, ss, b_t, inv(ms_to_ss);
sp       : ls, b_t, inv(ms_to_ls), 3*(mI_rot, ms, std_cell), ms, mI_rot,
	    ms_to_ls, ls;

{line: ms, ms_to_ss, ss;}
{line: ss, inv(ms_to_ss), ms, ms_to_ss, ss;}
{line: ms, ms_to_ls, ls;}
{line: ls, inv(ms_to_ls), ms, ms_to_ls, ls;}
line: sp;

ring: 1*line, ps_rot, b_t, cav;

cell: ring, symmetry=1;

end;
