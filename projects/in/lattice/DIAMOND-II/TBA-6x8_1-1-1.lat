
define lattice;

energy = 3.5;

dp = 1.0d-10; codeps = 1.0d-6;  dk = 1.0d-6;

meth = 4; nbend = 10; nquad = 10; nsext = 2;

cav: Cavity, L = 0.0, Frequency = 499654096.667, Voltage = 2200000, phi = 0.0;

d_1: drift, l = 2.500000;
d_2: drift, l = 0.179182;

d_3: drift, l = 0.20013291;

d_4: drift, l = 0.07752192;
d_5: drift, l = 0.07112718;
d_6: drift, l = 0.32385945;
d_7: drift, l = 0.21213788;

d_6d:  drift, l = 0.4336066-0.175;
d2:    drift, l = 0.110316;
dr4d:  drift, l = 0.163993;
dr6d:  drift, l = 1.500000;
d48:   drift, l = 0.900000;
d28:   drift, l = 0.984793;
dr4d8: drift, l = 0.075000;
dr6d8: drift, l = 4.000000;

b1: bending, l =  0.79999998,
    t =  2.45774968, t1 =  1.22887484, t2 =  1.22887484, k = -1.74989688,
    n = nbend, method = 4;
b2: bending, l =  0.48192233,
    t =  1.29225032, t1 =  0.64612516, t2 =  0.64612516, k = -1.99395788,
    n = nbend, method = 4;

qf1: quadrupole, l =  0.15000000, k =  9.52093656, n = nquad, method = 4;
qd2: quadrupole, l =  0.20000000, k = -9.58091186, n = nquad, method = 4;
qf3: quadrupole, l =  0.30000000, k =  5.23774592, n = nquad, method = 4;
qf4: quadrupole, l =  0.15000000, k =  6.40985851, n = nquad, method = 4;

{qf5: quadrupole, l = 0.400000, k =  6.928847, n = nquad, method = meth;
qd6: quadrupole, l = 0.150000, k = -4.775607, n = nquad, method = meth;}

qf5: quadrupole, l =  0.20000000, k =  6.99380431, n = nquad, method = 4;
qd6: quadrupole, l =  0.15000000, k = -5.86418731, n = nquad, method = 4;

q48:  quadrupole, l = 0.150000, k =  3.568383, n = nquad, method = meth;
q28:  quadrupole, l = 0.150000, k = -5.723301, n = nquad, method = meth;
q3d8: quadrupole, l = 0.150000, k = 17.088120, n = nquad, method = meth;

sfh: sextupole, l =  0.05000000, k =  464.42018682, n = nsext, method = 4;
sd1: sextupole, l =  0.10000000, k = -499.43362772, n = nsext, method = 4;
sd2: sextupole, l =  0.0,        k = -499.43362772, n = nsext, method = 4;

ps_rot: map;

tba_1: d_5, sd1, d_6, qf4, d_7, sfh;

tba_hcell: b1, tba_1, inv(tba_1), b2;

mid_mcell: dr4d, qf5, d2, qd6, dr6d;

std_mcell: d_1, qf1, d_2, qd2, d_3, qf3, d_4;

long_mcell: dr6d8, q48, d48, q28, d28, q3d8, dr4d8;

tba_cell: tba_hcell, inv(tba_hcell);

std_hcell: std_mcell, tba_cell, mid_mcell;
std_cell:  std_hcell, inv(std_hcell);

long_hcell: long_mcell, inv(tba_cell), tba_cell, mid_mcell;

line: std_mcell, tba_hcell, sd2, inv(std_mcell, tba_hcell), ps_rot, cav;
{line: std_hcell, cav;}
{line: std_cell, cav;}
{line: long_hcell, inv(long_hcell), cav;}
{line: long_hcell, inv(std_hcell), 2*std_cell, std_hcell, inv(long_hcell), cav;}

cell: line, symmetry=1;

end;
