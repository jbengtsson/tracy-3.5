ocx1    : multipole, l = 0.0, hom = (4,174.8031,0);
ocx2    : multipole, l = 0.0, hom = (4,2.0174,0);

mon     : beam position monitor;

ch      : corrector, horizontal;

cv      : corrector, vertical;


{----- table of segments ----------------------------------------------------}

bs     : bsom, bs00, bs01, bs02, bs03, bs04, bs05, bs06, bs07, bs08,
         bs09, bs10, bs11, bs12, bs13, bs14;
i_bs   : i_bs14, i_bs13, i_bs12, i_bs11, i_bs10, i_bs09, i_bs08,
         i_bs07, i_bs06, i_bs05, i_bs04, i_bs03, i_bs02, i_bs01, i_bs00, bsom;
bn     : bnom, bn00, bn01, bn02, bn03, bn04, bn05, bn06;
i_bn   : i_bn06, i_bn05, i_bn04, i_bn03, i_bn02, i_bn01, i_bn00, bnom;
vb     : dvb, qvb;
vb_bs  : dvbs, qvbs;
vbm    : dvb, qvbm;
cc     : ch, cv;
sd     : sdh, sdh;
sdm    : sdmh, sdmh;
oqc1   : dao, qof, ocx1, qof, dao;
oqc2   : dao, qof, ocx2, qof, dao;
oqcm   : dao, qofm, ocxm, qofm, dao;
mqo1   : oqc1, sfh;
mqo2   : oqc2, sfh;
mmon   : doc, mon, doc, sfh;
mp1    : mmon, cc, inv(mqo1);
mp2    : mmon, cc, inv(mqo2);
mpm    : doc, mon, doc, sfmh, cc, sfmh, oqcm;
mxy    : doc, oxy, doc, sxyh, sxyh, doc;
mxx    : doc, oxx, doc, sxxh, cc, sxxh, doc;
myy    : doc, oyy, doc, syyh, cc, syyh, doc;
bsl    : bs, lgbs;
i_bsl  : lgbs, i_bs;
bnl    : bn, lgbn;
i_bnl  : lgbn, i_bn;
bnsup  : lgbe, bn, lgbe;
i_bnsup: lgbe, i_bn, lgbe;
hnc    : bnl, dnvb, vb, d1, sd, d2, an;
i_hnc  : i_an, d2, inv(sd), d1, inv(vb), dnvb, i_bnl;
hsc    : bsl, dnvb, vb_bs, d1, sd, d2, an_bs;
i_hsc  : i_an_bs, d2, inv(sd), d1, inv(vb_bs), dnvb, i_bsl;
ncell  : inv(mqo1), i_hnc, hnc, mmon;
i_ncell: inv(mmon), i_hnc, hnc, mqo1;
ncellr : hnc, mp1, i_hnc;
i_ncellr: hnc, inv(mp1), i_hnc;
scell  : inv(mqo1), i_hsc, hsc, mmon;
i_scell: inv(mmon), i_hsc, hsc, mqo1;
hcor   : xm, hnc, mp1, i_hnc, xo, hnc, mp2, i_hnc, xo;
i_hcor : xo, hnc, inv(mp2), i_hnc, xo, hnc, inv(mp1), i_hnc, xm;
hscor  : xx, hsc, mp1, i_hnc, xo, hnc, mp2, i_hnc, xo;
i_hscor: xo, hnc, inv(mp2), i_hnc, xo, hnc, inv(mp1), i_hsc, xx;
dsup   : hnc, mpm, anm, d2m, sdm, d1, inv(vbm), dnvb, i_bnsup;
i_dsup : bnsup, dnvb, vbm, d1, inv(sdm), d2m, i_anm, inv(mpm), i_hnc;
mat    : d3, mon, inv(myy), qm1, dmon, inv(mxy), qm2, dmon, mon,
         inv(mxx), qm3, dm2, qm4, dstr, minigap;
tm     : dsup, mat;
i_tm   : inv(mat), i_dsup;
hm     : hcor, tm;
i_hm   : i_tm, i_hcor;
hsm    : hscor, tm;
i_hsm  : i_tm, i_hscor;
marc   : hm, i_hm;
i_marc : hm, i_hm;
pers   : center, xs, i_hm, hm, xs, i_hsm, hsm, xs, i_hm, hm, xs, i_hm, hm;
i_pers : i_hm, hm, xs, i_hm, hm, xs, i_hsm, hsm, xs, i_hm, hm, xs, center;
arcn   : center, xs, i_hm, hm;
i_arcn : i_hm, hm, xs, center;
arcs   : center, xs, i_hsm, hsm;
i_arcs : i_hsm, hsm, xs, center;
ring   : 3*pers;
i_ring : 3*i_pers;
test   : ncellr, bn, dl0, qc0, dl1, qc1, d1, bc, dl2;
i_test : dl2, bc, d1, qc1, dl1, qc0, dl0, i_bn, i_ncellr;

cell: test, symmetry=1;

end;

