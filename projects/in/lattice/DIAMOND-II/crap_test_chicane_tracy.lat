lgbe    : marker;

oxx     : multipole, l = 0.0, hom = (4,-58.8374,0);
oxy     : multipole, l = 0.0, hom = (4,9.7495,0);
oyy     : multipole, l = 0.0, hom = (4,155.8446,0);
