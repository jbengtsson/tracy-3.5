sf1     : sextupole, l = 0.05000, k =  1.57102e+03, n = nsext, Method = Meth;
sf2     : sextupole, l = 0.05000, k =  1.31383e+03, n = nsext, Method = Meth;
sd1     : sextupole, l = 0.10000, k = -1.47390e+03, n = nsext, Method = Meth;
