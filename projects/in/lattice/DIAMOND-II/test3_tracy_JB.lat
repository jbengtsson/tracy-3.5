sxh     : sextupole, l = 0.00000, k =  4.46651e+01, n = nsext, Method = Meth;

lgbom  : marker;

qfh    : bending, l = 0.120000, t = -rbang, k = 16.140218,
         t1 = 0.000000, t2 = 0.000000, n=nbend, method=meth;
mqfh   : bending, l = 0.120000, t = -rbang, k = 14.290512,
         t1 = 0.000000, t2 = 0.000000, n=nbend, method=meth;

oxx    : multipole, l = 0.0, hom = (4,0*453.8134,0);
oxy    : multipole, l = 0.0, hom = (4,-0*700.1775,0);
oyy    : multipole, l = 0.0, hom = (4,0*2000.0000,0);
oc1    : multipole, l = 0.0, hom = (4,0*35.6322,0);
oc2    : multipole, l = 0.0, hom = (4,-0*129.4600,0);
oc3    : multipole, l = 0.0, hom = (4,0*58.6448,0);


{----- table of segments ----------------------------------------------------}

lgb    : lgbom, lgb00, lgb01, lgb02, lgb03, lgb04, lgb05;
i_lgb  : i_lgb05, i_lgb04, i_lgb03, i_lgb02, i_lgb01, i_lgb00, lgbom;
hcell1 : lgb, dx, sd2, dx, dx, qfh, dx, oc1, sf2;
i_hcell1: sf2, oc1, dx, qfh, dx, dx, sd2, dx, i_lgb;
hcell2 : lgb, dx, sd2, dx, dx, qfh, dx, oc2, sf2;
i_hcell2: sf2, oc2, dx, qfh, dx, dx, sd2, dx, i_lgb;
hcell3 : lgb, dx, sd2, dx, dx, qfh, dx, oc2, sf2;
i_hcell3: sf2, oc2, dx, qfh, dx, dx, sd2, dx, i_lgb;
hcell4 : lgb, dx, sd2, dx, dx, qfh, dx, oc3, sf2;
i_hcell4: sf2, oc3, dx, qfh, dx, dx, sd2, dx, i_lgb;
hcell5 : lgb, dx, sd2, dx, dx, qfh, dx, oc3, sf2;
i_hcell5: sf2, oc3, dx, qfh, dx, dx, sd2, dx, i_lgb;
cell1  : i_hcell3, hcell4;
i_cell1: i_hcell4, hcell3;
llce   : hcell2, i_hcell3;
i_llce : hcell3, i_hcell2;
ds     : mb3h, dx, sd1, md33, dx, dx, mqfh, dx, sf1, i_hcell1;
i_ds   : hcell1, sf1, dx, mqfh, dx, dx, md33, sd1, dx, mb3h;
mc     : oxy, q1, sxh, dx, oxx, q2, sfh, dx, q3, sdh, dx, q4, oyy, dx,
         dx, dx;
mcds   : ssh, ssxtra, mc, ds;
i_mcds : i_ds, inv(mc), ssxtra, ssh;
half   : mcds, hcell2, cell1, i_hcell5;
i_half : hcell5, i_cell1, i_hcell2, i_mcds;
achr   : half, i_half;
i_achr : half, i_half;

ring   : 1*achr, cav;

cell: ring, symmetry=1;

end;

