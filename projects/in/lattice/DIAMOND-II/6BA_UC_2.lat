{c:\users\streun\opadat\sls-2\101pm_s7o7_a.opa}
{another trial, wp above coupling, small footprint}

{opa to tracy-2 export}

define lattice;
energy = 3.000000;
dp = 1.0d-8; codeps = 1.0d-10; dk = 1.0d-5;
meth = 4; nbend = 10; nquad = 10; nsext = 3;


{ SLS-2, 12 x 7-BA = 84. }
n_sls_2 = 84;

{ Number of cells: 4-BA 6, 6-BA 8, 8-BA 10. }
n_cell = 8;

n_dip = 24*n_cell/2;

{----- variables ----------------------------------------------------}

aban = 0.7*0.88*n_sls_2/n_dip;

c0 = 2.99792458e8; h_rf = 484; C = 12*24.2; Brho = 1e9*Energy/c0;

{cav: Cavity, Frequency = c0/C*h_rf, Voltage = 1.8e6, Harnum = h_rf,
     phi = 180.0;}
{ Optimized for alpha-buckets. }
cav: Cavity, Frequency = c0/C*h_rf, Voltage = 1.4e6, Harnum = h_rf,
     phi = 180.0;

{----- table of elements ----------------------------------------------------}

dmon: drift, l = 0.050000;
dnvb: drift, l = 0.010000;
dsvb: drift, l = 0.084000;
dnm:  drift, l = 0.300000;
dnm1: drift, l = 0.050000;
dnm2: drift, l = 0.150000;
dmp:  drift, l = 0.150000;
dxm:  drift, l = 0.200000;
dsx:  drift, l = 0.100000;
dme:  drift, l = 0.250000;
mgp:  drift, l = 1.000000;
dm1:  drift, l = 0.100000;
dm2:  drift, l = 0.150000;
dms:  drift, l = 1.760000;
dxd:  drift, l = 0.050000;
doc:  drift, l = 0.050000;
dbs:  drift, l = 0.073930;

center: marker;

qm3:  quadrupole, l = 0.15, k = -7.051552, n=nquad, method=meth;
qm2a: quadrupole, l = 0.15, k =  7.494419, n=nquad, method=meth;
qm2b: quadrupole, l = 0.15, k =  7.126250, n=nquad, method=meth;
qm1:  quadrupole, l = 0.15, k = -7.490407, n=nquad, method=meth;

L_bn = 0.273897; phi_bend = 360.0/(2*n_dip)*7/8;

bn00:   bending, l = L_bn*2.0/7.0, t = phi_bend*3.0/7.0, k = 0.0,
        t1 = 0.0, t2 = phi_bend*3.0/7.0, n=nbend, method=meth;
bn03:   bending, l = L_bn/7.0, t = phi_bend/7.0, k = 0.0,
        t1 = -phi_bend*3.0/7.0, t2 = phi_bend*4.0/7.0, n=nbend, method=meth;
bn06:   bending, l = L_bn*4.0/7.0, t = phi_bend*3.0/7.0, k = 0.0,
        t1 = -phi_bend*4.0/7.0, t2 = phi_bend, n=nbend, method=meth;

i_bn00: bending, l = L_bn*2.0/7.0, t = phi_bend*3.0/7.0, k = 0.0,
        t1 = phi_bend*3.0/7.0, t2 = 0.0, n=nbend, method=meth;
i_bn03: bending, l = L_bn/7.0, t = phi_bend/7.0, k = 0.0,
        t1 = phi_bend*4.0/7.0, t2 = -phi_bend*3.0/7.0, n=nbend, method=meth;
i_bn06: bending, l = L_bn*4.0/7.0, t = phi_bend*3.0/7.0, k = 0.0,
        t1 = phi_bend, t2 = -phi_bend*4.0/7.0, n=nbend, method=meth;


bn:   bn00, bn03, bn06;
i_bn: i_bn06, i_bn03, i_bn00;

an:    bending, l = 0.3, t = -aban, k = 4.083440, t1 = -aban,
       t2 = 0.0, n=nbend, method=meth;
i_an:  bending, l = 0.3, t = -aban, k = 4.083440,
       t1 = 0.0, t2 = -aban, n=nbend, method=meth;

anm:   bending, l = 0.3, t = -aban, k = 3.649531, t1 = -aban,
       t2 = 0.0, n=nbend, method=meth;
i_anm: bending, l = 0.3, t = -aban, k = 3.649531,
       t1 = 0.0, t2 = -aban, n=nbend, method=meth;

vbm:   bending, l = 0.206103, t = phi_bend/7.0+aban, k = -1.969615,
       t1 = -phi_bend, t2 = 2.5+aban, n=nbend, method=meth;
i_vbm: bending, l = 0.206103, t = phi_bend/7.0+aban, k = -1.969615,
       t1 = 2.5+aban, t2 = -phi_bend, n=nbend, method=meth;

vb: bending, l = 0.206103, t = phi_bend/7.0+aban, k = -4.195840,
    t1 = -phi_bend, t2 = 2.5+aban, n=nbend, method=meth;
i_vb: bending, l = 0.206103, t = phi_bend/7.0+aban, k = -4.195840,
      t1 = 2.5+aban, t2 = -phi_bend, n=nbend, method=meth;

{ 6-BA. }
sfh:  sextupole, l = 0.05, k =  9.09796e+02, n = nsext, Method = Meth;
sdh:  sextupole, l = 0.05, k = -9.80057e+02, n = nsext, Method = Meth;
sfmh: sextupole, l = 0.05, k =  9.13613e+02, n = nsext, Method = Meth;
sdmh: sextupole, l = 0.05, k = -3.47855e+02, n = nsext, Method = Meth;
{ 8-BA. }
{sfh:  sextupole, l = 0.050000, k =  1.23494e+03, n = nsext, method=meth;
sdh:  sextupole, l = 0.050000, k = -1.05002e+03, n = nsext, method=meth;
sfmh: sextupole, l = 0.050000, k =  6.34548e+02, n = nsext, method=meth;
sdmh: sextupole, l = 0.050000, k = -1.82233e+02, n = nsext, method=meth;}

sxxh: sextupole, l = 0.050000, k = 0.0, n = nsext, method=meth;
sxyh: sextupole, l = 0.050000, k = 0.0, n = nsext, method=meth;
syyh: sextupole, l = 0.050000, k = 0.0, n = nsext, method=meth;

ocx:  multipole, l = 0.0, hom = (4, 0.0, 0);
ocxm: multipole, l = 0.0, hom = (4, 0.0, 0);
ocy:  multipole, l = 0.0, hom = (4, 0.0, 0);
ocym: multipole, l = 0.0, hom = (4, 0.0, 0);

oxx:  multipole, l = 0.0, hom = (4, 0.0, 0);
oxy:  multipole, l = 0.0, hom = (4, 0.0, 0);
oyy:  multipole, l = 0.0, hom = (4, 0.0, 0);

mon: beam position monitor;
ch:  corrector, horizontal;
cv:  corrector, vertical;
chv: ch, cv;


{----- table of segments ----------------------------------------------------}

sd:  sdh, ocy, sdh;
sdm: sdmh, ocym, sdmh;

sxx: sxxh, chv, sxxh;
sxy: sxyh, chv, sxyh;
syy: syyh, chv, syyh;

hnc:   bn, dnvb, vb, dnm1, sd, dnm2, an;
i_hnc: i_an, dnm2, inv(sd), dnm1, i_vb, dnvb, i_bn;

mpfho: doc, ocx, doc, sfh;
mpfh_: doc, mon, doc, sfh;
mpf:   mpfh_, chv, inv(mpfho);

ncellr:   hnc, mpfh_, inv(mpfho), i_hnc;
i_ncellr: hnc, mpfho, inv(mpfh_), i_hnc;

mpfm: doc, mon, doc, sfmh, chv, sfmh, doc, ocxm, doc;

moxy: doc, oxy, doc, sxy, doc;
moxx: doc, oxx, doc, sxx, doc;
moyy: doc, oyy, doc, syy, doc;

dsup:   hnc, mpfm, anm, dxm, sdm, dnm1, i_vbm, dnvb, i_bn;
i_dsup: bn, dnvb, vbm, dnm1, inv(sdm), dxm, i_anm, inv(mpfm), i_hnc;

mat: dme, mon, inv(moyy), qm1, dmon, mon, inv(moxy), qm2a, dmon,
     mon, inv(moxx), qm2b, dm2, qm3, dms, mgp;

tm:   dsup, mat;
i_tm: inv(mat), i_dsup;

l1: drift, l = 1.3;
q1: quadrupole, l = 0.0, k = -0.623293, n = nquad, method = meth;
q2: quadrupole, l = 0.0, k =  0.735862, n = nquad, method = meth;
ss_h: q1, l1, q2;

{ Unit cell. }
{line: ncellr, cav;}
{ Matching Cell. }
{line: i_tm, tm, cav;}

{ SLS-2 }
{line: i_tm, 5*ncellr, tm, cav;}

{ Prototype DIAMOND-II. }
{ 1 4-BA, 2 6-BA, 3 8-BA. }
n_ucell = 1;
super_period: i_tm, n_ucell*ncellr, ss_h, inv(ss_h), n_ucell*ncellr, tm;

line: 1*super_period, cav;

cell: line, symmetry=1;

end;

{c:\users\streun\opadat\sls-2\101pm_s7o7_a.opa}
