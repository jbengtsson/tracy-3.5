d9:     drift, l =  0.11091709;
qd2_ms: quadrupole, l =  0.14884224, k =  8.58293902, n = nquad, method = 4;

d4:     drift, l =  0.50410493;
qd4_ls: quadrupole, l =  0.31240664, k =  -6.48895130, n = nquad, method = 4;
d3:     drift, l =  0.20211685;
qf3_ls: quadrupole, l =  0.15179198, k =  16.70634930, n = nquad, method = 4;
d2:     drift, l =  0.34551009;
qd2_ls: quadrupole, l =  0.16057482, k = -12.78058488, n = nquad, method = 4;
d1:     drift, l =  0.075;
qf1_ls: quadrupole, l =  0.1,        k =   0.0,        n = nquad, method = 4;

d10:    drift, l =  0.34738692;
