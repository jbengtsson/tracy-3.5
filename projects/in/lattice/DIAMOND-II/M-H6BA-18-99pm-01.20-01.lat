dl1a     : inv(dL_dl1a, dl1a_5, dl1a_4, dl1a_3, dl1a_2, dl1a_1);
dl2a     : dL_dl2a, dl2a_5, dl2a_4, dl2a_3, dl2a_2, dl2a_1;

match_ss:  dr_05, qd2, dr_04, ch, cv, sh1a, dr_03, qf1, dr_02, bpm, dr_01;

match_ms:  d_01, bpm, d_02, ch, cv, sh2, d_03, qf8, d_04;

match_ls:  dl_20, qd2_c1, dl_21, bpm, dl_22, ch, cv, sh1b, dl_23,
           qf1_c1, dl_24, dcor1, ch, cv, dcor1, dl_25, quad_add, dl_26,
           bpm, dl_27;

dip_cell:  dq1, d_05, qf6, d_06, bpm, d_07, dcor, s, ch, cv, dcor,
	   d_08,
	   dl2a, d_09, qd5, d_10, sd2, ch, cv, d_11,
	   bpm, d_13, of1, d_12, qf4, d_11, sf1,
	   sf1, d_11, qf4, d_12, of2, d_13, bpm,
	   d_11, ch, cv, sd1, d_10, qd3, d_09, dl1a;

ms_to_ss: match_ms, dip_cell, match_ss;

ms_to_ls: match_ms, dip_cell, match_ls;

std_cell: ms_to_ss, ss, b_t, inv(ms_to_ss);
sp:       ls, b_t, inv(ms_to_ls), 3*(ms, std_cell), ms, ms_to_ls, ls;

{line: ss, inv(ms_to_ss), ms, ms_to_ss, ss;}
{line: ms, ms_to_ls, ls;}
{line: ls, inv(ms_to_ls), ms, ms_to_ls, ls;}
line: sp;

ring: 1*line, ps_rot, b_t, cav;

cell: ring, symmetry=1;

end;

