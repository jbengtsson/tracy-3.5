
define lattice;

energy = 3.5;

dp = 1.0d-10; codeps = 1.0d-6; dk = 1.0d-6;

meth = 4; nbend = 10; nquad = 10; nsext = 2;


cav: Cavity, L = 0.0, Frequency = 499.654e6, Voltage = 2.2e6, phi = 0.0;

d_01: drift, l = 2.550000;
d_02: drift, l = 0.075000;
d_03: drift, l = 0.100000;
d_04: drift, l = 0.075000;

d_05: drift, l = 0.075000;
d_06: drift, l = 0.075000;
d_07: drift, l = 0.130000;
d_08: drift, l = 0.470000;
d_09: drift, l = 0.075000;

d_10: drift, l = 0.090000;
d_11: drift, l = 0.090000;
d_12: drift, l = 0.090000;
d_13: drift, l = 0.090000;
d_14: drift, l = 0.075000;
d_15: drift, l = 1.450000;
d_16: drift, l = 0.125000;
d_17: drift, l = 0.075000;
d_18: drift, l = 0.075000;
d_19: drift, l = 0.075000;
d_20: drift, l = 3.725000;

d_qd3: drift, l = 0.125;

sfc: marker;
ms:  marker;
ss:  marker;
ls:  marker;

b1_1: bending, l = 0.201000, t = 0.293829, k = 0.000000,
      t1 = -0.730876, t2 = 0.908493, n = nbend, method = meth;
b1_2: bending, l = 0.201000, t = 0.338225, k = 0.000000,
      t1 = -0.490234, t2 = 0.730876, n = nbend, method = meth;
b1_3: bending, l = 0.201000, t = 0.395966, k = 0.000000,
      t1 = -0.183701, t2 = 0.490234, n = nbend, method = meth;
b1_4: bending, l = 0.201000, t = 0.489532, k = 0.000000,
      t1 = 0.220234, t2 = 0.183701, n = nbend, method = meth;
b1_5: bending, l = 0.201000, t = 0.748514, k = 0.000000,
      t1 = 0.908493, t2 = -0.220234, n = nbend, method = meth;

q_b1: quadrupole, l = 0.0, k = 0.0, n = nquad, method = meth;

b1: b1_5, q_b1, b1_4, q_b1, b1_3, q_b1, b1_2, q_b1, b1_1; 

b2_1: bending, l = 0.201000, t = 0.293829, k = 0.000000,
      t1 = 0.842603, t2 = -0.664986, n = nbend, method = meth;
b2_2: bending, l = 0.201000, t = 0.338225, k = 0.000000,
      t1 = 0.664986, t2 = -0.424343, n = nbend, method = meth;
b2_3: bending, l = 0.201000, t = 0.395966, k = 0.000000,
      t1 = 0.424343, t2 = -0.117811, n = nbend, method = meth;
b2_4: bending, l = 0.201000, t = 0.489532, k = 0.000000,
      t1 = 0.117811, t2 = 0.286124, n = nbend, method = meth;
b2_5: bending, l = 0.201000, t = 0.748514, k = 0.000000,
      t1 = -0.286124, t2 = 0.842603, n = nbend, method = meth;

q_b2: quadrupole, l = 0.0, k = 0.0, n = nquad, method = meth;

b2: b2_1, q_b2, b2_2, q_b2, b2_3, q_b2, b2_4, q_b2, b2_5; 

b3: bending, l = 0.866800, t = 2.967868, k = -2.790450,
    t1 = 0.836518, t2 = 0.836518, n = nbend, method = meth;

b4_1: bending, l = 0.201000, t = 0.293829, k = 0.000000,
        t1 = 0.908493, t2 = -0.730876, n = nbend, method = meth;
b4_2: bending, l = 0.201000, t = 0.338225, k = 0.000000,
        t1 = 0.730876, t2 = -0.490234, n = nbend, method = meth;
b4_3: bending, l = 0.201000, t = 0.395966, k = 0.000000,
        t1 = 0.490234, t2 = -0.183701, n = nbend, method = meth;
b4_4: bending, l = 0.201000, t = 0.489532, k = 0.000000,
        t1 = 0.183701, t2 = 0.220234, n = nbend, method = meth;
b4_5: bending, l = 0.201000, t = 0.748514, k = 0.000000,
        t1 = -0.220234, t2 = 0.908493, n = nbend, method = meth;

q_b4: quadrupole, l = 0.0, k = 0.0, n = nquad, method = meth;

b4: b4_1, q_b4, b4_2, q_b4, b4_3, q_b4, b4_4, q_b4, b4_5; 

qd1ls: quadrupole, l = 0.125000, k =  1.009458, n = nquad, method = meth;
qf2ls: quadrupole, l = 0.142000, k = -9.161383, n = nquad, method = meth;
qf3ls: quadrupole, l = 0.162000, k =  4.591937, n = nquad, method = meth;
qf4ls: quadrupole, l = 0.100000, k =  5.544000, n = nquad, method = meth;

qf1ss: quadrupole, l = 0.175000, k =  7.731448, n = nquad, method = meth;
qd2ss: quadrupole, l = 0.125000, k = -9.563168, n = nquad, method = meth;

qd3l:  quadrupole, l = 0.125000, k = -2.508358, n = nquad, method = meth;
qf4l:  quadrupole, l = 0.142000, k =  5.660243, n = nquad, method = meth;
qd3r:  quadrupole, l = 0.125000, k = -3.884425, n = nquad, method = meth;
qf4r:  quadrupole, l = 0.142000, k =  2.983015, n = nquad, method = meth;

qf5:   quadrupole, l = 0.350000, k =  6.645807, n = nquad, method = meth;
qf6:   quadrupole, l = 0.250000, k =  6.804402, n = nquad, method = meth;

{qd3:  quadrupole, l = 0.125000, k = -0*4.30450044, n = nquad, method = meth;}
{qf4:  quadrupole, l = 0.142000, k =  4.83333029, n = nquad, method = meth;}
qf4:  quadrupole, l = 0.142000, k =  3.75550681, n = nquad, method = meth;

sfh:  sextupole, l = 0.07000, k =  0*2.89814e+02, n = nsext, Method = Meth;
sd1l: sextupole, l = 0.14000, k = -0*3.79332e+02, n = nsext, Method = Meth;
sd1r: sextupole, l = 0.14000, k = -0*1.15113e+02, n = nsext, Method = Meth;

sf: sfh, sfc, sfh;

sh1a: sextupole, l = 0.100000, k = 0.0, n = 3, method = meth;
sh2b: sextupole, l = 0.100000, k = 0.0, n = 3, method = meth;

bpm: beam position monitor;

ps_per: map;


std_match: d_01, bpm, qf1ss, d_02, sh1a, d_03, qd2ss, d_04, b1;

dip_cell:
  d_05, qd3l, d_06, sd1l, d_07, bpm, d_08, qf4l, d_09, sf,
  d_09, qf4r, d_08, bpm, d_07, sd1r, d_06, qd3r, d_05,

  b2, d_10, bpm, d_11, qf5, d_12, b3, d_13, qf6, d_14, sh2b, bpm, d_15;

long_match:
  b4, d_04, qd1ls, d_16, sh1a, d_02, qf2ls, d_17, bpm, d_18, qf3ls, d_19,
  qf4ls, d_20;

std_hcell: std_match, dip_cell;
std_cell:  std_hcell, ms, inv(std_hcell), ss;
long_cell: std_match, dip_cell, ms, inv(dip_cell), long_match, ls;

sp: inv(long_cell), 2*std_cell, long_cell;

{ Dipole cell. }
dip_cell_sym:
  b1, d_05, d_qd3, d_06, sd1l, d_07, bpm, d_08, qf4, d_09, sfh, sfc,
  {inv(b1, d_05, d_qd3, d_06, sd1l, d_07, bpm, d_08, qf4, d_09, sfh),}

  {d_10, bpm, d_11, qf5, d_12, b3{, d_13, qf6, d_14, sh2b, bpm, d_15,}
  cav;

{line: dip_cell_sym, cav;}
line: std_cell, cav;
{line: inv(long_cell), long_cell, cav;}
{line: sp, cav;}

cell: line, symmetry = 1;

end;
