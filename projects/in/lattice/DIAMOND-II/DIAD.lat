define lattice; ringtype = 1;

Energy = 3.0; { Beam momentum [GeV]. }

dP = 1e-8; CODeps = 1e-14;

Meth = 4; Nbend = 10; Nquad = 10; Nsext = 2;

pi = 4.0*arctan(1.0); c0 = 2.99792458e8;

Brho = 1e9*Energy/c0;

{ +++++++++++++++++++++++++++++++++++++++++++++++ }
{  }
{  DIAMOND STORAGE RING LATTICE }
{  version 10 iss 1 rev 5 27/08/2008 }
{  }
{  *** nonzero dispersion in straights }
{  *** six families of harmonic sextupoles }
{  *** starting point middle of the long straight }
{  *** dipole fringe fields added }
{  *** measured magnetic lengths for all magnets }
{  }
{ +++++++++++++++++++++++++++++++++++++++++++++++ }
{  Modified for DDBAs (4BA section) with 3.4m middle straight }
{  installed in cell2 (VMX) and cell11 (DIAD) }
{  good matching using triplet and quads in DDBA cell }
{  T.P. 4/5/13 }
{  }


{  Bendings }
bb: Bending, L = 0.933, T = (0.130899693899575)*180.0/pi, T1 = (0.065449846949788)*180.0/pi, T2 = (0.065449846949788)*180.0/pi, K = 0, GAP = 4*0.0233*0.6438, N = Nbend, Method = 4;
{              K2=-0.68, K3= 0.72, K4=-9859.2 }
{  K1=0.000677, K2=-0.68, K3= 0.72, K4=-9859.2 }

{ BB : CSRCSBEN,L=0.933,K1=0,Angle=0.130899693,E1=0.0654498,E2=0.0654498,	& }
{               SG_HALFWIDTH=2, SG_ORDER=1, STEADY_STATE=0, BINS=100, & }
{               N_KICKS=50, INTEGRATION_ORDER=4, CSR=1, ISR=1, EDGE_ORDER=2, HGAP=0.0233, FINT=0.6438 }

{  Injection kickers - have to define different kickers to fire on each turn to avoid problems with apertures? }
k1t0: Drift, L = 1e-12;
k2t0: Drift, L = 1e-12;
k3t0: Drift, L = 1e-12;
k4t0: Drift, L = 1e-12;

{  watch points for checing injection }
{ k1w1: watch,filename="%s.k1w1",mode="coordinate" }
{ k1w2: watch,filename="%s.k1w2",mode="coordinate" }
{ k2w1: watch,filename="%s.k2w1",mode="coordinate" }
{ k2w2: watch,filename="%s.k2w2",mode="coordinate" }
{ k3w1: watch,filename="%s.k3w1",mode="coordinate" }
{ k3w2: watch,filename="%s.k3w2",mode="coordinate" }
{ k4w1: watch,filename="%s.k4w1",mode="coordinate" }
{ k4w2: watch,filename="%s.k4w2",mode="coordinate" }

{ K1F:       LINE=(k1w1, K1T0, k1w2) }
{ K2F:       LINE=(k2w1, K2T0, k2w2) }
{ K3F:       LINE=(k3w1, K3T0, k3w2) }
{ K4F:       LINE=(k4w1, K4T0, k4w2) }
k1f: k1t0;
k2f: k2t0;
k3f: k3t0;
k4f: k4t0;
{ K1F:       MARK }
{ K2F:       MARK }
{ K3F:       MARK }
{ K4F:       MARK }

