{ OXX: MULT,ORDER=3 }
{ OXY: MULT,ORDER=3 }
{ OYY: MULT,ORDER=3 }

oxx: Drift, L = 0.0;
oxy: Drift, L = 0.0;
oyy: Drift, L = 0.0;

{ line definitions---------- }
halfa1: 
  dka, q3d, d10, q1d, d2b, s1d, d3b, oxx, q2d, d4b, 
  d10, oxy, s2d, d10, d6b1;
halfa2: 
  dk, q1b, d2b, s1b, d3b, oxx, q2b, d4b, d10, oxy, 
  s2b, d10, d6b;
halfa21: 
  dk, q1b, d2b, s1c, d3b, oxx, q2b, d4b, d10, oxy, 
  s2c, d10, d6b;
cell4com: 
  dl2b_1, dl2b_2, fp6, dl2b_3, dl2b_4, dl2b_5, drbm, fp7;
cell4com1: 
  fp7, drbm, dl2a_5, dl2a_4, dl2a_3, fp6, dl2a_2, dl2a_1;
cell4mid: 
  q1_2m, d1m, d10, dmid, fpmid, dmid, d10, d1m, q1_2m;
cell4midh: fp7, q1_2m, d1m, q1_1m, dmid, fpmid;
arc4: cell4com, cell4mid, cell4com1;
ebmb: 
  ss1, halfa2, oyy, fpdis, dl1a_5, dl1a_4, dl1a_3, fp8, dl1a_2, dl1a_1, 
  d10, d15, dlb, sy1, fpsy, d1s, q1_2, dhs, d025, sx1, fps, 
  sx1, d025, dhs, q1_3, fp7, d1s, fpsy, sy2, d05, dlbm;
ebmb1: 
  ss1, halfa21, oyy, fpdis, dl1b_5, dl1b_4, dl1b_3, fp9, dl1b_2, dl1b_1, 
  d10, d15, dlb, sy1, fpsy, d1s, q1_2, dhs, d025, sx1, fps, 
  sx1, d025, dhs, q1_3, fp7, d1s, fpsy, sy2, d05, dlbm;
ebma: 
  ls1, halfa1, oyy, fpdisa, dl11a_5, dl11a_4, dl11a_3, fp10, dl11a_2, dl11a_1, 
  d20, d05, dlb1, sy1, d1s, q1_21, dhs, d025, sx1, fps, sx1, 
  d025, dhs, q1_31, fp7, d1s, sy2, d05, dlbm;
cell2hre: inv(cell4midh), inv(cell4com), inv(ebmb);
cell2h: inv(cell2hre);
cell1: ebma, arc4, inv(ebmb1);
cell1re: inv(cell1);
cell2: ebmb, arc4, inv(ebmb);
cell22: 2*cell2;

sp: cell1, fpss, cell2, cell2, inv(cell1);

cav: cavity, Voltage = 2*2.2e6, Phi = 0.0, harnum = h_rf, frequency = 500e6;

ring: 1*sp, cav;

cell: ring, symmetry = 1;

end;
