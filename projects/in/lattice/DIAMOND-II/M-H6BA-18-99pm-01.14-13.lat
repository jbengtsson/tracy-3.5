d_04:     drift, l = 0.090000;
d_03:     drift, l = 0.075000;
d_02:     drift, l = 0.075000;
d_01:     drift, L = 0.634040;
d_01_id:  drift, L = 0.750000;

dl_27:    drift, l = 3.69749;
dl_26:    drift, l = 0.075000;
dl_25:    drift, l = 0.045000;
dl_24:    drift, l = 0.045000;
dl_23:    drift, l = 0.075000;
dl_22:    drift, l = 0.060000;
dl_21:    drift, l = 0.060000;
dl_20:    drift, l = 0.075000;

b_t: marker;
ms:  marker;
ss:  marker;
ls:  marker;

dl1a_1:   bending, l =  0.20000000,
    t =  0.35819342, t1 =  0.00000000, t2 =  0.35819342, k = -0.69634215,
    n = nbend, method = 4;
dl1a_2:   bending, l =  0.20000000,
    t =  0.41231263, t1 = -0.35819342, t2 =  0.77050605, k = -0.69634215,
    n = nbend, method = 4;
dl1a_3:   bending, l =  0.20000000,
    t =  0.48270269, t1 = -0.41231263, t2 =  1.25320874, k = -0.69634215,
    n = nbend, method = 4;
dl1a_4:   bending, l =  0.20000000,
    t =  0.59676436, t1 = -0.48270269, t2 =  1.84997309, k = -0.69634215,
    n = nbend, method = 4;
dl1a_5:   bending, l =  0.20000000,
    t =  0.91247678, t1 = -0.59676436, t2 =  2.76244987, k = -0.69634215,
    n = nbend, method = 4;
dl2a_1:   bending, l =  0.16666667,
    t =  0.35799974, t1 =  0.00000000, t2 =  0.35799974, k = -0.27340895,
    n = nbend, method = 4;
dl2a_2:   bending, l =  0.16666667,
    t =  0.41208968, t1 = -0.35799974, t2 =  0.77008942, k = -0.27340895,
    n = nbend, method = 4;
dl2a_3:   bending, l =  0.33333333,
    t =  0.48244168, t1 = -0.41208968, t2 =  1.25253110, k = -0.27340895,
    n = nbend, method = 4;
dl2a_4:   bending, l =  0.16666667,
    t =  0.59644167, t1 = -0.48244168, t2 =  1.84897277, k = -0.27340895,
    n = nbend, method = 4;
dl2a_5:   bending, l =  0.16666667,
    t =  0.91198338, t1 = -0.59644167, t2 =  2.76095615, k = -0.27340895,
    n = nbend, method = 4;

qf4:      bending, l =  0.15000000,
    t = -0.14396857, t1 = -0.07198428, t2 = -0.07198428, k =  4.76262186,
    n = nbend, method = 4;
qf8:      bending, l =  0.25000000,
    t = -0.24962409, t1 = -0.12481204, t2 = -0.12481204, k =  6.51166189,
    n = nbend, method = 4;
dq1:      bending, l =  0.87000000,
    t =  2.51415520, t1 =  1.25707760, t2 =  1.25707760, k = -2.77713040,
    n = nbend, method = 4;

qd3:      quadrupole, l = 0.15000000, k =   -0.20385755, n = nquad, method = 4;
qd5:      quadrupole, l = 0.11500000, k =   -5.49011326, n = nquad, method = 4;
qd2:      quadrupole, l = 0.18500000, k =   -5.41064215, n = nquad, method = 4;
qf1:      quadrupole, l = 0.25000000, k =    7.29999663, n = nquad, method = 4;
qf6:      quadrupole, l = 0.36000000, k =    7.29947176, n = nquad, method = 4;
qd2_c1:   quadrupole, l = 0.11500000, k =    4.58261461, n = nquad, method = 4;
qf1_c1:   quadrupole, l = 0.18500000, k =   -5.83618219, n = nquad, method = 4;
quad_add: quadrupole, l = 0.18500000, k =    6.21216342, n = nquad, method = 4;

sf1:      sextupole,  l = 0.07000000, k =  199.91678272, n = nsext, method = 4;
sd1:      sextupole,  l = 0.14000000, k = -223.29134027, n = nsext, method = 4;
sd2:      sextupole,  l = 0.14000000, k = -113.36708477, n = nsext, method = 4;

sh1:      sextupole,  l = 0.10000000, k =  -15.76082691, n = nsext, method = 4;
sh2:      sextupole,  l = 0.10000000, k = -118.62028936, n = nsext, method = 4;
s:        sextupole,  l = 0.10000000, k =  -50.85982846, n = nsext, method = 4;

of1:      multipole,  l = 0.09000000,
          hom = (4, 3.73048138e+03, 0.0),
          n = nsext, method = 4;

of2: multipole, l = 0.09000, hom = (4, 0.0, 0.0), n = nsext, Method = Meth;

bpm: beam position monitor;
ch:  corrector, horizontal, method = meth;
cv:  corrector, vertical, method = meth;
chv: ch, cv;

mI_rot: map;
ps_rot: map;

{----- table of segments ----------------------------------------------------}

dl1a: inv(dl1a_5, dl1a_4, dl1a_3, dl1a_2, dl1a_1);
dl2a: dl2a_5, dl2a_4, dl2a_3, dl2a_2, dl2a_1;

match_ss: dr_05, sh1, dr_03, chv, qd2, dr_04, qf1, dr_02, bpm, dr_01, dr_01_id;

match_ms: d_01_id, d_01, bpm, d_02, chv, sh2, d_03, qf8, d_04;

match_ls: dl_20, sh1, dl_21, bpm, dl_22, chv, qd2_c1, dl_23, qf1_c1, dl_24,
	  dcor1, chv, dcor1, dl_25, quad_add, dl_26, bpm, dl_27;

dip_cell: dq1, d_05, qf6, d_06, bpm, d_07, dcor, s, chv, dcor, d_08, dl2a,
	  d_09, qd5, d_10, sd2, chv, d_11, bpm, d_12, of1, d_13, qf4, d_14,
	  sf1, sf1, d_14, qf4, d_13, of2, d_16, bpm, d_11, chv, sd1, d_10,
	  qd3, d_09, dl1a;

ms_to_ss: match_ms, dip_cell, match_ss;

ms_to_ls: match_ms, dip_cell, match_ls;

std_cell: ms, ms_to_ss, ss, b_t, inv(ms_to_ss);
sp: ls, b_t, inv(ms_to_ls), 3*std_cell, ms, ms_to_ls, ls;

{line: ms, ms_to_ss, ss;}
{line: ss, inv(ms_to_ss), ms, mI_rot, ms_to_ss, ss;}
{line: ms, ms_to_ls, ls;}
{line: ls, inv(ms_to_ls), ms, ms_to_ls, ls;}
line: sp;

ring: 1*line, b_t, ps_rot, cav;

cell: ring, symmetry=1;

end;
