{ Symmetrized sh1a & sh1b: sh1. }

define lattice;
energy = 3.500000;
dp = 1d-6;  codeps = 1d-6;  dk = 1d-6;
meth = 4; nbend = 5*2; nquad = 5*2; nsext = 2;

pi = 4.0*arctan(1.0);
c0 = 2.99792458e8; gamma = 3.5e9/c0; Brho = 1e9*Energy/c0;
h_rf = 934; C = 6*93.4285600;

{----- table of elements ----------------------------------------------------}

{ CDR: Bare Lattice 1.66 MV, with IDs 2.69.
       V_RF = 1.5 MV => delta^ = 4.0%, sigma_s = 3.0 mm. }
cav: Cavity, L = 0.0, Frequency = c0/C*h_rf, Voltage = 1.5e6, harnum = h_rf,
     phi = 0.0;

dcor:     drift, l = 0.000000;
dcor1:    drift, l = 0.040000;

dr_01_id: drift, l = 1.000000;
dr_01:    drift, l = 1.457490;
dr_02:    drift, l = 0.075000;
dr_03:    drift, l = 0.075000;
dr_04:    drift, l = 0.080000;
dr_05:    drift, l = 0.075000;
dr_02_id: drift, l = 0.750000;

d_16:     drift, L = 0.330500-0.075-0.09;
d_14:     drift, l = 0.075000;
d_13:     drift, l = 0.075000;
d_12:     drift, L = 0.155500;
d_11:     drift, l = 0.075000;
d_10:     drift, l = 0.075000;
d_09:     drift, l = 0.075000;
d_08:     drift, l = 0.100000;
d_07:     drift, l = 0.080000;
d_06:     drift, l = 0.197000;
d_05:     drift, l = 0.090000;
d_04:     drift, l = 0.090000;
d_03:     drift, l = 0.075000;
d_02:     drift, l = 0.075000;
d_01:     drift, L = 0.634040;
d_01_id:  drift, L = 0.750000;

dl_27:    drift, l = 3.69749;
dl_26:    drift, l = 0.075000;
dl_25:    drift, l = 0.045000;
dl_24:    drift, l = 0.045000;
dl_23:    drift, l = 0.075000;
dl_22:    drift, l = 0.060000;
dl_21:    drift, l = 0.060000;
dl_20:    drift, l = 0.075000;

b_t: marker;
ms:  marker;
ss:  marker;
ls:  marker;

dl1a_1:   bending, l =  0.20000000,
    t =  0.35363923, t1 =  0.00000000, t2 =  0.35363923, k =  0.40195787,
    n = nbend, method = 4;
dl1a_2:   bending, l =  0.20000000,
    t =  0.40707035, t1 = -0.35363923, t2 =  0.76070959, k =  0.40195787,
    n = nbend, method = 4;
dl1a_3:   bending, l =  0.20000000,
    t =  0.47656545, t1 = -0.40707035, t2 =  1.23727503, k =  0.40195787,
    n = nbend, method = 4;
dl1a_4:   bending, l =  0.20000000,
    t =  0.58917690, t1 = -0.47656545, t2 =  1.82645193, k =  0.40195787,
    n = nbend, method = 4;
dl1a_5:   bending, l =  0.20000000,
    t =  0.90087525, t1 = -0.58917690, t2 =  2.72732718, k =  0.40195787,
    n = nbend, method = 4;
dl2a_1:   bending, l =  0.16666667,
    t =  0.43313407, t1 =  0.00000000, t2 =  0.43313407, k =  0.27381495,
    n = nbend, method = 4;
dl2a_2:   bending, l =  0.16666667,
    t =  0.49857601, t1 = -0.43313407, t2 =  0.93171008, k =  0.27381495,
    n = nbend, method = 4;
dl2a_3:   bending, l =  0.33333333,
    t =  0.58369296, t1 = -0.49857601, t2 =  1.51540305, k =  0.27381495,
    n = nbend, method = 4;
dl2a_4:   bending, l =  0.16666667,
    t =  0.72161843, t1 = -0.58369296, t2 =  2.23702148, k =  0.27381495,
    n = nbend, method = 4;
dl2a_5:   bending, l =  0.16666667,
    t =  1.10338370, t1 = -0.72161843, t2 =  3.34040518, k =  0.27381495,
    n = nbend, method = 4;

qf4:      bending, l =  0.15000000,
    t = -0.20869536, t1 = -0.10434768, t2 = -0.10434768, k =  5.38739910,
    n = nbend, method = 4;
qf8:      bending, l =  0.25000000,
    t = -0.24457218, t1 = -0.12228609, t2 = -0.12228609, k =  6.16552247,
    n = nbend, method = 4;
dq1:      bending, l =  0.87000000,
    t =  2.09423054, t1 =  1.04711527, t2 =  1.04711527, k = -2.82423820,
    n = nbend, method = 4;

qd3:      quadrupole, l = 0.15000000, k =   -5.68211080, n = nquad, method = 4;
qd5:      quadrupole, l = 0.11500000, k =   -8.66279573, n = nquad, method = 4;
qd2:      quadrupole, l = 0.18500000, k =   -8.32213897, n = nquad, method = 4;
qf1:      quadrupole, l = 0.25000000, k =    8.00296591, n = nquad, method = 4;
qf6:      quadrupole, l = 0.36000000, k =    7.77449421, n = nquad, method = 4;
qd2_c1:   quadrupole, l = 0.11500000, k =    0.46839097, n = nquad, method = 4;
qf1_c1:   quadrupole, l = 0.18500000, k =   -5.87325880, n = nquad, method = 4;
quad_add: quadrupole, l = 0.18500000, k =    6.73884019, n = nquad, method = 4;

sf1:      sextupole,  l = 0.07000000, k =  154.24770492, n = nsext, method = 4;
sd1:      sextupole,  l = 0.14000000, k = -184.09255175, n = nsext, method = 4;
sd2:      sextupole,  l = 0.14000000, k =  -84.2473347,  n = nsext, method = 4;

sh1:      sextupole,  l = 0.10000000, k = 0.0, n = nsext, method = 4;
sh2:      sextupole,  l = 0.10000000, k = 0.0, n = nsext, method = 4;
s:        sextupole,  l = 0.10000000, k = 0.0, n = nsext, method = 4;

of1:      multipole,  l = 0.09000000, hom = (4, 0.0, 0.0),
          n = nsext, method = 4;

of2: multipole, l = 0.09000, hom = (4, 0.0, 0.0), n = nsext, Method = Meth;

bpm: beam position monitor;
ch:  corrector, horizontal, method = meth;
cv:  corrector, vertical, method = meth;
chv: ch, cv;

mI_rot: map;
ps_rot: map;

{----- table of segments ----------------------------------------------------}

dl1a: inv(dl1a_5, dl1a_4, dl1a_3, dl1a_2, dl1a_1);
dl2a: dl2a_5, dl2a_4, dl2a_3, dl2a_2, dl2a_1;

match_ss: dr_05, sh1, dr_03, chv, qd2, dr_04, qf1, dr_02, bpm, dr_01, dr_01_id;

match_ms: d_01_id, d_01, bpm, d_02, chv, sh2, d_03, qf8, d_04;

match_ls: dl_20, sh1, dl_21, bpm, dl_22, chv, qd2_c1, dl_23, qf1_c1, dl_24,
	  dcor1, chv, dcor1, dl_25, quad_add, dl_26, bpm, dl_27;

dip_cell: dq1, d_05, qf6, d_06, bpm, d_07, dcor, s, chv, dcor, d_08, dl2a,
	  d_09, qd5, d_10, sd2, chv, d_11, bpm, d_12, of1, d_13, qf4, d_14,
	  sf1, sf1, d_14, qf4, d_13, of2, d_16, bpm, d_11, chv, sd1, d_10,
	  qd3, d_09, dl1a;

ms_to_ss: match_ms, dip_cell, match_ss;

ms_to_ls: match_ms, dip_cell, match_ls;

std_cell: ms, ms_to_ss, ss, b_t, inv(ms_to_ss);
sp: ls, b_t, inv(ms_to_ls), 3*std_cell, ms, ms_to_ls, ls;

{line: ms, ms_to_ss, ss;}
{line: ss, inv(ms_to_ss), ms, mI_rot, ms_to_ss, ss;}
{line: ms, ms_to_ls, ls;}
{line: ls, inv(ms_to_ls), ms, ms_to_ls, ls;}
line: sp;

ring: 1*line, b_t, ps_rot, cav;

cell: ring, symmetry=1;

end;
