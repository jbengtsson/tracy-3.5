{e:\opa\opa\examples\6ba-f.opa}

{opa to tracy-2 export}

define lattice;
energy = 3.500000;
dp = 1.0d-10;  codeps = 1.0d-6;  dk = 1.0d-6;
meth = 4; nbend = 10; nquad = 10;

{----- variables ----------------------------------------------------}

shift  = 0;

{----- table of elements ----------------------------------------------------}

cav: Cavity, L = 0.0, Frequency = 499654096.667, Voltage = 2200000, phi = 0*171.697982738;

dr1   : drift, l = 0.631221562204-0.175-shift;
drs   : drift, l = 0.075+shift;
dr2   : drift, l = 0.075000;
dr1d  : drift, l = 0.4336066-0.175;
d2    : drift, l = 0.110316;
dr4d  : drift, l = 0.163993;
dr6d  : drift, l = 1.500000;
d45   : drift, l = 0.179182;
d25   : drift, l = 0.482631;
dr4d5 : drift, l = 0.078006;
dr6d5 : drift, l = 2.500000;
d48   : drift, l = 0.900000;
d28   : drift, l = 0.984793;
dr4d8 : drift, l = 0.075000;
dr6d8 : drift, l = 4.000000;

qf1   : quadrupole, l = 0.150000, k = 5.912931, n=nquad, method=meth;
q2    : quadrupole, l = 0.150000, k = -4.775607, n=nquad, method=meth;
q3d   : quadrupole, l = 0.400000, k = 6.928847, n=nquad, method=meth;
an    : quadrupole, l = 0.200000, k = 0.75*9.067041, n=nquad, method=meth;
q45   : quadrupole, l = 0.150000, k = 6.950945, n=nquad, method=meth;
q25   : quadrupole, l = 0.200000, k = -7.253050, n=nquad, method=meth;
q3d5  : quadrupole, l = 0.300000, k = 8.523174, n=nquad, method=meth;
q48   : quadrupole, l = 0.150000, k = 3.568383, n=nquad, method=meth;
q28   : quadrupole, l = 0.150000, k = -5.723301, n=nquad, method=meth;
q3d8  : quadrupole, l = 0.150000, k = 17.088120, n=nquad, method=meth;

bnr   : bending, l = 0.450000, t = 1.500000, k = -1.158684,
        t1 = 0.000000, t2 = 1.500000, n=nbend, method=meth;
i_bnr   : bending, l = 0.450000, t = 1.500000, k = -1.158684,
        t1 = 1.500000, t2 = 0.000000, n=nbend, method=meth;
bnl   : bending, l = 0.450000, t = 1.500000, k = -1.158684,
        t1 = 1.500000, t2 = 0.000000, n=nbend, method=meth;
i_bnl   : bending, l = 0.450000, t = 1.500000, k = -1.158684,
        t1 = 0.000000, t2 = 1.500000, n=nbend, method=meth;
bnd   : bending, l = 0.504710, t = 2.250000, k = -4.281356,
        t1 = 1.125000, t2 = 1.125000, n=nbend, method=meth;

sf    : sextupole, l = 0.050000, k = 674.548022, n = 2, method=meth;
sd0   : sextupole, l = 0.050000, k = -1478.193180, n = 2, method=meth;
sd3   : sextupole, l = 0.050000, k = -640.844969, n = 2, method=meth;


{----- table of segments ----------------------------------------------------}

sdr0   : drs, 2*sd0, dr1;
sdl0   : dr1, 2*sd0, drs;
{cell   : bnr, sdr0, qf1, dr2, sf, sf, dr2, qf1, sdl0, bnl;
i_cell : i_bnl, inv(sdl0), qf1, dr2, sf, sf, dr2, qf1, inv(sdr0), i_bnr;}
sdr3   : dr1d, 2*sd3, drs;
sdl3   : drs, 2*sd3, dr1d;
dsup3r : bnr, sdr0, qf1, dr2, sf, sf, dr2, an, sdr3, bnd, dr4d, q3d,
         d2, q2, dr6d;
i_dsup3r: dr6d, q2, d2, q3d, dr4d, bnd, inv(sdr3), an, dr2, sf, sf,
         dr2, qf1, inv(sdr0), i_bnr;
dsup3l : dr6d, q2, d2, q3d, dr4d, bnd, sdl3, an, dr2, sf, sf, dr2, qf1,
         sdl0, bnl;
i_dsup3l: i_bnl, inv(sdl0), qf1, dr2, sf, sf, dr2, an, inv(sdl3), bnd,
         dr4d, q3d, d2, q2, dr6d;
dsup5r : bnr, sdr0, qf1, dr2, sf, sf, dr2, an, sdr3, bnd, dr4d5, q3d5,
         d25, q25, d45, q45, dr6d5;
i_dsup5r: dr6d5, q45, d45, q25, d25, q3d5, dr4d5, bnd, inv(sdr3), an,
         dr2, sf, sf, dr2, qf1, inv(sdr0), i_bnr;
dsup5l : dr6d5, q45, d45, q25, d25, q3d5, dr4d5, bnd, sdl3, an, dr2,
         sf, sf, dr2, qf1, sdl0, bnl;
i_dsup5l: i_bnl, inv(sdl0), qf1, dr2, sf, sf, dr2, an, inv(sdl3), bnd,
         dr4d5, q3d5, d25, q25, d45, q45, dr6d5;
dsup8r : bnr, sdr0, qf1, dr2, sf, sf, dr2, an, sdr3, bnd, dr4d8, q3d8,
         d28, q28, d48, q48, dr6d8;
i_dsup8r: dr6d8, q48, d48, q28, d28, q3d8, dr4d8, bnd, inv(sdr3), an,
         dr2, sf, sf, dr2, qf1, inv(sdr0), i_bnr;
dsup8l : dr6d8, q48, d48, q28, d28, q3d8, dr4d8, bnd, sdl3, an, dr2,
         sf, sf, dr2, qf1, sdl0, bnl;
i_dsup8l: i_bnl, inv(sdl0), qf1, dr2, sf, sf, dr2, an, inv(sdl3), bnd,
         dr4d8, q3d8, d28, q28, d48, q48, dr6d8;
sp35   : dsup5l, dsup3r, dsup3l, dsup5r;
i_sp35 : i_dsup5r, i_dsup3l, i_dsup3r, i_dsup5l;
sp38   : dsup8l, dsup3r, dsup3l, dsup8r;
i_sp38 : i_dsup8r, i_dsup3l, i_dsup3r, i_dsup8l;
sp358  : dsup8l, dsup3r, dsup3l, dsup5r, dsup5l, dsup3r, dsup3l, dsup8r;
i_sp358: i_dsup8r, i_dsup3l, i_dsup3r, i_dsup5l, i_dsup5r, i_dsup3l,
         i_dsup3r, i_dsup8l;

spl    : dsup8l, dsup3r, dsup3l, dsup5r, dsup5l, dsup3r, dsup3l, dsup5r;
i_spl  : i_dsup5r, i_dsup3l, i_dsup3r, i_dsup5l, i_dsup5r, i_dsup3l,
         i_dsup3r, i_dsup8l;

spr    : dsup5l, dsup3r, dsup3l, dsup5r, dsup5l, dsup3r, dsup3l, dsup8r;
i_spr  : i_dsup8r, i_dsup3l, i_dsup3r, i_dsup5l, i_dsup5r, i_dsup3l,
         i_dsup3r, i_dsup5l;

{sp     : spl, spr;
i_sp   : i_spr, i_spl;
ring   : sp;
i_ring : i_sp;}

sp: spl, spr;

{line: dsup5l, dsup3r, dsup3l, dsup5r, cav;}
{line:
  dsup8l, dsup3r, dsup3l, dsup5r, dsup5l, dsup3r, dsup3l, dsup5r,
  dsup5l, dsup3r, dsup3l, dsup5r, dsup5l, dsup3r, dsup3l, dsup8r, cav;}
line: 1*sp, cav;

cell: line, symmetry=1;

end;

