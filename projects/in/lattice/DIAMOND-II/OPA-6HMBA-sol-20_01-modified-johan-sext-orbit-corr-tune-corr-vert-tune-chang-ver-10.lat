bpm         : beam position monitor;
ch          : corrector, horizontal;
cv          : corrector, vertical;
b_t         : marker;


{----- table of segments ----------------------------------------------------}

chv   : ch, cv;
ocf6  : ocf61;
of1   : drof, of11, drof;
of2   : drof, of21, drof;
of3   : drof, of31, drof;
