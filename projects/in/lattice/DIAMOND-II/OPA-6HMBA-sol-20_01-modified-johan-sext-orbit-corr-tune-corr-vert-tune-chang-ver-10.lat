        d_ls05in, o2a, qdm11, d_ls01, qfm1, dr_02, bpm, o1a, qdm22, dr_01ls1,
        d_lsadd, d_ls, ls1;
hc1   : ss1, dr_01, bpm, dr_02, o1b, gs, qf1, dr_03, sh1a, chv, o2b,
        dr_04, qd2, dr_05, s1, o3;
hc2   : dl1a, s2, dr_06, qd3, dr_07, o4, sda, chv, dr_08, bpm, dr_09, qf422,
        dr_10, o5, sf, bpm, chv;
i_hc2 : inv(chv), bpm, sf, o5, dr_10, qf422, dr_09, bpm, dr_08, inv(chv),
        sda, o4, dr_07, qd3, dr_06, s2, i_dl1a;
hc3   : fps, dr_11, qf421, dr_12, of2, ge, dr_13, bpm, dr_14, o6, sdb, chv,
        gs, dr_15;
hc4   : qd5, dr_16, s3, dl2b, s4, dr_17, bpm, chv, dr_18, qf6;
i_hc4 : qf6, dr_18, inv(chv), bpm, dr_17, s4, i_dl2b, s3, dr_16, qd5;
hc5   : dr_19, ocf6, dq1, s5, ocf6, dr_20, qf8, dr_21, shmid, chv,
        dr_22, bpm, dr_23, cellcenter;
hc    : hc1, hc2, hc3, hc4, hc5;
i_hc  : inv(hc5), i_hc4, inv(hc3), i_hc2, inv(hc1);

sp1       : i_hc, hc;
i_sp1     : i_hc, hc;
sp1_b_t   : i_hc, b_t, hc;
i_sp1_b_t : i_hc, b_t, hc;

spj   : i_hc, hc;
i_spj : i_hc, hc;

hcj   : inv(mccj), hc2, hc3, hc4, hc5;
i_hcj : inv(hc5), i_hc4, inv(hc3), i_hc2, mccj;

spj1  : hcj, sp1, sp1_b_t, sp1, i_hcj;
i_spj1: hcj, i_sp1, i_sp1_b_t, i_sp1, i_hcj;

hcj1  : i_hcj, hcj;
i_hcj1: i_hcj, hcj;
sp    : spj1;
i_sp  : i_spj1;

cav: Cavity, L = 0.0, Frequency = 499.691e6, Voltage = 2.2e6, phi = 0.0;

{ Unit Cell. }
{ring: hc, i_hc, cav;}
{ Matching Cell. }
{ring: hcj, i_hcj, cav;}

ring: 1*spj1, b_t, cav;

cell: ring, symmetry=1;

end;

