{opa to tracy-2 export}

define lattice;
energy = 3.500000;
dp = 1.0d-10; codeps = 1.0d-6; dk = 1.0d-6;
meth = 4;

{----- variables ----------------------------------------------------}

dp      = 1e-10;
codeps  = 1e-6;
dk      = 1e-6;
nbend   = 10;
nquad   = 10;
nsext   = 2;

{----- table of elements ----------------------------------------------------}

cav: Cavity, L = 0.0, Frequency = 499654096.667, Voltage = 2200000, phi = 0.0;

d5: drift, l = 0.073642;
d6: drift, l = 0.430954;
d7: drift, l = 0.105044;

d_ms: drift, l = 1.500000;
d_ss: drift, l = 2.500000;
d_ls: drift, l = 4.000000;

ss: marker;
ms: marker;
ls: marker;

b1: bending, l = 1.200000, t = 2.942714, k = -1.055971,
    t1 = 1.471357, t2 = 1.471357, n=nbend, method=meth;
b2: bending, l = 0.573951, t = 0.807286, k = -1.560063,
    t1 = 0.403643, t2 = 0.403643, n=nbend, method=meth;

qf1a_tba: quadrupole, l =  0.16001797, k =  4.98609184, n = nquad, method = 4;
qf1b_tba: quadrupole, l =  0.14244836, k =  4.58041993, n = nquad, method = 4;

d4:     drift, l =  0.28369005;
qd4_ls: quadrupole, l =  0.40000000, k = -5.96234376, n = nquad, method = 4;
d3:     drift, l =  0.16259182;
qf3_ls: quadrupole, l =  0.15261853, k = 16.87221821, n = nquad, method = 4;
d2:     drift, l =  0.34486524;
qd2_ls: quadrupole, l =  0.16672350, k = -14.35122916, n = nquad, method = 4;
d1:     drift, l =  0.34759290;
qf1_ls: quadrupole, l =  0.39999944, k =  1.25524239, n = nquad, method = 4;

d8:     drift, l =  0.07819955;
qf1_ms: quadrupole, l =  0.19356547, k = -3.91974840, n = nquad, method = 4;
d9:     drift, l =  0.10696371;
qd2_ms: quadrupole, l =  0.14882440, k =  8.59046139, n = nquad, method = 4;

d10:    drift, l =  0.32314254;
qd3_ss: quadrupole, l =  0.15686959, k = -0.64700694, n = nquad, method = 4;
d11:    drift, l =  0.21741975;
qf2_ss: quadrupole, l =  0.20054796, k =  9.48022989, n = nquad, method = 4;
d12:    drift, l =  0.07500001;
qd1_ss: quadrupole, l =  0.10068468, k = -11.12708712, n = nquad, method = 4;

sfh:  sextupole, l =  0.05000000, k =  396.08716927, n = nsext, method = 4;
sd1a: sextupole, l =  0.10000000, k = -336.91839007, n = nsext, method = 4;
sd1b: sextupole, l =  0.10000000, k = -418.13138392, n = nsext, method = 4;

bpm: beam position monitor;
ch: corrector, horizontal;
cv: corrector, vertical;

ps_rot: map;


{----- table of segments ----------------------------------------------------}

tba_1:     d5, sd1a, d6, qf1a_tba, d7, sfh;
tba_2:     d5, sd1b, d6, qf1b_tba, d7, sfh;
tba_hcell: b1, tba_1, inv(tba_2), b2;
tba_cell:  tba_hcell, inv(tba_hcell);

ms_mcell:  d8, qf1_ms, d9, qd2_ms, d_ms;
ss_mcell:  d_ss, qd1_ss, d12, qf2_ss, d11, qd3_ss, d10;
ls_mcell:  d_ls, qf1_ls, d1, qd2_ls, d2, qf3_ls, d3, qd4_ls, d4;

std_hcell: ss_mcell, tba_cell, ms_mcell, ms;
std_cell:  inv(std_hcell), ss, std_hcell;

line2:     ls, ls_mcell, tba_cell, ms_mcell;

sp1: line2, inv(std_hcell), ss, ps_rot, std_hcell, inv(line2);
sp:  line2, 3*std_cell, inv(line2);

{ring: std_hcell, inv(std_hcell), cav;}
{ring: inv(std_hcell), ss, std_hcell, cav;}
{ring:  ss, std_hcell, inv(line2), line2, inv(std_hcell), ss, cav;}
ring: sp1, cav;
{ring: sp, ps_rot, cav;}

cell: ring, symmetry=1;

end;

