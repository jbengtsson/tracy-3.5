qf6:      quadrupole, l = 0.36000000, k =    7.29874556, n = nquad, method = 4;

qd2_c1:   quadrupole, l = 0.11500000, k =    6.36984508, n = nquad, method = 4;
qf1_c1:   quadrupole, l = 0.18500000, k =   -7.23314729, n = nquad, method = 4;
