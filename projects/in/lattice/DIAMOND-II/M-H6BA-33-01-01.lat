sf1:      sextupole,  l = 0.07000000, k =  187.90016899, n = nsext, method = 4;
sd1:      sextupole,  l = 0.14000000, k = -245.80753980, n = nsext, method = 4;
sd2:      sextupole,  l = 0.14000000, k =  -96.05353695, n = nsext, method = 4;

sls:      sextupole,  l = 0.10000000, k =  1e-10, n = nsext, method = 4;
