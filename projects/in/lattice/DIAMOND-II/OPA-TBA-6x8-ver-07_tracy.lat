qf3   : quadrupole, l = 0.300000, k = 3.438000, n=nquad, method=meth;
qf4   : quadrupole, l = 0.150000, k = 4.810000, n=nquad, method=meth;
qf5   : quadrupole, l = 0.200000, k = -2.484000, n=nquad, method=meth;
qd6   : quadrupole, l = 0.150000, k = 8.028011, n=nquad, method=meth;
q48   : quadrupole, l = 0.150000, k = 3.568383, n=nquad, method=meth;
