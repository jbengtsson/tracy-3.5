qf11  : quadrupole, l = 0.150000, k = 11.163090, n=nquad, method=meth;
qd11  : quadrupole, l = 0.150000, k = -14.923092, n=nquad, method=meth;
qd22  : quadrupole, l = 0.200000, k = 4.554853, n=nquad, method=meth;
