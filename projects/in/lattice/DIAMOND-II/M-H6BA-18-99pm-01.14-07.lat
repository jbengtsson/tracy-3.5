{ Symmetrized sh1a & sh1b: sh1. }

define lattice;
energy = 3.500000;
dp = 1d-6;  codeps = 1d-6;  dk = 1d-6;
meth = 4; nbend = 10; nquad = 10; nsext = 2;

pi = 4.0*arctan(1.0);
c0 = 2.99792458e8; gamma = 3.5e9/c0; Brho = 1e9*Energy/c0;
h_rf = 934; C = 6*93.4285600;

{----- table of elements ----------------------------------------------------}

{ CDR: Bare Lattice 1.66 MV, with IDs 2.69.
       V_RF = 1.5 MV => delta^ = 4.0%, sigma_s = 3.0 mm. }
cav: Cavity, L = 0.0, Frequency = c0/C*h_rf, Voltage = 1.5e6, harnum = h_rf,
     phi = 0.0;

dcor     : drift, l = 0.000000;
dcor1    : drift, l = 0.040000;
dL1 = 0.05;
dL2 = 0.1;
dr_01    : drift, l = 2.521350 - dL1 - dL2;
dr_02    : drift, l = 0.075000;
dr_03    : drift, l = 0.075000;
dr_04    : drift, l = 0.150000 + dL2;
dr_05    : drift, l = 0.075000;

d_14     : drift, l = 0.075000;
d_13     : drift, l = 0.075000;
d_12     : drift, l = 0.165500;
d_11     : drift, l = 0.075000;
d_10     : drift, l = 0.075000;
d_09     : drift, l = 0.075000;
d_08     : drift, l = 0.100000;
d_07     : drift, l = 0.080000;
d_06     : drift, l = 0.197000;
d_05     : drift, l = 0.090000;
d_04     : drift, l = 0.090000;
d_03     : drift, l = 0.075000;
d_02     : drift, l = 0.075000;
d_01     : drift, l = 1.384200;

dl_27    : drift, l = 3.696350;
dl_26    : drift, l = 0.075000;
dl_25    : drift, l = 0.035000;
dl_24    : drift, l = 0.035000;
dl_23    : drift, l = 0.075000;
dl_22    : drift, l = 0.075000;
dl_21    : drift, l = 0.075000;
dl_20    : drift, l = 0.075000;

b_t      : marker;
ms       : marker;
ss       : marker;
ls       : marker;

dl1a_1:   bending, l =  0.20000000,
    t =  0.42209444, t1 =  0.00000000, t2 =  0.42209444, k =  0.01431099,
    n = nbend, method = 4;
dl1a_2:   bending, l =  0.20000000,
    t =  0.48586841, t1 = -0.42209444, t2 =  0.90796285, k =  0.01431099,
    n = nbend, method = 4;
dl1a_3:   bending, l =  0.20000000,
    t =  0.56881592, t1 = -0.48586841, t2 =  1.47677877, k =  0.01431099,
    n = nbend, method = 4;
dl1a_4:   bending, l =  0.20000000,
    t =  0.70322597, t1 = -0.56881592, t2 =  2.18000474, k =  0.01431099,
    n = nbend, method = 4;
dl1a_5:   bending, l =  0.20000000,
    t =  1.07526089, t1 = -0.70322597, t2 =  3.25526563, k =  0.01431099,
    n = nbend, method = 4;
dl2a_1:   bending, l =  0.16667000,
    t =  0.37357460, t1 =  0.00000000, t2 =  0.37357460, k = -0.36162573,
    n = nbend, method = 4;
dl2a_2:   bending, l =  0.16667000,
    t =  0.43001775, t1 = -0.37357460, t2 =  0.80359235, k = -0.36162573,
    n = nbend, method = 4;
dl2a_3:   bending, l =  0.33334000,
    t =  0.50343042, t1 = -0.43001775, t2 =  1.30702277, k = -0.36162573,
    n = nbend, method = 4;
dl2a_4:   bending, l =  0.16667000,
    t =  0.62239001, t1 = -0.50343042, t2 =  1.92941279, k = -0.36162573,
    n = nbend, method = 4;
dl2a_5:   bending, l =  0.16667000,
    t =  0.95165944, t1 = -0.62239001, t2 =  2.88107223, k = -0.36162573,
    n = nbend, method = 4;

qf4:      bending, l =  0.15000000,
    t = -0.25538075, t1 = -0.12769038, t2 = -0.12769038, k =  4.86839307,
    n = nbend, method = 4;
qf8:      bending, l =  0.25000000,
    t = -0.43635749, t1 = -0.21817874, t2 = -0.21817874, k =  6.46344965,
    n = nbend, method = 4;
dq1:      bending, l =  0.87000000,
    t =  2.31078114, t1 =  1.15539057, t2 =  1.15539057, k = -2.80850333,
    n = nbend, method = 4;

qd3:      quadrupole, l = 0.15000000, k =   -3.30391005, n = nquad, method = 4;
qd5:      quadrupole, l = 0.10500000, k =   -4.85217194, n = nquad, method = 4;
qd2:      quadrupole, l = 0.15000000, k =   -7.44999879, n = nquad, method = 4;
qf1:      quadrupole, l = 0.20000000, k =    8.26918050, n = nquad, method = 4;
qf6:      quadrupole, l = 0.36000000, k =    7.26158588, n = nquad, method = 4;
qd2_c1:   quadrupole, l = 0.10500000, k =   -0.14529771, n = nquad, method = 4;
qf1_c1:   quadrupole, l = 0.18500000, k =   -5.56426703, n = nquad, method = 4;
quad_add: quadrupole, l = 0.18500000, k =    7.07244912, n = nquad, method = 4;

sf1:      sextupole,  l = 0.07000000, k =  144.05063828, n = nsext, method = 4;
sd1:      sextupole,  l = 0.14000000, k = -145.37955344, n = nsext, method = 4;
sd2:      sextupole,  l = 0.14000000, k = -140.66032372, n = nsext, method = 4;
s:        sextupole,  l = 0.10000000, k =   15.81474679, n = nsext, method = 4;
sh1:      sextupole,  l = 0.10000000, k =   -9.38134954, n = nsext, method = 4;
sh2:      sextupole,  l = 0.10000000, k =  -31.85221807, n = nsext, method = 4;

of1:      multipole,  l = 0.09000000, hom = (5, 0e6, 0.0),
          n = nsext, method = 4;

of2     : multipole, l = 0.09000, hom = (4, 0.0, 0.0), n = nsext, Method = Meth;

bpm: beam position monitor;
ch:  corrector, horizontal, method = meth;
cv:  corrector, vertical, method = meth;
chv: ch, cv;


ps_rot: map;
mI_rot: map;

{----- table of segments ----------------------------------------------------}

dl1a     : inv(dl1a_5, dl1a_4, dl1a_3, dl1a_2, dl1a_1);
dl2a     : dl2a_5, dl2a_4, dl2a_3, dl2a_2, dl2a_1;

match_ss: dr_05, sh1, dr_03, chv, qd2, dr_04, qf1, dr_02, bpm, dr_01;

match_ms: d_01, bpm, d_02, chv, sh2, d_03, qf8, d_04;

match_ls: dl_20, sh1, dl_21, bpm, dl_22, chv, qd2_c1, dl_23,
          qf1_c1, dl_24, dcor1, chv, dcor1, dl_25, quad_add, dl_26,
          bpm, dl_27;

dip_cell: dq1, d_05, qf6, d_06, bpm, d_07, dcor, s, chv, dcor, d_08,
	  dl2a, d_09, qd5, d_10, sd2, chv, d_11,
          bpm, d_12, of1, d_13, qf4, d_14, sf1,
	  sf1, d_14, qf4, d_13, of2, d_12, bpm,
	  d_11, chv, sd1, d_10, qd3, d_09, dl1a;

ms_to_ss : match_ms, dip_cell, match_ss;

ms_to_ls : match_ms, dip_cell, match_ls;

std_cell  : ms_to_ss, mI_rot, ss, b_t, inv(ms_to_ss);
sp       : ls, b_t, inv(ms_to_ls), 3*(ms, std_cell), ms, ms_to_ls, mI_rot, ls;

{line: ms, ms_to_ss, ss;}
line: ss, inv(ms_to_ss), ms, mI_rot, ms_to_ss, ss;
{line: ms, ms_to_ls, ls;}
{line: ls, inv(ms_to_ls), ms, ms_to_ls, ls;}
{line: sp;}

ring: 1*line, ps_rot, b_t, cav;

cell: ring, symmetry=1;

end;
