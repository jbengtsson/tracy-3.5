{** Marker **}
 FIN : marker;
 DEBUT : marker;
 K1 : marker;
 K2 : marker;

{**BPMs**}
 MBPM: marker;

{**Correctors**}
 hstr : corrector, horizontal,method=meth;
 vstr : corrector, vertical,method=meth;

BEGIN_S: marker;
END_S: marker;

{**Superperiods**}
S1A: BEGIN_S, DS, SS1A, hstr, vstr, DS, END_S;
S2A: BEGIN_S, DS, SS2A, hstr, vstr, DS, END_S;
S1B: BEGIN_S, DS, SS1B, hstr, vstr, DS, END_S;
S2B: BEGIN_S, DS, SS2B, hstr, vstr, DS, END_S;
S1C: BEGIN_S, DS, SS1C, hstr, vstr, DS, END_S;
S2C: BEGIN_S, DS, SS2C, hstr, vstr, DS, END_S;
S1D: BEGIN_S, DS, SS1D, hstr, vstr, DS, END_S;
S2D: BEGIN_S, DS, SS2D, hstr, vstr, DS, END_S;

PERIOD: DEBUT,D1D2,MBPM,K1,KD1,K1,KD2,Q1D,
	  D2B,S1D,D3B,Q2D,D4B,Q3D,D5B,S2D,D6Ba,MBPM,D6Bb,
	  BB,D4A,Q2AD,D3Aa,MBPM,D3Ab,S2A,D2A,Q1AD,D1Aa,MBPM,
	  D1Ab,S1A,D1A,Q1AB,D2A,S2A,D3A,Q2AB,D4Aa,MBPM,D4ab,
	  BB,D6B,S2C,D5B,Q3B,D4Ba,MBPM,D4Bb,Q2B,D3B,S1C,D2B,
	  Q1B,KD2,K1,KD1,K1,MBPM,D1BEnd2,
	  D1BCentre,
	  D1BCentre,
	  D1BEnd2,MBPM,K1,KD1,K1,KD2,Q1B,
	  D2B,S1B,D3B,Q2B,D4B,Q3B,D5B,S2B,D6Ba,MBPM,D6Bb,
	  BB,D4A,Q2AB,D3Aa,MBPM,D3Ab,S2A,D2A,Q1AB,D1Aa,MBPM,
	  D1Ab,S1A,D1A,Q1AB,D2A,S2A,D3A,Q2AB,D4Aa,MBPM,D4Ab,
	  BB,D6B,S2B,D5B,Q3B,D4Ba,MBPM,D4Bb,Q2B,D3B,S1B,D2B,
	  Q1B,KD2,K1,KD1,K1,MBPM,D1BEnd2,
	  D1BCentre,
	  D1BCentre,
	  D1BEnd2,MBPM,K1,KD1,K1,KD2,Q1B,
	  D2B,S1B,D3B,Q2B,D4B,Q3B,D5B,S2B,D6Ba,MBPM,D6Bb,
	  BB,D4A,Q2AB,D3Aa,MBPM,D3Ab,S2A,D2A,Q1AB,D1Aa,MBPM,
	  D1Ab,S1A,D1A,Q1AB,D2A,S2A,D3A,Q2AB,D4Aa,MBPM,D4Ab,
	  BB,D6B,S2B,D5B,Q3B,D4Ba,MBPM,D4Bb,Q2B,D3B,S1B,D2B,
	  Q1B,KD2,K1,KD1,K1,MBPM,D1BEnd2,
	  D1BCentre,
	  D1BCentre,
	  D1BEnd2,MBPM,K1,KD1,K1,KD2,Q1B,
	  D2B,S1C,D3B,Q2B,D4B,Q3B,D5B,S2C,D6Ba,MBPM,D6Bb,
	  BB,D4A,Q2AB,D3Aa,MBPM,D3Ab,S2A,D2A,Q1AB,D1Aa,MBPM,
	  D1Ab,S1A,D1A,Q1AD,D2A,S2A,D3A,Q2AD,D4Aa,MBPM,D4Ab,
	  BB,D6B,S2D,D5B,Q3D,D4Ba,MBPM,D4Bb,Q2D,D3B,S1D,D2B,
	  Q1D,KD2,K1,KD1,K1,MBPM,D1D2;

CAV: Cavity, Frequency=499.66d6,Harnum=936, Voltage=3.3d6;

RING: 6*PERIOD, CAV;

{***** Define CELL structure ****}
 CELL:	RING, symmetry = 1;

end;
